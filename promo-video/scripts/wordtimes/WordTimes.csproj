<Project Sdk="Microsoft.NET.Sdk">

  <!-- Where each word of a voice take starts and ends, for scripts/demo_audio.py: whisper.cpp through Whisper.net,
       the same versions Study Stash uses (Metal on a Mac with Apple silicon, the processor otherwise). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>WordTimes</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Metal" Version="1.9.1" />
  </ItemGroup>

</Project>
