{
  "name": "study-stash-promo",
  "private": true,
  "version": "1.0.0",
  "description": "Study Stash's promotional video, built with Remotion",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Promo out/promo.mp4",
    "render:vertical": "remotion render src/index.ts PromoVertical out/promo-vertical.mp4",
    "render:all": "npm run render && npm run render:vertical",
    "typecheck": "tsc --noEmit",
    "audio": "python3 scripts/make_audio.py"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/fonts": "4.0.529",
    "@remotion/transitions": "4.0.529",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
