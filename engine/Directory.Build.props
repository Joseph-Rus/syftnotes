<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Numbers, dates and casing work the same on every computer, so the library's files read the same everywhere. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The one place Syft Notes' version lives: CI publishes v<version> when it changes on main. The laptop and
         setup check it. -->
    <StudyStashVersion>0.23.1</StudyStashVersion>
    <Version>$(StudyStashVersion)</Version>
    <InformationalVersion>$(StudyStashVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The self-test, the demo libraries and the STUDYSTASH_* switches tests steer the app with (a pretend microphone,
         fixed ports, a made-up update): in every build unless TestHelpers=false, which is how a student's copy is built
         (windows\build.ps1 without -TestHelpers). Off, the switches read as unset and the self-test isn't there. -->
    <TestHelpers Condition="'$(TestHelpers)' == ''">true</TestHelpers>
    <DefineConstants Condition="'$(TestHelpers)' == 'true'">$(DefineConstants);TEST_HELPERS</DefineConstants>
  </PropertyGroup>
</Project>
