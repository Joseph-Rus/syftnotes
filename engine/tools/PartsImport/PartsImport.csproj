<Project Sdk="Microsoft.NET.Sdk">

  <!-- Not in StudyStash.slnx: run by hand when the parts library changes (see Program.cs and README.md), never by CI or
       the app. It downloads the chosen parts, makes them safe and in the house style, and writes the one embedded
       resource the app reads (src/StudyStash.Core/Rich/PartsLibrary.xml) and the credits. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <NoWarn>CS1998</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StudyStash.Core\StudyStash.Core.csproj" />
    <PackageReference Include="Svg.Skia" Version="5.1.1" />
  </ItemGroup>

</Project>
