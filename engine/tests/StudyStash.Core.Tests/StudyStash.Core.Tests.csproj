<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- xunit.v3 asks every call that takes a CancellationToken to pass TestContext.Current.CancellationToken: not done across these older tests yet. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.16.4" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StudyStash.Core\StudyStash.Core.csproj" />
    <!-- The app's own Poll, so tests wait the same way the app does (no other App code is referenced). -->
    <Compile Include="..\..\src\StudyStash.App\Services\Kit\Poll.cs" Link="Poll.cs" />
    <ProjectReference Include="..\..\src\StudyStash.Library\StudyStash.Library.csproj" />
    <ProjectReference Include="..\..\src\StudyStash.Audio\StudyStash.Audio.csproj" />
    <!-- Built first, not referenced: the live service test runs the engine itself, and `dotnet test` builds only what
         the tests depend on, so without this nothing compiled the command. -->
    <ProjectReference Include="..\..\src\StudyStash.Engine\StudyStash.Engine.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Golden\**" CopyToOutputDirectory="PreserveNewest" LinkBase="Golden" />
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" LinkBase="Fixtures" />
  </ItemGroup>

</Project>
