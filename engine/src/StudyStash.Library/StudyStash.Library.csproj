<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\StudyStash.Core\StudyStash.Core.csproj" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <!-- The library's MCP server, so Claude (Claude Code, Claude Desktop, claude.ai) can read your lectures. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StudyStash.Core.Tests" />
  </ItemGroup>

  <!-- The Study Stash icon, from assets/ at the repo's root: each page's favicon and home-screen icon. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\assets\study-stash.ico" LogicalName="study-stash.ico" />
    <EmbeddedResource Include="..\..\..\assets\icon.png" LogicalName="icon.png" />
    <EmbeddedResource Include="..\..\..\assets\apple-touch-icon.png" LogicalName="apple-touch-icon.png" />
  </ItemGroup>

  <!-- The phone app (web/, built with `npm run build`), served at /app/ from web/ beside the app. Left out when it
       hasn't been built: /app/ then says so. -->
  <ItemGroup Condition="Exists('..\..\..\web\dist\index.html')">
    <Content Include="..\..\..\web\dist\**\*" LinkBase="web" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
