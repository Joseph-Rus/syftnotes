<!-- The conversation from the ask bar under a lecture's notes (design 16's answer card), just above the bar: a solid
     card with every question asked here and its answer, oldest first, New chat to start afresh and a close button, in
     room the page makes for it, so it never lies over the notes. It scrolls inside a height of its own (AnswerHeight),
     the newest at the bottom. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:v="using:StudyStash.App.Views"
             x:Class="StudyStash.App.Views.WinAiAnswer"
             x:DataType="vm:AiAskModel"
             ClipToBounds="False">
  <UserControl.Styles>
    <StyleInclude Source="avares://StudyStash/Views/WinAiStyles.axaml" />
  </UserControl.Styles>

  <Border Name="Card" Classes="ai-answer-card" MaxWidth="600" IsVisible="{Binding HasLatest}">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,2,Auto" Margin="8,6,6,0">
        <!-- This place's kept conversations: one picked opens here, to carry on -->
        <Button Name="ChatsButton" Classes="ai-newchat" VerticalAlignment="Center" AutomationProperties.Name="Chats">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <c:Icon Glyph="forum" Size="14" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
            <TextBlock Classes="ai-asked" Text="Chats" VerticalAlignment="Center" />
            <c:Icon Glyph="expand_more" Size="13" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft" ShowMode="Standard" FlyoutPresenterClasses="bare">
              <v:AiChatsMenu />
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button Name="NewChat" Grid.Column="2" Classes="ai-newchat" VerticalAlignment="Center" Command="{Binding NewChatCommand}"
                AutomationProperties.Name="New chat">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <c:Icon Glyph="add" Size="14" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
            <TextBlock Classes="ai-asked" Text="New chat" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="4" Classes="ai-close" VerticalAlignment="Center" ToolTip.Tip="Close" AutomationProperties.Name="Close the answer"
                Command="{Binding CloseAnswerCommand}">
          <c:Icon Glyph="close" Size="16" Foreground="{DynamicResource Fg2}" />
        </Button>
      </Grid>
      <ScrollViewer Name="Thread" Classes="ai-answer-scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" c:FollowEnd.IsOn="True">
        <!-- Every question and its answer select as one, a drag running on from a question into its answer -->
        <ItemsControl ItemsSource="{Binding Turns}" Margin="14,2,14,12" c:TextSelection.Area="True">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="16" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AiTurn">
              <StackPanel Spacing="6">
                <c:PageText Classes="ai-q" Text="{Binding Question}" />
                <!-- The answer: the hopping bits while it's written, the pixel s beside it once it's there -->
                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsThinking}">
                  <c:SyftLoader Kind="HoppingBits" Size="22" IsActive="{Binding IsThinking}" VerticalAlignment="Center" />
                  <TextBlock Classes="ai-thinking" Text="{Binding ThinkingWords}" VerticalAlignment="Center" />
                </StackPanel>
                <c:PageText Classes="ai-answer" Text="{Binding Failed}" Foreground="{DynamicResource Warn}"
                           IsVisible="{Binding Failed, Converter={x:Static c:Converters.NotEmpty}}" />
                <Grid ColumnDefinitions="Auto,10,*" IsVisible="{Binding !IsThinking}">
                <c:SyftMark Size="26" Bits="False" VerticalAlignment="Top" Margin="0,2,0,0" IsVisible="{Binding Answer, Converter={x:Static c:Converters.NotEmpty}}" />
                <StackPanel Grid.Column="2" Spacing="6">
                  <c:NoteView Compact="True" BodySize="14" BodyLineHeight="20.3" Markdown="{Binding Answer}" IsVisible="{Binding Answer, Converter={x:Static c:Converters.NotEmpty}}" />
                  <v:AiByline HorizontalAlignment="Left" IsVisible="{Binding Byline, Converter={x:Static c:Converters.NotEmpty}}" />
                  <TextBlock Classes="ai-byline" Text="{Binding FellBackNote}" TextWrapping="Wrap" IsVisible="{Binding FellBackNote, Converter={x:Static c:Converters.NotEmpty}}" />
                  <TextBlock Classes="ai-byline" Text="{Binding OlderLibraryNote}" TextWrapping="Wrap" IsVisible="{Binding OlderLibraryNote, Converter={x:Static c:Converters.NotEmpty}}" />
                </StackPanel>
                </Grid>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
