<!-- Settings -> Phone, Mac: "Add a phone" (a QR code of the phone app's address beside the 6-digit code and the time
     it has left), then the phones already added, one rounded card with a Remove on each. Draws no outer padding —
     SettingsView gives the margins, as it does every section's. The QR code is always black on white: that's what a
     camera reads, in light and dark alike. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             x:Class="StudyStash.App.Views.MacPhones"
             x:DataType="vm:PhonesModel">
  <StackPanel Spacing="8">
    <TextBlock Classes="h" Text="Phone" />
    <TextBlock Classes="body" Text="Read your notes and lectures, search and ask, and add files from your phone. It's a web app your library serves: add it to your Home Screen and it opens like any other." />
    <TextBlock Classes="say" Text="Asking your library…" IsVisible="{Binding IsLoading}" />
    <Border Classes="group" IsVisible="{Binding ShowProblem}">
      <Border Classes="row">
        <Grid ColumnDefinitions="Auto,12,*,12,Auto">
          <c:Icon Glyph="info" Size="18" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Classes="row-title" Text="{Binding Problem}" TextWrapping="Wrap" />
          <Button Grid.Column="4" Classes="pill" Command="{Binding LoadCommand}" IsVisible="{Binding CanRetry}" VerticalAlignment="Center"><TextBlock Text="Try again" FontSize="13" /></Button>
        </Grid>
      </Border>
    </Border>

    <StackPanel IsVisible="{Binding IsReady}" Spacing="8">
      <!-- Adding one -->
      <Border Classes="group" IsVisible="{Binding ShowAdd}">
        <Border Classes="row">
          <Grid ColumnDefinitions="Auto,12,*,12,Auto">
            <c:Icon Glyph="add_link" Size="18" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
              <TextBlock Classes="row-title" Text="{Binding AddTitle}" />
              <TextBlock Classes="row-sub" Text="{Binding AddSub}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="4" Classes="pill primary" Command="{Binding AddPhoneCommand}" IsEnabled="{Binding !Asking}" VerticalAlignment="Center">
              <TextBlock Text="Add a phone" FontSize="13" FontWeight="Medium" />
            </Button>
          </Grid>
        </Border>
      </Border>
      <Border Classes="group" IsVisible="{Binding Adding}">
        <Grid ColumnDefinitions="Auto,24,*" Margin="20">
          <Border Name="QrCard" Background="White" CornerRadius="12" Padding="0" Width="184" Height="184" ClipToBounds="True" VerticalAlignment="Top"
                  ToolTip.Tip="{Binding Url}">
            <Viewbox Stretch="Uniform">
              <Canvas Width="{Binding QrSize}" Height="{Binding QrSize}">
                <Path Data="{Binding Qr}" Fill="Black" RenderOptions.EdgeMode="Aliased" />
              </Canvas>
            </Viewbox>
          </Border>
          <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
            <TextBlock Classes="row-sub" Text="1. Point your phone's camera at the code." TextWrapping="Wrap" />
            <TextBlock Classes="row-sub" Text="2. Type this in the page that opens:" TextWrapping="Wrap" />
            <SelectableTextBlock Name="PhoneCode" Text="{Binding Code}" FontFamily="SF Mono, Menlo, Cascadia Mono, Consolas, monospace" FontSize="34" FontWeight="SemiBold" LetterSpacing="4" Margin="0,2" />
            <TextBlock Classes="row-sub" Text="{Binding Left}" />
            <TextBlock Classes="row-sub" Text="3. Add it to your Home Screen from the Share menu." TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
              <Button Classes="pill" Command="{Binding AddPhoneCommand}" IsVisible="{Binding RanOut}"><TextBlock Text="New code" FontSize="13" /></Button>
              <Button Classes="pill" Command="{Binding DoneCommand}"><TextBlock Text="Done" FontSize="13" /></Button>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
      <TextBlock Classes="say" Text="{Binding Say}" IsVisible="{Binding Say, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />

      <!-- The phones already added -->
      <TextBlock Classes="section gap" Text="Phones" IsVisible="{Binding !NoPhones}" />
      <Border Classes="group" IsVisible="{Binding !NoPhones}">
        <ItemsControl ItemsSource="{Binding Phones}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PhoneRow">
              <StackPanel>
                <Border Classes="rowsep itemsep" />
                <Border Classes="row">
                  <Grid ColumnDefinitions="Auto,12,*,12,Auto">
                    <c:Icon Glyph="smartphone" Size="18" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="row-title" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="row-sub" Text="{Binding Meta}" />
                    </StackPanel>
                    <Button Grid.Column="4" Classes="pill" VerticalAlignment="Center"
                            Command="{Binding $parent[ItemsControl].((vm:PhonesModel)DataContext).RemoveCommand}" CommandParameter="{Binding}">
                      <TextBlock Text="Remove" FontSize="13" />
                    </Button>
                  </Grid>
                </Border>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
      <TextBlock Classes="say" Text="Removing a phone locks it out straight away. Add it again with a new code." IsVisible="{Binding !NoPhones}" />
    </StackPanel>
  </StackPanel>
</UserControl>
