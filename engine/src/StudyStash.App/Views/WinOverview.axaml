<!-- Home, Due's home and a class's home (Windows): the page beside the sidebar. A title (today's date, or the class's name)
     over one sentence, Record at its side; on Home the week (class meetings and what's due, day by day) and the newest
     lectures; a class's home lists its deadlines and lectures, then the ways further in (its lists on Canvas, linked
     folders, files). Sections are parted by space and hairlines: no boxes inside boxes, no icons on rows. Ask floats at
     the foot. The same page in both systems' looks: MacOverview.axaml is the one to edit; this is that file under its own name. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:s="using:StudyStash.App.Services"
             xmlns:v="using:StudyStash.App.Views"
             x:Class="StudyStash.App.Views.WinOverview"
             x:DataType="vm:OverviewModel">
  <UserControl.Styles>
    <!-- The page's side margins: the design's 56, drawn in when the window is narrow. -->
    <Style Selector="StackPanel.ov-page">
      <Setter Property="Margin" Value="56,6,56,132" />
    </Style>
    <Style Selector="StackPanel.ov-page.narrow">
      <Setter Property="Margin" Value="24,6,24,132" />
    </Style>
    <Style Selector="StackPanel.ov-ask">
      <Setter Property="Margin" Value="56,0,56,20" />
    </Style>
    <Style Selector="StackPanel.ov-ask.narrow">
      <Setter Property="Margin" Value="24,0,24,20" />
    </Style>
    <!-- The page's buttons: at the title's foot beside it, or a row of their own under it (narrow) -->
    <Style Selector="StackPanel.ov-actions">
      <Setter Property="Margin" Value="24,0,0,0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Grid.ov-head.narrow StackPanel.ov-actions">
      <Setter Property="Margin" Value="0,16,0,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
  </UserControl.Styles>

  <Panel>
  <ScrollViewer Name="Page" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="ov-page" Classes.narrow="{Binding Narrow}" Spacing="36">

      <!-- The date (or the class), the sentence under it, and Record at the header's foot. The title wraps in a column
           of its own, so a long class name never runs under the buttons: beside it, or under it when narrow. -->
      <Grid Classes="ov-head" Classes.narrow="{Binding Narrow}" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <StackPanel>
          <TextBlock Name="Title" Classes="page-title" Text="{Binding Title}" />
          <TextBlock Name="Lede" Classes="page-lede" Text="{Binding Lede}" Margin="0,8,0,0" />
          <TextBlock Classes="page-lede" Text="{Binding Description}" IsVisible="{Binding HasDescription}" FontSize="15" LineHeight="22" Margin="0,6,0,0"
                     MaxLines="3" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Name="Actions" Classes="ov-actions" Grid.Column="{Binding ActionsColumn}" Grid.Row="{Binding ActionsRow}" Orientation="Horizontal"
                    Spacing="8" VerticalAlignment="Bottom">
          <!-- Due's home: the two-column list, each assignment beside its detail -->
          <Button Name="FullList" Classes="plain" Height="48" Padding="18,0" Command="{Binding AllDueCommand}" IsVisible="{Binding IsDuePage}" Content="Full list" />
          <Button Name="Attach" Classes="plain" Height="48" Padding="18,0" Command="{Binding Files.AttachCommand, FallbackValue={x:Null}}" IsVisible="{Binding HasFiles}"
                  ToolTip.Tip="Attach notes, slides or a handout to this class (or drop files on the page)" AutomationProperties.Name="Attach to class" Content="Attach" />
          <!-- Record from here: into this class on its home, sorted by the library on Home. Red is only the dot; while
               a lecture records the pill is ringed in red, its dot a stop square, with the class, the level and the time. -->
          <Button Name="Record" Classes="record" Classes.recording="{Binding Running}" Classes.paused="{Binding Paused}" Command="{Binding RecordCommand}"
                  IsVisible="{Binding CanRecord}" AutomationProperties.Name="{Binding RecordTip}" ToolTip.Tip="{Binding RecordTip}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Classes="record-dot"><Border /></Border>
              <TextBlock Name="RecordWords" Text="{Binding RecordWords}" VerticalAlignment="Center" />
              <c:Waveform Bars="5" Height="16" MinBar="5" Levels="{Binding Recorder.Levels, FallbackValue={x:Null}}" Foreground="{DynamicResource Record}"
                          VerticalAlignment="Center" IsVisible="{Binding Running}" />
              <TextBlock Text="{Binding Elapsed}" FontWeight="Medium" Foreground="{DynamicResource InkMuted}" VerticalAlignment="Center" IsVisible="{Binding Recording}" />
              <TextBlock Classes="kbd" Text="{Binding RecordKeys}" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0" IsVisible="{Binding Idle}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Home: this week. What's late first (when anything is), then Monday to Sunday, today lifted out. -->
      <StackPanel Name="ThisWeek" IsVisible="{Binding ShowWeek}" Spacing="12">
        <TextBlock Classes="h2" Text="This week" />
        <!-- A narrow window scrolls the week sideways rather than squeezing its days. -->
        <!-- (The room round the week is part of what scrolls, so today's column, standing proud of the grid, and the
             week's own hairline aren't cut off at the scroller's edge.) -->
        <ScrollViewer Name="WeekScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="-8,-8">
          <Panel>
          <Border Name="Week" Classes="week" HorizontalAlignment="Left" Margin="8">
            <ItemsControl ItemsSource="{Binding Week}" AutomationProperties.Name="This week" ClipToBounds="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><c:WeekRow /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WeekDay">
                  <Panel>
                    <Border Width="1" Background="{DynamicResource Line}" HorizontalAlignment="Left" IsVisible="{Binding Ruled}" />
                    <Border Classes="day" Classes.today="{Binding IsToday}" Classes.late="{Binding IsLate}">
                      <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" MinHeight="26">
                          <TextBlock Classes="day-name" Text="{Binding Name}" />
                          <TextBlock Grid.Column="1" Classes="day-num" Text="{Binding Number}" />
                        </Grid>
                        <!-- Class meetings: the time, then the class by its short name beside its swatch; one that was
                             recorded says so, with a red dot -->
                        <ItemsControl ItemsSource="{Binding Meetings}" IsVisible="{Binding HasMeetings}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WeekMeeting">
                              <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Classes="micro" Text="{Binding Time}" />
                                  <Ellipse Width="6" Height="6" Fill="{DynamicResource Record}" Margin="9,0,5,0" VerticalAlignment="Center" IsVisible="{Binding Recorded}" />
                                  <TextBlock Classes="micro" Text="Recorded" IsVisible="{Binding Recorded}" />
                                </StackPanel>
                                <Grid ColumnDefinitions="Auto,6,*">
                                  <c:Swatch Small="True" Fill="{Binding Dot}" VerticalAlignment="Top" Margin="0,6,0,0" />
                                  <TextBlock Grid.Column="2" Classes="meeting-class" Classes.recorded="{Binding Recorded}" Text="{Binding Class}" />
                                </Grid>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Classes="rule" IsVisible="{Binding Divided}" />
                        <!-- What's due: the name in its class's highlighter, and when under it -->
                        <ItemsControl ItemsSource="{Binding Deadlines}" IsVisible="{Binding HasDeadlines}" ClipToBounds="False">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OverviewDue">
                              <Button Classes="deadline" Classes.late="{Binding Late}" Classes.done="{Binding Done}" AutomationProperties.Name="{Binding Said}"
                                      Command="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).OpenDueCommand}" CommandParameter="{Binding}">
                                <StackPanel Spacing="2">
                                  <c:Highlight Text="{Binding Title}" Fill="{Binding Dot}" />
                                  <TextBlock Classes="deadline-when" Text="{Binding When}" />
                                </StackPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="text-link" FontSize="13" Content="{Binding More}" IsVisible="{Binding HasMore}"
                                Command="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).OpenMoreCommand}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </Border>
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          </Panel>
        </ScrollViewer>
        <!-- Nothing due this week: the week stays, and says so in plain words, with what's next -->
        <TextBlock Name="WeekEmpty" Classes="empty" IsVisible="{Binding HasWeekEmpty}" MaxWidth="560">
          <Run Text="{Binding WeekEmpty}" FontWeight="Bold" Foreground="{DynamicResource Ink}" /><Run Text=" " /><Run Text="{Binding WeekNext}" />
        </TextBlock>
      </StackPanel>

      <!-- Due's home: what's to hand in, day by day, what's late first -->
      <ItemsControl Name="DueGroups" ItemsSource="{Binding DueGroups}" IsVisible="{Binding IsDuePage}" ClipToBounds="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Spacing="28" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:OverviewDueGroup">
            <Grid ColumnDefinitions="128,*">
              <TextBlock Classes="lecture-date" Classes.late="{Binding Late}" Text="{Binding Heading}" />
              <ItemsControl Grid.Column="1" ItemsSource="{Binding Items}" ClipToBounds="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="14" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:OverviewDue">
                    <Button Classes="deadline" Classes.late="{Binding Late}" AutomationProperties.Name="{Binding Said}"
                            Command="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).OpenDueCommand}" CommandParameter="{Binding}">
                      <StackPanel Spacing="2">
                        <c:Highlight Text="{Binding Title}" Fill="{Binding Dot}" FontSize="15" LineHeight="20" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Classes="deadline-when" Text="{Binding When}" />
                          <TextBlock Classes="deadline-when" Text="{Binding ClassLabel}" Foreground="{DynamicResource InkMuted}" IsVisible="{Binding HasClassLabel}" />
                        </StackPanel>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- A class's home: what's coming up to hand in -->
      <StackPanel Name="Deadlines" IsVisible="{Binding ShowDue}" Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="h2" Text="Upcoming deadlines" />
          <Button Grid.Column="1" Classes="text-link" Content="Everything due" Command="{Binding AllDueCommand}" IsVisible="{Binding CanSeeAllDue}" VerticalAlignment="Bottom" />
        </Grid>
        <TextBlock Classes="empty" Text="{Binding DueEmpty}" IsVisible="{Binding NoDue}" />
        <ItemsControl ItemsSource="{Binding Due}" ClipToBounds="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="14" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:OverviewDue">
              <Button Classes="deadline" Classes.late="{Binding Late}" AutomationProperties.Name="{Binding Said}"
                      Command="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).OpenDueCommand}" CommandParameter="{Binding}">
                <StackPanel Spacing="2">
                  <c:Highlight Text="{Binding Title}" Fill="{Binding Dot}" FontSize="15" LineHeight="20" />
                  <TextBlock Classes="deadline-when" Text="{Binding When}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- The newest lectures: when, the title over its class and a sentence or two, how long -->
      <StackPanel Name="Recent" IsVisible="{Binding ShowMain}" Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="h2" Text="{Binding LecturesHeading}" />
          <Button Name="AllLectures" Grid.Column="1" Classes="text-link" Content="{Binding AllLecturesWords}" Command="{Binding AllLecturesCommand}"
                  IsVisible="{Binding CanSeeAllLectures}" VerticalAlignment="Bottom" />
          <TextBlock Grid.Column="1" Text="{Binding AllLecturesWords}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkMuted}"
                     IsVisible="{Binding ShowLectureCount}" VerticalAlignment="Bottom" />
        </Grid>
        <TextBlock Classes="empty" Text="{Binding LecturesEmpty}" IsVisible="{Binding NoLectures}" />
        <ItemsControl Classes="rows" ItemsSource="{Binding Lectures}" Margin="0,-12,0,0" ClipToBounds="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:OverviewLecture">
              <StackPanel>
                <Border Classes="rule" />
                <Button Classes="lecture" Command="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).OpenLectureCommand}" CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="108,20,*,20,Auto">
                    <TextBlock Classes="lecture-date" Text="{Binding When}" />
                    <StackPanel Grid.Column="2" Spacing="4">
                      <TextBlock Classes="lecture-title" Text="{Binding Title}" />
                      <c:Highlight Classes="lecture-class" Text="{Binding ClassName}" Fill="{Binding Dot}"
                                   IsVisible="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).IsHome}" />
                      <TextBlock Classes="lecture-summary" Classes.pending="{Binding Pending}" Text="{Binding Summary}" IsVisible="{Binding HasSummary}" />
                    </StackPanel>
                    <TextBlock Grid.Column="4" Classes="lecture-length" Text="{Binding Length}" MinWidth="64" TextAlignment="Right" />
                  </Grid>
                </Button>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- A class's home: the ways further in, on Canvas -->
      <StackPanel Name="Links" IsVisible="{Binding HasLinks}" Spacing="12">
        <TextBlock Classes="h2" Text="On Canvas" />
        <ItemsControl Classes="rows" ItemsSource="{Binding Links}" Margin="0,-8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:OverviewLink">
              <StackPanel>
                <Border Classes="rule" />
                <Button Classes="row-link" Command="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).OpenLinkCommand}" CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="128,*">
                    <TextBlock Classes="row-title" Text="{Binding Label}" />
                    <TextBlock Grid.Column="1" Classes="row-sub" Text="{Binding Detail}" VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- A class's home: folders on the computer that go with it (a project's repo), linked, not copied in -->
      <StackPanel Name="LinkedFolders" IsVisible="{Binding ShowFolders}" Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="h2" Text="Linked folders" VerticalAlignment="Center" />
          <!-- Another one: over the folders' right edge, as the lectures' link is over theirs -->
          <Button Name="LinkAnother" Grid.Column="1" Classes="text-link" Content="Link a folder" Command="{Binding LinkFolderCommand}" IsVisible="{Binding CanLinkAnother}"
                  VerticalAlignment="Bottom" ToolTip.Tip="Link a folder on this computer to the class: it stays where it is, and search and the AI can read it" />
        </Grid>
        <!-- None yet: what one is for and the button that links one, together where the folders will be -->
        <Grid Name="NoFolders" ColumnDefinitions="*,24,Auto" IsVisible="{Binding !HasFolders}">
          <TextBlock Classes="empty" FontSize="15" LineHeight="22" VerticalAlignment="Center"
                     Text="A project's repo, a shared drive, anything that goes with this class but isn't notes. It stays where it is." />
          <Button Name="LinkFolder" Grid.Column="2" Classes="plain" Content="Link a folder" Command="{Binding LinkFolderCommand}" VerticalAlignment="Center"
                  ToolTip.Tip="Link a folder on this computer to the class: it stays where it is, and search and the AI can read it" />
        </Grid>
        <ItemsControl Classes="rows" ItemsSource="{Binding Folders}" IsVisible="{Binding HasFolders}" Margin="0,-8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LinkedFolder">
              <StackPanel>
                <Border Classes="rule" />
                <Button Classes="row-link" Command="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).OpenFolderCommand}" CommandParameter="{Binding}"
                        ToolTip.Tip="Open the folder">
                  <Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Unlink from this class" Command="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).UnlinkFolderCommand}" CommandParameter="{Binding}" />
                    </ContextMenu>
                  </Button.ContextMenu>
                  <StackPanel Spacing="2">
                    <TextBlock Classes="row-title" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="row-sub" Text="{Binding Detail}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- A class's home: what's attached to it (drop files anywhere on the page) -->
      <StackPanel Name="ClassFiles" IsVisible="{Binding HasFiles}" Spacing="12">
        <TextBlock Classes="h2" Text="Files" IsVisible="{Binding Files.HasItems, FallbackValue=False}" />
        <v:WinAttachments DataContext="{Binding Files}" />
      </StackPanel>

      <!-- Home: Study Stash is free, and a tip for the two students who build it goes to their Ko-fi page -->
      <Button Name="Support" Classes="text-link" Content="{x:Static s:SupportAsk.Button}" Command="{Binding SupportCommand}" IsVisible="{Binding CanSupport}"
              ToolTip.Tip="{x:Static s:SupportAsk.HomeTip}" />
    </StackPanel>
  </ScrollViewer>
  <!-- The page fades out under Ask, so what scrolls beneath never collides with it -->
  <Border Name="Fade" Height="120" VerticalAlignment="Bottom" IsHitTestVisible="False" IsVisible="{Binding HasAsk}" />
  <!-- Ask about everything (Home) or this class, docked at the foot of the page; its latest answer just above -->
  <StackPanel Classes="ov-ask" Classes.narrow="{Binding Narrow}" VerticalAlignment="Bottom" Spacing="8" IsVisible="{Binding HasAsk}">
    <v:WinAiAnswer DataContext="{Binding Ask}" IsVisible="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).HasAnswer}" MaxHeight="420" HorizontalAlignment="Center" />
    <v:WinAiAskBar DataContext="{Binding Ask}" />
  </StackPanel>
  </Panel>
</UserControl>
