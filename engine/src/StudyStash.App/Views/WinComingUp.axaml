<!-- Coming up, in the tray panel and the library window (Windows): the next few events today and tomorrow from the
     student's calendars, each with when, what, and the class it's for (its dot); a click records it. Hidden with no calendars; with
     calendars and nothing left, one quiet line says so. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:vm="using:StudyStash.App.ViewModels"
             x:Class="StudyStash.App.Views.WinComingUp"
             x:DataType="vm:ComingUpModel">
  <UserControl.Styles>
    <!-- "File every … in Machine Learning": a line of accent text under the event, not a second row. -->
    <Style Selector="Button.suggest">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.suggest:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextBlock.TextDecorations" Value="Underline" />
    </Style>
  </UserControl.Styles>

  <StackPanel IsVisible="{Binding HasCalendars}" Spacing="4">
    <TextBlock Text="{Binding Heading}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Fg2}" Margin="0,2,0,0" />
    <TextBlock IsVisible="{Binding IsEmpty}" Text="{Binding EmptyText}" FontSize="13" Foreground="{DynamicResource Fg3}" />
    <ItemsControl ItemsSource="{Binding Rows}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="2" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ComingUpRow">
          <StackPanel>
          <Button Classes="row" AutomationProperties.Name="{Binding Said}"
                  Command="{Binding $parent[UserControl].((vm:ComingUpModel)DataContext).RecordCommand}" CommandParameter="{Binding}">
            <Grid ColumnDefinitions="8,10,*,10,Auto">
              <c:Swatch Small="True" Fill="{Binding Dot}" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                <TextBlock IsVisible="{Binding HasDetail}" Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Fg2}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Grid.Column="4" Classes="num" Text="{Binding When}" FontSize="12" Foreground="{DynamicResource Fg3}" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button Classes="suggest" IsVisible="{Binding HasSuggestion}" Margin="23,0,8,4" HorizontalAlignment="Left" FontSize="11"
                  Command="{Binding $parent[UserControl].((vm:ComingUpModel)DataContext).FileCommand}" CommandParameter="{Binding}"
                  Content="{Binding SuggestText}" ToolTip.Tip="From now on, every event called this goes in that class, and what's recorded in it." />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
