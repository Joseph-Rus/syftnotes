<!-- Coming up, in the tray panel and the library window (Windows): the next few events today and tomorrow from the
     student's calendars, each with when, what, and the class it's for (its dot). Hidden with no calendars; with
     calendars and nothing left, one quiet line says so. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             x:Class="StudyStash.App.Views.WinComingUp"
             x:DataType="vm:ComingUpModel">
  <StackPanel IsVisible="{Binding HasCalendars}" Spacing="4">
    <TextBlock Text="{Binding Heading}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Fg2}" Margin="0,2,0,0" />
    <TextBlock IsVisible="{Binding IsEmpty}" Text="{Binding EmptyText}" FontSize="13" Foreground="{DynamicResource Fg3}" />
    <ItemsControl ItemsSource="{Binding Rows}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="2" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ComingUpRow">
          <Grid ColumnDefinitions="8,10,*,10,Auto" Margin="0,3">
            <Ellipse Width="8" Height="8" Fill="{Binding Dot}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
              <TextBlock IsVisible="{Binding HasDetail}" Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Fg2}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Grid.Column="4" Classes="num" Text="{Binding When}" FontSize="12" Foreground="{DynamicResource Fg3}" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
