<!-- The Canvas screens' shared Windows look (design 06, 08): a "cv-" prefix on every class so it never crosses the
     settings page's own classes once our controls sit inside it. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:StudyStash.App.Controls">

  <!-- design 08: one state's InfoBar -->
  <Style Selector="Border.cv-bar">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16,12,8,12" />
    <Setter Property="MinHeight" Value="48" />
  </Style>
  <Style Selector="Border.cv-bar.cv-info">
    <Setter Property="Background" Value="{DynamicResource IbInfo}" />
  </Style>
  <Style Selector="Border.cv-bar.cv-ok">
    <Setter Property="Background" Value="{DynamicResource IbOk}" />
  </Style>
  <Style Selector="Border.cv-bar.cv-warn">
    <Setter Property="Background" Value="{DynamicResource IbWarn}" />
  </Style>
  <Style Selector="Border.cv-bar.cv-error">
    <Setter Property="Background" Value="{DynamicResource IbErr}" />
  </Style>

  <Style Selector="Border.cv-dot">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="0,3,0,0" />
  </Style>
  <Style Selector="Border.cv-dot.cv-info">
    <Setter Property="Background" Value="{DynamicResource IcInfo}" />
  </Style>
  <Style Selector="Border.cv-dot.cv-ok">
    <Setter Property="Background" Value="{DynamicResource IcOk}" />
  </Style>
  <Style Selector="Border.cv-dot.cv-warn">
    <Setter Property="Background" Value="{DynamicResource IcWarn}" />
  </Style>
  <Style Selector="Border.cv-dot.cv-error">
    <Setter Property="Background" Value="{DynamicResource IcErr}" />
  </Style>
  <Style Selector="Border.cv-dot TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource IbGlyph}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.cv-msg">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20.3" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,1,0,0" />
  </Style>

  <Style Selector="Border.cv-track">
    <Setter Property="Height" Value="3" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>
  <Style Selector="Border.cv-bar-fill">
    <Setter Property="Height" Value="3" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.cv-bar-rest">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Fg3}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A state's button: the accent (Connect, Show me how) or Fluent's ctrl pill (everything else with one). -->
  <Style Selector="Button.cv-btn">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="{DynamicResource Ctrl}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CtrlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Button.cv-btn.cv-primary">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.cv-btn.cv-primary TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.cv-close">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <!-- design 06: Settings -> Canvas -->
  <Style Selector="TextBlock.cv-h1">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.cv-intro">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,12,0,0" />
  </Style>
  <Style Selector="TextBlock.cv-h2">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,18,0,8" />
  </Style>
  <Style Selector="TextBlock.cv-link">
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
  </Style>
  <Style Selector="Border.cv-item">
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="TextBlock.cv-value">
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.cv-dot-label">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="Ellipse.cv-dot">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
  </Style>
  <Style Selector="c|Icon.cv-scout">
    <Setter Property="Size" Value="14" />
    <Setter Property="Filled" Value="True" />
  </Style>
  <Style Selector="c|Icon.cv-scout.cv-ok">
    <Setter Property="Foreground" Value="{DynamicResource Ok}" />
  </Style>
  <Style Selector="c|Icon.cv-scout.cv-warn">
    <Setter Property="Foreground" Value="{DynamicResource Warn}" />
  </Style>
  <Style Selector="TextBlock.cv-scout">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="TextBlock.cv-placeholder">
    <Setter Property="Foreground" Value="{DynamicResource Fg3}" />
  </Style>
  <Style Selector="TextBlock.cv-change">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="c|Icon.cv-change">
    <Setter Property="Size" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="Button.cv-select-item">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>

  <!-- design 09: the Due list -->
  <Style Selector="TextBlock.cv-due-title">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.cv-due-sub">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="TextBlock.cv-group-label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    <Setter Property="Padding" Value="20,14,20,4" />
  </Style>
  <Style Selector="TextBlock.cv-group-label.cv-accent">
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
  </Style>
  <Style Selector="Button.cv-due-row">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="8,2" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.cv-due-row.cv-selected">
    <Setter Property="Background" Value="{DynamicResource Subtle2}" />
  </Style>
  <Style Selector="Border.cv-row-indicator">
    <Setter Property="Width" Value="3" />
    <Setter Property="Height" Value="16" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.cv-row-title">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.cv-row-right">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="TextBlock.cv-row-right.cv-strong">
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.cv-row-sub">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="Ellipse.cv-row-dot">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
  </Style>

  <!-- design 09: an assignment's detail -->
  <Style Selector="TextBlock.cv-meta">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="TextBlock.cv-detail-title">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="35" />
  </Style>
  <Style Selector="Border.cv-tiles">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.cv-tile-sep">
    <Setter Property="Width" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Sep}" />
  </Style>
  <Style Selector="TextBlock.cv-tile-label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="TextBlock.cv-tile-value">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.cv-h3">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.cv-rule">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Sep}" />
  </Style>
  <Style Selector="TextBlock.cv-rubric-crit">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.cv-rubric-pts">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="TextBlock.cv-rubric-comment">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.cv-submission">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="TextBlock.cv-sub-status">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.cv-sub-detail">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="TextBlock.cv-comment">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20.3" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.cv-comment-author">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="Button.cv-hand-in">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="TextBlock.cv-hand-in">
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Border.cv-chip">
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,0,12,0" />
  </Style>
  <Style Selector="TextBlock.cv-chip-name">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.cv-chip-size">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="Button.cv-toolbtn">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="Button.cv-toolicon">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- design 10/11: a Canvas-linked class's own page -->
  <Style Selector="c|Icon.cv-scoutline">
    <Setter Property="Size" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>

  <!-- the tabs layout's own text tabs, an accent underline on the current one -->
  <Style Selector="Button.cv-tab-item">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Padding" Value="7,8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.cv-tab-item.cv-on">
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.cv-tab-underline">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="3" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
  </Style>

  <!-- a tree section's own header row (Modules, Files, Announcements) -->
  <Style Selector="Button.cv-section-header">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sep}" />
  </Style>
  <Style Selector="TextBlock.cv-section-title">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="c|Icon.cv-tree-icon">
    <Setter Property="Size" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="Ellipse.cv-new-dot">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="Fill" Value="{DynamicResource Accent}" />
  </Style>

  <!-- a module: its own small label, an open module's items, a collapsed module's summary row -->
  <Style Selector="TextBlock.cv-mod-label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="Button.cv-mod-item">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Margin" Value="8,0" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="TextBlock.cv-mod-title">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBlock.cv-mod-right">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="Button.cv-mod-collapsed">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Margin" Value="8,0" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="TextBlock.cv-mod-collapsed-text">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>

  <!-- a lecture row -->
  <Style Selector="Button.cv-lecture-row">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Margin" Value="8,0" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="TextBlock.cv-lecture-title">
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- a reader (a page or an announcement) -->
  <Style Selector="TextBlock.cv-reader-body">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20.3" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- The course/interval picker, restyled as Fluent's ctrl pill (a Button + Flyout: the ComboBox template fights
       a custom look harder than it's worth). -->
  <Style Selector="Button.cv-select">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="{DynamicResource Ctrl}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CtrlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <!-- design 07: connecting Canvas, each step an expander card -->
  <Style Selector="Border.cv-step">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="Border.cv-num">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="1.3" />
    <Setter Property="BorderBrush" Value="{DynamicResource Fg3}" />
  </Style>
  <Style Selector="Border.cv-num TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Fg3}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.cv-num.cv-current">
    <Setter Property="BorderBrush" Value="{DynamicResource Fg}" />
  </Style>
  <Style Selector="Border.cv-num.cv-current TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
  </Style>
  <Style Selector="c|Icon.cv-num-done">
    <Setter Property="Size" Value="20" />
    <Setter Property="Filled" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
  </Style>
  <Style Selector="TextBlock.cv-step-title">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBlock.cv-step-title.cv-current">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.cv-step-title.cv-todo">
    <Setter Property="Foreground" Value="{DynamicResource Fg3}" />
  </Style>
  <Style Selector="TextBlock.cv-step-body">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="c|Icon.cv-chevron">
    <Setter Property="Size" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="Border.cv-illus">
    <Setter Property="Background" Value="{DynamicResource Ground}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10" />
  </Style>
  <Style Selector="TextBlock.cv-illus-title">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.cv-illus-toggle">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="15" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Ellipse.cv-illus-knob">
    <Setter Property="Width" Value="11" />
    <Setter Property="Height" Value="11" />
    <Setter Property="Fill" Value="White" />
    <Setter Property="Margin" Value="0,0,2,0" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.cv-illus-load">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="Border.cv-illus-load TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Border.cv-illus-pick">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,3" />
  </Style>
  <Style Selector="Border.cv-illus-pick TextBlock">
    <Setter Property="FontSize" Value="9" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="TextBlock.cv-illus-row">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="TextBlock.cv-illus-row.cv-highlight">
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.cv-illus-row.cv-highlight">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="TextBlock.cv-caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="TextBlock.cv-caption-num">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
  </Style>
  <Style Selector="TextBlock.cv-waiting">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>

</Styles>
