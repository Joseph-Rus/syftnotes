<!-- The full app (Windows): the same window as the Mac's, with Windows' title bar over it (the app's name, the system's
     caption buttons). The sidebar straight on the window's canvas (its toolbar, then SidebarBody), and beside it one
     white page with a hairline round it (LibraryPages). The page's tools sit at its top right. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:v="using:StudyStash.App.Views"
             x:Class="StudyStash.App.Views.WinLibrary"
             x:DataType="vm:LibraryModel">
  <UserControl.Styles>
    <!-- The real window has its own rounded corners and shadow; a screenshot draws both itself. -->
    <Style Selector="Border#Chrome.chrome">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BoxShadow" Value="{DynamicResource ShadowLg}" />
    </Style>
  </UserControl.Styles>

  <Border Name="Chrome" Background="{DynamicResource Canvas}" ClipToBounds="True" Classes.chrome="{Binding DrawChrome}">
    <Panel>
    <DockPanel>
    <!-- The title bar: drag the window by it; the app's mark and name on its left, the system's caption buttons on
         its right. -->
    <c:WindowHeader Name="Header" DockPanel.Dock="Top" Title="Study Stash" DrawChrome="{Binding DrawChrome}" />
    <Grid ColumnDefinitions="Auto,*" Margin="8,0,8,8">
      <!-- The sidebar: straight on the canvas, no panel behind it -->
      <DockPanel Name="Sidebar" Width="244" Margin="0,0,8,0" IsVisible="{Binding ShowSidebar}" Background="Transparent" c:WindowHeader.MovesWindow="True">
        <!-- Its toolbar: fold the sidebar away on the left, back and forward through the places picked on the right. -->
        <Grid Name="SideTools" DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,2,Auto" Height="32" Margin="6,6,6,18">
          <Button Name="ToggleSidebar" Classes="icon-btn" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="{x:Static v:KeyWords.HideSidebar}" AutomationProperties.Name="Hide sidebar">
            <c:Icon Glyph="sidebar" Size="18" />
          </Button>
          <Button Name="Back" Grid.Column="2" Classes="icon-btn" Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip.Tip="{x:Static v:KeyWords.Back}" AutomationProperties.Name="Back">
            <c:Icon Glyph="arrow_back" Size="18" />
          </Button>
          <Button Name="Forward" Grid.Column="4" Classes="icon-btn" Command="{Binding GoForwardCommand}" IsEnabled="{Binding CanGoForward}" ToolTip.Tip="{x:Static v:KeyWords.Forward}" AutomationProperties.Name="Forward">
            <c:Icon Glyph="arrow_forward" Size="18" />
          </Button>
        </Grid>
        <v:SidebarBody Name="Side" />
      </DockPanel>

      <!-- The page: one white sheet, a hairline round it, no shadow. The sheet itself takes no clicks, so the strip
           along its top (where nothing else is) still moves the window. -->
      <Panel Grid.Column="1">
      <Border Name="Pane" Background="{DynamicResource Surface}" CornerRadius="{DynamicResource RadiusPane}" BoxShadow="{DynamicResource LineRing}" IsHitTestVisible="False" />
      <Border CornerRadius="{DynamicResource RadiusPane}" ClipToBounds="True">
      <DockPanel>
        <!-- The page's toolbar: its tools on the right; with the sidebar folded away, its button and back and forward
             on the left. -->
        <Grid Name="PaneTools" DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Height="32" Margin="12,10,12,0">
          <StackPanel Name="PaneNav" Orientation="Horizontal" Spacing="2" IsVisible="{Binding !ShowSidebar}">
            <Button Name="ShowSidebar" Classes="icon-btn" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="{x:Static v:KeyWords.ShowSidebar}" AutomationProperties.Name="Show sidebar">
              <c:Icon Glyph="sidebar" Size="18" />
            </Button>
            <Button Classes="icon-btn" Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip.Tip="{x:Static v:KeyWords.Back}" AutomationProperties.Name="Back">
              <c:Icon Glyph="arrow_back" Size="18" />
            </Button>
            <Button Classes="icon-btn" Command="{Binding GoForwardCommand}" IsEnabled="{Binding CanGoForward}" ToolTip.Tip="{x:Static v:KeyWords.Forward}" AutomationProperties.Name="Forward">
              <c:Icon Glyph="arrow_forward" Size="18" />
            </Button>
          </StackPanel>
          <v:PaneTools Name="Tools" Grid.Column="2" />
        </Grid>
        <v:LibraryPages Name="Pages" />
      </DockPanel>
      </Border>
      </Panel>
    </Grid>
    </DockPanel>

    <!-- "Put CS 101 in a new group": its name, over the window -->
    <Panel Name="FolderAsk" IsVisible="{Binding AskingFolder}" Background="Transparent">
      <v:WinNewFolder HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Panel>
    <!-- "Delete this lecture?", over the window: a click outside it is Cancel -->
    <Panel Name="DeleteAsk" IsVisible="{Binding AskingDelete}" Background="Transparent" PointerPressed="OnDeleteAskPressed">
      <v:WinDeleteLecture HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Panel>
    <!-- "Stop recording Data Mining and start Capstone team sync?", over the window: a click outside it is Cancel -->
    <Panel Name="ConfirmAsk" IsVisible="{Binding AskingConfirm}" Background="Transparent" PointerPressed="OnConfirmAskPressed">
      <v:ConfirmCard HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Panel>
    </Panel>
  </Border>
</UserControl>
