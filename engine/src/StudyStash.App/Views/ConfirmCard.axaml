<!-- A question over the library window with two answers (both looks): "Stop recording Data Mining and start Capstone
     team sync?", with Stop and start, and Cancel. Escape cancels. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             x:Class="StudyStash.App.Views.ConfirmCard"
             x:DataType="vm:LibraryModel"
             ClipToBounds="False">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelConfirmCommand}" />
  </UserControl.KeyBindings>
  <Border Width="400" Padding="22,20,22,18" CornerRadius="{DynamicResource RadiusPanel}" Background="{DynamicResource PopupBg}" BoxShadow="{DynamicResource ShadowFloat}">
    <StackPanel Spacing="8">
      <TextBlock Name="Question" Text="{Binding Confirming.Title, FallbackValue=''}" FontSize="17" FontWeight="ExtraBold" LineHeight="24" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Confirming.Text, FallbackValue=''}" FontSize="14.5" LineHeight="22" Foreground="{DynamicResource InkMuted}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button Name="Cancel" Classes="btn sm" Content="Cancel" Command="{Binding CancelConfirmCommand}" />
        <Button Name="Confirm" Classes="btn sm ink" Content="{Binding Confirming.Yes, FallbackValue=''}" Command="{Binding ConfirmCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
