<!-- Settings -> Phone, Windows 11: "Add a phone" (a QR code of the phone app's address beside the 6-digit code and
     the time it has left), then the phones already added, each its own card with Remove, as Settings lists devices.
     On just this computer the phone connects through the student's Google account first (docs/phone-google.md):
     Connect with Google, then the account, a QR code that opens the phone app with it, Disconnect, and the phones that
     use it, each its own card; adding a phone over Tailscale is under "Other ways", closed until pressed, and phones
     added over Tailscale before stay listed below. Draws no outer padding — SettingsView gives the margins. The QR
     codes are always black on white: that's what a camera reads, in light and dark alike. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             x:Class="StudyStash.App.Views.WinPhones"
             x:DataType="vm:PhonesModel">
  <StackPanel Spacing="4">
    <TextBlock Classes="h" Text="Phone" />
    <TextBlock Classes="body lede" Text="{Binding Body}" />
    <!-- Just this computer: through the student's Google account -->
    <Panel IsVisible="{Binding ViaGoogle}">
      <StackPanel Name="GooglePhone" DataContext="{Binding Google}" x:DataType="vm:PhoneGoogleModel" Spacing="4">
        <Border Classes="group" IsVisible="{Binding ShowConnect}">
          <Border Classes="row">
            <Grid ColumnDefinitions="Auto,16,*,16,Auto">
              <c:Icon Glyph="cloud" Size="20" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="row-title" Text="{Binding Title}" TextWrapping="Wrap" />
                <TextBlock Classes="row-sub" Text="{Binding Lede}" TextWrapping="Wrap" />
                <TextBlock Classes="row-sub" Text="{Binding CantConnect}" IsVisible="{Binding !CanConnect}" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
              <Button Grid.Column="4" Classes="btn sm ink" Command="{Binding ConnectCommand}" IsEnabled="{Binding CanConnect}" VerticalAlignment="Center">
                <TextBlock Text="Connect with Google" />
              </Button>
            </Grid>
          </Border>
        </Border>
        <Border Classes="group" IsVisible="{Binding Connecting}">
          <Border Classes="row">
            <Grid ColumnDefinitions="Auto,16,*,16,Auto">
              <c:Icon Glyph="open_in_new" Size="20" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="row-title" Text="Finish in your browser" />
                <TextBlock Classes="row-sub" Text="Pick your Google account there and press Allow. Then come back here." TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="4" Classes="btn sm" Command="{Binding CancelConnectCommand}" VerticalAlignment="Center"><TextBlock Text="Cancel" /></Button>
            </Grid>
          </Border>
        </Border>
        <Border Classes="group" IsVisible="{Binding ShowConnected}">
          <Grid ColumnDefinitions="Auto,24,*" Margin="16">
            <Border Name="GoogleQrCard" Background="White" CornerRadius="4" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" Width="186" Height="186"
                    ClipToBounds="True" VerticalAlignment="Top" ToolTip.Tip="{Binding QrLink}">
              <Viewbox Stretch="Uniform">
                <Canvas Width="{Binding QrSize}" Height="{Binding QrSize}">
                  <Path Data="{Binding Qr}" Fill="Black" RenderOptions.EdgeMode="Aliased" />
                </Canvas>
              </Viewbox>
            </Border>
            <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
              <TextBlock Classes="row-title" Text="{Binding Account}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="row-sub" Text="{Binding StepOne, StringFormat='1. {0}'}" TextWrapping="Wrap" />
              <TextBlock Classes="row-sub" Text="{Binding StepTwo, StringFormat='2. {0}'}" TextWrapping="Wrap" />
              <TextBlock Classes="row-sub" Text="{Binding HowItWorks}" TextWrapping="Wrap" Margin="0,4,0,0" />
              <TextBlock Classes="row-sub" Text="{Binding Status}" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0" IsVisible="{Binding !ConfirmingDisconnect}">
                <Button Classes="btn sm ink" Command="{Binding ConnectCommand}" IsVisible="{Binding SignedOut}"><TextBlock Text="Connect again" /></Button>
                <Button Classes="btn sm" Command="{Binding AskDisconnectCommand}" IsEnabled="{Binding !Busy}"><TextBlock Text="Disconnect…" /></Button>
              </StackPanel>
              <StackPanel Spacing="8" Margin="0,6,0,0" IsVisible="{Binding ConfirmingDisconnect}">
                <TextBlock Classes="say" Text="{Binding ConfirmWords}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="btn sm" Command="{Binding KeepConnectedCommand}"><TextBlock Text="Cancel" /></Button>
                  <Button Classes="btn sm ink" Command="{Binding DisconnectCommand}"><TextBlock Text="Disconnect" /></Button>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>
        <!-- The phones that use it: each its own card -->
        <ItemsControl ItemsSource="{Binding Phones}" IsVisible="{Binding HasPhones}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DrivePhoneRow">
              <Border Classes="group" Margin="0">
                <Border Classes="row">
                  <Grid ColumnDefinitions="Auto,16,*,16,Auto">
                    <c:Icon Glyph="smartphone" Size="20" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="row-title" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="row-sub" Text="{Binding Meta}" />
                    </StackPanel>
                    <Button Grid.Column="4" Classes="btn sm" VerticalAlignment="Center"
                            Command="{Binding $parent[ItemsControl].((vm:PhoneGoogleModel)DataContext).RemoveCommand}" CommandParameter="{Binding}">
                      <TextBlock Text="Remove" />
                    </Button>
                  </Grid>
                </Border>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- With Syft Notes closed too: the library runs in the background, started by the computer at login
             (BackgroundLibrary), so the phone is still answered after the app quits -->
        <Border Classes="group" IsVisible="{Binding ShowWhenClosed}">
          <Border Classes="row">
            <Grid ColumnDefinitions="*,16,Auto">
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="row-title" Text="{Binding WhenClosedTitle}" TextWrapping="Wrap" />
                <TextBlock Classes="row-sub" Text="{Binding WhenClosedSub}" TextWrapping="Wrap" />
                <TextBlock Classes="row-sub" Text="{Binding WhenClosedProblem}" IsVisible="{Binding WhenClosedProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
              <ToggleButton Name="AnswerWhenClosed" Grid.Column="2" Classes="switch" AutomationProperties.Name="{Binding WhenClosedTitle}"
                            IsChecked="{Binding AnswerWhenClosed}" IsEnabled="{Binding !Busy}" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </Border>
        <c:PageText Classes="say" Text="{Binding Say}" IsVisible="{Binding Say, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
      </StackPanel>
    </Panel>

    <!-- Just this computer: the Tailscale way (an Android phone, or the phone's web page) folded under "Other ways",
         closed until it's pressed -->
    <StackPanel Spacing="2" IsVisible="{Binding ViaGoogle}" Margin="0,4,0,0">
      <Button Name="OtherWays" Classes="text-link" Command="{Binding ToggleOtherWaysCommand}" AutomationProperties.Name="Other ways">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <c:Icon Glyph="chevron_right" Size="16" IsVisible="{Binding !OtherWays}" VerticalAlignment="Center" />
          <c:Icon Glyph="expand_more" Size="16" IsVisible="{Binding OtherWays}" VerticalAlignment="Center" />
          <TextBlock Text="Other ways" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <TextBlock Classes="say" Text="{Binding OtherWaysAbout}" TextWrapping="Wrap" />
    </StackPanel>
    <TextBlock Classes="say" Text="Asking your library…" IsVisible="{Binding ShowLoading}" />
    <Border Classes="group" IsVisible="{Binding ShowProblem}">
      <Border Classes="row">
        <Grid ColumnDefinitions="Auto,16,*,16,Auto">
          <c:Icon Glyph="info" Size="20" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Classes="row-title" Text="{Binding Problem}" TextWrapping="Wrap" />
          <Button Grid.Column="4" Classes="btn sm" Command="{Binding LoadCommand}" IsVisible="{Binding CanRetry}" VerticalAlignment="Center"><TextBlock Text="Try again" /></Button>
        </Grid>
      </Border>
    </Border>

    <StackPanel IsVisible="{Binding IsReady}" Spacing="4">
      <!-- Adding one -->
      <Border Classes="group" IsVisible="{Binding ShowAdd}">
        <Border Classes="row">
          <Grid ColumnDefinitions="Auto,16,*,16,Auto">
            <c:Icon Glyph="smartphone" Size="20" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
              <TextBlock Classes="row-title" Text="{Binding AddTitle}" />
              <TextBlock Classes="row-sub" Text="{Binding AddSub}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="4" Classes="btn sm ink" Command="{Binding AddPhoneCommand}" IsEnabled="{Binding !Asking}" VerticalAlignment="Center">
              <TextBlock Text="Add a phone" />
            </Button>
          </Grid>
        </Border>
      </Border>
      <Border Classes="group" IsVisible="{Binding Adding}">
        <Grid ColumnDefinitions="Auto,24,*" Margin="16">
          <Border Name="QrCard" Background="White" CornerRadius="4" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" Width="186" Height="186"
                  ClipToBounds="True" VerticalAlignment="Top" ToolTip.Tip="{Binding Url}">
            <Viewbox Stretch="Uniform">
              <Canvas Width="{Binding QrSize}" Height="{Binding QrSize}">
                <Path Data="{Binding Qr}" Fill="Black" RenderOptions.EdgeMode="Aliased" />
              </Canvas>
            </Viewbox>
          </Border>
          <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
            <TextBlock Classes="row-sub" Text="1. Scan this with your phone: in the Syft Notes app on your iPhone or iPad, tap Scan the QR code. On Android, point the camera at it." TextWrapping="Wrap" />
            <TextBlock Classes="row-sub" Text="2. If it asks for a code, type this:" TextWrapping="Wrap" />
            <c:PageText Name="PhoneCode" Text="{Binding Code}" FontFamily="Cascadia Mono, Consolas, SF Mono, Menlo, monospace" FontSize="32" FontWeight="SemiBold" LetterSpacing="4" Margin="0,2" />
            <TextBlock Classes="row-sub" Text="{Binding Left}" />
            <TextBlock Classes="row-sub" Text="On Android, add the page that opens to your home screen." TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
              <Button Classes="btn sm" Command="{Binding AddPhoneCommand}" IsVisible="{Binding RanOut}"><TextBlock Text="New code" /></Button>
              <Button Classes="btn sm" Command="{Binding DoneCommand}"><TextBlock Text="Done" /></Button>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
      <c:PageText Classes="say" Text="{Binding Say}" IsVisible="{Binding Say, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
      <Button Classes="btn sm" Command="{Binding OpenFixCommand}" IsVisible="{Binding HasFix}" HorizontalAlignment="Left"><TextBlock Text="Open the page" /></Button>

      <!-- The phones already added: each its own card -->
      <TextBlock Classes="section gap" Text="{Binding PhonesTitle}" IsVisible="{Binding !NoPhones}" />
      <ItemsControl ItemsSource="{Binding Phones}" IsVisible="{Binding !NoPhones}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PhoneRow">
            <Border Classes="group" Margin="0">
              <Border Classes="row">
                <Grid ColumnDefinitions="Auto,16,*,16,Auto">
                  <c:Icon Glyph="smartphone" Size="20" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="row-title" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="row-sub" Text="{Binding Meta}" />
                  </StackPanel>
                  <Button Grid.Column="4" Classes="btn sm" VerticalAlignment="Center"
                          Command="{Binding $parent[ItemsControl].((vm:PhonesModel)DataContext).RemoveCommand}" CommandParameter="{Binding}">
                    <TextBlock Text="Remove" />
                  </Button>
                </Grid>
              </Border>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="say" Text="{Binding RemoveLine}" IsVisible="{Binding !NoPhones}" />
    </StackPanel>
  </StackPanel>
</UserControl>
