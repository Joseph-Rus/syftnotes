<!-- Settings -> Phone, Windows 11: "Add a phone" (a QR code of the phone app's address beside the 6-digit code and
     the time it has left), then the phones already added, each its own card with Remove, as Settings lists devices.
     Draws no outer padding — SettingsView gives the margins. The QR code is always black on white: that's what a
     camera reads, in light and dark alike. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             x:Class="StudyStash.App.Views.WinPhones"
             x:DataType="vm:PhonesModel">
  <StackPanel Spacing="4">
    <TextBlock Classes="h" Text="Phone" />
    <TextBlock Classes="body" Text="Record lectures, read your notes, search, ask and study, write by hand and add files from your phone: the Study Stash app on iPhone and iPad, or on Android the web app your library serves." />
    <TextBlock Classes="say" Text="Asking your library…" IsVisible="{Binding IsLoading}" />
    <Border Classes="group" IsVisible="{Binding ShowProblem}">
      <Border Classes="row">
        <Grid ColumnDefinitions="Auto,16,*,16,Auto">
          <c:Icon Glyph="info" Size="20" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Classes="row-title" Text="{Binding Problem}" TextWrapping="Wrap" />
          <Button Grid.Column="4" Classes="pill" Command="{Binding LoadCommand}" IsVisible="{Binding CanRetry}" VerticalAlignment="Center"><TextBlock Text="Try again" /></Button>
        </Grid>
      </Border>
    </Border>

    <StackPanel IsVisible="{Binding IsReady}" Spacing="4">
      <!-- Adding one -->
      <Border Classes="group" IsVisible="{Binding ShowAdd}">
        <Border Classes="row">
          <Grid ColumnDefinitions="Auto,16,*,16,Auto">
            <c:Icon Glyph="smartphone" Size="20" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
              <TextBlock Classes="row-title" Text="{Binding AddTitle}" />
              <TextBlock Classes="row-sub" Text="{Binding AddSub}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="4" Classes="pill primary" Command="{Binding AddPhoneCommand}" IsEnabled="{Binding !Asking}" VerticalAlignment="Center">
              <TextBlock Text="Add a phone" />
            </Button>
          </Grid>
        </Border>
      </Border>
      <Border Classes="group" IsVisible="{Binding Adding}">
        <Grid ColumnDefinitions="Auto,24,*" Margin="16">
          <Border Name="QrCard" Background="White" CornerRadius="4" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" Width="186" Height="186"
                  ClipToBounds="True" VerticalAlignment="Top" ToolTip.Tip="{Binding Url}">
            <Viewbox Stretch="Uniform">
              <Canvas Width="{Binding QrSize}" Height="{Binding QrSize}">
                <Path Data="{Binding Qr}" Fill="Black" RenderOptions.EdgeMode="Aliased" />
              </Canvas>
            </Viewbox>
          </Border>
          <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
            <TextBlock Classes="row-sub" Text="1. In the Study Stash app on your iPhone or iPad, tap Scan the QR code. On Android, point the camera at it." TextWrapping="Wrap" />
            <TextBlock Classes="row-sub" Text="2. Type this code:" TextWrapping="Wrap" />
            <c:PageText Name="PhoneCode" Text="{Binding Code}" FontFamily="Cascadia Mono, Consolas, SF Mono, Menlo, monospace" FontSize="32" FontWeight="SemiBold" LetterSpacing="4" Margin="0,2" />
            <TextBlock Classes="row-sub" Text="{Binding Left}" />
            <TextBlock Classes="row-sub" Text="On Android, add the page that opens to your home screen." TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
              <Button Classes="pill" Command="{Binding AddPhoneCommand}" IsVisible="{Binding RanOut}"><TextBlock Text="New code" /></Button>
              <Button Classes="pill" Command="{Binding DoneCommand}"><TextBlock Text="Done" /></Button>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
      <c:PageText Classes="say" Text="{Binding Say}" IsVisible="{Binding Say, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
      <Button Classes="pill" Command="{Binding OpenFixCommand}" IsVisible="{Binding HasFix}" HorizontalAlignment="Left"><TextBlock Text="Open the page" FontSize="13" /></Button>

      <!-- The phones already added: each its own card -->
      <TextBlock Classes="section gap" Text="Phones" IsVisible="{Binding !NoPhones}" />
      <ItemsControl ItemsSource="{Binding Phones}" IsVisible="{Binding !NoPhones}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PhoneRow">
            <Border Classes="group" Margin="0">
              <Border Classes="row">
                <Grid ColumnDefinitions="Auto,16,*,16,Auto">
                  <c:Icon Glyph="smartphone" Size="20" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="row-title" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="row-sub" Text="{Binding Meta}" />
                  </StackPanel>
                  <Button Grid.Column="4" Classes="pill" VerticalAlignment="Center"
                          Command="{Binding $parent[ItemsControl].((vm:PhonesModel)DataContext).RemoveCommand}" CommandParameter="{Binding}">
                    <TextBlock Text="Remove" />
                  </Button>
                </Grid>
              </Border>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="say" Text="Removing a phone locks it out straight away. Add it again with a new code." IsVisible="{Binding !NoPhones}" />
    </StackPanel>
  </StackPanel>
</UserControl>
