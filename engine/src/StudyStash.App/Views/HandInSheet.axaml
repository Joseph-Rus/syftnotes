<!-- The checklist after a hand-in (Submit & Organize, "Ask me"; test builds only), over a window on its dialog layer
     (Controls/ConfirmLayer.cs), as the ask for a tip is: the title, the file handed in as it was found, the files worked
     from with why (the sure ones ticked), and the buttons. "Not now" is the plain one and has the keyboard; "File it" (or
     "File it and clear the rest") the ink one. Escape and a click outside count as "Not now". Drawn from the Syft tokens,
     the same on both systems. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:vm="using:StudyStash.App.ViewModels"
             x:Class="StudyStash.App.Views.HandInSheet"
             x:DataType="vm:HandInModel"
             Width="500" Focusable="False"
             AutomationProperties.Name="{Binding Title}">
  <StackPanel Margin="{DynamicResource Inset6}" Spacing="{DynamicResource Space3}">
    <TextBlock Name="Question" Text="{Binding Title}" FontSize="{DynamicResource FontSubtitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Intro}" FontSize="{DynamicResource FontBody}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />

    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space2}" IsVisible="{Binding Loading.Busy}">
      <c:SyftLoader Kind="HoppingBits" Size="18" VerticalAlignment="Center" />
      <TextBlock Text="{x:Static vm:FilingWords.Looking}" FontSize="{DynamicResource FontBody}" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
    </StackPanel>

    <StackPanel Spacing="{DynamicResource Space3}" IsVisible="{Binding Loaded}">
      <!-- What was handed in, as it was found. -->
      <StackPanel Spacing="{DynamicResource Space1}">
        <TextBlock Text="{x:Static vm:FilingWords.HandedInLabel}" FontSize="{DynamicResource FontCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
        <Border Background="{DynamicResource SurfaceSunken}" CornerRadius="{DynamicResource RadiusControl}" Padding="{DynamicResource Inset3}">
          <StackPanel Spacing="{DynamicResource Space2}">
            <TextBlock Text="{x:Static vm:FilingWords.IsThisIt}" FontSize="{DynamicResource FontBody}" FontWeight="SemiBold" IsVisible="{Binding IsUnsure}" />
            <TextBlock Text="{Binding NotFound}" FontSize="{DynamicResource FontBody}" TextWrapping="Wrap" IsVisible="{Binding IsNone}" />
            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding !IsNone}">
              <c:Icon Glyph="check_circle" Size="18" VerticalAlignment="Top" Margin="0,1,0,0" IsVisible="{Binding IsExact}" />
              <c:Icon Glyph="description" Size="18" VerticalAlignment="Top" Margin="0,1,0,0" IsVisible="{Binding IsUnsure}" Foreground="{DynamicResource TextMuted}" />
              <StackPanel Grid.Column="1" Spacing="0" Margin="8,0,0,0">
                <TextBlock Text="{Binding FileName}" FontSize="{DynamicResource FontBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding FilePath}" FontSize="{DynamicResource FontCaption}" Foreground="{DynamicResource TextMuted}"
                           TextTrimming="PrefixCharacterEllipsis" ToolTip.Tip="{Binding FilePath}" c:Tips.WhenCut="True" />
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space2}" IsVisible="{Binding IsUnsure}">
              <Button Name="ItIs" Classes="btn sm" Command="{Binding ItIsCommand}" Content="{x:Static vm:FilingWords.Yes}" />
              <Button Classes="btn sm" Command="{Binding ChooseCommand}" Content="{x:Static vm:FilingWords.ChooseAnother}" />
            </StackPanel>
            <Button Name="ChooseFile" Classes="btn sm" HorizontalAlignment="Left" Command="{Binding ChooseCommand}" IsVisible="{Binding IsNone}"
                    Content="{x:Static vm:FilingWords.ChooseTheFile}" />
            <TextBlock Text="{Binding PickSay}" FontSize="{DynamicResource FontCaption}" Foreground="{DynamicResource Warn}" TextWrapping="Wrap"
                       IsVisible="{Binding PickSay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- The files worked from, each with why: the sure ones ticked. -->
      <StackPanel Spacing="{DynamicResource Space1}">
        <TextBlock Text="{Binding MaterialsLabel}" FontSize="{DynamicResource FontCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
        <TextBlock Text="{x:Static vm:FilingWords.NoMaterials}" FontSize="{DynamicResource FontBody}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                   IsVisible="{Binding !HasMaterials}" />
        <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasMaterials}">
          <ItemsControl ItemsSource="{Binding Materials}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="{DynamicResource Space2}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HandInMaterialRow">
                <CheckBox IsChecked="{Binding Ticked}" AutomationProperties.Name="{Binding Name}" VerticalContentAlignment="Top">
                  <StackPanel Spacing="0">
                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Path}" c:Tips.WhenCut="True" />
                    <TextBlock Text="{Binding Why}" FontSize="{DynamicResource FontCaption}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                  </StackPanel>
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </StackPanel>

    <TextBlock Text="{Binding Loading.Say}" FontSize="{DynamicResource FontBody}" Foreground="{DynamicResource Warn}" TextWrapping="Wrap"
               IsVisible="{Binding Loading.Say, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <TextBlock Text="{Binding Filing.Say}" FontSize="{DynamicResource FontBody}" Foreground="{DynamicResource Warn}" TextWrapping="Wrap"
               IsVisible="{Binding Filing.Say, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space2}" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Name="NotNow" Classes="btn sm" Command="{Binding NotNowCommand}" Content="{x:Static vm:FilingWords.NotNow}" AutomationProperties.Name="{x:Static vm:FilingWords.NotNow}" />
      <Button Name="FileIt" Classes="btn sm ink" Command="{Binding FileItCommand}" IsEnabled="{Binding Loaded}"
              Content="{Binding FileLabel}" AutomationProperties.Name="{Binding FileLabel}" />
    </StackPanel>
  </StackPanel>
</UserControl>
