<!-- First-run setup (Windows): the Mac's three flows (just this computer, the laptop, the library), each with its own
     name and sidebar caption, chosen on the welcome, plus one step for Windows where Egghead Notes records: pin the tray
     icon out of the overflow. The same page as the Mac's (MacSetup), as the library window is the same in both looks:
     the steps straight on the window's canvas under Windows' own title bar, the page one white sheet beside them
     (SetupStyles). The AI and Canvas steps widen the window. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:s="using:StudyStash.App.Services"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:v="using:StudyStash.App.Views"
             x:Class="StudyStash.App.Views.WinSetup"
             x:DataType="vm:SetupModel"
             Classes="in-setup"
             Width="760" Height="580">
  <UserControl.Styles>
    <StyleInclude Source="avares://StudyStash/Views/SetupStyles.axaml" />
    <!-- The window's frame, for a screenshot only: a real window has Windows' own corners, edge and shadow. -->
    <Style Selector="Border#Frame.framed">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BoxShadow" Value="{DynamicResource ShadowLg}" />
    </Style>
  </UserControl.Styles>

  <Border Name="Frame" Background="{DynamicResource Canvas}" ClipToBounds="True">
    <DockPanel>
      <!-- The title bar: drag the window by it; the system's caption buttons sit on its right. -->
      <c:WindowHeader Name="Header" DockPanel.Dock="Top" CanResize="False" Title="{Binding HeaderTitle}" />
      <Grid ColumnDefinitions="228,*" Margin="8,0,8,8">
        <!-- The steps: straight on the canvas, as the library's sidebar is -->
        <StackPanel Classes="setup-side" Spacing="2">
          <!-- Which setup this is: just this computer's, the library's or the laptop's -->
          <StackPanel Classes="flow" Orientation="Horizontal" Spacing="8">
            <c:Icon Glyph="{Binding FlowIcon}" Size="16" VerticalAlignment="Center" />
            <TextBlock Classes="side-group" Text="{Binding FlowName}" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Steps}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StepItem">
                <Border Classes="step" Classes.current="{Binding Current}" Classes.todo="{Binding Todo}">
                  <Grid ColumnDefinitions="18,10,*,Auto">
                    <c:Icon Classes="done" IsVisible="{Binding ShowCheck}" />
                    <Border Classes="num" IsVisible="{Binding ShowNumber}"><TextBlock Text="{Binding Number}" /></Border>
                    <TextBlock Grid.Column="2" Classes="title" Text="{Binding Title}" />
                    <Border Grid.Column="3" Classes="tag" Margin="8,0,0,0" IsVisible="{Binding ShowOptional}"><TextBlock Text="Optional" /></Border>
                    <Border Grid.Column="3" Classes="tag" Margin="8,0,0,0" IsVisible="{Binding ShowSkipped}"><TextBlock Text="Skipped" /></Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- The page: one white sheet, a hairline round it -->
        <Panel Grid.Column="1">
          <Border Classes="setup-pane" />
          <Border Classes="setup-clip">
            <DockPanel>
              <!-- The step's buttons: the links that leave it on the left, Back and the step's own action on the right -->
              <Grid DockPanel.Dock="Bottom" Classes="setup-foot" ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                  <Button Classes="text-link" IsVisible="{Binding OnCanvas}" Command="{Binding SkipCommand}" Content="Skip for now" />
                  <Button Name="Guided" Classes="text-link" IsVisible="{Binding HasGuidedLink}" Command="{Binding BackToGuidedCommand}" Content="{Binding GuidedLabel}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                  <Button Classes="btn" Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}" Content="Back" />
                  <Button Classes="btn ink" Command="{Binding NextCommand}" IsEnabled="{Binding CanContinue}" Content="{Binding ContinueLabel}" />
                </StackPanel>
              </Grid>
              <!-- The step scrolls over a foot that stays put: a long list (a whole term of Canvas courses) never runs
                   over Continue. -->
              <ScrollViewer Name="Page" VerticalScrollBarVisibility="Auto">
                <StackPanel Classes="setup-page">
                  <TextBlock Classes="step-label" Text="{Binding StepLabel}" />

                  <!-- Welcome: how Egghead Notes will be used, three choices: icon | name (and Recommended) over a line
                       of help | the radio. -->
                  <!-- The first page: what happens to a lecture, before any choice. -->
                  <StackPanel IsVisible="{Binding OnIntro}">
                    <!-- The egghead says hello, first thing -->
                    <c:Doodle Art="hello" Size="120" HorizontalAlignment="Left" Margin="0,0,0,14" />
                    <TextBlock Classes="page-title step-title" Text="{Binding IntroTitle}" />
                    <TextBlock Classes="page-lede step-lede" Text="{Binding IntroBody}" />
                    <ItemsControl ItemsSource="{Binding IntroPoints}" Margin="0,20,0,0" MaxWidth="500" HorizontalAlignment="Stretch">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="14" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:IntroPoint">
                          <Grid ColumnDefinitions="Auto,14,*">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource Fill}" VerticalAlignment="Top">
                              <c:Icon Glyph="{Binding Glyph}" Size="18" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="2" Spacing="2">
                              <TextBlock Classes="choice-title" Text="{Binding Title}" />
                              <TextBlock Classes="choice-about" Text="{Binding About}" TextWrapping="Wrap" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <StackPanel IsVisible="{Binding OnWelcome}">
                    <TextBlock Classes="page-title step-title" Text="{Binding WelcomeTitle}" />
                    <TextBlock Classes="page-lede step-lede" Text="{Binding WelcomeBody}" />
                    <StackPanel Name="Choices" Spacing="10" Margin="0,22,0,0" MaxWidth="480" HorizontalAlignment="Stretch">
                      <Button AutomationProperties.Name="{Binding OneComputerTitle}" AutomationProperties.HelpText="{Binding OneComputerAbout}" Name="OneComputer" Classes="choice" Classes.on="{Binding IsOneComputer}" Command="{Binding ChooseOneComputerCommand}" IsEnabled="{Binding CanChooseOneComputer}">
                        <Grid ColumnDefinitions="Auto,14,*,14,Auto">
                          <c:Icon Classes="choice-icon" Glyph="desktop_windows" />
                          <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Classes="choice-title" Text="{Binding OneComputerTitle}" />
                              <Border Classes="tag"><TextBlock Text="Recommended" /></Border>
                            </StackPanel>
                            <TextBlock Classes="choice-about" Text="{Binding OneComputerAbout}" />
                          </StackPanel>
                          <Border Grid.Column="4" Classes="radio" Classes.on="{Binding IsOneComputer}"><Ellipse /></Border>
                        </Grid>
                      </Button>
                      <!-- Advanced: a laptop for class and a computer at home, folded away (most students have one computer) -->
                      <Button Name="OtherComputers" Classes="text-link" Margin="0,6,0,0" Command="{Binding ToggleOtherComputersCommand}"
                              AutomationProperties.Name="{x:Static vm:SetupModel.OtherComputersLabel}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <c:Icon Glyph="chevron_right" Size="18" IsVisible="{Binding !OtherComputersOpen}" />
                          <c:Icon Glyph="expand_more" Size="18" IsVisible="{Binding OtherComputersOpen}" />
                          <TextBlock Text="{x:Static vm:SetupModel.OtherComputersLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <StackPanel Spacing="10" IsVisible="{Binding OtherComputersOpen}">
                        <TextBlock Classes="hint" Text="{x:Static vm:SetupModel.OtherComputersAbout}" Margin="0,0,0,2" />
                        <Button AutomationProperties.Name="{x:Static vm:SetupModel.LaptopTitle}" AutomationProperties.HelpText="{x:Static vm:SetupModel.LaptopAbout}" Name="Laptop" Classes="choice" Classes.on="{Binding IsLaptop}" Command="{Binding ChooseLaptopCommand}" IsEnabled="{Binding CanChooseLaptop}">
                          <Grid ColumnDefinitions="Auto,14,*,14,Auto">
                            <c:Icon Classes="choice-icon" Glyph="laptop_mac" />
                            <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                              <TextBlock Classes="choice-title" Text="{x:Static vm:SetupModel.LaptopTitle}" />
                              <TextBlock Classes="choice-about" Text="{x:Static vm:SetupModel.LaptopAbout}" />
                            </StackPanel>
                            <Border Grid.Column="4" Classes="radio" Classes.on="{Binding IsLaptop}"><Ellipse /></Border>
                          </Grid>
                        </Button>
                        <Button AutomationProperties.Name="{x:Static vm:SetupModel.LibraryTitle}" AutomationProperties.HelpText="{Binding LibraryAbout}" Name="Library" Classes="choice" Classes.on="{Binding IsLibrary}" Command="{Binding ChooseLibraryCommand}" IsEnabled="{Binding CanChooseLibrary}">
                          <Grid ColumnDefinitions="Auto,14,*,14,Auto">
                            <c:Icon Classes="choice-icon" Glyph="dns" />
                            <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                              <TextBlock Classes="choice-title" Text="{x:Static vm:SetupModel.LibraryTitle}" />
                              <TextBlock Classes="choice-about" Text="{Binding LibraryAbout}" />
                            </StackPanel>
                            <Border Grid.Column="4" Classes="radio" Classes.on="{Binding IsLibrary}"><Ellipse /></Border>
                          </Grid>
                        </Button>
                      </StackPanel>
                    </StackPanel>
                    <!-- Just this computer: Continue makes the library here; while it does, and if it can't, say so. -->
                    <Grid ColumnDefinitions="Auto,8,*" Margin="0,14,0,0" MinHeight="20" MaxWidth="480" HorizontalAlignment="Left" IsVisible="{Binding ShowWelcomeStatus}">
                      <Panel VerticalAlignment="Top" Margin="0,2,0,0">
                        <c:Spinner IsVisible="{Binding Connecting}" Width="14" Height="14" Foreground="{DynamicResource InkMuted}" />
                        <c:Icon Classes="warn" Size="16" IsVisible="{Binding HasWelcomeProblem}" />
                      </Panel>
                      <TextBlock Grid.Column="2" Classes="hint" IsVisible="{Binding Connecting}" Text="Getting your library ready…" />
                      <TextBlock Grid.Column="2" Classes="say" IsVisible="{Binding HasWelcomeProblem}" Text="{Binding LibraryResult}" />
                    </Grid>
                  </StackPanel>

                  <!-- The library: its name and password (Continue creates it) -->
                  <StackPanel IsVisible="{Binding OnPassword}">
                    <TextBlock Classes="page-title step-title" Text="{Binding PasswordTitle}" />
                    <TextBlock Classes="page-lede step-lede" Text="{Binding PasswordLede}" />
                    <Grid ColumnDefinitions="*,12,*" Margin="0,24,0,0" MaxWidth="480" HorizontalAlignment="Stretch" IsEnabled="{Binding CanEditLibrary}">
                      <StackPanel>
                        <TextBlock Classes="label" Text="Library name" />
                        <Border Classes="field"><TextBox Classes="bare" Text="{Binding LibraryName}" PlaceholderText="Sam's library" /></Border>
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Classes="label" Text="Password" />
                        <Border Classes="field">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBox Classes="bare" Text="{Binding Password}" PasswordChar="•" RevealPassword="{Binding ShowPassword}" />
                            <Button Grid.Column="1" Classes="link-btn" Margin="6,0,0,0" Command="{Binding ToggleShowPasswordCommand}" Content="{Binding ShowPasswordText}" />
                          </Grid>
                        </Border>
                      </StackPanel>
                    </Grid>
                    <!-- Where the notes live: the folder a library already here keeps, or where a new one's go -->
                    <Grid Name="NotesFolderRow" ColumnDefinitions="16,8,*" Margin="0,14,0,0" MaxWidth="480" HorizontalAlignment="Left">
                      <c:Icon Glyph="folder" Size="15" Foreground="{DynamicResource InkMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Classes="hint" Text="{Binding NotesFolderWords}" ToolTip.Tip="{Binding NotesFolder}" TextWrapping="NoWrap"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,8,*" Margin="0,16,0,0" MinHeight="20" MaxWidth="480" HorizontalAlignment="Left">
                      <Panel VerticalAlignment="Top" Margin="0,2,0,0">
                        <c:Spinner IsVisible="{Binding Connecting}" Width="14" Height="14" Foreground="{DynamicResource InkMuted}" />
                        <c:Icon Classes="ok" Size="16" IsVisible="{Binding LibraryOk}" />
                        <c:Icon Classes="warn" Size="16">
                          <c:Icon.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                              <Binding Path="HasLibraryResult" />
                              <Binding Path="LibraryOk" Converter="{x:Static BoolConverters.Not}" />
                            </MultiBinding>
                          </c:Icon.IsVisible>
                        </c:Icon>
                      </Panel>
                      <TextBlock Grid.Column="2" Classes="say" IsVisible="{Binding HasLibraryResult}" Text="{Binding LibraryResult}" />
                    </Grid>
                  </StackPanel>

                  <!-- The laptop: find and connect to your library (Continue connects) -->
                  <StackPanel IsVisible="{Binding OnLibrary}">
                    <TextBlock Classes="page-title step-title" Text="Connect to your library" />
                    <TextBlock Classes="page-lede step-lede" Text="Your library is the computer at home that keeps your lectures. Type the address and password its setup showed, or let Egghead Notes look for it." />
                    <Grid ColumnDefinitions="*,10,Auto" RowDefinitions="Auto,Auto,16,Auto,Auto" Margin="0,24,0,0" MaxWidth="480" HorizontalAlignment="Stretch">
                      <TextBlock Classes="label" Text="Address" />
                      <Border Grid.Row="1" Classes="field"><TextBox Classes="bare" Text="{Binding Address}" PlaceholderText="http://mac-mini:8787" /></Border>
                      <Button Grid.Row="1" Grid.Column="2" Classes="btn sm" Command="{Binding FindCommand}" IsEnabled="{Binding !Finding}" Content="Find it" />
                      <TextBlock Grid.Row="3" Classes="label" Text="Password" />
                      <Border Grid.Row="4" Classes="field">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBox Classes="bare" Text="{Binding ConnectPassword}" PasswordChar="•" RevealPassword="{Binding ShowPassword}" />
                          <Button Grid.Column="1" Classes="link-btn" Margin="6,0,0,0" Command="{Binding ToggleShowPasswordCommand}" Content="{Binding ShowPasswordText}" />
                        </Grid>
                      </Border>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,8,*" Margin="0,16,0,0" MinHeight="20" MaxWidth="480" HorizontalAlignment="Left">
                      <Panel VerticalAlignment="Top" Margin="0,2,0,0">
                        <c:Spinner IsVisible="{Binding Connecting}" Width="14" Height="14" Foreground="{DynamicResource InkMuted}" />
                        <c:Spinner IsVisible="{Binding Finding}" Width="14" Height="14" Foreground="{DynamicResource InkMuted}" />
                        <c:Icon Classes="ok" Size="16" IsVisible="{Binding LibraryOk}" />
                        <c:Icon Classes="warn" Size="16">
                          <c:Icon.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                              <Binding Path="HasLibraryResult" />
                              <Binding Path="LibraryOk" Converter="{x:Static BoolConverters.Not}" />
                            </MultiBinding>
                          </c:Icon.IsVisible>
                        </c:Icon>
                      </Panel>
                      <TextBlock Grid.Column="2" Classes="say" IsVisible="{Binding HasLibraryResult}" Text="{Binding LibraryResult}" />
                    </Grid>
                  </StackPanel>

                  <!-- The microphone -->
                  <StackPanel IsVisible="{Binding OnMicrophone}">
                    <TextBlock Classes="page-title step-title" Text="Let Egghead Notes hear your lectures" />
                    <TextBlock Classes="page-lede step-lede" Text="It records with this PC's microphone. The recording stays on this PC; only the transcript goes to your library." />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,28,0,0" IsVisible="{Binding ShowMicCheck}">
                      <c:Icon Classes="ok" Size="18" />
                      <TextBlock Classes="say" Text="The microphone is allowed." />
                    </StackPanel>
                    <StackPanel IsVisible="{Binding ShowMicCheck}" Margin="0,16,0,0" Spacing="8">
                      <c:Waveform Height="28" Bars="24" Levels="{Binding MicLevels}" Foreground="{DynamicResource Ink}" HorizontalAlignment="Left" />
                      <TextBlock Classes="hint" Text="{Binding MicLine}" />
                    </StackPanel>
                    <Button Classes="btn sm ink" HorizontalAlignment="Left" Margin="0,28,0,0" Command="{Binding AllowMicCommand}" IsVisible="{Binding ShowAllowMic}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:Icon Glyph="mic" Size="16" />
                        <TextBlock Text="Allow the microphone" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <StackPanel IsVisible="{Binding ShowMicProblem}" Margin="0,24,0,0" Spacing="8" MaxWidth="480" HorizontalAlignment="Left">
                      <TextBlock IsVisible="{Binding HasMicProblemTitle}" Classes="say" FontWeight="Bold" Text="{Binding MicProblemTitle}" />
                      <TextBlock Classes="hint" Text="{Binding MicProblemText}" />
                      <Button Classes="btn sm" HorizontalAlignment="Left" Margin="0,6,0,0" Command="{Binding MicSettingsCommand}" IsVisible="{Binding HasMicProblemButton}" Content="{Binding MicProblemButton}" />
                    </StackPanel>
                  </StackPanel>

                  <!-- The transcription model -->
                  <StackPanel IsVisible="{Binding OnModel}">
                    <TextBlock Classes="page-title step-title" Text="Download the transcription model" />
                    <TextBlock Classes="page-lede step-lede" Text="{Binding ModelBody}" />
                    <!-- The model for this computer (Recommended, with why) or the one picked instead, its size, and Change,
                         which opens every model as a one-line list in place of the card and the download. -->
                    <Button AutomationProperties.Name="{Binding ChosenModel.Name}" AutomationProperties.HelpText="{Binding ChosenModel.Line}" Classes="choice" IsVisible="{Binding ShowModelCard}" Command="{Binding ChangeModelCommand}" Margin="0,22,0,0"
                            MaxWidth="480" HorizontalAlignment="Stretch">
                      <Grid ColumnDefinitions="*,16,Auto">
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="choice-title" Text="{Binding ChosenModel.Name}" />
                            <Border Classes="tag" IsVisible="{Binding ChosenModel.Recommended}"><TextBlock Text="Recommended" /></Border>
                          </StackPanel>
                          <TextBlock Classes="choice-about" Text="{Binding ChosenModel.Line}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                          <TextBlock Classes="num hint" Text="{Binding ChosenModel.Size}" HorizontalAlignment="Right" />
                          <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,2" HorizontalAlignment="Right">
                            <TextBlock Text="Change" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkMuted}" Margin="0,0,0,1" />
                          </Border>
                        </StackPanel>
                      </Grid>
                    </Button>
                    <!-- The list shuts again without a pick: the model stays the one it was. -->
                    <Button Classes="text-link small" IsVisible="{Binding ChoosingModel}" Command="{Binding ChangeModelCommand}" HorizontalAlignment="Right" Margin="0,16,0,0" Content="Cancel" />
                    <!-- (Each row keeps room round itself for its focus ring, which a list would cut off at the row's edge.) -->
                    <ItemsControl ItemsSource="{Binding Models}" IsVisible="{Binding ChoosingModel}" Margin="-4,7,-4,-3" MaxWidth="488" HorizontalAlignment="Stretch">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="s:ModelChoice">
                          <Button AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Size}" Classes="choice row" Classes.on="{Binding Chosen}" CommandParameter="{Binding}" Margin="4,3"
                                  Command="{Binding $parent[UserControl].((vm:SetupModel)DataContext).PickModelCommand}">
                            <Grid ColumnDefinitions="*,12,Auto,16,Auto">
                              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Classes="choice-title" Text="{Binding Name}" />
                                <Border Classes="tag" IsVisible="{Binding Recommended}"><TextBlock Text="Recommended" /></Border>
                              </StackPanel>
                              <TextBlock Grid.Column="2" Classes="num hint" Text="{Binding Size}" VerticalAlignment="Center" />
                              <Border Grid.Column="4" Classes="radio" Classes.on="{Binding Chosen}"><Ellipse /></Border>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel IsVisible="{Binding ShowModelDownload}" MaxWidth="480" HorizontalAlignment="Stretch">
                      <Border Classes="track" Margin="0,32,0,0">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding ModelProgress, Converter={x:Static vm:CanvasConverters.FillStar}}" />
                            <ColumnDefinition Width="{Binding ModelProgress, Converter={x:Static vm:CanvasConverters.RestStar}}" />
                          </Grid.ColumnDefinitions>
                          <Border Classes="bar" />
                        </Grid>
                      </Border>
                      <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <TextBlock Classes="num hint" Text="{Binding ModelDone}" />
                        <TextBlock Grid.Column="1" Classes="num hint" Text="{Binding ModelLeft}" />
                      </Grid>
                      <TextBlock IsVisible="{Binding ModelDownloading}" Classes="hint" Text="You can carry on while this finishes." Margin="0,20,0,0" />
                      <Grid IsVisible="{Binding HasModelProblem}" ColumnDefinitions="*,12,Auto" Margin="0,20,0,0">
                        <TextBlock Classes="say" Text="{Binding ModelProblem}" />
                        <Button Grid.Column="2" Classes="btn sm" Command="{Binding RetryModelCommand}" Content="Try again" VerticalAlignment="Center" />
                      </Grid>
                    </StackPanel>
                  </StackPanel>

                  <!-- Classes: the Canvas courses found (ticked), the library's classes so far, and a row to add one; every
                       row on the same columns: marker | name | what it covers | action. -->
                  <!-- What it's for: school brings Canvas and classes; anything else is folders -->
                  <StackPanel IsVisible="{Binding OnUses}">
                    <TextBlock Classes="page-title step-title" Text="What will you use Egghead Notes for?" />
                    <TextBlock Classes="page-lede step-lede" Text="Pick any that fit. School brings in Canvas and classes; anything else gets folders, and the notes are written for it." />
                    <ItemsControl ItemsSource="{Binding UseChoices}" Margin="0,20,0,0" MaxWidth="480" HorizontalAlignment="Stretch">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:UseChoice">
                          <Border Classes="choice-row" Padding="12,10" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Line}">
                            <Grid ColumnDefinitions="Auto,12,*,12,Auto">
                              <c:Icon Classes="choice-icon" Glyph="{Binding Glyph}" />
                              <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="choice-title" Text="{Binding Title}" />
                                <TextBlock Classes="choice-about" Text="{Binding About}" />
                              </StackPanel>
                              <CheckBox Grid.Column="4" AutomationProperties.Name="{Binding Title}" Classes="tick" IsChecked="{Binding Ticked}" VerticalAlignment="Center" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <StackPanel IsVisible="{Binding OnClasses}">
                    <TextBlock Classes="page-title step-title" Text="{Binding ClassesTitle}" />
                    <TextBlock Classes="page-lede step-lede" Text="{Binding ClassesLede}" />
                    <ScrollViewer Margin="0,18,0,0" MaxWidth="480" MaxHeight="236" HorizontalAlignment="Stretch" IsVisible="{Binding HasCourses}">
                      <ItemsControl ItemsSource="{Binding Courses}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SetupCourse">
                            <Grid ColumnDefinitions="20,10,*" Height="46">
                              <CheckBox AutomationProperties.Name="{Binding Name}" Classes="tick" IsChecked="{Binding Ticked}" VerticalAlignment="Center" />
                              <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Code}" IsVisible="{Binding HasCode}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource InkSubtle}" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Code}" c:Tips.WhenCut="True" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Classes}" Margin="0,14,0,0" MaxWidth="480" HorizontalAlignment="Stretch">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SetupClass">
                          <Grid ColumnDefinitions="20,10,150,12,*" Height="34">
                            <c:Swatch Fill="{Binding Dot}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" Classes="hint" Text="{Binding About}" TextWrapping="NoWrap" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnDefinitions="20,10,150,12,*,10,Auto" Margin="0,10,0,0" MaxWidth="480" HorizontalAlignment="Stretch">
                      <c:Icon Glyph="add" Size="16" Foreground="{DynamicResource InkSubtle}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                      <Border Grid.Column="2" Classes="field"><TextBox Classes="bare" Text="{Binding NewClass}" PlaceholderText="CS 101" /></Border>
                      <Border Grid.Column="4" Classes="field"><TextBox Classes="bare" Text="{Binding NewAbout}" PlaceholderText="What it covers" /></Border>
                      <Button Grid.Column="6" Classes="btn sm" Command="{Binding AddClassCommand}" Content="Add" />
                    </Grid>
                    <TextBlock IsVisible="{Binding HasClassProblem}" Classes="hint" Text="{Binding ClassProblem}" MaxWidth="480" HorizontalAlignment="Left" Margin="30,10,0,0" />
                  </StackPanel>

                  <!-- Start at login (off unless switched on) -->
                  <StackPanel IsVisible="{Binding OnStartAtLogin}">
                    <TextBlock Classes="page-title step-title" Text="{Binding StartAtLoginTitle}" />
                    <TextBlock Classes="page-lede step-lede" Text="{Binding StartAtLoginLede}" />
                    <Border Classes="group" Margin="0,24,0,0">
                      <Grid Classes="row" ColumnDefinitions="*,12,Auto" MinHeight="64">
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="Open when you log in" FontSize="15" FontWeight="Bold" />
                          <TextBlock Classes="hint" Text="{Binding StartAtLoginHint}" />
                        </StackPanel>
                        <ToggleButton AutomationProperties.Name="Open when you log in" Grid.Column="2" Classes="switch" IsChecked="{Binding StartAtLogin}" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </StackPanel>

                  <!-- The library's last page: how to connect your laptop -->
                  <StackPanel IsVisible="{Binding OnLibraryDone}">
                    <TextBlock Classes="page-title step-title" Text="Your library is ready" />
                    <TextBlock Classes="page-lede step-lede" Text="Connect your laptop: install Egghead Notes on it, and in its setup open Advanced and choose “My laptop for class”. Then enter:" />
                    <Border Classes="group" Margin="0,22,0,0">
                      <StackPanel>
                        <ItemsControl ItemsSource="{Binding Addresses}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SetupAddress">
                              <StackPanel>
                                <Grid Classes="row" ColumnDefinitions="112,*,10,Auto">
                                  <TextBlock Classes="key" Text="{Binding Where}" />
                                  <TextBlock Grid.Column="1" Classes="value" Text="{Binding Url}" ToolTip.Tip="{Binding Url}" c:Tips.WhenCut="True" />
                                  <Button Grid.Column="3" Classes="btn sm" VerticalAlignment="Center" Command="{Binding $parent[ItemsControl].((vm:SetupModel)DataContext).CopyCommand}" CommandParameter="{Binding Url}" Content="Copy" />
                                </Grid>
                                <Border Classes="rule" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Classes="row" ColumnDefinitions="112,*,10,Auto">
                          <TextBlock Classes="key" Text="Password" />
                          <TextBlock Grid.Column="1" Classes="value" Text="{Binding PasswordText}" />
                          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Classes="btn sm" Command="{Binding ToggleShowPasswordCommand}" Content="{Binding ShowPasswordText}" />
                            <Button Classes="btn sm" Command="{Binding CopyPasswordCommand}" Content="Copy" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>
                    <StackPanel IsVisible="{Binding HasKeys}" Spacing="12" Margin="0,20,0,0" MaxWidth="480" HorizontalAlignment="Left">
                      <Button Classes="text-link" AutomationProperties.Name="Change shortcuts" Command="{Binding ToggleKeysCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <c:Icon Glyph="keyboard" Size="16" />
                          <TextBlock Text="Change shortcuts" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Panel IsVisible="{Binding KeysOpen}">
                        <v:ShortcutsEditor DataContext="{Binding Keys}" />
                      </Panel>
                    </StackPanel>
                  </StackPanel>

                  <!-- A recording computer's last page (the laptop, or just this computer): how to record -->
                  <StackPanel IsVisible="{Binding OnLaptopDone}">
                    <TextBlock Classes="page-title step-title" Text="You're set" />
                    <TextBlock Classes="page-lede step-lede" Text="{Binding RecordHint}" />
                    <!-- A computer that records: what to do next. -->
                    <StackPanel IsVisible="{Binding !IsLibrary}" Margin="0,16,0,4" MaxWidth="480" HorizontalAlignment="Left" Spacing="10">
                      <TextBlock Classes="label" Text="What to do next" />
                      <ItemsControl ItemsSource="{Binding NextSteps}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:IntroPoint">
                            <Grid ColumnDefinitions="Auto,10,*">
                              <c:Icon Glyph="{Binding Glyph}" Size="16" Foreground="{DynamicResource AccentText}" VerticalAlignment="Top" Margin="0,1,0,0" />
                              <StackPanel Grid.Column="2" Spacing="1">
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Classes="hint" Text="{Binding About}" TextWrapping="Wrap" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <Border Classes="group" Margin="0,22,0,0">
                      <StackPanel>
                        <Grid Classes="row" ColumnDefinitions="Auto,12,150,*">
                          <c:Icon Classes="ok" Size="16" />
                          <TextBlock Grid.Column="2" Classes="key" Text="Your library" />
                          <TextBlock Grid.Column="3" Classes="value" Text="{Binding LibrarySummary}" />
                        </Grid>
                        <Border Classes="rule" />
                        <Grid Classes="row" ColumnDefinitions="Auto,12,150,*">
                          <Panel Width="16">
                            <c:Icon Classes="ok" Size="16" IsVisible="{Binding ModelReady}" />
                            <c:Icon IsVisible="{Binding !ModelReady}" Glyph="hourglass_top" Size="16" Foreground="{DynamicResource InkMuted}" VerticalAlignment="Center" />
                          </Panel>
                          <TextBlock Grid.Column="2" Classes="key" Text="Transcription model" />
                          <TextBlock Grid.Column="3" Classes="value" Text="{Binding ModelSummary}" />
                        </Grid>
                        <Border Classes="rule" IsVisible="{Binding ShowNotesSummary}" />
                        <Grid Classes="row" ColumnDefinitions="Auto,12,150,*" IsVisible="{Binding ShowNotesSummary}">
                          <c:Icon Classes="ok" Size="16" />
                          <TextBlock Grid.Column="2" Classes="key" Text="Notes" />
                          <TextBlock Grid.Column="3" Classes="value" Text="{Binding NotesSummary}" />
                        </Grid>
                      </StackPanel>
                    </Border>
                    <TextBlock IsVisible="{Binding OnOneComputerDone}" Classes="hint" Text="{Binding AddLaptopLater}" MaxWidth="480" HorizontalAlignment="Left" Margin="0,16,0,0" />
                    <StackPanel IsVisible="{Binding HasKeys}" Spacing="12" Margin="0,20,0,0" MaxWidth="480" HorizontalAlignment="Left">
                      <Button Classes="text-link" AutomationProperties.Name="Change shortcuts" Command="{Binding ToggleKeysCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <c:Icon Glyph="keyboard" Size="16" />
                          <TextBlock Text="Change shortcuts" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Panel IsVisible="{Binding KeysOpen}">
                        <v:ShortcutsEditor DataContext="{Binding Keys}" />
                      </Panel>
                    </StackPanel>
                  </StackPanel>

                  <!-- The taskbar (where Egghead Notes records) -->
                  <StackPanel IsVisible="{Binding OnTaskbar}">
                    <TextBlock Classes="page-title step-title" Text="Keep Egghead Notes on the taskbar" />
                    <TextBlock Classes="page-lede step-lede" Text="Windows tucks new icons away under ^. Drag Egghead Notes next to the clock so Record is always one click away." />
                    <Border Classes="group" Margin="0,24,0,0" Padding="20">
                      <Grid ColumnDefinitions="Auto,20,*">
                        <StackPanel Spacing="6" VerticalAlignment="Bottom">
                          <Border Padding="6" CornerRadius="{DynamicResource RadiusControl}" Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                  BoxShadow="{DynamicResource Shadow}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                              <Panel Width="32" Height="32"><c:Icon Glyph="cloud" Size="16" Foreground="{DynamicResource InkSubtle}" /></Panel>
                              <Border Width="32" Height="32" CornerRadius="6" BorderBrush="{DynamicResource Ink}" BorderThickness="2">
                                <c:AppMarkGlyph Width="17" Height="17" Foreground="{DynamicResource Ink}" />
                              </Border>
                              <Panel Width="32" Height="32"><c:Icon Glyph="bluetooth" Size="16" Foreground="{DynamicResource InkSubtle}" /></Panel>
                            </StackPanel>
                          </Border>
                          <Border Height="40" CornerRadius="{DynamicResource RadiusControl}" Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="10,0">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                              <c:Icon Glyph="keyboard_arrow_up" Size="16" Foreground="{DynamicResource Ink}" />
                              <c:DashedBox Width="28" Height="28" Stroke="{DynamicResource Ink}" />
                              <c:Icon Glyph="wifi" Size="16" Foreground="{DynamicResource Ink}" />
                              <c:Icon Glyph="volume_up" Size="16" Foreground="{DynamicResource Ink}" />
                              <TextBlock Classes="num" Text="12:34" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                          </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Classes="hint" Text="Select ^ in the taskbar corner, then drag the Egghead Notes icon down beside the clock." FontSize="14" LineHeight="21"
                                   MaxWidth="240" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                      </Grid>
                    </Border>
                    <Button Classes="text-link" Margin="0,18,0,0" Command="{Binding TaskbarSettingsCommand}" Content="Open taskbar settings instead" />
                  </StackPanel>

                  <!-- Who writes the notes: the pane pads itself, so it sits out to the page's edges -->
                  <Panel IsVisible="{Binding OnAi}" Margin="-40,0,-40,0">
                    <v:WinAiSetup DataContext="{Binding Ai}" />
                  </Panel>

                  <!-- Canvas: its own steps (in setup's look, SetupCanvasStyles); the foot's Skip for now, Back and
                       Continue are setup's -->
                  <Panel IsVisible="{Binding OnCanvas}">
                    <v:WinCanvasConnect DataContext="{Binding Canvas}" />
                  </Panel>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Panel>
      </Grid>
    </DockPanel>
  </Border>
</UserControl>
