<!-- The library window's one gentle ask for a tip (Services/SupportAsk.cs says when), atop the lecture list: a card in
     the Mac's group language, as design 08's Canvas cards sit atop the Due list (Group fill, radius 16). It covers
     nothing; each button answers it and it goes. The Ko-fi button is a raised pill, not the accent, so it never
     outshines the lecture chosen below it; the other two are plain text that washes on hover. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:s="using:StudyStash.App.Services"
             x:Class="StudyStash.App.Views.MacSupportAsk"
             x:DataType="vm:SupportAskModel">
  <UserControl.Styles>
    <Style Selector="Border.ask">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{DynamicResource Group}" />
      <Setter Property="Padding" Value="12,12,12,4" />
    </Style>
    <Style Selector="Button.ask">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.ask-tip">
      <Setter Property="Background" Value="{DynamicResource Raised}" />
    </Style>
    <Style Selector="Button.ask-tip /template/ Border#PART_Bg">
      <Setter Property="BoxShadow" Value="{DynamicResource RaisedShadow}" />
    </Style>
    <Style Selector="Button.ask-tip TextBlock">
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.ask-plain TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    </Style>
  </UserControl.Styles>
  <Border Classes="ask">
    <StackPanel>
      <TextBlock Text="{x:Static s:SupportAsk.Title}" FontSize="13" FontWeight="SemiBold" />
      <TextBlock Text="{x:Static s:SupportAsk.Text}" FontSize="12" LineHeight="17.4" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" Margin="0,2,0,0" />
      <Button Name="Tip" Classes="ask ask-tip" Command="{Binding TipCommand}" HorizontalAlignment="Left" Margin="0,10,0,0">
        <TextBlock Text="{x:Static s:SupportAsk.Button}" />
      </Button>
      <!-- Plain text buttons: their words line up with the text above, their hover wash reaching into the padding. -->
      <StackPanel Orientation="Horizontal" Margin="-12,4,0,0">
        <Button Name="Later" Classes="ask ask-plain" IsVisible="{Binding CanWait}" Command="{Binding LaterCommand}">
          <TextBlock Text="{x:Static s:SupportAsk.LaterButton}" />
        </Button>
        <Button Name="Never" Classes="ask ask-plain" Command="{Binding NeverCommand}">
          <TextBlock Text="{x:Static s:SupportAsk.NeverButton}" />
        </Button>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
