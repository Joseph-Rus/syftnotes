<!-- Settings, in the design's settings language: Mac a glass sidebar over grouped rows (mac-13-ai-engines,
     mac-06-canvas-settings); Windows a nav with an accent indicator over card rows on a Layer page (win-13-*,
     win-06-*). The code-behind adds "mac" or "win" to the root, and every look-specific value below is a style
     scoped by it (.mac X / .win X), so the classes read the same either way:
       group   a card of rows: Mac one Border (radius 16, Group), Windows each row its own Card (see "choice")
       row     one line in a group: title + sub on the left, a control on the right
       row-title / row-sub   its two lines of text
       section a header above a group ("Colour theme"), with room for a trailing link
       pill    a small button (Options, Add, Sign in…); "primary" tints it as the default action
       choice  a selectable card (a model, an AI, a colour) with an "on" state
       select  a dropdown-styled button (unfold_more/expand_more); not used here yet — for wave 2
       switch  an accent-track, white-knob toggle (ToggleButton, not the Fluent ToggleSwitch)
       link    small accent-coloured text, for a section header's trailing action
     Appearance is new: 10 colour-theme swatches, applied live and saved. Other sections keep their content; wave 2
     gives Canvas and AI their own screens. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:StudyStash.App.Services"
             xmlns:app="using:StudyStash.App"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:v="using:StudyStash.App.Views"
             xmlns:vm="using:StudyStash.App.ViewModels"
             x:Class="StudyStash.App.Views.SettingsView"
             x:DataType="s:SettingsModel"
             ClipToBounds="False">
  <UserControl.Styles>
    <!-- The window's own frame, drawn only for a screenshot: a real window is already rounded, edged and shadowed
         by the system (macOS; Windows 11), so drawing both would double up. -->
    <Style Selector="Border#Chrome">
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector=".mac Border#Chrome">
      <Setter Property="Background" Value="{DynamicResource Win}" />
    </Style>
    <Style Selector=".mac Border#Chrome.chrome">
      <Setter Property="CornerRadius" Value="26" />
      <Setter Property="BoxShadow" Value="{DynamicResource WindowShadow}" />
    </Style>
    <Style Selector=".win Border#Chrome">
      <Setter Property="Background" Value="{DynamicResource Mica}" />
    </Style>
    <Style Selector=".win Border#Chrome.chrome">
      <Setter Property="BorderBrush" Value="{DynamicResource FlyStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BoxShadow" Value="{DynamicResource ShadowLg}" />
    </Style>

    <!-- The sidebar: Mac an inset floating glass panel below the title bar; Windows plain, flush on the Mica. -->
    <Style Selector="c|Glass.side">
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector=".mac c|Glass.side">
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="BoxShadow" Value="{DynamicResource SideGlassShadow}" />
      <Setter Property="Margin" Value="8,0,0,8" />
      <Setter Property="Padding" Value="10,10,10,14" />
    </Style>
    <Style Selector=".win c|Glass.side">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="4,8" />
    </Style>

    <!-- One nav row: Mac highlights the row itself and tints its icon; Windows only shades it and adds the pill. -->
    <Style Selector="Button.nav">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="c|Icon.navicon">
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    </Style>
    <Style Selector="Border.indicator">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector=".mac Button.nav">
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector=".mac Button.nav.on">
      <Setter Property="Background" Value="{DynamicResource Fill2}" />
    </Style>
    <Style Selector=".mac Button.nav.on /template/ Border#PART_Bg">
      <Setter Property="BoxShadow" Value="{DynamicResource EdgeSoft}" />
    </Style>
    <Style Selector=".mac Button.nav.on TextBlock.navlabel">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector=".mac Button.nav.on c|Icon.navicon">
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    </Style>
    <Style Selector=".win Button.nav">
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector=".win c|Icon.navicon">
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
    </Style>
    <Style Selector=".win Button.nav.on">
      <Setter Property="Background" Value="{DynamicResource Subtle}" />
    </Style>
    <Style Selector=".win Button.nav.on Border.indicator">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- The sidebar's two groups: this computer's settings, then the library's own. -->
    <Style Selector="TextBlock.navgroup">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector=".mac TextBlock.navgroup">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Fg3}" />
      <Setter Property="Margin" Value="10,4,0,4" />
    </Style>
    <Style Selector=".win TextBlock.navgroup">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
      <Setter Property="Margin" Value="12,6,0,4" />
    </Style>
    <Style Selector=".mac TextBlock.navgroup.second">
      <Setter Property="Margin" Value="10,16,0,4" />
    </Style>
    <Style Selector=".win TextBlock.navgroup.second">
      <Setter Property="Margin" Value="12,18,0,4" />
    </Style>

    <!-- The content page: Mac sits right on the window's Win colour; Windows is an inset Layer with its own corner. -->
    <Style Selector=".win Border.page">
      <Setter Property="Background" Value="{DynamicResource Layer}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LayerStroke}" />
      <Setter Property="BorderThickness" Value="1,1,0,0" />
      <Setter Property="CornerRadius" Value="8,0,0,0" />
    </Style>
    <Style Selector=".mac StackPanel.pagebody">
      <Setter Property="Margin" Value="40,12,40,32" />
      <Setter Property="Spacing" Value="24" />
    </Style>
    <Style Selector=".win StackPanel.pagebody">
      <Setter Property="Margin" Value="36,28,36,28" />
      <Setter Property="Spacing" Value="16" />
    </Style>

    <Style Selector="TextBlock.h">
      <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    </Style>
    <Style Selector=".mac TextBlock.h">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="c:Typography.Extra" Value="-0.39" />
    </Style>
    <Style Selector=".win TextBlock.h">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,4,0,4" />
    </Style>
    <Style Selector="TextBlock.body">
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector=".mac TextBlock.body">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="19.5" />
      <Setter Property="MaxWidth" Value="540" />
    </Style>
    <Style Selector=".win TextBlock.body">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="LineHeight" Value="21" />
      <Setter Property="MaxWidth" Value="560" />
    </Style>
    <Style Selector="TextBlock.say">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="MaxWidth" Value="480" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="TextBlock.link">
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    </Style>
    <Style Selector=".mac TextBlock.link">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector=".win TextBlock.link">
      <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- A section's header: the label, and room on the right for a trailing link. -->
    <Style Selector="Grid.section">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector=".mac TextBlock.section">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="4,0" />
    </Style>
    <Style Selector=".win TextBlock.section">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <!-- A header that starts a new part of a page: a little more room above it than between its own rows. -->
    <Style Selector=".mac TextBlock.section.gap">
      <Setter Property="Margin" Value="4,10,4,0" />
    </Style>
    <Style Selector=".win TextBlock.section.gap">
      <Setter Property="Margin" Value="0,10,0,0" />
    </Style>
    <!-- A list's rows in one group: a hairline above every row but the first. -->
    <Style Selector="Border.itemsep">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ContentPresenter:nth-child(n+2) Border.itemsep">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- A group of rows: Mac one rounded card; Windows nothing itself (its rows are each their own card, "choice"). -->
    <Style Selector="Border.group">
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector=".mac Border.group">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{DynamicResource Group}" />
    </Style>
    <Style Selector=".win Border.group">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- One row inside a group: title + sub on the left, a control on the right. -->
    <Style Selector="Border.row">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector=".mac Border.row">
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="Padding" Value="16,8" />
    </Style>
    <Style Selector=".win Border.row">
      <Setter Property="MinHeight" Value="64" />
      <Setter Property="Padding" Value="16,10" />
    </Style>
    <Style Selector="TextBlock.row-title">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector=".mac TextBlock.row-title">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector=".win TextBlock.row-title">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBlock.row-sub">
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    </Style>
    <Style Selector=".mac TextBlock.row-sub">
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector=".win TextBlock.row-sub">
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- A hairline between two rows of a group, from the rows' text edge to the right. -->
    <Style Selector="Border.rowsep">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Sep}" />
      <Setter Property="Margin" Value="16,0,0,0" />
    </Style>
    <Style Selector=".mac Border.rowsep">
      <Setter Property="Height" Value="0.5" />
    </Style>
    <!-- A row's action column: whatever sits there (a switch, a select, a button) lines up at the right edge and on
         the row's centre line. -->
    <Style Selector="Border.row > Grid > :is(Control).act">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="TextBlock.plain">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- A small button (Options, Add, Save…), "primary" for the section's default action. -->
    <Style Selector="Button.pill">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector=".mac Button.pill">
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Background" Value="{DynamicResource Raised}" />
    </Style>
    <Style Selector=".mac Button.pill /template/ Border#PART_Bg">
      <Setter Property="BoxShadow" Value="{DynamicResource RaisedShadow}" />
    </Style>
    <Style Selector=".mac Button.pill.primary">
      <Setter Property="Background" Value="{DynamicResource Tint}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector=".mac Button.pill.primary /template/ Border#PART_Bg">
      <Setter Property="BoxShadow" Value="{DynamicResource EdgeTint}" />
    </Style>
    <Style Selector=".win Button.pill">
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Background" Value="{DynamicResource Ctrl}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CtrlBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector=".win Button.pill.primary">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector=".win Button.pill.primary TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A dropdown-styled button: not used on this page yet, kept here for wave 2's Canvas/AI screens. -->
    <Style Selector="Button.select">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector=".mac Button.select">
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="12,0,8,0" />
      <Setter Property="Background" Value="{DynamicResource Raised}" />
    </Style>
    <Style Selector=".mac Button.select /template/ Border#PART_Bg">
      <Setter Property="BoxShadow" Value="{DynamicResource RaisedShadow}" />
    </Style>
    <Style Selector=".win Button.select">
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="11,0,10,0" />
      <Setter Property="Background" Value="{DynamicResource Ctrl}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CtrlBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- "Recommended" beside the model for this computer: setup's badge. -->
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Background" Value="{DynamicResource AccentTint}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector=".win Border.badge">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource Subtle2}" />
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    </Style>

    <!-- A selectable card (a model, an AI, a colour theme): Mac a tinted card, Windows a stroked one; both take an
         accent border when chosen. -->
    <Style Selector="Border.choice">
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.choice.on">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector=".mac Border.choice">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{DynamicResource Group}" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="BoxShadow" Value="{DynamicResource EdgeSoft}" />
    </Style>
    <Style Selector=".win Border.choice">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
      <Setter Property="Padding" Value="14,12" />
    </Style>
    <!-- Declared after .win Border.choice, so the chosen card's accent isn't painted over by the plain stroke. -->
    <Style Selector=".win Border.choice.on">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <!-- A card's focus ring follows its corners, 4 px out. -->
    <Style Selector=".mac Border.cardring">
      <Setter Property="CornerRadius" Value="20" />
    </Style>
    <Style Selector=".win Border.cardring">
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <!-- A card that isn't chosen, hovered or pressed: its own outline shows faintly (no box round it). -->
    <Style Selector="Button.card:pointerover Border.choice:not(.on), Button.card:pressed Border.choice:not(.on)">
      <Setter Property="BorderBrush" Value="{DynamicResource Fg3}" />
    </Style>

    <!-- Settings → Appearance's mode: Mac a three-way segmented pill (System Settings' own Appearance control) — one
         rounded track holding three equal buttons, the chosen one raised. -->
    <Style Selector="Border.seg">
      <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector=".mac Border.seg">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource Group}" />
    </Style>
    <Style Selector="Button.seg-item">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector=".mac Button.seg-item">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    </Style>
    <Style Selector=".mac Button.seg-item.on">
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="Background" Value="{DynamicResource Raised}" />
    </Style>
    <Style Selector=".mac Button.seg-item.on /template/ Border#PART_Bg">
      <Setter Property="BoxShadow" Value="{DynamicResource RaisedShadow}" />
    </Style>

    <!-- An accent-track, white-knob toggle: a plain ToggleButton, not the Fluent ToggleSwitch (which doesn't follow
         the colour theme). -->
    <Style Selector="ToggleButton.switch">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Border Name="Track" CornerRadius="11" Background="{DynamicResource Fill2}" />
            <Border Name="Knob" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource Mini}"
                    HorizontalAlignment="Left" Margin="2,0,0,0" BoxShadow="0 1 3 0 #40000000" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.switch:checked /template/ Border#Track">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="ToggleButton.switch:checked /template/ Border#Knob">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,0,2,0" />
    </Style>

    <!-- A text field, as the other sections already draw them. -->
    <Style Selector="Border.field">
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="9,0" />
    </Style>
    <Style Selector=".mac Border.field">
      <Setter Property="Background" Value="{DynamicResource Raised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sep}" />
    </Style>
    <Style Selector=".win Border.field">
      <Setter Property="Background" Value="{DynamicResource Ctrl}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CtrlBorder}" />
    </Style>
    <Style Selector="Border.field.bad">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>

    <!-- The colour theme swatches: Mac a filled ring (a gap of Win, an Accent rim when chosen); Windows a squared
         swatch with a Fg border and a check when chosen. Hovered or pressed, the rim shows faintly; focused from the
         keyboard, a focus ring goes round the swatch. Never a box round the whole cell. -->
    <Style Selector="Border.swatchring">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.swatch:pointerover Border.swatchring, Button.swatch:pressed Border.swatchring">
      <Setter Property="Background" Value="{DynamicResource Fg3}" />
    </Style>
    <Style Selector=".mac Border.swatchring.on">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Border.swatchborder">
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.swatch:pointerover Border.swatchborder, Button.swatch:pressed Border.swatchborder">
      <Setter Property="BorderBrush" Value="{DynamicResource Fg3}" />
    </Style>
    <Style Selector=".win Border.swatchborder.on">
      <Setter Property="BorderBrush" Value="{DynamicResource Fg}" />
    </Style>
    <Style Selector="TextBlock.swatchname">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector=".win TextBlock.swatchname">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector=".mac Button.select TextBlock">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector=".win Button.select TextBlock">
      <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- An engine's problems sit above the AI engines pane, lined up with its own padding. -->
    <Style Selector=".mac UserControl.problems">
      <Setter Property="Margin" Value="40,32,40,-16" />
      <Setter Property="MaxWidth" Value="640" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector=".win UserControl.problems">
      <Setter Property="Margin" Value="36,24,36,-8" />
      <Setter Property="MaxWidth" Value="680" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <!-- A select's menu: one plain, neutral panel, like the menus elsewhere in the app. -->
    <ControlTheme x:Key="SettingsMenu" TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource {x:Type MenuFlyoutPresenter}}">
      <Setter Property="Background" Value="{DynamicResource PopupBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PopupStroke}" />
      <Setter Property="BorderThickness" Value="{DynamicResource PopupStrokeWidth}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusMenu}" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="MinWidth" Value="180" />
    </ControlTheme>
    <DataTemplate x:Key="NavRow" x:DataType="s:NavItem">
      <Button Classes="nav" Classes.on="{Binding On}" Command="{Binding $parent[UserControl].((s:SettingsModel)DataContext).GoCommand}" CommandParameter="{Binding Id}">
        <Panel>
          <Border Classes="indicator" Width="3" Height="16" CornerRadius="2" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Margin="-12,0,0,0" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <c:Icon Classes="navicon" Glyph="{Binding Glyph}" Size="16" />
            <TextBlock Classes="navlabel" Text="{Binding Label}" VerticalAlignment="Center" />
          </StackPanel>
        </Panel>
      </Button>
    </DataTemplate>
    <!-- A select's item: the menu's own item, bound to its choice (a MenuItem inside an item template would sit in the
         real item's header, and picking it did nothing). -->
    <ControlTheme x:Key="PickItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:SettingChoice">
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Header" Value="{Binding Label}" />
      <Setter Property="Command" Value="{Binding Pick}" />
    </ControlTheme>
  </UserControl.Resources>

  <Border Name="Chrome">
    <DockPanel>
      <!-- The title bar: drag the window by it; the system's window buttons sit in it. -->
      <c:WindowHeader Name="Header" DockPanel.Dock="Top" CanResize="False" />

      <Grid Name="Cols" ColumnDefinitions="220,*">
        <c:Glass Classes="side">
          <StackPanel Spacing="2">
            <TextBlock Classes="navgroup" Text="{Binding ComputerNavTitle}" />
            <ItemsControl ItemsSource="{Binding ComputerNav}" ItemTemplate="{StaticResource NavRow}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Classes="navgroup second" Text="Your library" />
            <ItemsControl ItemsSource="{Binding LibraryNav}" ItemTemplate="{StaticResource NavRow}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </c:Glass>

        <Border Grid.Column="1" Classes="page">
          <Panel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding OnPlainPage}">
            <StackPanel Classes="pagebody">
              <!-- General -->
              <StackPanel IsVisible="{Binding OnGeneral}" Spacing="8">
                <TextBlock Classes="h" Text="General" />
                <TextBlock Classes="body" Text="How Study Stash starts, setup, and its version." />
                <TextBlock Classes="section" Text="Startup" />
                <Border Classes="group">
                  <Border Classes="row">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Classes="row-title" Text="Open when you log in" />
                        <TextBlock Classes="row-sub" Text="To the menu bar or tray" />
                      </StackPanel>
                      <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding StartAtLogin}" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </Border>
                <TextBlock Classes="section" Text="Setup" />
                <Border Classes="group">
                  <Border Classes="row">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Classes="row-title" Text="Run setup again" />
                        <TextBlock Classes="row-sub" Text="The first-run steps, with what's set up already kept" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Name="SetUpByHand" Theme="{StaticResource Surface}" Padding="0" Command="{Binding RunSetupByHandCommand}" VerticalAlignment="Center">
                          <TextBlock Text="Set up by hand" FontSize="12" Foreground="{DynamicResource AccentText}" />
                        </Button>
                        <Button Classes="pill" Command="{Binding RunSetupAgainCommand}" VerticalAlignment="Center"><TextBlock Text="Run setup" /></Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </Border>
                <TextBlock Classes="section" Text="About" />
                <Border Classes="group">
                  <StackPanel>
                    <Border Classes="row">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="row-title" Text="{Binding Version, StringFormat='Study Stash {0}'}" />
                        <Button Grid.Column="1" Classes="pill" Command="{Binding QuitCommand}" VerticalAlignment="Center"><TextBlock Text="Quit Study Stash" /></Button>
                      </Grid>
                    </Border>
                    <Border Classes="rowsep" />
                    <!-- The credit NVIDIA's licence (CC BY 4.0) asks for, beside OpenAI's. -->
                    <Border Classes="row">
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="row-title" Text="Speech models" />
                        <TextBlock Classes="row-sub" Text="Whisper by OpenAI (MIT); NVIDIA Parakeet TDT 0.6B v3 and TitaNet small (CC BY 4.0) and pyannote segmentation 3.0 (MIT), converted to ONNX by sherpa-onnx. They run on this computer and download only when you pick them." TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Border Classes="rowsep" />
                    <!-- Study Stash is free: a tip for the two students who build it goes to their Ko-fi page. -->
                    <Border Classes="row">
                      <Grid ColumnDefinitions="*,16,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                          <TextBlock Classes="row-title" Text="Support Study Stash" />
                          <TextBlock Classes="row-sub" Text="{x:Static s:SupportAsk.AboutLine}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Name="BuyClaudeUsage" Grid.Column="2" Classes="pill" Command="{Binding BuyClaudeUsageCommand}" VerticalAlignment="Center">
                          <TextBlock Text="{x:Static s:SupportAsk.Button}" />
                        </Button>
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- Appearance -->
              <!-- Shortcuts: every key the student can change, and whether search and Record work from any app. -->
              <StackPanel IsVisible="{Binding OnShortcuts}" Spacing="8">
                <TextBlock Classes="h" Text="Shortcuts" />
                <TextBlock Classes="body" Text="Change the keys for searching, recording, asking and Settings." TextWrapping="Wrap" />
                <CheckBox IsChecked="{Binding Shortcuts}" Margin="0,4,0,4">
                  <TextBlock Text="Search and Record work from any app" FontSize="13" />
                </CheckBox>
                <v:ShortcutsEditor DataContext="{Binding Keys}" />
                <TextBlock Classes="say" Text="{Binding ShortcutsSay}" IsVisible="{Binding ShortcutsSay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel IsVisible="{Binding OnAppearance}" Spacing="8">
                <TextBlock Classes="h" Text="Appearance" />
                <TextBlock Classes="body" Text="Pick how Study Stash looks." />
                <TextBlock Classes="section" Text="Mode" />
                <!-- Mac: a three-way segmented pill, System Settings' own way of choosing an appearance. -->
                <Border Classes="seg" IsVisible="{Binding IsMac}" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="seg-item" Classes.on="{Binding AppearanceIsSystem}"
                            Command="{Binding PickAppearanceCommand}" CommandParameter="{x:Static s:AppAppearance.System}">
                      <TextBlock Text="Match system" />
                    </Button>
                    <Button Classes="seg-item" Classes.on="{Binding AppearanceIsLight}"
                            Command="{Binding PickAppearanceCommand}" CommandParameter="{x:Static s:AppAppearance.Light}">
                      <TextBlock Text="Light" />
                    </Button>
                    <Button Classes="seg-item" Classes.on="{Binding AppearanceIsDark}"
                            Command="{Binding PickAppearanceCommand}" CommandParameter="{x:Static s:AppAppearance.Dark}">
                      <TextBlock Text="Dark" />
                    </Button>
                  </StackPanel>
                </Border>
                <!-- Windows: a vertical list of radio rows, each the full row wide; a row's hover stays inside the
                     group's rounded corners. -->
                <Border Classes="group" IsVisible="{Binding IsWin}" ClipToBounds="True">
                  <ItemsControl ItemsSource="{Binding AppearanceOptions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="s:AppearanceOption">
                        <StackPanel>
                          <Border Classes="rowsep itemsep" />
                          <Button Theme="{StaticResource Surface}" HorizontalContentAlignment="Stretch"
                                  Command="{Binding $parent[UserControl].((s:SettingsModel)DataContext).PickAppearanceCommand}" CommandParameter="{Binding Mode}">
                            <Border Classes="row">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="row-title" Text="{Binding Label}" />
                                <Panel Grid.Column="1" Classes="act" Width="16" Height="16">
                                  <Ellipse Width="16" Height="16" Stroke="{DynamicResource Fg3}" StrokeThickness="1.3" IsVisible="{Binding !Chosen}" />
                                  <Ellipse Width="16" Height="16" Stroke="{DynamicResource Accent}" StrokeThickness="1.3" IsVisible="{Binding Chosen}" />
                                  <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}" IsVisible="{Binding Chosen}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Panel>
                              </Grid>
                            </Border>
                          </Button>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
                <TextBlock Classes="say" Text="Light and dark set the whole app at once: the dropdown, quick panel, recorder, library and setup." />
                <TextBlock Classes="section gap" Text="Colour theme" />
                <Border Classes="group" Padding="16">
                  <!-- Unclipped, so a swatch's focus ring shows whole. -->
                  <ItemsControl ItemsSource="{Binding Themes}" ClipToBounds="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="app:ThemeSwatch">
                        <Button Classes="quiet swatch" Theme="{StaticResource Surface}" Padding="0" Margin="0,0,0,10"
                                Command="{Binding $parent[UserControl].((s:SettingsModel)DataContext).PickThemeCommand}" CommandParameter="{Binding Name}">
                          <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <Panel IsVisible="{Binding $parent[UserControl].((s:SettingsModel)DataContext).ShowMacSwatch}" Width="52" Height="52" HorizontalAlignment="Center">
                              <Border Classes="swatchring" Classes.on="{Binding Chosen}" Width="52" Height="52" CornerRadius="26">
                                <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource Win}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                  <Ellipse Width="44" Height="44" Fill="{Binding Swatch}" />
                                </Border>
                              </Border>
                              <Border Classes="focusring" Margin="-4" CornerRadius="30" />
                            </Panel>
                            <Panel IsVisible="{Binding !$parent[UserControl].((s:SettingsModel)DataContext).ShowMacSwatch}" Width="40" Height="40" HorizontalAlignment="Center">
                              <Border Width="40" Height="40" CornerRadius="4" Background="{Binding Swatch}" />
                              <Border Classes="swatchborder" Classes.on="{Binding Chosen}" Width="40" Height="40" CornerRadius="4" BorderThickness="2" />
                              <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource Mini}" IsVisible="{Binding Chosen}">
                                <c:Icon Glyph="check" Size="12" Foreground="{DynamicResource Fg}" />
                              </Border>
                              <Border Classes="focusring" Margin="-4" CornerRadius="8" />
                            </Panel>
                            <TextBlock Classes="swatchname" Text="{Binding Name}" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
                <TextBlock Classes="say" Text="The accent for buttons, the selection and highlights. Your class colours stay the same." />
              </StackPanel>

              <!-- Connection: which library this computer uses (and, where it runs one, that library's process) -->
              <StackPanel IsVisible="{Binding OnConnection}" Spacing="8">
                <TextBlock Classes="h" Text="Connection" />
                <TextBlock Classes="body" Text="{Binding LibraryLine}" />
                <!-- The library runs here: what it's doing, and its page. Nothing to connect to: using another computer's
                     library instead is This computer's choice, below. -->
                <StackPanel Spacing="8" IsVisible="{Binding LibraryHere}">
                  <TextBlock Classes="say" Text="{Binding LibraryServiceLine}" IsVisible="{Binding LibraryServiceLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                    <Button Classes="pill" Command="{Binding OpenLibraryPageCommand}"><TextBlock Text="Open the library's page" FontSize="13" /></Button>
                    <Button Classes="pill" Command="{Binding StartLibraryCommand}" IsVisible="{Binding CanStartLibrary}"><TextBlock Text="Start" FontSize="13" /></Button>
                    <Button Classes="pill" Command="{Binding StopLibraryCommand}" IsVisible="{Binding CanStopLibrary}"><TextBlock Text="Stop" FontSize="13" /></Button>
                  </StackPanel>
                  <TextBlock Classes="say" Text="It runs while Study Stash is open. Turn on Start at login in General to keep it running; its own settings, and adding a laptop, are under Your library." />
                </StackPanel>
                <!-- A laptop: the library it sends lectures to -->
                <StackPanel Spacing="8" IsVisible="{Binding !LibraryHere}">
                  <TextBlock Classes="section" Text="Connect to a library" />
                  <Grid ColumnDefinitions="*,10,160" MaxWidth="480" HorizontalAlignment="Left">
                    <Border Classes="field"><TextBox Classes="bare" Text="{Binding Address}" PlaceholderText="http://mac-mini:8787" FontSize="13" /></Border>
                    <Border Grid.Column="2" Classes="field"><TextBox Classes="bare" Text="{Binding Password}" PasswordChar="•" PlaceholderText="Password" FontSize="13" /></Border>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                    <Button Classes="pill primary" Command="{Binding ConnectCommand}"><TextBlock Text="Connect" FontSize="13" FontWeight="Medium" /></Button>
                    <Button Classes="pill" Command="{Binding OpenLibraryPageCommand}"><TextBlock Text="Open the library's page" FontSize="13" /></Button>
                  </StackPanel>
                </StackPanel>
                <TextBlock Classes="say" Text="{Binding LibrarySay}" IsVisible="{Binding LibrarySay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="section gap" Text="Your name in the library" />
                <Border Classes="field" Width="240" HorizontalAlignment="Left"><TextBox Classes="bare" Text="{Binding DisplayName}" FontSize="13" /></Border>
                <!-- This computer's role, switched any time after setup (docs/one-download.md) -->
                <TextBlock Classes="section gap" Text="This computer" />
                <TextBlock Classes="body" Text="{Binding RoleWords}" />
                <!-- An old library whose lectures haven't all come over yet (it stopped part-way, or setup made this the library) -->
                <Border Classes="group" IsVisible="{Binding ShowPendingBring}">
                  <Border Classes="row">
                    <Grid ColumnDefinitions="Auto,12,*,12,Auto">
                      <c:Icon Glyph="info" Size="18" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="row-title" Text="{Binding PendingBringTitle}" TextWrapping="Wrap" />
                        <TextBlock Classes="row-sub" Text="{Binding PendingBringLine}" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="pill" Command="{Binding LeaveThemThereCommand}" IsEnabled="{Binding !Switching}"><TextBlock Text="Leave them there" FontSize="13" /></Button>
                        <Button Classes="pill primary" Command="{Binding BringAgainCommand}" IsEnabled="{Binding !Switching}"><TextBlock Text="{Binding PendingBringAction}" FontSize="13" FontWeight="Medium" /></Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </Border>
                <!-- A laptop: keep everything on this computer, bringing over the library it used -->
                <StackPanel Spacing="8" IsVisible="{Binding IsLaptopRole}">
                  <Border Classes="group">
                    <Border Classes="row">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                          <TextBlock Classes="row-title" Text="Use just this computer" />
                          <TextBlock Classes="row-sub" Text="{Binding JustThisComputerLine}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="pill act" Margin="12,0,0,0" IsVisible="{Binding !ConfirmingBecomeLibrary}" Command="{Binding AskBecomeLibraryCommand}">
                          <TextBlock Text="Use just this computer…" FontSize="13" />
                        </Button>
                      </Grid>
                    </Border>
                  </Border>
                  <StackPanel Spacing="8" IsVisible="{Binding ConfirmingBecomeLibrary}">
                    <TextBlock Classes="say" MaxWidth="560" Text="{Binding BecomeLibraryQuestion}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="pill" Command="{Binding CancelBecomeLibraryCommand}" IsEnabled="{Binding !Switching}"><TextBlock Text="Cancel" FontSize="13" /></Button>
                      <Button Classes="pill primary" Command="{Binding ConfirmBecomeLibraryCommand}" IsEnabled="{Binding !Switching}"><TextBlock Text="Use just this computer" FontSize="13" FontWeight="Medium" /></Button>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
                <!-- A library: use a library on another computer instead, handing everything over first -->
                <StackPanel Spacing="8" IsVisible="{Binding IsLibraryRole}">
                  <Border Classes="group">
                    <Border Classes="row">
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="row-title" Text="Use a library on another computer" />
                        <TextBlock Classes="row-sub" TextWrapping="Wrap"
                                   Text="Everything in this library goes to it first: every lecture with its notes and transcript, attached files, your classes and chats. Then this computer records for it." />
                      </StackPanel>
                    </Border>
                  </Border>
                  <Grid ColumnDefinitions="*,10,160" MaxWidth="480" HorizontalAlignment="Left" Margin="0,4,0,0" IsVisible="{Binding !ConfirmingBecomeLaptop}">
                    <Border Classes="field"><TextBox Classes="bare" Text="{Binding BecomeLaptopAddress}" PlaceholderText="http://mac-mini:8787" FontSize="13" /></Border>
                    <Border Grid.Column="2" Classes="field"><TextBox Classes="bare" Text="{Binding BecomeLaptopPassword}" PasswordChar="•" PlaceholderText="Its password" FontSize="13" /></Border>
                  </Grid>
                  <Button Classes="pill" HorizontalAlignment="Left" IsVisible="{Binding !ConfirmingBecomeLaptop}" Command="{Binding AskBecomeLaptopCommand}">
                    <TextBlock Text="Become a laptop" FontSize="13" />
                  </Button>
                  <StackPanel Spacing="8" IsVisible="{Binding ConfirmingBecomeLaptop}">
                    <TextBlock Classes="say" MaxWidth="560"
                               Text="Everything in this library goes to that address first, so nothing is left behind; if that library can't take it all, nothing changes here. Then this computer stops being the library: its lectures, notes and settings stay right where they are, ready for it to be the library again any time." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="pill" Command="{Binding CancelBecomeLaptopCommand}" IsEnabled="{Binding !Switching}"><TextBlock Text="Cancel" FontSize="13" /></Button>
                      <Button Classes="pill primary" Command="{Binding ConfirmBecomeLaptopCommand}" IsEnabled="{Binding !Switching}"><TextBlock Text="Switch" FontSize="13" FontWeight="Medium" /></Button>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
                <!-- How far bringing (or handing on) a library has got, then what came -->
                <TextBlock Classes="say" Text="{Binding BringLine}" IsVisible="{Binding BringLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Border IsVisible="{Binding ShowBringBar}" Height="4" CornerRadius="2" Background="{DynamicResource Fill2}" Width="480"
                        HorizontalAlignment="Left" Margin="0,4,0,0">
                  <Border Width="{Binding BringBarWidth}" CornerRadius="2" Background="{DynamicResource Accent}" HorizontalAlignment="Left" />
                </Border>
                <TextBlock Classes="say" MaxWidth="560" Text="{Binding SwitchSay}" IsVisible="{Binding SwitchSay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>

              <!-- Recording -->
              <StackPanel IsVisible="{Binding OnRecording}" Spacing="8">
                <TextBlock Classes="h" Text="Recording" />
                <TextBlock Classes="body" Text="Each lecture is written down on this computer by the model you pick. The recording never leaves it; the library gets the transcript." />
                <TextBlock Classes="section" Text="Transcription model" />
                <!-- Unclipped, so a card's focus ring shows whole. -->
                <ItemsControl ItemsSource="{Binding Models}" MaxWidth="480" HorizontalAlignment="Left" ClipToBounds="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="s:ModelChoice">
                      <Button Classes="quiet card" Theme="{StaticResource Surface}" Margin="0,0,0,8" Padding="0"
                              Command="{Binding $parent[UserControl].((s:SettingsModel)DataContext).PickModelCommand}" CommandParameter="{Binding}">
                        <Panel>
                          <Border Classes="focusring cardring" Margin="-4" />
                          <Border Classes="choice" Classes.on="{Binding Chosen}" Margin="0">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                  <Border Classes="badge" IsVisible="{Binding Recommended}"><TextBlock Text="Recommended" /></Border>
                                </StackPanel>
                                <TextBlock Text="{Binding About}" FontSize="12" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" />
                              </StackPanel>
                              <c:Icon Grid.Column="1" IsVisible="{Binding Here}" Glyph="check_circle" Filled="True" Size="18" Foreground="{DynamicResource Accent}" Margin="10,0,0,0" />
                            </Grid>
                          </Border>
                        </Panel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="say" Text="{Binding ModelAdviceLine}" Margin="0,0,0,0" />
                <Border IsVisible="{Binding ModelDownloading}" Height="4" CornerRadius="2" Background="{DynamicResource Fill2}" Width="480"
                        HorizontalAlignment="Left" Margin="0,8,0,0">
                  <Border Width="{Binding ModelBarWidth}" CornerRadius="2" Background="{DynamicResource Accent}" HorizontalAlignment="Left" />
                </Border>
                <TextBlock Classes="say" Text="{Binding ModelLine}" />
                <!-- A model no longer in use (after a switch) stays until the student says to remove it. -->
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0" IsVisible="{Binding HasSpare}">
                  <TextBlock Text="{Binding SpareLine}" FontSize="12" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380" />
                  <Button Classes="pill" Command="{Binding AskRemoveSpareCommand}" VerticalAlignment="Center"><TextBlock Text="Remove" FontSize="13" /></Button>
                </StackPanel>
                <StackPanel Spacing="8" Margin="0,8,0,0" IsVisible="{Binding ConfirmingRemove}">
                  <TextBlock Text="{Binding RemoveQuestion}" FontSize="12" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" MaxWidth="480" HorizontalAlignment="Left" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="pill" Command="{Binding KeepSpareCommand}"><TextBlock Text="Keep" FontSize="13" /></Button>
                    <Button Classes="pill primary" Command="{Binding RemoveSpareCommand}"><TextBlock Text="Remove" FontSize="13" FontWeight="Medium" /></Button>
                  </StackPanel>
                </StackPanel>
                <TextBlock Classes="section" Text="Language" />
                <Border Classes="field" Width="240" HorizontalAlignment="Left"><TextBox Classes="bare" Text="{Binding Language}" PlaceholderText="Found for each lecture (or en, es, fr…)" FontSize="13" /></Border>
                <CheckBox IsVisible="{Binding CanRecordComputerAudio}" IsChecked="{Binding ComputerAudio}" Margin="0,16,0,0">
                  <TextBlock Text="Also record what this computer plays (a lecture on Zoom or Teams)" FontSize="13" />
                </CheckBox>
                <CheckBox IsChecked="{Binding Speakers}" Margin="0,16,0,0">
                  <TextBlock Text="Tell speakers apart in the transcript" FontSize="13" />
                </CheckBox>
                <TextBlock Classes="say" Text="{Binding SpeakersLine}" TextWrapping="Wrap" MaxWidth="480" HorizontalAlignment="Left" />
                <TextBlock Classes="section" Text="Keep recordings" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Classes="field" Width="64"><TextBox Classes="bare" Text="{Binding KeepAudio}" FontSize="13" /></Border>
                  <TextBlock Text="days after they're filed (0 keeps them). The notes and transcript stay." FontSize="12" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>

              <!-- Your library: its own settings, through its API (Library, Classes, Notes and sorting, Folders). Every
                   row is one grid: its words on the left, its control in the right column on the row's centre line. -->
              <StackPanel IsVisible="{Binding OnLibraryPage}" Spacing="8">
                <TextBlock Classes="h" Text="{Binding LibraryPageTitle}" />
                <TextBlock Classes="body" Text="{Binding LibraryPageLine}" />
                <TextBlock Classes="say" Text="Asking your library…" IsVisible="{Binding Lib.IsLoading}" />
                <Border Classes="group" IsVisible="{Binding Lib.ShowProblem}">
                  <Border Classes="row">
                    <Grid ColumnDefinitions="Auto,12,*,12,Auto">
                      <c:Icon Glyph="info" Size="18" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Classes="row-title" Text="{Binding Lib.Problem}" TextWrapping="Wrap" />
                      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="pill" Command="{Binding Lib.LoadCommand}" IsVisible="{Binding Lib.CanRetry}"><TextBlock Text="Try again" FontSize="13" /></Button>
                        <Button Classes="pill" Command="{Binding Lib.OpenLibraryPageCommand}" IsVisible="{Binding Lib.CanOpenPage}"><TextBlock Text="Open its page" FontSize="13" /></Button>
                        <Button Classes="pill" Command="{Binding GoCommand}" CommandParameter="Connection" IsVisible="{Binding Lib.IsNoLibrary}"><TextBlock Text="Connection" FontSize="13" /></Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </Border>
                <TextBlock Classes="say" Text="{Binding Lib.Say}" IsVisible="{Binding Lib.Say, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <StackPanel IsVisible="{Binding Lib.IsReady}" Spacing="8">
                  <!-- Library -->
                  <StackPanel IsVisible="{Binding OnLibrary}" Spacing="8">
                    <TextBlock Classes="section gap" Text="{Binding Lib.NameSection}" />
                    <Border Classes="group">
                      <StackPanel>
                        <Border Classes="row">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                              <TextBlock Classes="row-title" Text="Name" />
                              <TextBlock Classes="row-sub" Text="{Binding Lib.NameSub}" />
                            </StackPanel>
                            <Border Grid.Column="1" Classes="field act" Width="220">
                              <TextBox Name="LibraryName" Classes="bare" Text="{Binding Lib.Name}" FontSize="13" VerticalAlignment="Center" />
                            </Border>
                          </Grid>
                        </Border>
                        <Border Classes="rowsep" IsVisible="{Binding Lib.ShowReach}" />
                        <Border Classes="row" IsVisible="{Binding Lib.ShowReach}">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                              <TextBlock Classes="row-title" Text="Password" />
                              <TextBlock Classes="row-sub" Text="{Binding Lib.PasswordLine}" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="pill act" Command="{Binding Lib.ChangePasswordCommand}" IsVisible="{Binding !Lib.ChangingPassword}"><TextBlock Text="Change…" FontSize="13" /></Button>
                            <StackPanel Grid.Column="1" Classes="act" Orientation="Horizontal" Spacing="8" IsVisible="{Binding Lib.ChangingPassword}">
                              <Border Classes="field" Width="180">
                                <TextBox Name="NewPassword" Classes="bare" Text="{Binding Lib.NewPassword}" PasswordChar="•" PlaceholderText="New password" FontSize="13" VerticalAlignment="Center" />
                              </Border>
                              <Button Classes="pill" Command="{Binding Lib.ChangePasswordCommand}"><TextBlock Text="Cancel" FontSize="13" /></Button>
                              <Button Classes="pill primary" Command="{Binding Lib.SavePasswordCommand}"><TextBlock Text="Save" FontSize="13" FontWeight="Medium" /></Button>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </StackPanel>
                    </Border>
                    <TextBlock Classes="say" Text="{Binding Lib.PasswordSay}" IsVisible="{Binding Lib.PasswordSay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <!-- A library on this computer: let laptops connect (a password, then the addresses below), or not -->
                    <StackPanel IsVisible="{Binding Lib.CanChangeLaptops}" Spacing="8">
                      <TextBlock Classes="section gap" Text="Laptops" />
                      <Border Classes="group">
                        <Border Classes="row">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                              <TextBlock Classes="row-title" Text="{Binding Lib.LaptopsTitle}" />
                              <TextBlock Classes="row-sub" Text="{Binding Lib.LaptopsSub}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="pill act" Command="{Binding Lib.AddLaptopCommand}" Margin="12,0,0,0" IsEnabled="{Binding !Lib.ChangingLaptops}">
                              <Button.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                  <Binding Path="Lib.OnlyThisComputer" />
                                  <Binding Path="!Lib.AddingLaptop" />
                                </MultiBinding>
                              </Button.IsVisible>
                              <TextBlock Text="Add a laptop…" FontSize="13" />
                            </Button>
                            <StackPanel Grid.Column="1" Classes="act" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" IsVisible="{Binding Lib.AddingLaptop}">
                              <Border Classes="field" Width="180">
                                <TextBox Name="LaptopPassword" Classes="bare" Text="{Binding Lib.LaptopPassword}" PasswordChar="•" PlaceholderText="A password for your laptop" FontSize="13" VerticalAlignment="Center" />
                              </Border>
                              <Button Classes="pill" Command="{Binding Lib.AddLaptopCommand}"><TextBlock Text="Cancel" FontSize="13" /></Button>
                              <Button Classes="pill primary" Command="{Binding Lib.TurnOnLaptopsCommand}" IsEnabled="{Binding !Lib.ChangingLaptops}"><TextBlock Text="Turn on" FontSize="13" FontWeight="Medium" /></Button>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="pill act" Command="{Binding Lib.TurnOffLaptopsCommand}" IsVisible="{Binding Lib.LaptopsCanConnect}" IsEnabled="{Binding !Lib.ChangingLaptops}" Margin="12,0,0,0">
                              <TextBlock Text="Turn off" FontSize="13" />
                            </Button>
                          </Grid>
                        </Border>
                      </Border>
                      <TextBlock Classes="say" Text="{Binding Lib.LaptopSay}" IsVisible="{Binding Lib.LaptopSay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <TextBlock Classes="section gap" Text="How your laptop reaches it" IsVisible="{Binding Lib.ShowReach}" />
                    <Border Classes="group" IsVisible="{Binding Lib.ShowReach}">
                      <ItemsControl ItemsSource="{Binding Lib.Addresses}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <StackPanel>
                            <Border Classes="rowsep itemsep" />
                            <Border Classes="row">
                              <Grid ColumnDefinitions="*,Auto">
                                <SelectableTextBlock Classes="row-title" Text="{Binding}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="pill act" Command="{Binding $parent[UserControl].((s:SettingsModel)DataContext).Lib.CopyAddressCommand}" CommandParameter="{Binding}">
                                  <TextBlock Text="Copy" FontSize="13" />
                                </Button>
                              </Grid>
                            </Border>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                    <TextBlock Classes="say" Text="{Binding Lib.ReachLine}" IsVisible="{Binding Lib.ShowReach}" />

                    <TextBlock Classes="section gap" Text="On its computer" />
                    <Border Classes="group">
                      <StackPanel>
                        <Border Classes="row">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                              <TextBlock Classes="row-title" Text="{Binding Lib.StartAtLoginTitle}" />
                              <TextBlock Classes="row-sub" Text="{Binding Lib.StartAtLoginSub}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Classes="switch act" IsChecked="{Binding Lib.StartAtLoginOn}" IsEnabled="{Binding Lib.CanStartAtLogin}" Margin="12,0,0,0" />
                          </Grid>
                        </Border>
                        <Border Classes="rowsep" />
                        <Border Classes="row">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                              <TextBlock Classes="row-title" Text="Notes folder" />
                              <TextBlock Classes="row-sub" Text="{Binding Lib.NotesFolder}" TextTrimming="PrefixCharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="pill act" Command="{Binding Lib.ShowNotesFolderCommand}" IsVisible="{Binding Lib.IsHere}" Margin="12,0,0,0">
                              <TextBlock Text="{Binding Lib.RevealLabel}" FontSize="13" />
                            </Button>
                          </Grid>
                        </Border>
                      </StackPanel>
                    </Border>
                    <!-- A laptop: keeping everything on this computer instead (Connection → This computer) -->
                    <Border Classes="group" IsVisible="{Binding IsLaptopRole}">
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="row-title" Text="Use just this computer" />
                            <TextBlock Classes="row-sub" Text="{Binding JustThisComputerLine}" TextWrapping="Wrap" />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="pill act" Command="{Binding GoJustThisComputerCommand}" Margin="12,0,0,0">
                            <TextBlock Text="Use just this computer…" FontSize="13" />
                          </Button>
                        </Grid>
                      </Border>
                    </Border>

                    <TextBlock Classes="section gap" Text="Updates" />
                    <Border Classes="group">
                      <StackPanel>
                        <Border Classes="row">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="row-title" Text="{Binding Lib.UpdateLine}" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Classes="pill primary act" Command="{Binding Lib.UpdateNowCommand}" IsVisible="{Binding Lib.CanUpdateNow}" Margin="12,0,0,0">
                              <TextBlock Text="Update now" FontSize="13" FontWeight="Medium" />
                            </Button>
                          </Grid>
                        </Border>
                        <Border Classes="rowsep" />
                        <Border Classes="row">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                              <TextBlock Classes="row-title" Text="Update automatically" />
                              <TextBlock Classes="row-sub" Text="{Binding Lib.AutoUpdateSub}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Classes="switch act" IsChecked="{Binding Lib.AutoUpdate}" />
                          </Grid>
                        </Border>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <!-- Classes: each its own card, the name, other names and what it covers lined up in columns -->
                  <StackPanel IsVisible="{Binding OnClasses}" Spacing="8">
                    <!-- Use Canvas course names: classes named from course codes take their courses' names, after a preview -->
                    <Border Classes="group" Margin="0,8,0,0" IsVisible="{Binding Lib.HasCourseNames}">
                      <StackPanel>
                        <Border Classes="row">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                              <TextBlock Classes="row-title" Text="Use Canvas course names" />
                              <TextBlock Classes="row-sub" Text="{Binding Lib.CourseNamesSub}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="pill act" Command="{Binding Lib.AskUseCourseNamesCommand}" IsEnabled="{Binding Lib.CanUseCourseNames}" IsVisible="{Binding !Lib.ConfirmingCourseNames}"><TextBlock Text="Preview…" FontSize="13" /></Button>
                            <StackPanel Grid.Column="1" Classes="act" Orientation="Horizontal" Spacing="8" IsVisible="{Binding Lib.ConfirmingCourseNames}">
                              <Button Classes="pill" Command="{Binding Lib.CancelUseCourseNamesCommand}"><TextBlock Text="Cancel" FontSize="13" /></Button>
                              <Button Classes="pill primary" Command="{Binding Lib.UseCourseNamesCommand}" IsEnabled="{Binding Lib.CanUseCourseNames}"><TextBlock Text="{Binding Lib.RenameLabel}" FontSize="13" FontWeight="Medium" /></Button>
                            </StackPanel>
                          </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Lib.CourseNames}" IsVisible="{Binding Lib.ConfirmingCourseNames}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CourseNameRow">
                              <StackPanel>
                                <Border Classes="rowsep" />
                                <Border Classes="row">
                                  <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                      <TextBlock Classes="row-title" Text="{Binding To}" TextTrimming="CharacterEllipsis" />
                                      <TextBlock Classes="row-sub" Text="{Binding Now}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Classes="row-sub act" Text="{Binding Meta}" VerticalAlignment="Center" />
                                  </Grid>
                                </Border>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Lib.Classes}" Margin="0,8,0,0">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LibraryClassRow">
                          <Border Classes="group" Margin="0" Padding="16,12">
                            <Grid ColumnDefinitions="Auto,12,3*,8,2*,8,Auto" RowDefinitions="Auto,6,Auto,6,Auto">
                              <Ellipse Width="8" Height="8" Fill="{Binding Dot}" VerticalAlignment="Center" />
                              <Border Grid.Column="2" Classes="field"><TextBox Classes="bare" Text="{Binding Name}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" LostFocus="OnClassLostFocus" /></Border>
                              <Border Grid.Column="4" Classes="field"><TextBox Classes="bare" Text="{Binding Aliases}" PlaceholderText="Other names, like cs101" FontSize="13" VerticalAlignment="Center" LostFocus="OnClassLostFocus" /></Border>
                              <Button Grid.Column="6" Theme="{StaticResource Surface}" Width="30" Height="30" CornerRadius="{DynamicResource RadiusControl}" HorizontalContentAlignment="Center"
                                      Command="{Binding $parent[UserControl].((s:SettingsModel)DataContext).Lib.RemoveClassCommand}" CommandParameter="{Binding}" ToolTip.Tip="Remove the class (its lectures stay)">
                                <c:Icon Glyph="close" Size="15" Foreground="{DynamicResource Fg3}" />
                              </Button>
                              <Border Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Classes="field">
                                <TextBox Classes="bare" Text="{Binding Description}" PlaceholderText="What it covers (it helps the AI sort)" FontSize="13" VerticalAlignment="Center" LostFocus="OnClassLostFocus" />
                              </Border>
                              <TextBlock Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="3" Classes="row-sub" Text="{Binding Meta}" TextTrimming="PrefixCharacterEllipsis" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Classes="group" Margin="0" Padding="16,12">
                      <Grid ColumnDefinitions="Auto,12,3*,8,2*,8,Auto">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Fill2}" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Classes="field"><TextBox Name="NewLibraryClass" Classes="bare" Text="{Binding Lib.NewClass}" PlaceholderText="A new class" FontSize="13" VerticalAlignment="Center" /></Border>
                        <TextBlock Grid.Column="4" Classes="row-sub" Text="Its other names and what it covers come next." VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Column="6" Classes="pill" Command="{Binding Lib.AddClassCommand}" VerticalAlignment="Center"><TextBlock Text="Add" FontSize="13" /></Button>
                      </Grid>
                    </Border>
                    <TextBlock Classes="say" Text="Renaming or removing a class keeps its lectures where they are." />
                  </StackPanel>

                  <!-- Notes and sorting -->
                  <StackPanel IsVisible="{Binding OnNotes}" Spacing="8">
                    <TextBlock Classes="section gap" Text="Notes" />
                    <Border Classes="group">
                      <StackPanel>
                        <Border Classes="row">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                              <TextBlock Classes="row-title" Text="Write study notes from each lecture" />
                              <TextBlock Classes="row-sub" Text="{Binding Lib.WriteNotesSub}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Classes="switch act" IsChecked="{Binding Lib.WriteNotes}" />
                          </Grid>
                        </Border>
                        <Border Classes="rowsep" />
                        <Border Classes="row">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                              <TextBlock Classes="row-title" Text="Sort lectures into classes with AI" />
                              <TextBlock Classes="row-sub" Text="Otherwise only the class it was recorded for, or its title, sorts it" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Classes="switch act" IsChecked="{Binding Lib.SortWithAi}" />
                          </Grid>
                        </Border>
                        <Border Classes="rowsep" IsVisible="{Binding Lib.SortWithAi}" />
                        <Border Classes="row" IsVisible="{Binding Lib.SortWithAi}">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                              <TextBlock Classes="row-title" Text="Sorts them with" />
                              <TextBlock Classes="row-sub" Text="The AI that reads a lecture to pick its class" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="select act" MaxWidth="260">
                              <Grid ColumnDefinitions="*,6,Auto">
                                <TextBlock Classes="plain" Text="{Binding Lib.SortEngineLabel}" VerticalAlignment="Center" />
                                <c:Icon Grid.Column="2" Glyph="unfold_more" Size="15" Foreground="{DynamicResource Fg2}" />
                              </Grid>
                              <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterTheme="{StaticResource SettingsMenu}" ItemsSource="{Binding Lib.SortEngineChoices}" ItemContainerTheme="{StaticResource PickItem}" />
                              </Button.Flyout>
                            </Button>
                          </Grid>
                        </Border>
                        <Border Classes="rowsep" />
                        <Border Classes="row">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                              <TextBlock Classes="row-title" Text="Files a lecture when the AI is at least" />
                              <TextBlock Classes="row-sub" Text="Less sure, and the lecture waits in Unsorted for you" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="select act" MinWidth="90">
                              <Grid ColumnDefinitions="*,6,Auto">
                                <TextBlock Text="{Binding Lib.ConfidenceLabel}" VerticalAlignment="Center" />
                                <c:Icon Grid.Column="2" Glyph="unfold_more" Size="15" Foreground="{DynamicResource Fg2}" />
                              </Grid>
                              <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterTheme="{StaticResource SettingsMenu}" ItemsSource="{Binding Lib.ConfidenceChoices}" ItemContainerTheme="{StaticResource PickItem}" />
                              </Button.Flyout>
                            </Button>
                          </Grid>
                        </Border>
                      </StackPanel>
                    </Border>

                    <TextBlock Classes="section gap" Text="Local models" />
                    <Border Classes="group">
                      <StackPanel>
                        <Border Classes="row">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                              <TextBlock Classes="row-title" Text="Writes the notes" />
                              <TextBlock Classes="row-sub" Text="When Ollama writes them" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="select act" MaxWidth="260">
                              <Grid ColumnDefinitions="*,6,Auto">
                                <TextBlock Classes="plain" Text="{Binding Lib.SummaryLabel}" VerticalAlignment="Center" />
                                <c:Icon Grid.Column="2" Glyph="unfold_more" Size="15" Foreground="{DynamicResource Fg2}" />
                              </Grid>
                              <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterTheme="{StaticResource SettingsMenu}" ItemsSource="{Binding Lib.SummaryChoices}" ItemContainerTheme="{StaticResource PickItem}" />
                              </Button.Flyout>
                            </Button>
                          </Grid>
                        </Border>
                        <Border Classes="rowsep" />
                        <Border Classes="row">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                              <TextBlock Classes="row-title" Text="Sorts lectures into classes" />
                              <TextBlock Classes="row-sub" Text="When Ollama sorts them" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="select act" MaxWidth="260">
                              <Grid ColumnDefinitions="*,6,Auto">
                                <TextBlock Classes="plain" Text="{Binding Lib.SortLabel}" VerticalAlignment="Center" />
                                <c:Icon Grid.Column="2" Glyph="unfold_more" Size="15" Foreground="{DynamicResource Fg2}" />
                              </Grid>
                              <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterTheme="{StaticResource SettingsMenu}" ItemsSource="{Binding Lib.SortChoices}" ItemContainerTheme="{StaticResource PickItem}" />
                              </Button.Flyout>
                            </Button>
                          </Grid>
                        </Border>
                      </StackPanel>
                    </Border>
                    <TextBlock Classes="say" Text="{Binding Lib.OllamaLine}" />

                    <TextBlock Classes="section gap" Text="Open in a terminal" IsVisible="{Binding Lib.HasTerminals}" />
                    <Border Classes="group" IsVisible="{Binding Lib.HasTerminals}">
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="row-title" Text="Opens a class with Claude Code, Codex or Gemini in" />
                            <TextBlock Classes="row-sub" Text="On the library's computer" />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="select act">
                            <Grid ColumnDefinitions="*,6,Auto">
                              <TextBlock Text="{Binding Lib.TerminalLabel}" VerticalAlignment="Center" />
                              <c:Icon Grid.Column="2" Glyph="unfold_more" Size="15" Foreground="{DynamicResource Fg2}" />
                            </Grid>
                            <Button.Flyout>
                              <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterTheme="{StaticResource SettingsMenu}" ItemsSource="{Binding Lib.TerminalChoices}" ItemContainerTheme="{StaticResource PickItem}" />
                            </Button.Flyout>
                          </Button>
                        </Grid>
                      </Border>
                    </Border>

                    <TextBlock Classes="section gap" Text="Rewrite every summary" />
                    <Border Classes="group">
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="row-title" Text="{Binding Lib.RewriteTitle}" />
                            <TextBlock Classes="row-sub" Text="{Binding Lib.RewriteSub}" />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="pill act" Command="{Binding Lib.AskRewriteAllCommand}" IsVisible="{Binding !Lib.ConfirmingRewrite}"><TextBlock Text="Rewrite all…" FontSize="13" /></Button>
                          <StackPanel Grid.Column="1" Classes="act" Orientation="Horizontal" Spacing="8" IsVisible="{Binding Lib.ConfirmingRewrite}">
                            <Button Classes="pill" Command="{Binding Lib.CancelRewriteAllCommand}"><TextBlock Text="Cancel" FontSize="13" /></Button>
                            <Button Classes="pill primary" Command="{Binding Lib.RewriteAllCommand}"><TextBlock Text="Rewrite them all" FontSize="13" FontWeight="Medium" /></Button>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </Border>
                    <TextBlock Classes="say" Text="Useful after switching models. It can take a while." />
                  </StackPanel>

                  <!-- Folders it may read -->
                  <StackPanel IsVisible="{Binding OnFolders}" Spacing="8">
                    <Border Classes="group" Margin="0,8,0,0">
                      <StackPanel>
                        <Border Classes="row" IsVisible="{Binding Lib.NoFolders}">
                          <TextBlock Classes="row-title" Text="No folders yet." Foreground="{DynamicResource Fg2}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding Lib.Folders}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReadFolderRow">
                              <StackPanel>
                              <Border Classes="rowsep itemsep" />
                              <Border Classes="row">
                                <Grid ColumnDefinitions="Auto,12,*,16,Auto,8,Auto,16,Auto,8,Auto,8,Auto">
                                  <c:Icon Glyph="folder" Size="18" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
                                  <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Classes="row-title" Text="{Binding Name}" />
                                    <TextBlock Classes="row-sub" Text="{Binding Path}" TextTrimming="PrefixCharacterEllipsis" />
                                  </StackPanel>
                                  <TextBlock Grid.Column="4" Classes="row-sub" Text="AI reads" VerticalAlignment="Center" />
                                  <ToggleButton Grid.Column="6" Classes="switch" IsChecked="{Binding Ai}" VerticalAlignment="Center" />
                                  <TextBlock Grid.Column="8" Classes="row-sub" Text="Private" VerticalAlignment="Center" />
                                  <ToggleButton Grid.Column="10" Classes="switch" IsChecked="{Binding Private}" VerticalAlignment="Center" />
                                  <Button Grid.Column="12" Theme="{StaticResource Surface}" Width="30" Height="30" CornerRadius="{DynamicResource RadiusControl}" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                                          Command="{Binding $parent[UserControl].((s:SettingsModel)DataContext).Lib.RemoveFolderCommand}" CommandParameter="{Binding}" ToolTip.Tip="Stop reading this folder">
                                    <c:Icon Glyph="close" Size="15" Foreground="{DynamicResource Fg3}" />
                                  </Button>
                                </Grid>
                              </Border>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                    <Border Classes="group" Margin="0">
                      <Border Classes="row">
                        <Grid ColumnDefinitions="Auto,12,*,12,Auto">
                          <c:Icon Glyph="add" Size="18" Foreground="{DynamicResource Fg3}" VerticalAlignment="Center" />
                          <Border Grid.Column="2" Classes="field"><TextBox Name="NewFolder" Classes="bare" Text="{Binding Lib.NewFolder}" PlaceholderText="A folder on the library's computer, like ~/Documents/School" FontSize="13" VerticalAlignment="Center" /></Border>
                          <Button Grid.Column="4" Classes="pill" Command="{Binding Lib.AddFolderCommand}" VerticalAlignment="Center"><TextBlock Text="Add" FontSize="13" /></Button>
                        </Grid>
                      </Border>
                    </Border>
                    <TextBlock Classes="say" Text="{Binding Lib.FilesLine}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>

              <!-- Canvas: its own pane (design 06), in the page's margins like every other section -->
              <Panel IsVisible="{Binding OnCanvas}">
                <Panel IsVisible="{Binding IsMac}">
                  <v:MacCanvasSettings DataContext="{Binding Canvas}" />
                </Panel>
                <Panel IsVisible="{Binding IsWin}">
                  <v:WinCanvasSettings DataContext="{Binding Canvas}" />
                </Panel>
              </Panel>

              <!-- Phone: adding one, and the phones already added -->
              <Panel IsVisible="{Binding OnPhone}">
                <v:MacPhones DataContext="{Binding Phones}" IsVisible="{Binding $parent[UserControl].((s:SettingsModel)DataContext).IsMac}" />
                <v:WinPhones DataContext="{Binding Phones}" IsVisible="{Binding $parent[UserControl].((s:SettingsModel)DataContext).IsWin}" />
              </Panel>

              <!-- Calendars: pasting a feed, Connect buttons for kinds that offer one, and the sources already added -->
              <Panel IsVisible="{Binding OnCalendars}">
                <v:MacCalendarSettings DataContext="{Binding Calendars}" IsVisible="{Binding $parent[UserControl].((s:SettingsModel)DataContext).IsMac}" />
                <v:WinCalendarSettings DataContext="{Binding Calendars}" IsVisible="{Binding $parent[UserControl].((s:SettingsModel)DataContext).IsWin}" />
              </Panel>
            </StackPanel>
          </ScrollViewer>

          <!-- AI engines (design 13), with whatever's wrong with an engine above them (design 18), and AI tool
               access (design 14): these panes pad and scroll themselves. -->
          <DockPanel IsVisible="{Binding OnAi}">
            <Panel DockPanel.Dock="Top" IsVisible="{Binding AiProblems.Problems.Count, Converter={x:Static c:Converters.Some}}">
              <v:MacAiProblems Classes="problems" DataContext="{Binding AiProblems}" IsVisible="{Binding $parent[UserControl].((s:SettingsModel)DataContext).IsMac}" />
              <v:WinAiProblems Classes="problems" DataContext="{Binding AiProblems}" IsVisible="{Binding $parent[UserControl].((s:SettingsModel)DataContext).IsWin}" />
            </Panel>
            <Panel>
              <v:MacAiEngines DataContext="{Binding Engines}" IsVisible="{Binding $parent[UserControl].((s:SettingsModel)DataContext).IsMac}" />
              <v:WinAiEngines DataContext="{Binding Engines}" IsVisible="{Binding $parent[UserControl].((s:SettingsModel)DataContext).IsWin}" />
            </Panel>
          </DockPanel>
          <Panel IsVisible="{Binding OnAccess}">
            <v:MacAiAccess DataContext="{Binding Access}" IsVisible="{Binding $parent[UserControl].((s:SettingsModel)DataContext).IsMac}" />
            <v:WinAiAccess DataContext="{Binding Access}" IsVisible="{Binding $parent[UserControl].((s:SettingsModel)DataContext).IsWin}" />
          </Panel>
          </Panel>
        </Border>
      </Grid>
    </DockPanel>
  </Border>
</UserControl>
