<!-- Settings, in the library window's look (as setup is, SetupStyles), the same in both looks: the sections straight on
     the window's canvas as the library's sidebar is, the open one its white chip; the page one white sheet with a
     hairline round it, a big bold title and a grey sentence under it, a heading per part in the library's weight, and
     the settings themselves on white panels with hairlines between their rows. Its buttons are Styles.axaml's own
     (btn sm, btn sm ink for a part's one main action, text-link), its switches, ticks, radios and choices ink and
     greys: no accent in Settings, so a colour theme no longer tints Settings' own controls (Skin.NoAccent, set in the
     code-behind). The code-behind adds "mac" or "win" to the root for the little that still differs, the window's own
     frame. The classes:
       group   a white panel of rows, a hairline round it
       row     one line in a group: title + sub on the left, a control on the right
       row-title / row-sub   its two lines of text
       section a part's heading over a group ("Colour theme")
       btn sm  a button (Options, Add, Sign in…); "ink" for the part's one main action
       choice  a selectable panel (a model, when it's written down), ringed in ink when chosen
       select  a menu's button: the choice and a chevron in a hairline
       switch  grey off, ink on
     The panes it hosts (Your AI, AI apps, Canvas) are drawn in it too: SettingsPaneStyles restyles their own classes
     under ".in-settings", the class this view carries. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:StudyStash.App.Services"
             xmlns:rich="using:StudyStash.Core.Rich"
             xmlns:app="using:StudyStash.App"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:v="using:StudyStash.App.Views"
             xmlns:vm="using:StudyStash.App.ViewModels"
             x:Class="StudyStash.App.Views.SettingsView"
             x:DataType="s:SettingsModel"
             Classes="in-settings"
             ClipToBounds="False">
  <UserControl.Styles>
    <StyleInclude Source="avares://StudyStash/Views/SettingsPaneStyles.axaml" />

    <!-- ===== The window ===== -->

    <!-- The window's canvas, with its own frame drawn only for a screenshot: a real window is already rounded, edged and
         shadowed by the system (macOS; Windows 11), so drawing both would double up. -->
    <Style Selector="Border#Chrome">
      <Setter Property="Background" Value="{DynamicResource Canvas}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector=".mac Border#Chrome.chrome">
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="BoxShadow" Value="{DynamicResource WindowShadow}" />
    </Style>
    <Style Selector=".win Border#Chrome.chrome">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BoxShadow" Value="{DynamicResource ShadowLg}" />
    </Style>

    <!-- The page: one white sheet, a hairline round it, no shadow (the library's pane); what's on it cut to its corners. -->
    <Style Selector="Border.sheet">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusPane}" />
      <Setter Property="BoxShadow" Value="{DynamicResource LineRing}" />
    </Style>
    <Style Selector="Border.sheet-clip">
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusPane}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="StackPanel.pagebody">
      <Setter Property="Margin" Value="40,30,40,40" />
    </Style>

    <!-- ===== The sections, on the canvas: the library's sidebar ===== -->

    <!-- Search, over them: a white field with a hairline round it, ringed in ink while the caret's in it (the ring drawn
         inside, so the words don't move). While it has words, the sidebar is what matches (a setting and the section
         it's in), then a row that asks the helper instead. -->
    <Style Selector="Border.search">
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BoxShadow" Value="{DynamicResource LineRing}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,0,6,0" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Border.search:focus-within">
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Padding" Value="8.5,0,4.5,0" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Button.hit">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="TextBlock.hit-title">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.hit-where">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource InkSubtle}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- A section: a row of the library's sidebar, the open one the white chip with bold words. (Its hairline is a
         border inside it: a ring outside one would be cut off by the list.) -->
    <Style Selector="Button.nav">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="Button.nav.on">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="c|Icon.navicon">
      <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.nav:pointerover c|Icon.navicon, Button.nav.on c|Icon.navicon">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <!-- The sidebar's groups ("Your library"): its group labels, a little room over each. -->
    <Style Selector="TextBlock.navgroup">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource InkSubtle}" />
      <Setter Property="Margin" Value="10,10,0,4" />
    </Style>
    <Style Selector="TextBlock.navgroup.second">
      <Setter Property="Margin" Value="10,16,0,4" />
    </Style>

    <!-- ===== The page's words ===== -->

    <!-- The title: setup's (the library's page title, a little smaller for the narrower page). -->
    <Style Selector="TextBlock.h">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="ExtraBold" />
      <Setter Property="LineHeight" Value="36" />
      <Setter Property="LetterSpacing" Value="-0.6" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Grey words on the page, and (lede) the sentence under the title, the library's. -->
    <Style Selector="TextBlock.body">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="LineHeight" Value="21" />
      <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="MaxWidth" Value="560" />
    </Style>
    <Style Selector="TextBlock.body.lede">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="LineHeight" Value="24" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <!-- A quieter line under a part: what it does, what just happened. -->
    <Style Selector="TextBlock.say">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="19" />
      <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="MaxWidth" Value="560" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- A part's heading: the library's h2 ("Up next"), room over it to start a new part. -->
    <Style Selector="Grid.section">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="ExtraBold" />
      <Setter Property="LineHeight" Value="24" />
      <Setter Property="LetterSpacing" Value="-0.17" />
      <Setter Property="Margin" Value="0,16,0,0" />
    </Style>
    <!-- A list's rows in one group: a hairline above every row but the first. -->
    <Style Selector="Border.itemsep">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ContentPresenter:nth-child(n+2) Border.itemsep">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- ===== Groups and rows ===== -->

    <!-- A group of rows: a white panel, its hairline a border inside it (a ring outside would be cut off where a group
         clips its rows' hover to its corners). -->
    <Style Selector="Border.group">
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="58" />
      <Setter Property="Padding" Value="16,10" />
    </Style>
    <Style Selector="TextBlock.row-title">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LineHeight" Value="20" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.row-sub">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="18" />
      <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
    </Style>
    <!-- A hairline between two rows of a group, from the rows' text edge to the right. -->
    <Style Selector="Border.rowsep">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Line}" />
      <Setter Property="Margin" Value="16,0,0,0" />
    </Style>
    <!-- A row's action column: whatever sits there (a switch, a select, a button) lines up at the right edge and on
         the row's centre line. -->
    <Style Selector="Border.row > Grid > :is(Control).act">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="TextBlock.plain">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ===== Controls ===== -->

    <!-- Buttons are Styles.axaml's pills (btn sm, btn sm ink); here they sit at their own width, words centred. -->
    <Style Selector="Button.btn">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.btn c|Icon">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.text-link.small">
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- A menu's button: the choice in ink and a chevron, in a hairline, the control's corners (the library's picker). -->
    <Style Selector="Button.select">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="Padding" Value="12,0,8,0" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="Button.select:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource InkSubtle}" />
    </Style>
    <Style Selector="Button.select TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- "Recommended" beside the model for this computer: setup's tag, grey words on the sunken grey. -->
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
    </Style>

    <!-- A selectable panel (a model, when it's written down): setup's choice, white with a hairline, ringed in ink when
         chosen (the ring drawn inside it, the padding giving way so nothing in it moves). -->
    <Style Selector="Border.choice">
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="15,11" />
    </Style>
    <Style Selector="Button.card:pointerover Border.choice, Button.card:pressed Border.choice">
      <Setter Property="BorderBrush" Value="{DynamicResource InkSubtle}" />
    </Style>
    <Style Selector="Border.choice.on, Button.card:pointerover Border.choice.on">
      <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="TextBlock.choice-title">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LineHeight" Value="20" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.choice-about">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="18" />
      <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- A card's focus ring follows its corners, 4 px out. -->
    <Style Selector="Border.cardring">
      <Setter Property="CornerRadius" Value="16" />
    </Style>

    <!-- Appearance's mode: the three in one sunken track, the chosen one the white chip with a hairline. -->
    <Style Selector="Border.seg">
      <Setter Property="Padding" Value="3" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
    </Style>
    <Style Selector="Button.seg-item">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
    </Style>
    <Style Selector="Button.seg-item:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="Button.seg-item.on">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    </Style>

    <!-- A text field: white, a hairline round it, the control's corners; ringed in ink while the caret's in it (the
         ring drawn inside, so the words don't move). -->
    <Style Selector="Border.field">
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="Border.field:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Padding" Value="9.5,0" />
    </Style>
    <Style Selector="Border.field TextBox.bare">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Border.field.bad">
      <Setter Property="BorderBrush" Value="{DynamicResource Warn}" />
    </Style>

    <!-- How far along: a grey track, filled in ink. -->
    <Style Selector="Border.track">
      <Setter Property="Height" Value="6" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="{DynamicResource Line}" />
      <Setter Property="Width" Value="480" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.track > Border">
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="{DynamicResource Ink}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- The colour themes: each a round swatch, a gap of the page's white, and an ink rim round the chosen one. Hovered
         or pressed, the rim shows in grey; focused from the keyboard, a focus ring goes round the swatch. Never a box
         round the whole cell. -->
    <Style Selector="Border.swatchring">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.swatch:pointerover Border.swatchring, Button.swatch:pressed Border.swatchring">
      <Setter Property="Background" Value="{DynamicResource InkSubtle}" />
    </Style>
    <Style Selector="Border.swatchring.on, Button.swatch:pointerover Border.swatchring.on">
      <Setter Property="Background" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="TextBlock.swatchname">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- An engine's problems sit above the Your AI pane, lined up with its own margins. -->
    <Style Selector="UserControl.problems">
      <Setter Property="Margin" Value="40,30,40,-14" />
      <Setter Property="MaxWidth" Value="640" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- A setting search or the helper went to: it flashes once on its page. -->
    <Style Selector="Panel.spot">
      <Setter Property="Background" Value="{DynamicResource Hl}" />
    </Style>
    <Style Selector="TextBlock.spot">
      <Setter Property="Background" Value="{DynamicResource Hl}" />
    </Style>

    <!-- Ask your AI: the student's words on the sunken grey at the right (setup's chat), the AI's plain on the left with
         what it did under them as small chips; the field is the library's Ask bar without its float. -->
    <Style Selector="Border.bubble">
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="MaxWidth" Value="420" />
      <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    </Style>
    <!-- Not "ask": that name is the Ask bar's (Styles.axaml), whose fixed height and floating shadow it would take. -->
    <Style Selector="Border.settings-ask">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
      <Setter Property="Padding" Value="16,6,7,6" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.settings-ask:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="Border.settings-ask TextBox.bare">
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="DockPanel.assistant">
      <Setter Property="Margin" Value="40,30,40,24" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <!-- A select's menu: one plain, neutral panel, like the menus elsewhere in the app. -->
    <ControlTheme x:Key="SettingsMenu" TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource {x:Type MenuFlyoutPresenter}}">
      <Setter Property="Background" Value="{DynamicResource PopupBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PopupStroke}" />
      <Setter Property="BorderThickness" Value="{DynamicResource PopupStrokeWidth}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusMenu}" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="MinWidth" Value="180" />
    </ControlTheme>
    <DataTemplate x:Key="NavRow" x:DataType="s:NavItem">
      <Button AutomationProperties.Name="{Binding Label}" Classes="nav" Classes.on="{Binding On}" Command="{Binding $parent[UserControl].((s:SettingsModel)DataContext).GoCommand}" CommandParameter="{Binding Id}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <c:Icon Classes="navicon" Glyph="{Binding Glyph}" Size="17" />
          <TextBlock Classes="navlabel" Text="{Binding Label}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </DataTemplate>
    <!-- A select's item: the menu's own item, bound to its choice (a MenuItem inside an item template would sit in the
         real item's header, and picking it did nothing). -->
    <ControlTheme x:Key="PickItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:SettingChoice">
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Header" Value="{Binding Label}" />
      <Setter Property="Command" Value="{Binding Pick}" />
    </ControlTheme>
  </UserControl.Resources>

  <Border Name="Chrome">
    <DockPanel>
      <!-- The title bar: drag the window by it; the system's window buttons sit in it. -->
      <c:WindowHeader Name="Header" DockPanel.Dock="Top" CanResize="False" />

      <Grid Name="Cols" ColumnDefinitions="228,*" Margin="8,0,8,8">
        <!-- The sections: straight on the canvas, as the library's sidebar is -->
        <ScrollViewer Name="Side" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="2" Margin="6,2,10,8">
            <Border Classes="search">
              <Grid ColumnDefinitions="Auto,6,*,Auto" VerticalAlignment="Center">
                <c:Icon Glyph="search" Size="16" Foreground="{DynamicResource InkSubtle}" VerticalAlignment="Center" />
                <TextBox Name="Search" Grid.Column="2" Classes="bare" Text="{Binding SearchText}" PlaceholderText="Search settings" FontSize="14"
                         VerticalAlignment="Center" AutomationProperties.Name="Search settings">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding OpenFirstHitCommand}" />
                    <KeyBinding Gesture="Escape" Command="{Binding ClearSearchCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="3" Theme="{StaticResource Surface}" Padding="2" Command="{Binding ClearSearchCommand}" IsVisible="{Binding Searching}"
                        ToolTip.Tip="Clear" AutomationProperties.Name="Clear the search" VerticalAlignment="Center">
                  <c:Icon Glyph="close" Size="14" Foreground="{DynamicResource InkMuted}" />
                </Button>
              </Grid>
            </Border>

            <!-- What the search found -->
            <StackPanel Spacing="2" IsVisible="{Binding Searching}">
              <ItemsControl ItemsSource="{Binding SearchHits}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="s:SettingsHit">
                    <Button Classes="hit" AutomationProperties.Name="{Binding Title}" Command="{Binding $parent[UserControl].((s:SettingsModel)DataContext).OpenHitCommand}" CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="Auto,10,*">
                        <c:Icon Glyph="{Binding Glyph}" Size="17" Foreground="{DynamicResource InkMuted}" VerticalAlignment="Top" Margin="0,1,0,0" />
                        <StackPanel Grid.Column="2" Spacing="1">
                          <TextBlock Classes="hit-title" Text="{Binding Title}" />
                          <TextBlock Classes="hit-where" Text="{Binding Where}" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="hit-where" Text="Nothing in Settings matches." Margin="10,4,0,4" IsVisible="{Binding NoHits}" />
              <Button Name="AskSearch" Classes="hit" Command="{Binding AskAboutSearchCommand}" AutomationProperties.Name="Ask your AI instead" Margin="0,6,0,0">
                <Grid ColumnDefinitions="Auto,10,*">
                  <c:Icon Glyph="forum" Size="17" Foreground="{DynamicResource Ink}" VerticalAlignment="Top" Margin="0,1,0,0" />
                  <TextBlock Grid.Column="2" Classes="hit-title" Text="{Binding AskLine}" FontWeight="Bold" />
                </Grid>
              </Button>
            </StackPanel>

            <StackPanel Spacing="2" IsVisible="{Binding !Searching}">
            <ContentControl Content="{Binding AssistantNav}" ContentTemplate="{StaticResource NavRow}" Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding NavGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="s:NavGroup">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="navgroup" Classes.second="{Binding Later}" Text="{Binding Title}" />
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource NavRow}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Classes="sheet" />
        <Border Grid.Column="1" Classes="sheet-clip">
          <Panel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding OnPlainPage}">
            <StackPanel Classes="pagebody">
              <!-- General -->
              <StackPanel IsVisible="{Binding OnGeneral}" Spacing="8">
                <TextBlock Classes="h" Text="General" />
                <TextBlock Classes="body lede" Text="How Syft Notes starts and updates, its shortcuts, and setup." />
                <TextBlock Classes="section" Text="Startup" />
                <Border Classes="group">
                  <Border Classes="row">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Classes="row-title" Text="Open when you log in" />
                        <TextBlock Classes="row-sub" Text="{Binding StartAtLoginSub}" TextWrapping="Wrap" />
                      </StackPanel>
                      <ToggleButton AutomationProperties.Name="Open when you log in" Grid.Column="1" Classes="switch" IsChecked="{Binding StartAtLogin}" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </Border>
                <!-- A laptop's own updates: this computer's version and switch. The library's are under Advanced → Library;
                     on a computer that is the library there's only that one place. -->
                <StackPanel Spacing="8" IsVisible="{Binding IsLaptopRole}">
                  <TextBlock Classes="section" Text="Updates" />
                  <Border Classes="group">
                    <StackPanel>
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <c:PageText Classes="row-title" Text="{Binding UpdateHereLine}" TextWrapping="Wrap" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1" Classes="act" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                            <Button Classes="btn sm" Command="{Binding CheckUpdateHereCommand}" IsEnabled="{Binding !UpdateHereBusy}">
                              <TextBlock Text="Check now" />
                            </Button>
                            <Button Classes="btn sm ink" Command="{Binding UpdateHereNowCommand}" IsVisible="{Binding CanUpdateHere}" IsEnabled="{Binding !UpdateHereBusy}">
                              <TextBlock Text="Update now" />
                            </Button>
                          </StackPanel>
                        </Grid>
                      </Border>
                      <Border Classes="rowsep" />
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="row-title" Text="Update automatically" />
                            <TextBlock Classes="row-sub" Text="{Binding AutoUpdateHereSub}" TextWrapping="Wrap" />
                          </StackPanel>
                          <ToggleButton AutomationProperties.Name="Update automatically" Grid.Column="1" Classes="switch act" IsChecked="{Binding AutoUpdateHere}" Margin="12,0,0,0" />
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Border>
                </StackPanel>
                <!-- The library is this computer: its version and updates are the app's, here in General. -->
                <StackPanel Spacing="8" IsVisible="{Binding LibraryHere}">
                      <TextBlock Classes="section" Text="Updates" />
                      <Border Classes="group">
                        <StackPanel>
                          <Border Classes="row">
                            <Grid ColumnDefinitions="*,Auto">
                              <c:PageText Classes="row-title" Text="{Binding Lib.UpdateLine}" TextWrapping="Wrap" />
                              <Button Grid.Column="1" Classes="btn sm ink act" Command="{Binding Lib.UpdateNowCommand}" IsVisible="{Binding Lib.CanUpdateNow}" Margin="12,0,0,0">
                                <TextBlock Text="Update now" />
                              </Button>
                            </Grid>
                          </Border>
                          <Border Classes="rowsep" />
                          <Border Classes="row">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="row-title" Text="Update automatically" />
                                <TextBlock Classes="row-sub" Text="{Binding Lib.AutoUpdateSub}" TextWrapping="Wrap" />
                              </StackPanel>
                              <ToggleButton AutomationProperties.Name="Update automatically" Grid.Column="1" Classes="switch act" IsChecked="{Binding Lib.AutoUpdate}" />
                            </Grid>
                          </Border>
                        </StackPanel>
                      </Border>
                </StackPanel>
                <!-- The daily count: every role, beside the updates. -->
                <Border Classes="group">
                  <Border Classes="row">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="row-title" Text="Count this copy" />
                        <TextBlock Classes="row-sub" Text="{Binding CountThisCopySub}" TextWrapping="Wrap" />
                      </StackPanel>
                      <ToggleButton AutomationProperties.Name="Count this copy" Grid.Column="1" Classes="switch act" IsChecked="{Binding CountThisCopy}" Margin="12,0,0,0" />
                    </Grid>
                  </Border>
                </Border>
                <StackPanel Spacing="8">
                  <TextBlock Classes="section gap" Text="Shortcuts" />
                                  <CheckBox IsChecked="{Binding Shortcuts}" Margin="0,4,0,4">
                    <TextBlock Text="Search and Record work from any app" FontSize="14" />
                  </CheckBox>
                  <v:ShortcutsEditor DataContext="{Binding Keys}" />
                  <c:PageText Classes="say" Text="{Binding ShortcutsSay}" IsVisible="{Binding ShortcutsSay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
                </StackPanel>
                <!-- What it's for: the library's, so every computer and phone goes by it. School brings Canvas and classes. -->
                <StackPanel Spacing="8" IsVisible="{Binding Lib.IsReady}">
                  <TextBlock Classes="section gap" Text="What you use it for" />
                  <Border Classes="group">
                    <Border Classes="row">
                      <StackPanel Spacing="8">
                        <ItemsControl ItemsSource="{Binding Lib.Uses}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:UseChoice">
                              <CheckBox IsChecked="{Binding Ticked}" Margin="0,0,18,4" ToolTip.Tip="{Binding About}">
                                <TextBlock Text="{Binding Title}" FontSize="14" />
                              </CheckBox>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="row-sub" TextWrapping="Wrap" Text="School brings in Canvas and classes, and study notes. Without it you get folders, and notes written for meetings and talks: decisions, action items, open questions." />
                      </StackPanel>
                    </Border>
                  </Border>
                </StackPanel>
                <TextBlock Classes="section" Text="Setup" />
                <Border Classes="group">
                  <Border Classes="row">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Classes="row-title" Text="Run setup again" />
                        <TextBlock Classes="row-sub" Text="The first-run steps, with what's set up already kept" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Name="SetUpByHand" Classes="text-link small" Command="{Binding RunSetupByHandCommand}" VerticalAlignment="Center" Content="Set up by hand" />
                        <Button Classes="btn sm" Command="{Binding RunSetupAgainCommand}" VerticalAlignment="Center"><TextBlock Text="Run setup" /></Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </Border>
                <TextBlock Classes="section" Text="About" />
                <Border Classes="group">
                  <StackPanel>
                    <Border Classes="row">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                          <TextBlock Classes="row-title" Text="Credits" />
                          <TextBlock Classes="row-sub" Text="The speech models and illustration parts Syft Notes uses, and their licences" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <Button Classes="btn sm" Command="{Binding ToggleCreditsCommand}"><TextBlock Text="{Binding CreditsButton}" /></Button>
                          <Button Classes="btn sm" Command="{Binding QuitCommand}"><TextBlock Text="Quit Syft Notes" /></Button>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <StackPanel IsVisible="{Binding ShowCredits}">
                    <Border Classes="rowsep" />
                    <!-- The credit NVIDIA's licence (CC BY 4.0) asks for, beside OpenAI's; Cactus Whistle and its engine are
                         carried in the app under Apache-2.0, whose text is beside it (needle/LICENSE.txt). -->
                    <Border Classes="row">
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="row-title" Text="Speech models" />
                        <TextBlock Classes="row-sub" Text="Whisper by OpenAI (MIT); NVIDIA Parakeet TDT 0.6B v3 and TitaNet small (CC BY 4.0) and pyannote segmentation 3.0 (MIT), converted to ONNX by sherpa-onnx; for the recorder's live words, Cactus Whistle and its needle engine by Cactus Compute (Apache-2.0) on ARM, and Whisper tiny on x64, which come with Syft Notes. They run on this computer, and the others download only when you pick them." TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Border Classes="rowsep" />
                    <!-- The credits the illustration parts' licences ask for (CC BY, MIT), from the parts library itself. -->
                    <Border Classes="row">
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="row-title" Text="Illustration parts" />
                        <TextBlock Classes="row-sub" Text="{x:Static rich:PartsLibrary.AboutLine}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- Appearance -->
              <!-- Shortcuts: every key the student can change, and whether search and Record work from any app. -->

              <StackPanel IsVisible="{Binding OnAppearance}" Spacing="8">
                <TextBlock Classes="h" Text="Appearance" />
                <TextBlock Classes="body lede" Text="Pick how Syft Notes looks." />
                <TextBlock Classes="section" Text="Mode" />
                <!-- The three in one sunken track, the chosen one the white chip. -->
                <Border Classes="seg" HorizontalAlignment="Left" Margin="0,4,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="seg-item" Classes.on="{Binding AppearanceIsSystem}"
                            Command="{Binding PickAppearanceCommand}" CommandParameter="{x:Static s:AppAppearance.System}">
                      <TextBlock Text="Match system" />
                    </Button>
                    <Button Classes="seg-item" Classes.on="{Binding AppearanceIsLight}"
                            Command="{Binding PickAppearanceCommand}" CommandParameter="{x:Static s:AppAppearance.Light}">
                      <TextBlock Text="Light" />
                    </Button>
                    <Button Classes="seg-item" Classes.on="{Binding AppearanceIsDark}"
                            Command="{Binding PickAppearanceCommand}" CommandParameter="{x:Static s:AppAppearance.Dark}">
                      <TextBlock Text="Dark" />
                    </Button>
                  </StackPanel>
                </Border>
                <TextBlock Classes="say" Text="Light and dark set the whole app at once: the dropdown, quick panel, recorder, library and setup." />
                <TextBlock Classes="section gap" Text="Colour theme" />
                <Border Classes="group" Padding="16,18,16,8">
                  <!-- Unclipped, so a swatch's focus ring shows whole. -->
                  <ItemsControl ItemsSource="{Binding Themes}" ClipToBounds="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="app:ThemeSwatch">
                        <Button AutomationProperties.Name="{Binding Name}" Classes="quiet swatch" Theme="{StaticResource Surface}" Padding="0" Margin="0,0,0,10"
                                Command="{Binding $parent[UserControl].((s:SettingsModel)DataContext).PickThemeCommand}" CommandParameter="{Binding Name}">
                          <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <Panel Width="52" Height="52" HorizontalAlignment="Center">
                              <Border Classes="swatchring" Classes.on="{Binding Chosen}" Width="52" Height="52" CornerRadius="26">
                                <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource Surface}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                  <Ellipse Width="44" Height="44" Fill="{Binding Swatch}" />
                                </Border>
                              </Border>
                              <Border Classes="focusring" Margin="-4" CornerRadius="30" />
                            </Panel>
                            <TextBlock Classes="swatchname" Text="{Binding Name}" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
                <TextBlock Classes="say" Text="The accent for buttons, the selection and highlights. Your class colours stay the same." />
              </StackPanel>

              <!-- Connection: which library this computer uses (and, where it runs one, that library's process) -->
              <StackPanel IsVisible="{Binding OnConnection}" Spacing="8">
                <TextBlock Classes="h" Text="Connection" />
                <c:PageText Classes="body lede" Text="{Binding LibraryLine}" />
                <!-- The library runs here: what it's doing, and its page. Nothing to connect to: using another computer's
                     library instead is This computer's choice, below. -->
                <StackPanel Spacing="8" IsVisible="{Binding LibraryHere}">
                  <c:PageText Classes="say" Text="{Binding LibraryServiceLine}" IsVisible="{Binding LibraryServiceLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                    <Button Classes="btn sm" Command="{Binding OpenLibraryPageCommand}"><TextBlock Text="Open the library's page" /></Button>
                    <Button Classes="btn sm" Command="{Binding StartLibraryCommand}" IsVisible="{Binding CanStartLibrary}"><TextBlock Text="Start" /></Button>
                    <Button Classes="btn sm" Command="{Binding StopLibraryCommand}" IsVisible="{Binding CanStopLibrary}"><TextBlock Text="Stop" /></Button>
                  </StackPanel>
                  <TextBlock Classes="say" Text="It runs while Syft Notes is open. Turn on Start at login in General to keep it running; its own settings, and adding a laptop, are under Your library." />
                </StackPanel>
                <!-- A laptop: the library it sends lectures to -->
                <StackPanel Spacing="8" IsVisible="{Binding !LibraryHere}">
                  <TextBlock Classes="section" Text="Connect to a library" />
                  <Grid ColumnDefinitions="*,10,160" MaxWidth="480" HorizontalAlignment="Left">
                    <Border Classes="field"><TextBox Classes="bare" Text="{Binding Address}" PlaceholderText="http://mac-mini:8787" /></Border>
                    <Border Grid.Column="2" Classes="field"><TextBox Classes="bare" Text="{Binding Password}" PasswordChar="•" PlaceholderText="Password" /></Border>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                    <Button Classes="btn sm ink" Command="{Binding ConnectCommand}"><TextBlock Text="Connect" /></Button>
                    <Button Classes="btn sm" Command="{Binding OpenLibraryPageCommand}"><TextBlock Text="Open the library's page" /></Button>
                  </StackPanel>
                </StackPanel>
                <c:PageText Classes="say" Text="{Binding LibrarySay}" IsVisible="{Binding LibrarySay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="section gap" Text="Your name in the library" />
                <Border Classes="field" Width="240" HorizontalAlignment="Left"><TextBox Classes="bare" Text="{Binding DisplayName}" /></Border>
                <!-- This computer's role, switched any time after setup (docs/one-download.md) -->
                <TextBlock Classes="section gap" Text="This computer" />
                <TextBlock Classes="body" Text="{Binding RoleWords}" />
                <!-- An old library whose lectures haven't all come over yet (it stopped part-way, or setup made this the library) -->
                <Border Classes="group" IsVisible="{Binding ShowPendingBring}">
                  <Border Classes="row">
                    <Grid ColumnDefinitions="Auto,12,*,12,Auto">
                      <c:Icon Glyph="info" Size="18" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="row-title" Text="{Binding PendingBringTitle}" TextWrapping="Wrap" />
                        <TextBlock Classes="row-sub" Text="{Binding PendingBringLine}" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="btn sm" Command="{Binding LeaveThemThereCommand}" IsEnabled="{Binding !Switching}"><TextBlock Text="Leave them there" /></Button>
                        <Button Classes="btn sm ink" Command="{Binding BringAgainCommand}" IsEnabled="{Binding !Switching}"><TextBlock Text="{Binding PendingBringAction}" /></Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </Border>
                <!-- A laptop: keep everything on this computer, bringing over the library it used -->
                <StackPanel Spacing="8" IsVisible="{Binding IsLaptopRole}">
                  <Border Classes="group">
                    <Border Classes="row">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                          <TextBlock Classes="row-title" Text="Use just this computer" />
                          <TextBlock Classes="row-sub" Text="{Binding JustThisComputerLine}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="btn sm act" Margin="12,0,0,0" IsVisible="{Binding !ConfirmingBecomeLibrary}" Command="{Binding AskBecomeLibraryCommand}">
                          <TextBlock Text="Use just this computer…" />
                        </Button>
                      </Grid>
                    </Border>
                  </Border>
                  <StackPanel Spacing="8" IsVisible="{Binding ConfirmingBecomeLibrary}">
                    <TextBlock Classes="say" MaxWidth="560" Text="{Binding BecomeLibraryQuestion}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="btn sm" Command="{Binding CancelBecomeLibraryCommand}" IsEnabled="{Binding !Switching}"><TextBlock Text="Cancel" /></Button>
                      <Button Classes="btn sm ink" Command="{Binding ConfirmBecomeLibraryCommand}" IsEnabled="{Binding !Switching}"><TextBlock Text="Use just this computer" /></Button>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
                <!-- A library: use a library on another computer instead, handing everything over first -->
                <StackPanel Spacing="8" IsVisible="{Binding IsLibraryRole}">
                  <Border Classes="group">
                    <Border Classes="row">
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="row-title" Text="Use a library on another computer" />
                        <TextBlock Classes="row-sub" TextWrapping="Wrap"
                                   Text="Everything in this library goes to it first: every lecture with its notes and transcript, attached files, your classes and chats. Then this computer records for it." />
                      </StackPanel>
                    </Border>
                  </Border>
                  <Grid ColumnDefinitions="*,10,160" MaxWidth="480" HorizontalAlignment="Left" Margin="0,4,0,0" IsVisible="{Binding !ConfirmingBecomeLaptop}">
                    <Border Classes="field"><TextBox Classes="bare" Text="{Binding BecomeLaptopAddress}" PlaceholderText="http://mac-mini:8787" /></Border>
                    <Border Grid.Column="2" Classes="field"><TextBox Classes="bare" Text="{Binding BecomeLaptopPassword}" PasswordChar="•" PlaceholderText="Its password" /></Border>
                  </Grid>
                  <Button Classes="btn sm" HorizontalAlignment="Left" IsVisible="{Binding !ConfirmingBecomeLaptop}" Command="{Binding AskBecomeLaptopCommand}">
                    <TextBlock Text="Become a laptop" />
                  </Button>
                  <StackPanel Spacing="8" IsVisible="{Binding ConfirmingBecomeLaptop}">
                    <TextBlock Classes="say" MaxWidth="560"
                               Text="Everything in this library goes to that address first, so nothing is left behind; if that library can't take it all, nothing changes here. Then this computer stops being the library: its lectures, notes and settings stay right where they are, ready for it to be the library again any time." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="btn sm" Command="{Binding CancelBecomeLaptopCommand}" IsEnabled="{Binding !Switching}"><TextBlock Text="Cancel" /></Button>
                      <Button Classes="btn sm ink" Command="{Binding ConfirmBecomeLaptopCommand}" IsEnabled="{Binding !Switching}"><TextBlock Text="Switch" /></Button>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
                <!-- How far bringing (or handing on) a library has got, then what came -->
                <TextBlock Classes="say" Text="{Binding BringLine}" IsVisible="{Binding BringLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Border Classes="track" IsVisible="{Binding ShowBringBar}" Margin="0,4,0,0">
                  <Border Width="{Binding BringBarWidth}" />
                </Border>
                <c:PageText Classes="say" MaxWidth="560" Text="{Binding SwitchSay}" IsVisible="{Binding SwitchSay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>

              <!-- Recording -->
              <StackPanel IsVisible="{Binding OnRecording}" Spacing="8">
                <TextBlock Classes="h" Text="Recording" />
                <TextBlock Classes="body lede" Text="Each lecture is written down on this computer by the model you pick. The recording never leaves it; the library gets the transcript." />
                <TextBlock Classes="section" Text="Transcription model" />
                <!-- Unclipped, so a card's focus ring shows whole. -->
                <ItemsControl ItemsSource="{Binding Models}" MaxWidth="480" HorizontalAlignment="Left" ClipToBounds="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="s:ModelChoice">
                      <Button AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding About}" Classes="quiet card" Theme="{StaticResource Surface}" Margin="0,0,0,8" Padding="0"
                              Command="{Binding $parent[UserControl].((s:SettingsModel)DataContext).PickModelCommand}" CommandParameter="{Binding}">
                        <Panel>
                          <Border Classes="focusring cardring" Margin="-4" />
                          <Border Classes="choice" Classes.on="{Binding Chosen}" Margin="0">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <TextBlock Classes="choice-title" Text="{Binding Name}" />
                                  <Border Classes="badge" IsVisible="{Binding Recommended}"><TextBlock Text="Recommended" /></Border>
                                </StackPanel>
                                <TextBlock Classes="choice-about" Text="{Binding About}" />
                              </StackPanel>
                              <StackPanel Grid.Column="1" Spacing="6" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <c:Icon IsVisible="{Binding Here}" Glyph="check_circle" Filled="True" Size="18" Foreground="{DynamicResource Ink}" HorizontalAlignment="Right" />
                                <!-- Downloaded and not in use: its own Remove (asks first, under the list) -->
                                <Button Classes="btn sm" IsVisible="{Binding CanRemove}" AutomationProperties.Name="{Binding RemoveSaid}" ToolTip.Tip="{Binding RemoveSaid}"
                                        Command="{Binding $parent[UserControl].((s:SettingsModel)DataContext).AskRemoveModelCommand}" CommandParameter="{Binding}">
                                  <TextBlock Text="Remove" />
                                </Button>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </Panel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="say" Text="{Binding ModelAdviceLine}" Margin="0,0,0,0" />
                <Border Classes="track" IsVisible="{Binding ModelDownloading}" Margin="0,8,0,0">
                  <Border Width="{Binding ModelBarWidth}" />
                </Border>
                <c:PageText Classes="say" Text="{Binding ModelLine}" />
                <!-- A model no longer in use (after a switch) stays until the student presses its Remove in the list. -->
                <StackPanel Spacing="8" Margin="0,8,0,0" IsVisible="{Binding ConfirmingRemove}">
                  <TextBlock Classes="say" Text="{Binding RemoveQuestion}" Margin="0" MaxWidth="480" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="btn sm" Command="{Binding KeepSpareCommand}"><TextBlock Text="Keep" /></Button>
                    <Button Classes="btn sm ink" Command="{Binding RemoveSpareCommand}"><TextBlock Text="Remove" /></Button>
                  </StackPanel>
                </StackPanel>
                <!-- When a lecture is written down: one choice, the model's cards' look. -->
                <TextBlock Classes="section" Text="When it's written down" />
                <StackPanel Width="480" HorizontalAlignment="Left" ClipToBounds="False">
                  <Button AutomationProperties.Name="As you record" AutomationProperties.HelpText="The recorder shows the transcript as the lecture goes, and you can ask about what's been said so far." Name="WrittenAsYouRecord" Classes="quiet card" Theme="{StaticResource Surface}" Margin="0,0,0,8" Padding="0"
                          Command="{Binding PickLiveTranscriptCommand}" CommandParameter="live">
                    <Panel>
                      <Border Classes="focusring cardring" Margin="-4" />
                      <Border Classes="choice" Classes.on="{Binding LiveTranscript}">
                        <StackPanel Spacing="2">
                          <TextBlock Classes="choice-title" Text="As you record" />
                          <TextBlock Classes="choice-about" Text="The recorder shows the transcript as the lecture goes, and you can ask about what's been said so far." />
                        </StackPanel>
                      </Border>
                    </Panel>
                  </Button>
                  <Button AutomationProperties.Name="After class" AutomationProperties.HelpText="Only records during the lecture, which saves battery. It's written down once you stop, so the transcript, and asking about it, come then." Name="WrittenAfterClass" Classes="quiet card" Theme="{StaticResource Surface}" Margin="0,0,0,8" Padding="0"
                          Command="{Binding PickLiveTranscriptCommand}" CommandParameter="after">
                    <Panel>
                      <Border Classes="focusring cardring" Margin="-4" />
                      <Border Classes="choice" Classes.on="{Binding AfterClass}">
                        <StackPanel Spacing="2">
                          <TextBlock Classes="choice-title" Text="After class" />
                          <TextBlock Classes="choice-about" Text="Only records during the lecture, which saves battery. It's written down once you stop, so the transcript, and asking about it, come then." />
                        </StackPanel>
                      </Border>
                    </Panel>
                  </Button>
                </StackPanel>
                <TextBlock Classes="say" Text="{Binding LiveTranscriptLine}" TextWrapping="Wrap" MaxWidth="480" HorizontalAlignment="Left"
                           IsVisible="{Binding LiveTranscriptLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="section" Text="Language" />
                <Border Classes="field" Width="240" HorizontalAlignment="Left"><TextBox Classes="bare" Text="{Binding Language}" PlaceholderText="Found for each lecture (or en, es, fr…)" /></Border>
                <CheckBox IsVisible="{Binding CanRecordComputerAudio}" IsChecked="{Binding ComputerAudio}" Margin="0,16,0,0">
                  <TextBlock Text="Also record what this computer plays (a lecture on Zoom or Teams)" FontSize="14" />
                </CheckBox>
                <CheckBox IsChecked="{Binding Speakers}" Margin="0,16,0,0">
                  <TextBlock Text="Tell speakers apart in the transcript" FontSize="14" />
                </CheckBox>
                <TextBlock Classes="say" Text="{Binding SpeakersLine}" TextWrapping="Wrap" MaxWidth="480" HorizontalAlignment="Left" />
                <TextBlock Classes="section" Text="Keep recordings" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Classes="field" Width="64"><TextBox Classes="bare" Text="{Binding KeepAudio}" /></Border>
                  <TextBlock Classes="say" Text="days after they're filed (0 keeps them). The notes and transcript stay." Margin="0" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>

              <!-- Your library: its own settings, through its API (Library, Classes, Notes and sorting, Folders). Every
                   row is one grid: its words on the left, its control in the right column on the row's centre line. -->
              <StackPanel IsVisible="{Binding OnLibraryPage}" Spacing="8">
                <TextBlock Classes="h" Text="{Binding LibraryPageTitle}" />
                <TextBlock Classes="body lede" Text="{Binding LibraryPageLine}" />
                <TextBlock Classes="say" Text="Asking your library…" IsVisible="{Binding Lib.IsLoading}" />
                <Border Classes="group" IsVisible="{Binding Lib.ShowProblem}">
                  <Border Classes="row">
                    <Grid ColumnDefinitions="Auto,12,*,12,Auto">
                      <c:Icon Glyph="info" Size="18" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
                      <c:PageText Grid.Column="2" Classes="row-title" Text="{Binding Lib.Problem}" TextWrapping="Wrap" />
                      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="btn sm" Command="{Binding Lib.LoadCommand}" IsVisible="{Binding Lib.CanRetry}"><TextBlock Text="Try again" /></Button>
                        <Button Classes="btn sm" Command="{Binding Lib.OpenLibraryPageCommand}" IsVisible="{Binding Lib.CanOpenPage}"><TextBlock Text="Open its page" /></Button>
                        <Button Classes="btn sm" Command="{Binding GoCommand}" CommandParameter="Connection" IsVisible="{Binding Lib.IsNoLibrary}"><TextBlock Text="Connection" /></Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </Border>
                <c:PageText Classes="say" Text="{Binding Lib.Say}" IsVisible="{Binding Lib.Say, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <StackPanel IsVisible="{Binding Lib.IsReady}" Spacing="8">
                  <!-- Library -->
                  <StackPanel IsVisible="{Binding OnLibrary}" Spacing="8">
                    <TextBlock Classes="section gap" Text="{Binding Lib.NameSection}" />
                    <Border Classes="group">
                      <StackPanel>
                        <Border Classes="row">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                              <TextBlock Classes="row-title" Text="Name" />
                              <TextBlock Classes="row-sub" Text="{Binding Lib.NameSub}" />
                            </StackPanel>
                            <Border Grid.Column="1" Classes="field act" Width="220">
                              <TextBox Name="LibraryName" Classes="bare" Text="{Binding Lib.Name}" VerticalAlignment="Center" />
                            </Border>
                          </Grid>
                        </Border>
                        <Border Classes="rowsep" IsVisible="{Binding Lib.ShowReach}" />
                        <Border Classes="row" IsVisible="{Binding Lib.ShowReach}">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                              <TextBlock Classes="row-title" Text="Password" />
                              <TextBlock Classes="row-sub" Text="{Binding Lib.PasswordLine}" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="btn sm act" Command="{Binding Lib.ChangePasswordCommand}" IsVisible="{Binding !Lib.ChangingPassword}"><TextBlock Text="Change…" /></Button>
                            <StackPanel Grid.Column="1" Classes="act" Orientation="Horizontal" Spacing="8" IsVisible="{Binding Lib.ChangingPassword}">
                              <Border Classes="field" Width="180">
                                <TextBox Name="NewPassword" Classes="bare" Text="{Binding Lib.NewPassword}" PasswordChar="•" PlaceholderText="New password" VerticalAlignment="Center" />
                              </Border>
                              <Button Classes="btn sm" Command="{Binding Lib.ChangePasswordCommand}"><TextBlock Text="Cancel" /></Button>
                              <Button Classes="btn sm ink" Command="{Binding Lib.SavePasswordCommand}"><TextBlock Text="Save" /></Button>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </StackPanel>
                    </Border>
                    <c:PageText Classes="say" Text="{Binding Lib.PasswordSay}" IsVisible="{Binding Lib.PasswordSay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <!-- A library on this computer: let laptops connect (a password, then the addresses below), or not -->
                    <StackPanel IsVisible="{Binding Lib.CanChangeLaptops}" Spacing="8">
                      <TextBlock Classes="section gap" Text="Laptops" />
                      <Border Classes="group">
                        <Border Classes="row">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                              <TextBlock Classes="row-title" Text="{Binding Lib.LaptopsTitle}" />
                              <TextBlock Classes="row-sub" Text="{Binding Lib.LaptopsSub}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="btn sm act" Command="{Binding Lib.AddLaptopCommand}" Margin="12,0,0,0" IsEnabled="{Binding !Lib.ChangingLaptops}">
                              <Button.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                  <Binding Path="Lib.OnlyThisComputer" />
                                  <Binding Path="!Lib.AddingLaptop" />
                                </MultiBinding>
                              </Button.IsVisible>
                              <TextBlock Text="Add a laptop…" />
                            </Button>
                            <StackPanel Grid.Column="1" Classes="act" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" IsVisible="{Binding Lib.AddingLaptop}">
                              <Border Classes="field" Width="180">
                                <TextBox Name="LaptopPassword" Classes="bare" Text="{Binding Lib.LaptopPassword}" PasswordChar="•" PlaceholderText="A password for your laptop" VerticalAlignment="Center" />
                              </Border>
                              <Button Classes="btn sm" Command="{Binding Lib.AddLaptopCommand}"><TextBlock Text="Cancel" /></Button>
                              <Button Classes="btn sm ink" Command="{Binding Lib.TurnOnLaptopsCommand}" IsEnabled="{Binding !Lib.ChangingLaptops}"><TextBlock Text="Turn on" /></Button>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="btn sm act" Command="{Binding Lib.TurnOffLaptopsCommand}" IsVisible="{Binding Lib.LaptopsCanConnect}" IsEnabled="{Binding !Lib.ChangingLaptops}" Margin="12,0,0,0">
                              <TextBlock Text="Turn off" />
                            </Button>
                          </Grid>
                        </Border>
                      </Border>
                      <c:PageText Classes="say" Text="{Binding Lib.LaptopSay}" IsVisible="{Binding Lib.LaptopSay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <TextBlock Classes="section gap" Text="How your laptop reaches it" IsVisible="{Binding Lib.ShowReach}" />
                    <Border Classes="group" IsVisible="{Binding Lib.ShowReach}">
                      <ItemsControl ItemsSource="{Binding Lib.Addresses}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <StackPanel>
                            <Border Classes="rowsep itemsep" />
                            <Border Classes="row">
                              <Grid ColumnDefinitions="*,Auto">
                                <c:PageText Classes="row-title" Text="{Binding}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="btn sm act" Command="{Binding $parent[UserControl].((s:SettingsModel)DataContext).Lib.CopyAddressCommand}" CommandParameter="{Binding}">
                                  <TextBlock Text="Copy" />
                                </Button>
                              </Grid>
                            </Border>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                    <TextBlock Classes="say" Text="{Binding Lib.ReachLine}" IsVisible="{Binding Lib.ShowReach}" />

                    <TextBlock Classes="section gap" Text="On its computer" />
                    <Border Classes="group">
                      <StackPanel>
                        <!-- On this computer it's the app's own login item: General → Open when you log in. -->
                        <Border Classes="row" IsVisible="{Binding !Lib.IsHere}">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                              <TextBlock Classes="row-title" Text="{Binding Lib.StartAtLoginTitle}" />
                              <TextBlock Classes="row-sub" Text="{Binding Lib.StartAtLoginSub}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton AutomationProperties.Name="{Binding Lib.StartAtLoginTitle}" Grid.Column="1" Classes="switch act" IsChecked="{Binding Lib.StartAtLoginOn}" IsEnabled="{Binding Lib.CanStartAtLogin}" Margin="12,0,0,0" />
                          </Grid>
                        </Border>
                        <Border Classes="rowsep" IsVisible="{Binding !Lib.IsHere}" />
                        <Border Classes="row">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                              <TextBlock Classes="row-title" Text="Notes folder" />
                              <c:PageText Classes="row-sub" Text="{Binding Lib.NotesFolder}" TextTrimming="PrefixCharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="btn sm act" Command="{Binding Lib.ShowNotesFolderCommand}" IsVisible="{Binding Lib.IsHere}" Margin="12,0,0,0">
                              <TextBlock Text="{Binding Lib.RevealLabel}" />
                            </Button>
                          </Grid>
                        </Border>
                      </StackPanel>
                    </Border>
                    <StackPanel Spacing="8" IsVisible="{Binding IsLaptopRole}">
                    <TextBlock Classes="section gap" Text="{Binding Lib.UpdatesHeading}" />
                    <Border Classes="group">
                      <StackPanel>
                        <Border Classes="row">
                          <Grid ColumnDefinitions="*,Auto">
                            <c:PageText Classes="row-title" Text="{Binding Lib.UpdateLine}" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Classes="btn sm ink act" Command="{Binding Lib.UpdateNowCommand}" IsVisible="{Binding Lib.CanUpdateNow}" Margin="12,0,0,0">
                              <TextBlock Text="Update now" />
                            </Button>
                          </Grid>
                        </Border>
                        <Border Classes="rowsep" />
                        <Border Classes="row">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                              <TextBlock Classes="row-title" Text="Update automatically" />
                              <TextBlock Classes="row-sub" Text="{Binding Lib.AutoUpdateSub}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton AutomationProperties.Name="Update automatically" Grid.Column="1" Classes="switch act" IsChecked="{Binding Lib.AutoUpdate}" />
                          </Grid>
                        </Border>
                      </StackPanel>
                    </Border>
                    </StackPanel>
                  </StackPanel>

                  <!-- Classes: each its own card, the name, other names and what it covers lined up in columns -->
                  <StackPanel IsVisible="{Binding OnClasses}" Spacing="8">
                    <!-- Use Canvas course names: classes named from course codes take their courses' names, after a preview -->
                    <Border Classes="group" Margin="0,8,0,0" IsVisible="{Binding Lib.HasCourseNames}">
                      <StackPanel>
                        <Border Classes="row">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                              <TextBlock Classes="row-title" Text="Use Canvas course names" />
                              <TextBlock Classes="row-sub" Text="{Binding Lib.CourseNamesSub}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="btn sm act" Command="{Binding Lib.AskUseCourseNamesCommand}" IsEnabled="{Binding Lib.CanUseCourseNames}" IsVisible="{Binding !Lib.ConfirmingCourseNames}"><TextBlock Text="Preview…" /></Button>
                            <StackPanel Grid.Column="1" Classes="act" Orientation="Horizontal" Spacing="8" IsVisible="{Binding Lib.ConfirmingCourseNames}">
                              <Button Classes="btn sm" Command="{Binding Lib.CancelUseCourseNamesCommand}"><TextBlock Text="Cancel" /></Button>
                              <Button Classes="btn sm ink" Command="{Binding Lib.UseCourseNamesCommand}" IsEnabled="{Binding Lib.CanUseCourseNames}"><TextBlock Text="{Binding Lib.RenameLabel}" /></Button>
                            </StackPanel>
                          </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Lib.CourseNames}" IsVisible="{Binding Lib.ConfirmingCourseNames}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CourseNameRow">
                              <StackPanel>
                                <Border Classes="rowsep" />
                                <Border Classes="row">
                                  <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                      <TextBlock Classes="row-title" Text="{Binding To}" TextTrimming="CharacterEllipsis" />
                                      <TextBlock Classes="row-sub" Text="{Binding Now}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Classes="row-sub act" Text="{Binding Meta}" VerticalAlignment="Center" />
                                  </Grid>
                                </Border>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Lib.Classes}" Margin="0,8,0,0">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LibraryClassRow">
                          <Border Classes="group" Margin="0" Padding="16,12">
                            <Grid ColumnDefinitions="Auto,12,3*,8,2*,8,Auto" RowDefinitions="Auto,6,Auto,6,Auto">
                              <c:Swatch Small="True" Fill="{Binding Dot}" VerticalAlignment="Center"/>
                              <Border Grid.Column="2" Classes="field"><TextBox Classes="bare" Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" LostFocus="OnClassLostFocus" /></Border>
                              <Border Grid.Column="4" Classes="field"><TextBox Classes="bare" Text="{Binding Aliases}" PlaceholderText="Other names, like cs101" VerticalAlignment="Center" LostFocus="OnClassLostFocus" /></Border>
                              <Button Grid.Column="6" Theme="{StaticResource Surface}" Width="30" Height="30" CornerRadius="{DynamicResource RadiusControl}" HorizontalContentAlignment="Center"
                                      Command="{Binding $parent[UserControl].((s:SettingsModel)DataContext).Lib.RemoveClassCommand}" CommandParameter="{Binding}" ToolTip.Tip="Remove the class (its lectures stay)">
                                <c:Icon Glyph="close" Size="15" Foreground="{DynamicResource Fg3}" />
                              </Button>
                              <Border Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Classes="field">
                                <TextBox Classes="bare" Text="{Binding Description}" PlaceholderText="What it covers (it helps the AI sort)" VerticalAlignment="Center" LostFocus="OnClassLostFocus" />
                              </Border>
                              <TextBlock Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="3" Classes="row-sub" Text="{Binding Meta}" TextTrimming="PrefixCharacterEllipsis" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Classes="group" Margin="0" Padding="16,12">
                      <Grid ColumnDefinitions="Auto,12,3*,8,2*,8,Auto">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Fill2}" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Classes="field"><TextBox Name="NewLibraryClass" Classes="bare" Text="{Binding Lib.NewClass}" PlaceholderText="A new class" VerticalAlignment="Center" /></Border>
                        <TextBlock Grid.Column="4" Classes="row-sub" Text="Its other names and what it covers come next." VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Column="6" Classes="btn sm" Command="{Binding Lib.AddClassCommand}" VerticalAlignment="Center"><TextBlock Text="Add" /></Button>
                      </Grid>
                    </Border>
                    <TextBlock Classes="say" Text="Renaming or removing a class keeps its lectures where they are." />
                  </StackPanel>

                  <!-- Notes and sorting -->
                  <StackPanel IsVisible="{Binding OnNotes}" Spacing="8">
                    <TextBlock Classes="section gap" Text="Notes" />
                    <Border Classes="group">
                      <StackPanel>
                        <Border Classes="row">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                              <TextBlock Classes="row-title" Text="Write study notes from each lecture" />
                              <TextBlock Classes="row-sub" Text="{Binding Lib.WriteNotesSub}" />
                            </StackPanel>
                            <ToggleButton AutomationProperties.Name="Write study notes from each lecture" Grid.Column="1" Classes="switch act" IsChecked="{Binding Lib.WriteNotes}" />
                          </Grid>
                        </Border>
                        <Border Classes="rowsep" />
                        <Border Classes="row">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                              <TextBlock Classes="row-title" Text="Sort lectures into classes with AI" />
                              <TextBlock Classes="row-sub" Text="Otherwise only the class it was recorded for, or its title, sorts it" />
                            </StackPanel>
                            <ToggleButton AutomationProperties.Name="Sort lectures into classes with AI" Grid.Column="1" Classes="switch act" IsChecked="{Binding Lib.SortWithAi}" />
                          </Grid>
                        </Border>
                        <Border Classes="rowsep" IsVisible="{Binding Lib.SortWithAi}" />
                        <Border Classes="row" IsVisible="{Binding Lib.SortWithAi}">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                              <TextBlock Classes="row-title" Text="Sorts them with" />
                              <TextBlock Classes="row-sub" Text="The AI that reads a lecture to pick its class" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="select act" MaxWidth="260">
                              <Grid ColumnDefinitions="*,6,Auto">
                                <TextBlock Classes="plain" Text="{Binding Lib.SortEngineLabel}" VerticalAlignment="Center" />
                                <c:Icon Grid.Column="2" Glyph="unfold_more" Size="15" Foreground="{DynamicResource Fg2}" />
                              </Grid>
                              <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterTheme="{StaticResource SettingsMenu}" ItemsSource="{Binding Lib.SortEngineChoices}" ItemContainerTheme="{StaticResource PickItem}" />
                              </Button.Flyout>
                            </Button>
                          </Grid>
                        </Border>
                        <Border Classes="rowsep" />
                        <Border Classes="row">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                              <TextBlock Classes="row-title" Text="Files a lecture when the AI is at least" />
                              <TextBlock Classes="row-sub" Text="Less sure, and the lecture waits in Unsorted for you" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="select act" MinWidth="90">
                              <Grid ColumnDefinitions="*,6,Auto">
                                <TextBlock Text="{Binding Lib.ConfidenceLabel}" VerticalAlignment="Center" />
                                <c:Icon Grid.Column="2" Glyph="unfold_more" Size="15" Foreground="{DynamicResource Fg2}" />
                              </Grid>
                              <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterTheme="{StaticResource SettingsMenu}" ItemsSource="{Binding Lib.ConfidenceChoices}" ItemContainerTheme="{StaticResource PickItem}" />
                              </Button.Flyout>
                            </Button>
                          </Grid>
                        </Border>
                      </StackPanel>
                    </Border>

                    <TextBlock Classes="section gap" Text="Local models" />
                    <Border Classes="group">
                      <StackPanel>
                        <Border Classes="row">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                              <TextBlock Classes="row-title" Text="Writes the notes" />
                              <TextBlock Classes="row-sub" Text="When Ollama writes them" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="select act" MaxWidth="260">
                              <Grid ColumnDefinitions="*,6,Auto">
                                <TextBlock Classes="plain" Text="{Binding Lib.SummaryLabel}" VerticalAlignment="Center" />
                                <c:Icon Grid.Column="2" Glyph="unfold_more" Size="15" Foreground="{DynamicResource Fg2}" />
                              </Grid>
                              <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterTheme="{StaticResource SettingsMenu}" ItemsSource="{Binding Lib.SummaryChoices}" ItemContainerTheme="{StaticResource PickItem}" />
                              </Button.Flyout>
                            </Button>
                          </Grid>
                        </Border>
                        <Border Classes="rowsep" />
                        <Border Classes="row">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                              <TextBlock Classes="row-title" Text="Sorts lectures into classes" />
                              <TextBlock Classes="row-sub" Text="When Ollama sorts them" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="select act" MaxWidth="260">
                              <Grid ColumnDefinitions="*,6,Auto">
                                <TextBlock Classes="plain" Text="{Binding Lib.SortLabel}" VerticalAlignment="Center" />
                                <c:Icon Grid.Column="2" Glyph="unfold_more" Size="15" Foreground="{DynamicResource Fg2}" />
                              </Grid>
                              <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterTheme="{StaticResource SettingsMenu}" ItemsSource="{Binding Lib.SortChoices}" ItemContainerTheme="{StaticResource PickItem}" />
                              </Button.Flyout>
                            </Button>
                          </Grid>
                        </Border>
                      </StackPanel>
                    </Border>
                    <c:PageText Classes="say" Text="{Binding Lib.OllamaLine}" />

                    <TextBlock Classes="section gap" Text="Open in a terminal" IsVisible="{Binding Lib.HasTerminals}" />
                    <Border Classes="group" IsVisible="{Binding Lib.HasTerminals}">
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="row-title" Text="Opens a class with Claude Code, Codex or Gemini in" />
                            <TextBlock Classes="row-sub" Text="On the library's computer" />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="select act">
                            <Grid ColumnDefinitions="*,6,Auto">
                              <TextBlock Text="{Binding Lib.TerminalLabel}" VerticalAlignment="Center" />
                              <c:Icon Grid.Column="2" Glyph="unfold_more" Size="15" Foreground="{DynamicResource Fg2}" />
                            </Grid>
                            <Button.Flyout>
                              <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterTheme="{StaticResource SettingsMenu}" ItemsSource="{Binding Lib.TerminalChoices}" ItemContainerTheme="{StaticResource PickItem}" />
                            </Button.Flyout>
                          </Button>
                        </Grid>
                      </Border>
                    </Border>

                    <TextBlock Classes="section gap" Text="Rewrite every summary" />
                    <Border Classes="group">
                      <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="row-title" Text="{Binding Lib.RewriteTitle}" />
                            <TextBlock Classes="row-sub" Text="{Binding Lib.RewriteSub}" />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="btn sm act" Command="{Binding Lib.AskRewriteAllCommand}" IsVisible="{Binding !Lib.ConfirmingRewrite}"><TextBlock Text="Rewrite all…" /></Button>
                          <StackPanel Grid.Column="1" Classes="act" Orientation="Horizontal" Spacing="8" IsVisible="{Binding Lib.ConfirmingRewrite}">
                            <Button Classes="btn sm" Command="{Binding Lib.CancelRewriteAllCommand}"><TextBlock Text="Cancel" /></Button>
                            <Button Classes="btn sm ink" Command="{Binding Lib.RewriteAllCommand}"><TextBlock Text="Rewrite them all" /></Button>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </Border>
                    <TextBlock Classes="say" Text="Useful after switching models. It can take a while." />
                  </StackPanel>

                  <!-- Folders it may read -->
                  <StackPanel IsVisible="{Binding OnFolders}" Spacing="8">
                    <Border Classes="group" Margin="0,8,0,0">
                      <StackPanel>
                        <Border Classes="row" IsVisible="{Binding Lib.NoFolders}">
                          <TextBlock Classes="row-title" Text="No folders yet." Foreground="{DynamicResource Fg2}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding Lib.Folders}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReadFolderRow">
                              <StackPanel>
                              <Border Classes="rowsep itemsep" />
                              <Border Classes="row">
                                <Grid ColumnDefinitions="Auto,12,*,16,Auto,8,Auto,16,Auto,8,Auto,8,Auto">
                                  <c:Icon Glyph="folder" Size="18" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
                                  <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Classes="row-title" Text="{Binding Name}" />
                                    <c:PageText Classes="row-sub" Text="{Binding Path}" TextTrimming="PrefixCharacterEllipsis" />
                                  </StackPanel>
                                  <TextBlock Grid.Column="4" Classes="row-sub" Text="AI reads" VerticalAlignment="Center" />
                                  <ToggleButton AutomationProperties.Name="{Binding Name, StringFormat='AI reads {0}'}" Grid.Column="6" Classes="switch" IsChecked="{Binding Ai}" VerticalAlignment="Center" />
                                  <TextBlock Grid.Column="8" Classes="row-sub" Text="Private" VerticalAlignment="Center" />
                                  <ToggleButton AutomationProperties.Name="{Binding Name, StringFormat='{}{0} is private'}" Grid.Column="10" Classes="switch" IsChecked="{Binding Private}" VerticalAlignment="Center" />
                                  <Button Grid.Column="12" Theme="{StaticResource Surface}" Width="30" Height="30" CornerRadius="{DynamicResource RadiusControl}" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                                          Command="{Binding $parent[UserControl].((s:SettingsModel)DataContext).Lib.RemoveFolderCommand}" CommandParameter="{Binding}" ToolTip.Tip="Stop reading this folder">
                                    <c:Icon Glyph="close" Size="15" Foreground="{DynamicResource Fg3}" />
                                  </Button>
                                </Grid>
                              </Border>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                    <Border Classes="group" Margin="0">
                      <Border Classes="row">
                        <Grid ColumnDefinitions="Auto,12,*,12,Auto">
                          <c:Icon Glyph="add" Size="18" Foreground="{DynamicResource Fg3}" VerticalAlignment="Center" />
                          <Border Grid.Column="2" Classes="field"><TextBox Name="NewFolder" Classes="bare" Text="{Binding Lib.NewFolder}" PlaceholderText="A folder on the library's computer, like ~/Documents/School" VerticalAlignment="Center" /></Border>
                          <Button Grid.Column="4" Classes="btn sm" Command="{Binding Lib.AddFolderCommand}" VerticalAlignment="Center"><TextBlock Text="Add" /></Button>
                        </Grid>
                      </Border>
                    </Border>
                    <TextBlock Classes="say" Text="{Binding Lib.FilesLine}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>

              <!-- Canvas: its own pane (design 06), in the page's margins like every other section -->
              <Panel IsVisible="{Binding OnCanvas}">
                <Panel IsVisible="{Binding IsMac}">
                  <v:MacCanvasSettings DataContext="{Binding Canvas}" />
                </Panel>
                <Panel IsVisible="{Binding IsWin}">
                  <v:WinCanvasSettings DataContext="{Binding Canvas}" />
                </Panel>
              </Panel>

              <!-- Phone: adding one, and the phones already added -->
              <Panel IsVisible="{Binding OnPhone}">
                <v:MacPhones DataContext="{Binding Phones}" IsVisible="{Binding $parent[UserControl].((s:SettingsModel)DataContext).IsMac}" />
                <v:WinPhones DataContext="{Binding Phones}" IsVisible="{Binding $parent[UserControl].((s:SettingsModel)DataContext).IsWin}" />
              </Panel>

              <!-- Granola: sign in to it (on its own page, in the browser), then the lectures there that Syft Notes doesn't
                   have, each with Transfer, and whether a new one is announced. -->
              <Panel IsVisible="{Binding OnGranola}">
                <StackPanel Name="GranolaPage" DataContext="{Binding Granola}" x:DataType="vm:GranolaSettingsModel" Spacing="8">
                  <TextBlock Classes="h" Text="Granola" />
                  <TextBlock Classes="body lede" Text="{x:Static vm:GranolaSettingsModel.About}" TextWrapping="Wrap" />
                  <Border Classes="group">
                    <StackPanel>
                      <!-- Not signed in: Connect, or Cancel while the browser is open on Granola's page -->
                      <Border Classes="row" IsVisible="{Binding SignedOut}">
                        <Grid ColumnDefinitions="*,16,Auto">
                          <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="row-title" Text="Connect Granola" />
                            <TextBlock Classes="row-sub" Text="{x:Static vm:GranolaSettingsModel.SignInNote}" TextWrapping="Wrap" IsVisible="{Binding !Connecting}" />
                            <TextBlock Classes="row-sub" Text="Waiting for you to sign in in your browser…" TextWrapping="Wrap" IsVisible="{Binding Connecting}" />
                          </StackPanel>
                          <Button Name="GranolaConnect" Grid.Column="2" Classes="btn sm ink" Command="{Binding ConnectCommand}" IsVisible="{Binding CanConnect}" VerticalAlignment="Center">
                            <TextBlock Text="Connect" />
                          </Button>
                          <Button Name="GranolaCancel" Grid.Column="2" Classes="btn sm" Command="{Binding CancelConnectCommand}" IsVisible="{Binding Connecting}" VerticalAlignment="Center">
                            <TextBlock Text="Cancel" />
                          </Button>
                        </Grid>
                      </Border>
                      <!-- Signed in: who as, and Disconnect -->
                      <Border Classes="row" IsVisible="{Binding SignedIn}">
                        <Grid ColumnDefinitions="*,16,Auto">
                          <StackPanel Spacing="2" VerticalAlignment="Center">
                            <c:PageText Classes="row-title" Text="{Binding ConnectedLine}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="row-sub" Text="Syft Notes looks for new lectures every few minutes." TextWrapping="Wrap" />
                          </StackPanel>
                          <Button Name="GranolaDisconnect" Grid.Column="2" Classes="btn sm" Command="{Binding DisconnectCommand}" VerticalAlignment="Center">
                            <TextBlock Text="Disconnect" />
                          </Button>
                        </Grid>
                      </Border>
                      <Border Classes="rowsep" IsVisible="{Binding SignedIn}" />
                      <Border Classes="row" IsVisible="{Binding SignedIn}">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="row-title" Text="Tell me when Granola has a new lecture" />
                            <TextBlock Classes="row-sub" Text="A notification with a Transfer button" />
                          </StackPanel>
                          <ToggleButton AutomationProperties.Name="Tell me when Granola has a new lecture" Grid.Column="1" Classes="switch" IsChecked="{Binding Notify}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Border>
                  <c:PageText Name="GranolaProblem" Classes="row-sub" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" Foreground="{DynamicResource Warn}" TextWrapping="Wrap" />

                  <!-- What's waiting in Granola -->
                  <StackPanel Spacing="8" IsVisible="{Binding SignedIn}">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                      <TextBlock Classes="section" Text="In Granola, not in Syft Notes" Margin="0" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Name="GranolaLook" Classes="btn sm" Command="{Binding LookNowCommand}" IsEnabled="{Binding !Looking}">
                          <TextBlock Text="Look now" />
                        </Button>
                        <Button Name="GranolaTransferAll" Classes="btn sm ink" Command="{Binding TransferAllCommand}" IsVisible="{Binding HasSeveral}">
                          <TextBlock Text="Transfer all" />
                        </Button>
                      </StackPanel>
                    </Grid>
                    <Border Classes="group" IsVisible="{Binding NothingWaiting}">
                      <Border Classes="row">
                        <TextBlock Classes="row-sub" Text="{x:Static vm:GranolaSettingsModel.NothingWaitingWords}" TextWrapping="Wrap" />
                      </Border>
                    </Border>
                    <ItemsControl Name="GranolaLectures" ItemsSource="{Binding Lectures}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GranolaLecture">
                          <Border Classes="group" Margin="0,0,0,6">
                            <Border Classes="row">
                              <Grid ColumnDefinitions="*,16,Auto">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                  <TextBlock Classes="row-title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Classes="row-sub" Text="{Binding When}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                  <Button Classes="text-link small" VerticalAlignment="Center" IsEnabled="{Binding !Busy}"
                                          Command="{Binding $parent[ItemsControl].((vm:GranolaSettingsModel)DataContext).LeaveCommand}" CommandParameter="{Binding}"
                                          ToolTip.Tip="Leave it in Granola and don't offer it again" Content="Leave it" />
                                  <Button Classes="btn sm ink" IsEnabled="{Binding !Busy}"
                                          Command="{Binding $parent[ItemsControl].((vm:GranolaSettingsModel)DataContext).TransferCommand}" CommandParameter="{Binding}">
                                    <TextBlock Text="Transfer" />
                                  </Button>
                                </StackPanel>
                              </Grid>
                            </Border>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <TextBlock Classes="say" Text="{x:Static vm:GranolaSettingsModel.PlanNote}" />
                </StackPanel>
              </Panel>

              <!-- Calendars: pasting a feed, Connect buttons for kinds that offer one, and the sources already added -->
              <Panel IsVisible="{Binding OnCalendars}">
                <v:MacCalendarSettings DataContext="{Binding Calendars}" IsVisible="{Binding $parent[UserControl].((s:SettingsModel)DataContext).IsMac}" />
                <v:WinCalendarSettings DataContext="{Binding Calendars}" IsVisible="{Binding $parent[UserControl].((s:SettingsModel)DataContext).IsWin}" />
              </Panel>
            </StackPanel>
          </ScrollViewer>

          <!-- AI engines (design 13), with whatever's wrong with an engine above them (design 18), and AI tool
               access (design 14): these panes pad and scroll themselves. -->
          <DockPanel IsVisible="{Binding OnAi}">
            <Panel DockPanel.Dock="Top" IsVisible="{Binding AiProblems.Problems.Count, Converter={x:Static c:Converters.Some}}">
              <v:MacAiProblems Classes="problems" DataContext="{Binding AiProblems}" IsVisible="{Binding $parent[UserControl].((s:SettingsModel)DataContext).IsMac}" />
              <v:WinAiProblems Classes="problems" DataContext="{Binding AiProblems}" IsVisible="{Binding $parent[UserControl].((s:SettingsModel)DataContext).IsWin}" />
            </Panel>
            <Panel>
              <v:MacAiEngines DataContext="{Binding Engines}" IsVisible="{Binding $parent[UserControl].((s:SettingsModel)DataContext).IsMac}" />
              <v:WinAiEngines DataContext="{Binding Engines}" IsVisible="{Binding $parent[UserControl].((s:SettingsModel)DataContext).IsWin}" />
            </Panel>
          </DockPanel>
          <Panel IsVisible="{Binding OnAccess}">
            <v:MacAiAccess DataContext="{Binding Access}" IsVisible="{Binding $parent[UserControl].((s:SettingsModel)DataContext).IsMac}" />
            <v:WinAiAccess DataContext="{Binding Access}" IsVisible="{Binding $parent[UserControl].((s:SettingsModel)DataContext).IsWin}" />
          </Panel>

          <!-- Ask your AI: the student's own AI, finding and changing settings (it pads and scrolls itself, with the
               field at the bottom) -->
          <Panel IsVisible="{Binding OnAssistant}">
          <DockPanel Classes="assistant" DataContext="{Binding Assistant}" x:DataType="vm:SettingsChatModel">
            <StackPanel DockPanel.Dock="Top" Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="h" Text="{Binding Title}" HorizontalAlignment="Left" />
                <Button Grid.Column="1" Classes="btn sm" Command="{Binding NewChatCommand}" IsVisible="{Binding Thread.Count, Converter={x:Static c:Converters.Some}}"
                        VerticalAlignment="Center"><TextBlock Text="New chat" /></Button>
              </Grid>
              <TextBlock Classes="body lede" Text="{Binding Lede}" />
            </StackPanel>

            <!-- The field, at the bottom while the AI is ready -->
            <StackPanel DockPanel.Dock="Bottom" Spacing="8" IsVisible="{Binding IsReady}" Margin="0,12,0,0">
              <StackPanel Spacing="6" IsVisible="{Binding HasProblem}">
                <c:PageText Classes="say" Text="{Binding Problem}" Foreground="{DynamicResource Warn}" Margin="0" />
                <Button Classes="btn sm" Command="{Binding SetUpCommand}" IsVisible="{Binding ProblemNeedsSetup}" HorizontalAlignment="Left"><TextBlock Text="Run setup" /></Button>
              </StackPanel>
              <Border Classes="settings-ask">
                <Grid ColumnDefinitions="*,6,Auto">
                  <TextBox Name="AskBox" c:OneLinePaste.IsOn="True" Classes="bare" Text="{Binding Draft}" PlaceholderText="{Binding Placeholder}" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxHeight="96" AutomationProperties.Name="Ask your AI">
                    <TextBox.KeyBindings>
                      <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
                    </TextBox.KeyBindings>
                  </TextBox>
                  <Panel Grid.Column="2" VerticalAlignment="Bottom">
                    <Button Classes="ask-send" Command="{Binding SendCommand}" IsVisible="{Binding !Busy}" ToolTip.Tip="Send" AutomationProperties.Name="Send">
                      <c:Icon Glyph="arrow_upward" Size="17" Foreground="{DynamicResource Surface}" />
                    </Button>
                    <Button Classes="ask-send" Command="{Binding StopCommand}" IsVisible="{Binding Busy}" ToolTip.Tip="Stop" AutomationProperties.Name="Stop the answer">
                      <c:Icon Glyph="stop" Filled="True" Size="16" Foreground="{DynamicResource Surface}" />
                    </Button>
                  </Panel>
                </Grid>
              </Border>
            </StackPanel>

            <Panel Margin="0,16,0,0">
              <!-- Looking for the student's AI -->
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsLooking}" VerticalAlignment="Top">
                <c:SyftLoader Kind="HoppingBits" Size="20" />
                <TextBlock Classes="say" Text="Looking for your AI…" Margin="0" />
              </StackPanel>

              <!-- No AI here yet: setup installs one and signs in -->
              <StackPanel Spacing="10" IsVisible="{Binding IsNoAi}" VerticalAlignment="Top">
                <TextBlock Classes="body" Text="{Binding NoAiText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="btn sm ink" Command="{Binding SetUpCommand}"><TextBlock Text="Set it up" /></Button>
                  <Button Classes="btn sm" Command="{Binding LookAgainCommand}"><TextBlock Text="Look again" /></Button>
                </StackPanel>
              </StackPanel>

              <!-- Before anything's asked: a few things to try -->
              <StackPanel Spacing="10" IsVisible="{Binding ShowWelcome}" VerticalAlignment="Top">
                <c:SyftMark Size="84" HorizontalAlignment="Left" />
                <TextBlock Classes="say" Text="Try asking:" Margin="0" />
                <ItemsControl ItemsSource="{Binding Suggestions}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Button Classes="btn sm" Margin="0,0,8,8" Command="{Binding $parent[DockPanel].((vm:SettingsChatModel)DataContext).SuggestCommand}" CommandParameter="{Binding}">
                        <TextBlock Text="{Binding}" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- The conversation, newest at the bottom: one drag selects from message to message -->
              <ScrollViewer Name="AssistantThread" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" c:FollowEnd.IsOn="True"
                            IsVisible="{Binding Thread.Count, Converter={x:Static c:Converters.Some}}">
                <ItemsControl ItemsSource="{Binding Thread}" c:TextSelection.Area="True">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="14" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.DataTemplates>
                    <DataTemplate DataType="vm:StudentEntry">
                      <Border Classes="bubble">
                        <c:PageText Text="{Binding Text}" FontSize="15" LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource Ink}" />
                      </Border>
                    </DataTemplate>
                    <DataTemplate DataType="vm:AiEntry">
                      <!-- The replies: the pixel s beside each -->
                      <Grid ColumnDefinitions="Auto,10,*" HorizontalAlignment="Left">
                      <c:SyftMark Size="28" Bits="False" VerticalAlignment="Top" />
                      <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Left" MaxWidth="520">
                        <TextBlock Text="{Binding Byline}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource InkSubtle}" />
                        <c:PageText Text="{Binding Text}" FontSize="15" LineHeight="22" TextWrapping="Wrap" Foreground="{DynamicResource Ink}"
                                    IsVisible="{Binding Text, Converter={x:Static c:Converters.NotEmpty}}" />
                        <ItemsControl ItemsSource="{Binding Chips}" IsVisible="{Binding HasChips}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <Border Classes="chip" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                  <c:Icon Glyph="check" Size="12" Foreground="{DynamicResource Ink}" />
                                  <TextBlock Text="{Binding}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource InkMuted}" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.DataTemplates>
                </ItemsControl>
              </ScrollViewer>
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Busy}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0,0,0,-4">
                <c:SyftLoader Kind="HoppingBits" Size="22" IsActive="{Binding Busy}" />
              </StackPanel>
            </Panel>
          </DockPanel>
          </Panel>
          </Panel>
        </Border>
      </Grid>
    </DockPanel>
  </Border>
</UserControl>
