<!-- Settings → AI engines (design 13, Windows): who writes the notes, the rich notes switches and who designs them, who answers
     questions, every engine's state and what to do about it, and the Ollama fallback. The pane's own padding and scrolling; the settings window is
     the host's. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             x:Class="StudyStash.App.Views.WinAiEngines"
             x:DataType="vm:AiEnginesModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://StudyStash/Views/WinAiStyles.axaml" />
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36,28,36,20" Spacing="4" MaxWidth="680">

      <TextBlock Classes="ai-title" Text="Your AI" />
      <TextBlock Classes="ai-sub" MaxWidth="560" Margin="0,4,0,0"
                 Text="{Binding Lede}" />

      <TextBlock Text="{Binding OlderLibraryWords}" Classes="ai-sub" Margin="0,8,0,0" IsVisible="{Binding OlderLibrary}" />
      <TextBlock Text="Your library isn't answering. Check it's on and connected." Classes="ai-sub" Margin="0,8,0,0" IsVisible="{Binding Offline}" />

      <!-- Who does what -->
      <TextBlock Classes="ai-section" Text="Who does what" Margin="0,18,0,8" />
      <Border Classes="ai-card">
        <Grid Classes="ai-row" ColumnDefinitions="Auto,16,*,Auto">
          <c:Icon Glyph="edit_note" Size="20" />
          <StackPanel Classes="ai-row-text" Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Classes="ai-row-title" Text="Writes your notes" />
            <TextBlock Classes="ai-row-sub" Text="After each lecture, on your library" />
          </StackPanel>
          <Button AutomationProperties.Name="Writes your notes" Grid.Column="3" Classes="ai-select-btn" VerticalAlignment="Center">
            <Border Classes="ai-select">
              <Grid ColumnDefinitions="*,8,Auto">
                <TextBlock Text="{Binding SelectedNotesName}" TextTrimming="CharacterEllipsis" />
                <c:Icon Grid.Column="2" Glyph="expand_more" Size="16" Foreground="{DynamicResource Fg2}" />
              </Grid>
            </Border>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterTheme="{StaticResource AiMenuFlyout}" ItemsSource="{Binding NotesChoices}" ItemContainerTheme="{StaticResource AiChoiceItem}" />
            </Button.Flyout>
          </Button>
        </Grid>
      </Border>
      <Border Classes="ai-card" Margin="0,8,0,0">
        <Grid Classes="ai-row" ColumnDefinitions="Auto,16,*,Auto">
          <c:Icon Glyph="forum" Size="20" />
          <StackPanel Classes="ai-row-text" Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Classes="ai-row-title" Text="Answers your questions" />
            <TextBlock Classes="ai-row-sub" Text="Ask bar, recorder chat and quick panel" />
          </StackPanel>
          <Button AutomationProperties.Name="Answers your questions" Grid.Column="3" Classes="ai-select-btn" VerticalAlignment="Center">
            <Border Classes="ai-select">
              <Grid ColumnDefinitions="*,8,Auto">
                <TextBlock Text="{Binding SelectedAskName}" TextTrimming="CharacterEllipsis" />
                <c:Icon Grid.Column="2" Glyph="expand_more" Size="16" Foreground="{DynamicResource Fg2}" />
              </Grid>
            </Border>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterTheme="{StaticResource AiMenuFlyout}" ItemsSource="{Binding AskChoices}" ItemContainerTheme="{StaticResource AiChoiceItem}" />
            </Button.Flyout>
          </Button>
        </Grid>
      </Border>

      <!-- Rich notes: diagrams, formula plots and drawings after the notes, and who designs them -->
      <StackPanel IsVisible="{Binding HasRich}">
        <TextBlock Classes="ai-section" Text="Rich notes" Margin="0,18,0,8" />
        <Border Classes="ai-card" Margin="0">
          <Grid Classes="ai-row" ColumnDefinitions="Auto,16,*,Auto">
            <c:Icon Glyph="auto_awesome" Size="20" />
            <StackPanel Classes="ai-row-text" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock Classes="ai-row-title" Text="Rich notes" />
              <TextBlock Classes="ai-row-sub" Text="{Binding RichAbout}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock Text="{Binding RichOn, Converter={x:Static c:Converters.OnOff}}" FontSize="14" />
              <ToggleButton AutomationProperties.Name="Rich notes" Theme="{StaticResource AiToggle}" IsChecked="{Binding RichOn}" />
            </StackPanel>
          </Grid>
        </Border>
        <StackPanel IsVisible="{Binding ShowKinds}">
        <Border Classes="ai-card" Margin="0,8,0,0">
          <Grid Classes="ai-row" ColumnDefinitions="Auto,16,*,Auto">
            <c:Icon Glyph="hub" Size="20" />
            <StackPanel Classes="ai-row-text" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock Classes="ai-row-title" Text="Diagrams" />
              <TextBlock Classes="ai-row-sub" Text="Flowcharts, state and sequence diagrams, timelines and mind maps" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock Text="{Binding RichDiagrams, Converter={x:Static c:Converters.OnOff}}" FontSize="14" />
              <ToggleButton AutomationProperties.Name="Diagrams" Theme="{StaticResource AiToggle}" IsChecked="{Binding RichDiagrams}" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Classes="ai-card" Margin="0,8,0,0">
          <Grid Classes="ai-row" ColumnDefinitions="Auto,16,*,Auto">
            <c:Icon Glyph="tune" Size="20" />
            <StackPanel Classes="ai-row-text" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock Classes="ai-row-title" Text="Formula plots" />
              <TextBlock Classes="ai-row-sub" Text="A curve or distribution drawn from the lecturer's formula, with sliders" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock Text="{Binding RichPlots, Converter={x:Static c:Converters.OnOff}}" FontSize="14" />
              <ToggleButton AutomationProperties.Name="Formula plots" Theme="{StaticResource AiToggle}" IsChecked="{Binding RichPlots}" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Classes="ai-card" Margin="0,8,0,0">
          <Grid Classes="ai-row" ColumnDefinitions="Auto,16,*,Auto">
            <c:Icon Glyph="palette" Size="20" />
            <StackPanel Classes="ai-row-text" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock Classes="ai-row-title" Text="Drawings" />
              <TextBlock Classes="ai-row-sub" Text="Labelled figures of what a lecture describes (not with the free AI)" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock Text="{Binding RichDrawings, Converter={x:Static c:Converters.OnOff}}" FontSize="14" />
              <ToggleButton AutomationProperties.Name="Drawings" Theme="{StaticResource AiToggle}" IsChecked="{Binding RichDrawings}" />
            </StackPanel>
          </Grid>
        </Border>
        </StackPanel>
        <StackPanel IsVisible="{Binding ShowDrawnBy}">
        <Border Classes="ai-card" Margin="0,8,0,0">
          <Grid Classes="ai-row" ColumnDefinitions="Auto,16,*,Auto">
            <c:Icon Glyph="memory" Size="20" />
            <StackPanel Classes="ai-row-text" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock Classes="ai-row-title" Text="Drawn by" />
              <TextBlock Classes="ai-row-sub" Text="{Binding DiagramsAbout}" TextWrapping="Wrap" />
            </StackPanel>
            <Button AutomationProperties.Name="Drawn by" Grid.Column="3" Classes="ai-select-btn" VerticalAlignment="Center">
              <Border Classes="ai-select">
                <Grid ColumnDefinitions="*,8,Auto">
                  <TextBlock Text="{Binding SelectedDiagramsName}" TextTrimming="CharacterEllipsis" />
                  <c:Icon Grid.Column="2" Glyph="expand_more" Size="16" Foreground="{DynamicResource Fg2}" />
                </Grid>
              </Border>
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterTheme="{StaticResource AiMenuFlyout}" ItemsSource="{Binding DiagramsChoices}" ItemContainerTheme="{StaticResource AiChoiceItem}" />
              </Button.Flyout>
            </Button>
          </Grid>
        </Border>
        </StackPanel>
      </StackPanel>

      <!-- How fast Claude Code writes the notes and designs the rich notes -->
      <StackPanel IsVisible="{Binding HasSpeed}">
        <TextBlock Classes="ai-section" Text="How fast Claude works" Margin="0,18,0,8" />
        <Border Classes="ai-card" Margin="0">
          <Grid Classes="ai-row" ColumnDefinitions="Auto,16,*,Auto">
            <c:Icon Glyph="schedule" Size="20" />
            <StackPanel Classes="ai-row-text" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock Classes="ai-row-title" Text="Notes and diagrams" />
              <TextBlock Classes="ai-row-sub" Text="{Binding SpeedAbout}" TextWrapping="Wrap" />
            </StackPanel>
            <Button AutomationProperties.Name="Notes and diagrams" Grid.Column="3" Classes="ai-select-btn" VerticalAlignment="Center">
              <Border Classes="ai-select">
                <Grid ColumnDefinitions="*,8,Auto">
                  <TextBlock Text="{Binding SelectedSpeedName}" TextTrimming="CharacterEllipsis" />
                  <c:Icon Grid.Column="2" Glyph="expand_more" Size="16" Foreground="{DynamicResource Fg2}" />
                </Grid>
              </Border>
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterTheme="{StaticResource AiMenuFlyout}" ItemsSource="{Binding SpeedChoices}" ItemContainerTheme="{StaticResource AiChoiceItem}" />
              </Button.Flyout>
            </Button>
          </Grid>
        </Border>
      </StackPanel>

      <!-- Engines -->
      <Grid ColumnDefinitions="*,Auto" Margin="0,18,0,8">
        <TextBlock Classes="ai-section" Text="AIs on your library" />
        <Button Grid.Column="1" Classes="ai-textbtn" IsVisible="{Binding HasAddChoices}">
          <TextBlock Classes="ai-link" Text="Add another AI" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterTheme="{StaticResource AiMenuFlyout}" ItemsSource="{Binding AddChoices}" ItemContainerTheme="{StaticResource AiAddItem}">
              <MenuFlyout.ItemTemplate>
                <DataTemplate x:DataType="vm:AiEngineRow">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Name, StringFormat='Get {0}'}" FontSize="14" />
                        <TextBlock Text="{Binding About}" FontSize="12" Foreground="{DynamicResource Fg2}" />
                      </StackPanel>
                </DataTemplate>
              </MenuFlyout.ItemTemplate>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
      <ItemsControl ItemsSource="{Binding Engines}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AiEngineRow">
            <Border Classes="ai-card" Margin="{Binding First, Converter={x:Static c:Converters.FirstCardMargin}}">
              <Grid Classes="ai-row" ColumnDefinitions="Auto,16,*,Auto">
                <c:Icon Glyph="{Binding Icon}" Size="20" />
                <StackPanel Classes="ai-row-text" Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Classes="ai-row-title" Text="{Binding Name}" />
                  <TextBlock Classes="ai-row-sub" Text="{Binding About}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Classes="ai-dot" Classes.good="{Binding Good}" Classes.warn="{Binding Warn}" />
                    <TextBlock Classes="ai-state" Classes.warn="{Binding Warn}" Text="{Binding StateWords}" />
                  </StackPanel>
                  <Button Classes="ai-pillbtn" Command="{Binding ActCommand}" IsVisible="{Binding !NeedsOptions}">
                    <Border Classes="ai-pill" Classes.primary="{Binding IsPrimary}">
                      <TextBlock Text="{Binding ActionWords}" />
                    </Border>
                  </Button>
                  <Button Classes="ai-pillbtn" IsVisible="{Binding NeedsOptions}">
                    <Border Classes="ai-pill">
                      <TextBlock Text="{Binding ActionWords}" />
                    </Border>
                    <Button.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterTheme="{StaticResource AiMenuFlyout}">
                        <MenuItem Theme="{StaticResource AiMenuItem}" Header="Check it works" Command="{Binding CheckCommand}" />
                        <MenuItem Theme="{StaticResource AiMenuItem}" Header="Models" ItemsSource="{Binding ModelChoices}" IsVisible="{Binding HasModels}" ItemContainerTheme="{StaticResource AiModelItem}" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- API keys: an engine can run on a key instead of (or as well as) its app -->
      <StackPanel IsVisible="{Binding HasKeys}">
        <TextBlock Classes="ai-section" Text="API keys" Margin="0,18,0,8" />
        <ItemsControl ItemsSource="{Binding Keys}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ApiKeyRow">
              <Border Classes="ai-card" Margin="0,0,0,2">
                <Grid Classes="ai-row" ColumnDefinitions="Auto,16,*,Auto">
                  <c:Icon Glyph="key" Size="20" />
                  <StackPanel Classes="ai-row-text" Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Classes="ai-row-title" Text="{Binding Name}" />
                    <TextBlock Classes="ai-row-sub" Text="{Binding Sub}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="200" Height="30" CornerRadius="{DynamicResource RadiusControl}" BorderThickness="1" Padding="9,0" Background="{DynamicResource Ctrl}" BorderBrush="{DynamicResource CtrlBorder}">
                      <TextBox Classes="bare" VerticalAlignment="Center" Text="{Binding Draft}" PasswordChar="•" FontSize="14"
                               PlaceholderText="{Binding HasKey, Converter={x:Static vm:KeyWords.Placeholder}}"
                               AutomationProperties.Name="{Binding Name, StringFormat='{}{0} API key'}">
                        <TextBox.KeyBindings>
                          <KeyBinding Gesture="Enter" Command="{Binding SaveCommand}" />
                        </TextBox.KeyBindings>
                      </TextBox>
                    </Border>
                    <Button Classes="ai-pillbtn" Command="{Binding SaveCommand}">
                      <Border Classes="ai-pill primary"><TextBlock Text="Save" /></Border>
                    </Button>
                    <Button Classes="ai-pillbtn" Command="{Binding RemoveCommand}" IsVisible="{Binding HasKey}">
                      <Border Classes="ai-pill"><TextBlock Text="Remove" /></Border>
                    </Button>
                    <Button Classes="ai-textbtn" Command="{Binding GetKeyCommand}" IsVisible="{Binding !HasKey}">
                      <TextBlock Classes="ai-link" Text="Get a key" />
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- If an engine isn’t available -->
      <TextBlock Classes="ai-section" Text="If your AI isn’t available" Margin="0,18,0,8" />
      <Border Classes="ai-card">
        <Grid Classes="ai-row" ColumnDefinitions="Auto,16,*,Auto">
          <c:Icon Glyph="swap_horiz" Size="20" />
          <StackPanel Classes="ai-row-text" Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Classes="ai-row-title" Text="Use the free AI (Ollama) instead" />
            <TextBlock Classes="ai-row-sub" Text="So notes and answers never stall" />
          </StackPanel>
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="{Binding Fallback, Converter={x:Static c:Converters.OnOff}}" FontSize="14" />
            <ToggleButton AutomationProperties.Name="Use the free AI (Ollama) instead" Theme="{StaticResource AiToggle}" IsChecked="{Binding Fallback}" />
          </StackPanel>
        </Grid>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
