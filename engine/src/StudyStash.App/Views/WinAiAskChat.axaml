<!-- The recorder's compact chat and the quick panel's ask (design 16): a 360-wide thread of question/answer bubbles
     with the byline, and a small field with an engine chip and send icon (no scope chip: it always asks about this
     lecture, live while it's recording). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:v="using:StudyStash.App.Views"
             x:Class="StudyStash.App.Views.WinAiAskChat"
             x:DataType="vm:AiAskModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://StudyStash/Views/WinAiStyles.axaml" />
    <!-- Its own card in styles, not on the Border, so the recorder's embedded chat stays without one when the theme
         changes (a resource set on the Border itself would come back with it) -->
    <Style Selector="Border#Card">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource Acrylic}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FlyStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="{DynamicResource ShadowLg}" />
      <Setter Property="Padding" Value="14,16,16,16" />
      <Setter Property="Width" Value="360" />
    </Style>
    <Style Selector="Border#Card.embedded">
      <Setter Property="Background" Value="{x:Null}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BoxShadow" Value="none" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="NaN" />
    </Style>
  </UserControl.Styles>
  <!-- Esc closes the chat, the same as its close button -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseChatCommand}" />
  </UserControl.KeyBindings>

  <Border Name="Card">
    <StackPanel Spacing="10">
      <!-- The conversation, with a close button (and Esc) that gives the transcript its room back; kept for this
           lecture, so asking again or "Show the chat" brings it back. A long one scrolls, newest at the bottom. -->
      <Grid Name="ChatHeader" ColumnDefinitions="*,Auto" IsVisible="{Binding HasLatest}" Margin="0,0,0,-4">
        <TextBlock Classes="ai-asked" Text="Chat" VerticalAlignment="Center" />
        <Button Name="CloseChat" Grid.Column="1" Classes="ai-close" VerticalAlignment="Center" ToolTip.Tip="Close chat" AutomationProperties.Name="Close chat"
                Command="{Binding CloseChatCommand}">
          <c:Icon Glyph="close" Size="14" Foreground="{DynamicResource Fg2}" />
        </Button>
      </Grid>
      <ScrollViewer Name="Thread" MaxHeight="240" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" c:FollowEnd.IsOn="True"
                  IsVisible="{Binding HasLatest}">
        <ItemsControl ItemsSource="{Binding Turns}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AiTurn">
              <StackPanel Spacing="10">
                <Border Classes="ai-bubble-q" MaxWidth="280">
                  <TextBlock Text="{Binding Question}" />
                </Border>
                <Border Classes="ai-bubble-a" MaxWidth="330" IsVisible="{Binding !IsThinking}">
                  <StackPanel Spacing="6">
                    <c:NoteView Compact="True" BodySize="14" BodyLineHeight="20.3" Markdown="{Binding Answer}" IsVisible="{Binding Answer, Converter={x:Static c:Converters.NotEmpty}}" />
                    <TextBlock Classes="ai-answer" Text="{Binding Failed}" Foreground="{DynamicResource Warn}"
                               IsVisible="{Binding Failed, Converter={x:Static c:Converters.NotEmpty}}" />
                    <Button Theme="{StaticResource Surface}" Padding="0" HorizontalContentAlignment="Left"
                            Command="{Binding $parent[UserControl].((vm:AiAskModel)DataContext).OpenTurnSourceCommand}" CommandParameter="{Binding}"
                            IsVisible="{Binding Byline, Converter={x:Static c:Converters.NotEmpty}}">
                      <TextBlock Classes="ai-byline" Text="{Binding Byline}" />
                    </Button>
                    <TextBlock Classes="ai-byline" Text="{Binding FellBackNote}" IsVisible="{Binding FellBackNote, Converter={x:Static c:Converters.NotEmpty}}" />
                  </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsThinking}">
                  <c:Spinner Width="14" Height="14" Foreground="{DynamicResource Fg2}" />
                  <TextBlock Classes="ai-thinking" Text="{Binding ThinkingWords}" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <Button Name="ShowChat" Theme="{StaticResource Surface}" Padding="0" HorizontalAlignment="Left" IsVisible="{Binding CanShowChat}"
              Command="{Binding ShowChatCommand}" AutomationProperties.Name="Show the chat">
        <TextBlock Classes="ai-byline" Text="Show the chat" />
      </Button>

      <Border Classes="ai-field">
        <Grid ColumnDefinitions="*,4,Auto,4,Auto" VerticalAlignment="Center">
          <TextBox Classes="bare" Text="{Binding Question}" PlaceholderText="{Binding Placeholder}" FontSize="14" VerticalAlignment="Center">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding AskCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button Name="EngineChip" Grid.Column="2" Classes="ai-chipbtn" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4" Height="30" Margin="6,0">
              <c:Icon Glyph="auto_awesome" Size="14" Foreground="{DynamicResource AccentText}" />
              <TextBlock Text="{Binding EngineName}" TextTrimming="CharacterEllipsis" MaxWidth="90" FontSize="13" VerticalAlignment="Center" />
              <c:Icon Glyph="expand_more" Size="15" Foreground="{DynamicResource Fg2}" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="Top" VerticalOffset="-20" ShowMode="Standard" FlyoutPresenterClasses="bare">
                <ContentControl Content="{Binding Menu}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:EngineMenuModel">
                      <v:WinAiEngineMenu />
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button AutomationProperties.Name="Send question" Grid.Column="4" Classes="ai-send" Command="{Binding AskCommand}" Height="30" VerticalAlignment="Center" IsVisible="{Binding !Busy}">
            <c:Icon Glyph="send" Size="18" Foreground="{DynamicResource Fg}" />
          </Button>
          <!-- While an answer is being written, the same place stops it -->
          <Button Grid.Column="4" Classes="ai-send" Command="{Binding StopCommand}" Height="30" VerticalAlignment="Center" IsVisible="{Binding Busy}"
                  ToolTip.Tip="Stop" AutomationProperties.Name="Stop the answer">
            <c:Icon Glyph="stop" Filled="True" Size="18" Foreground="{DynamicResource Fg}" />
          </Button>
        </Grid>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
