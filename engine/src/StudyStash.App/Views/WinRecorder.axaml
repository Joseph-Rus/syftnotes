<!-- The floating recorder (Windows): small, a white pill with a red dot (Stop), the class, a level meter and the time;
     open, 360 × 520, the transcript fading upward, and a chat on the footer band. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:v="using:StudyStash.App.Views"
             x:Class="StudyStash.App.Views.WinRecorder"
             x:DataType="vm:RecorderModel"
             ClipToBounds="False">
  <!-- Esc anywhere in the recorder closes its chat (the chat's own close button does the same) -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding Ask.CloseChatCommand}" />
  </UserControl.KeyBindings>
  <UserControl.Styles>
    <Style Selector="Button.stop">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.control">
      <Setter Property="Background" Value="{DynamicResource Ctrl}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CtrlBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.old">
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    </Style>
    <Style Selector="TextBlock.paused">
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    </Style>
    <Style Selector="Button.square">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
  <Panel>
    <!-- The pill: a small white capsule floating over whatever else is on screen, and red only in its dot. The dot is
         Stop (a stop square in it while it records; a red ring round a red centre while it's paused), then the class
         by its short name, a level meter that moves with what the microphone hears, and the time. A click anywhere
         else on it opens the recorder; a drag moves it. Paused, "Paused" takes the class's place and the meter rests,
         each in the room the other had, so the pill never changes size under the pointer. -->
    <Border Name="Pill" IsVisible="{Binding !Expanded}" Classes.recording="{Binding IsRunning}" Classes.paused="{Binding IsPaused}" Height="44" CornerRadius="22"
            Padding="6,0" Background="{DynamicResource Surface}" BoxShadow="{DynamicResource ShadowFloat}" HorizontalAlignment="Left"
            AutomationProperties.Name="{Binding PillSaid}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button AutomationProperties.Name="Stop" Classes="stop" Command="{Binding StopCommand}" ToolTip.Tip="Stop" VerticalAlignment="Center">
          <Border Classes="record-dot mini"><Border /></Border>
        </Button>
        <Panel VerticalAlignment="Center">
          <TextBlock Name="PillClass" Text="{Binding ShortClass}" FontSize="14" FontWeight="Bold" MaxWidth="150" TextTrimming="CharacterEllipsis"
                     Opacity="{Binding IsRunning, Converter={x:Static c:Converters.Shown}}" />
          <TextBlock Text="Paused" FontSize="14" FontWeight="Bold" Opacity="{Binding IsPaused, Converter={x:Static c:Converters.Shown}}" />
        </Panel>
        <c:Waveform Bars="3" Height="16" MinBar="5" Levels="{Binding Levels}" Foreground="{DynamicResource Record}" VerticalAlignment="Center"
                    Opacity="{Binding IsRunning, Converter={x:Static c:Converters.Shown}}" />
        <TextBlock Name="PillTime" Text="{Binding Elapsed}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource InkMuted}" MinWidth="40"
                   VerticalAlignment="Center" Margin="0,0,6,0" />
      </StackPanel>
    </Border>

    <!-- Expanded -->
    <Border IsVisible="{Binding Expanded}" Width="360" Height="520" CornerRadius="8" Background="{DynamicResource Acrylic}" BoxShadow="{DynamicResource ShadowLg}"
            BorderBrush="{DynamicResource FlyStroke}" BorderThickness="1" ClipToBounds="True">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Height="48" Margin="16,0,8,0" ColumnDefinitions="Auto,10,Auto,10,Auto,*,Auto">
          <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Rec}" VerticalAlignment="Center" IsVisible="{Binding IsRunning}" />
          <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Fg3}" VerticalAlignment="Center" IsVisible="{Binding IsPaused}" />
          <TextBlock Grid.Column="2" Text="{Binding DisplayClass}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Grid.Column="4" Classes="num" Text="{Binding Elapsed}" FontSize="14" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4">
            <Button AutomationProperties.Name="Make it small" Classes="square" Command="{Binding ToggleCommand}" ToolTip.Tip="Make it small">
              <c:Icon Glyph="close_fullscreen" Size="16" Foreground="{DynamicResource Fg2}" />
            </Button>
            <Button AutomationProperties.Name="{Binding PauseTip}" Classes="square control" Command="{Binding PauseCommand}" ToolTip.Tip="{Binding PauseTip}">
              <c:Icon Glyph="{Binding PauseGlyph}" Filled="True" Size="16" Foreground="{DynamicResource Fg}" />
            </Button>
            <Button AutomationProperties.Name="Stop" Classes="square" Background="{DynamicResource Record}" Command="{Binding StopCommand}" ToolTip.Tip="Stop">
              <c:Icon Glyph="stop" Filled="True" Size="12" Foreground="{DynamicResource OnRecord}" />
            </Button>
          </StackPanel>
        </Grid>

        <!-- Ask about this lecture, with any engine (design 16); none for one written down after class -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Footer}" BorderBrush="{DynamicResource Sep}" BorderThickness="0,1,0,0"
                IsVisible="{Binding Live}">
          <v:WinAiAskChat Name="AskChat" Margin="16,14,16,16" DataContext="{Binding Ask}" />
        </Border>

        <!-- What's been said, newest at the bottom, fading out toward the top -->
        <ScrollViewer Name="Heard" Padding="16,0,16,16" VerticalScrollBarVisibility="Hidden">
          <ScrollViewer.OpacityMask>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Color="Transparent" Offset="0" />
              <GradientStop Color="Black" Offset="0.55" />
            </LinearGradientBrush>
          </ScrollViewer.OpacityMask>
          <Panel VerticalAlignment="Bottom">
            <TextBlock IsVisible="{Binding NoLines}" Text="{Binding Waiting}" FontSize="13" Foreground="{DynamicResource Fg3}" TextWrapping="Wrap" />
            <!-- One drag selects from line to line (a line copied from its start keeps its time); the room between
                 them is left to the recorder's background, which moves it. -->
            <ItemsControl ItemsSource="{Binding Lines}" Background="{x:Null}" c:TextSelection.Area="True">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HeardLine">
                  <Grid ColumnDefinitions="36,10,*">
                    <TextBlock Classes="num" Text="{Binding Time}" FontSize="12" Foreground="{DynamicResource Fg3}" Margin="0,2,0,0" />
                    <c:PageText Grid.Column="2" Text="{Binding Text}" CopyLead="{Binding CopyLead}" FontSize="14" LineHeight="20.3" TextWrapping="Wrap"
                               Classes.old="{Binding !Latest}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Panel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Panel>
</UserControl>
