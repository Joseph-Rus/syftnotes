<!-- The floating recorder (Windows): small, a white pill with a red cell (Stop), the class, a level meter and the time;
     open, 360 × 520 in the Syft look shared with the Mac (Styles.axaml's rec-* classes): the recording cell, the class and
     a cell meter, one strip of controls, the transcript in three greys, and the chat. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:v="using:StudyStash.App.Views"
             x:Class="StudyStash.App.Views.WinRecorder"
             x:DataType="vm:RecorderModel"
             ClipToBounds="False">
  <!-- Esc anywhere in the recorder closes its chat (the chat's own close button does the same) -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding Ask.CloseChatCommand}" />
  </UserControl.KeyBindings>
  <UserControl.Styles>
    <Style Selector="Button.stop">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="c:Cell.Round" Value="True" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
  <Panel>
    <!-- The pill: a small white capsule floating over whatever else is on screen, and red only in its dot. The dot is
         Stop (a stop square in it while it records; a red ring round a red centre while it's paused), then the class
         by its short name, a level meter that moves with what the microphone hears, and the time. A click anywhere
         else on it opens the recorder; a drag moves it. Paused, "Paused" takes the class's place and the meter rests,
         each in the room the other had, so the pill never changes size under the pointer. -->
    <Border Name="Pill" IsVisible="{Binding !Expanded}" Classes.recording="{Binding IsRunning}" Classes.paused="{Binding IsPaused}" Height="44" CornerRadius="22"
            Padding="6,0" Background="{DynamicResource Surface}" BoxShadow="{DynamicResource ShadowFloat}" HorizontalAlignment="Left"
            AutomationProperties.Name="{Binding PillSaid}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button AutomationProperties.Name="Stop" Classes="stop" Command="{Binding StopCommand}" ToolTip.Tip="Stop" VerticalAlignment="Center">
          <Border Classes="record-dot mini"><Border /></Border>
        </Button>
        <Panel VerticalAlignment="Center">
          <TextBlock Name="PillClass" Text="{Binding ShortClass}" ToolTip.Tip="{Binding ShortClass}" c:Tips.WhenCut="True" FontSize="{DynamicResource FontBody}" FontWeight="Bold" MaxWidth="150" TextTrimming="CharacterEllipsis"
                     Opacity="{Binding IsRunning, Converter={x:Static c:Converters.Shown}}" />
          <TextBlock Text="Paused" FontSize="{DynamicResource FontBody}" FontWeight="Bold" Opacity="{Binding IsPaused, Converter={x:Static c:Converters.Shown}}" />
        </Panel>
        <c:Waveform Bars="3" Height="16" Lively="True" Levels="{Binding Levels}" Foreground="{DynamicResource Record}" VerticalAlignment="Center"
                    Opacity="{Binding IsRunning, Converter={x:Static c:Converters.Shown}}" />
        <TextBlock Name="PillTime" Text="{Binding Elapsed}" FontSize="{DynamicResource FontBody}" FontWeight="Medium" Foreground="{DynamicResource InkMuted}" MinWidth="40"
                   VerticalAlignment="Center" Margin="0,0,6,0" />
      </StackPanel>
    </Border>

    <!-- Open: the same Syft look as the Mac's (Styles.axaml's rec-* classes), in Windows' own corners and hairline -->
    <Border IsVisible="{Binding Expanded}" Width="360" Height="520" CornerRadius="{DynamicResource RadiusControl}" Background="{DynamicResource Surface}"
            BoxShadow="{DynamicResource ShadowLg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" ClipToBounds="True">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Height="56" Margin="16,0,10,0" ColumnDefinitions="Auto,10,Auto,10,Auto,10,Auto,*,Auto">
          <c:SyftCell Width="10" Height="10" Fill="{DynamicResource Recording}" VerticalAlignment="Center" IsVisible="{Binding IsRunning}" />
          <c:SyftCell Width="10" Height="10" Fill="{DynamicResource InkSubtle}" VerticalAlignment="Center" IsVisible="{Binding IsPaused}" />
          <TextBlock Grid.Column="2" Classes="rec-title" Text="{Binding DisplayClass}" MaxWidth="120" ToolTip.Tip="{Binding DisplayClass}" c:Tips.WhenCut="True" />
          <c:Waveform Grid.Column="4" Bars="3" Height="18" Lively="True" Levels="{Binding Levels}" Foreground="{DynamicResource Recording}"
                      VerticalAlignment="Center" IsVisible="{Binding IsRunning}" AutomationProperties.AccessibilityView="Raw" />
          <TextBlock Grid.Column="6" Classes="num rec-time" Text="{Binding Elapsed}" />
          <Border Grid.Column="8" Classes="rec-strip">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button AutomationProperties.Name="Make it small" Classes="rec-quiet" Command="{Binding ToggleCommand}" ToolTip.Tip="Make it small">
                <c:Icon Glyph="close_fullscreen" Size="16" />
              </Button>
              <Button AutomationProperties.Name="{Binding PauseTip}" Classes="rec-quiet" Command="{Binding PauseCommand}" ToolTip.Tip="{Binding PauseTip}">
                <c:Icon Glyph="{Binding PauseGlyph}" Filled="True" Size="17" />
              </Button>
              <Button AutomationProperties.Name="Stop" Classes="rec-stop" Command="{Binding StopCommand}" ToolTip.Tip="Stop">
                  <!-- Its ink square -->
                  <c:Icon Glyph="stop" Filled="True" Size="16" Foreground="{DynamicResource OnRecording}" />
                </Button>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Ask about this lecture, with any engine (design 16); none for one written down after class -->
        <v:WinAiAskChat Name="AskChat" DockPanel.Dock="Bottom" Margin="12,4,12,12" DataContext="{Binding Ask}" IsVisible="{Binding Live}" />

        <!-- What's been said, newest at the bottom: bold in ink, the older lines in three steps of grey -->
        <ScrollViewer Name="Heard" Padding="16,0,16,16" VerticalScrollBarVisibility="Hidden">
          <Panel VerticalAlignment="Bottom">
            <TextBlock IsVisible="{Binding NoLines}" Text="{Binding Waiting}" FontSize="{DynamicResource FontBody}" Foreground="{DynamicResource InkMuted}" TextWrapping="Wrap" />
            <!-- One drag selects from line to line (a line copied from its start keeps its time); the room between
                 them is left to the recorder's background, which moves it. -->
            <ItemsControl ItemsSource="{Binding Lines}" Background="{x:Null}" c:TextSelection.Area="True">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HeardLine">
                  <Grid ColumnDefinitions="36,10,*">
                    <TextBlock Classes="num heard-time" Text="{Binding Time}" />
                    <c:PageText Grid.Column="2" Classes="heard" Text="{Binding Text}" CopyLead="{Binding CopyLead}"
                               Classes.old="{Binding !Latest}" Classes.fade1="{Binding Fade1}" Classes.fade2="{Binding Fade2}" Classes.fade3="{Binding Fade3}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Panel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Panel>
</UserControl>
