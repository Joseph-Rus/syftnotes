<!-- The floating recorder (Surfaces, Windows 11 02): a small bar, 32 tall, recording or paused; open, 360 × 520, the
     transcript fading upward, and a chat on the footer band. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:v="using:StudyStash.App.Views"
             x:Class="StudyStash.App.Views.WinRecorder"
             x:DataType="vm:RecorderModel"
             ClipToBounds="False">
  <!-- Esc anywhere in the recorder closes its chat (the chat's own close button does the same) -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding Ask.CloseChatCommand}" />
  </UserControl.KeyBindings>
  <UserControl.Styles>
    <Style Selector="Button.stop">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <!-- The recording dot breathes, slowly: it's alive, and never glows. -->
    <Style Selector="Ellipse.pulse">
      <Style.Animations>
        <Animation Duration="0:0:1.6" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Button.control">
      <Setter Property="Background" Value="{DynamicResource Ctrl}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CtrlBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.old">
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    </Style>
    <Style Selector="TextBlock.paused">
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    </Style>
    <Style Selector="Button.square">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
  <Panel>
    <!-- The pill: small, and only says it's recording. The red dot pulses slowly (no glow), then the time and a tiny
         level meter; with the pointer over it Stop takes the meter's place, and a click opens the recorder. -->
    <Border Name="Pill" IsVisible="{Binding !Expanded}" Height="32" CornerRadius="8" Background="{DynamicResource Acrylic}" BoxShadow="{DynamicResource Shadow}"
            BorderBrush="{DynamicResource FlyStroke}" BorderThickness="1" Padding="12,0,5,0" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Panel Width="8" Height="8" VerticalAlignment="Center">
          <Ellipse Classes="pulse" Fill="{DynamicResource Rec}" IsVisible="{Binding IsRunning}" />
          <Ellipse Fill="{DynamicResource Fg3}" IsVisible="{Binding IsPaused}" />
        </Panel>
        <TextBlock Classes="num" Text="{Binding Elapsed}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                   Classes.paused="{Binding IsPaused}" />
        <Panel Width="22" Height="22" VerticalAlignment="Center">
          <c:Waveform Bars="3" Height="10" MinBar="2" Levels="{Binding Levels}" Foreground="{DynamicResource Fg2}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowMeter}" />
          <c:Icon Glyph="pause" Filled="True" Size="12" Foreground="{DynamicResource Fg2}" HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsVisible="{Binding ShowPausedMark}" />
          <Button Classes="stop control" Command="{Binding StopCommand}" ToolTip.Tip="Stop" IsVisible="{Binding Hovered}">
            <c:Icon Glyph="stop" Filled="True" Size="12" Foreground="{DynamicResource Fg}" />
          </Button>
        </Panel>
      </StackPanel>
    </Border>

    <!-- Expanded -->
    <Border IsVisible="{Binding Expanded}" Width="360" Height="520" CornerRadius="8" Background="{DynamicResource Acrylic}" BoxShadow="{DynamicResource ShadowLg}"
            BorderBrush="{DynamicResource FlyStroke}" BorderThickness="1" ClipToBounds="True">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Height="48" Margin="16,0,8,0" ColumnDefinitions="Auto,10,Auto,10,Auto,*,Auto">
          <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Rec}" VerticalAlignment="Center" IsVisible="{Binding IsRunning}" />
          <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Fg3}" VerticalAlignment="Center" IsVisible="{Binding IsPaused}" />
          <TextBlock Grid.Column="2" Text="{Binding DisplayClass}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Grid.Column="4" Classes="num" Text="{Binding Elapsed}" FontSize="14" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4">
            <Button Classes="square" Command="{Binding ToggleCommand}" ToolTip.Tip="Make it small">
              <c:Icon Glyph="close_fullscreen" Size="16" Foreground="{DynamicResource Fg2}" />
            </Button>
            <Button Classes="square control" Command="{Binding PauseCommand}" ToolTip.Tip="{Binding PauseTip}">
              <c:Icon Glyph="{Binding PauseGlyph}" Filled="True" Size="16" Foreground="{DynamicResource Fg}" />
            </Button>
            <Button Classes="square" Background="{DynamicResource Accent}" Command="{Binding StopCommand}" ToolTip.Tip="Stop">
              <c:Icon Glyph="stop" Filled="True" Size="16" Foreground="{DynamicResource OnAccent}" />
            </Button>
          </StackPanel>
        </Grid>

        <!-- Ask about this lecture, with any engine (design 16) -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Footer}" BorderBrush="{DynamicResource Sep}" BorderThickness="0,1,0,0">
          <v:WinAiAskChat Name="AskChat" Margin="16,14,16,16" DataContext="{Binding Ask}" />
        </Border>

        <!-- What's been said, newest at the bottom, fading out toward the top -->
        <ScrollViewer Name="Heard" Padding="16,0,16,16" VerticalScrollBarVisibility="Hidden">
          <ScrollViewer.OpacityMask>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Color="Transparent" Offset="0" />
              <GradientStop Color="Black" Offset="0.55" />
            </LinearGradientBrush>
          </ScrollViewer.OpacityMask>
          <Panel VerticalAlignment="Bottom">
            <TextBlock IsVisible="{Binding NoLines}" Text="{Binding Waiting}" FontSize="13" Foreground="{DynamicResource Fg3}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Lines}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HeardLine">
                  <Grid ColumnDefinitions="36,10,*">
                    <TextBlock Classes="num" Text="{Binding Time}" FontSize="12" Foreground="{DynamicResource Fg3}" Margin="0,2,0,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="14" LineHeight="20.3" TextWrapping="Wrap"
                               Classes.old="{Binding !Latest}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Panel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Panel>
</UserControl>
