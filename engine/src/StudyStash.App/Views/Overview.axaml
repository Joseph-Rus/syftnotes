<!-- Home, Due and a folder's page (both looks): the page that fills the pane beside the sidebar. A title (today's date,
     "Due", or the folder's name underlined in its highlighter) over a sentence or two, with Record (and on a folder's
     page Attach) at its side. Home: Up next (the rest of today's and tomorrow's events, each a button that records
     it) and every note, newest first, with a filter. A folder: its lectures or meetings by week, and a rail with
     what's due, its lists on Canvas and when it next meets. Due: the calendar. Sections are parted by space and
     hairlines: no boxes inside boxes, no metric tiles. Ask floats at the foot of Home and a folder's page. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:s="using:StudyStash.App.Services"
             xmlns:v="using:StudyStash.App.Views"
             x:Class="StudyStash.App.Views.Overview"
             x:DataType="vm:OverviewModel">
  <UserControl.Styles>
    <!-- The page's side margins: the design's 56, drawn in when the window is narrow. -->
    <Style Selector="StackPanel.ov-page">
      <Setter Property="Margin" Value="56,6,56,132" />
    </Style>
    <Style Selector="StackPanel.ov-page.narrow">
      <Setter Property="Margin" Value="24,6,24,132" />
    </Style>
    <Style Selector="StackPanel.ov-ask">
      <Setter Property="Margin" Value="56,0,56,20" />
    </Style>
    <Style Selector="StackPanel.ov-ask.narrow">
      <Setter Property="Margin" Value="24,0,24,20" />
    </Style>
    <!-- The page's buttons: at the title's foot beside it, or a row of their own under it (narrow) -->
    <Style Selector="StackPanel.ov-actions">
      <Setter Property="Margin" Value="24,0,0,0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Grid.ov-head.narrow StackPanel.ov-actions">
      <Setter Property="Margin" Value="0,16,0,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <!-- A folder's rail: 272 beside its notes, or the page's width under them (narrow) -->
    <Style Selector="StackPanel.ov-rail">
      <Setter Property="Width" Value="272" />
      <Setter Property="Margin" Value="48,0,0,0" />
    </Style>
    <Style Selector="Grid.narrow > StackPanel.ov-rail">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Margin" Value="0,36,0,0" />
    </Style>
  </UserControl.Styles>

  <Panel>
  <ScrollViewer Name="Page" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="ov-page" Classes.narrow="{Binding Narrow}">

      <!-- The date (or "Due", or the folder), the sentence under it, and the page's buttons at the header's foot. The
           title wraps in a column of its own, so a long name never runs under the buttons. -->
      <Grid Classes="ov-head" Classes.narrow="{Binding Narrow}" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <StackPanel>
          <TextBlock Name="Title" Classes="page-title" Text="{Binding Title}" IsVisible="{Binding !IsFolder}" />
          <c:Highlight Name="FolderTitle" Classes="page-title" Under="True" Text="{Binding Title}" Fill="{Binding Dot}" IsVisible="{Binding IsFolder}" HorizontalAlignment="Left" />
          <TextBlock Name="Lede" Classes="page-lede" Text="{Binding Lede}" IsVisible="{Binding HasLede}" Margin="0,8,0,0" />
        </StackPanel>
        <StackPanel Name="Actions" Classes="ov-actions" Grid.Column="{Binding ActionsColumn}" Grid.Row="{Binding ActionsRow}" Orientation="Horizontal"
                    Spacing="8" VerticalAlignment="Bottom">
          <!-- A folder: attach a recording, slides or a handout to it -->
          <Button Name="Attach" Classes="btn" Command="{Binding Files.AttachCommand, FallbackValue={x:Null}}" IsVisible="{Binding CanAttach}"
                  ToolTip.Tip="Attach a recording, notes, slides or a handout to this folder (or drop files on the page)" AutomationProperties.Name="Attach">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:Icon Glyph="attach_file" Size="16" VerticalAlignment="Center" />
              <TextBlock Text="Attach" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <!-- Record from here: into this folder on its page; on Home, into the event that's on, or Unsorted. Red is
               only the dot; while something records the pill is ringed in red, its dot a stop square, with the folder,
               the level and the time. -->
          <Button Name="Record" Classes="record" Classes.recording="{Binding Running}" Classes.paused="{Binding Paused}" Command="{Binding RecordCommand}"
                  IsVisible="{Binding CanRecord}" AutomationProperties.Name="{Binding RecordTip}" ToolTip.Tip="{Binding RecordTip}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Classes="record-dot"><Border /></Border>
              <TextBlock Name="RecordWords" Text="{Binding RecordWords}" VerticalAlignment="Center" />
              <c:Waveform Bars="5" Height="16" MinBar="5" Levels="{Binding Recorder.Levels, FallbackValue={x:Null}}" Foreground="{DynamicResource Record}"
                          VerticalAlignment="Center" IsVisible="{Binding Running}" />
              <TextBlock Text="{Binding Elapsed}" FontWeight="Medium" Foreground="{DynamicResource InkMuted}" VerticalAlignment="Center" IsVisible="{Binding Recording}" />
              <TextBlock Classes="kbd" Text="{Binding RecordKeys}" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0" IsVisible="{Binding Idle}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Home: the one gentle ask for a tip, when it's due, in the page's flow -->
      <Panel IsVisible="{Binding HasAsking}" Margin="0,28,0,0" MaxWidth="560" HorizontalAlignment="Left">
        <c:BySkin Name="SupportAsk" Mac="{x:Type v:MacSupportAsk}" Win="{x:Type v:WinSupportAsk}" DataContext="{Binding Asking}" />
      </Panel>

      <!-- Home: up next. The rest of today's and tomorrow's events; each row is a button that starts recording it. -->
      <StackPanel Name="UpNext" IsVisible="{Binding ShowUpNext}" Margin="0,36,0,0">
        <TextBlock Classes="h2" Text="Up next" Margin="0,0,0,12" />
        <TextBlock Name="NoUpNext" Classes="empty" Text="{Binding UpNextEmpty}" IsVisible="{Binding NoUpNext}" MaxWidth="560" />
        <ItemsControl ItemsSource="{Binding UpNext}" ClipToBounds="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:UpNext">
              <Button Classes="event" Classes.soon="{Binding Soon}" ToolTip.Tip="Click to record" AutomationProperties.Name="{Binding Said}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Command="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).RecordEventCommand}" CommandParameter="{Binding}">
                <Grid ColumnDefinitions="108,20,*">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Classes="event-when" Text="{Binding Time}" />
                    <TextBlock Classes="event-day" Text="{Binding Day}" />
                  </StackPanel>
                  <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Classes="lecture-title" Text="{Binding Title}" IsVisible="{Binding ShowTitle}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <!-- An event that's just its class: the name once, as the highlight -->
                    <c:Highlight Classes="lecture-title" Text="{Binding FolderShown}" Fill="{Binding Dot}" IsVisible="{Binding TitleIsFolder}" VerticalAlignment="Center" />
                    <c:Highlight Classes="lecture-class" Text="{Binding FolderShown}" Fill="{Binding Dot}" IsVisible="{Binding ShowFolder}" VerticalAlignment="Center" />
                  </WrapPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Home: every note, newest first; the filter shows them all or only the unsorted ones, and a folder picked in
           it goes to that folder's page -->
      <StackPanel Name="Notes" IsVisible="{Binding IsHome}" Margin="0,36,0,0">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
          <TextBlock Classes="h2" Text="{Binding NotesHeading}" VerticalAlignment="Bottom" />
          <Button Name="Filter" Grid.Column="1" Classes="picker" AutomationProperties.Name="{Binding FilterName}" ToolTip.Tip="Which notes to show">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding FilterName}" VerticalAlignment="Center" />
              <c:Icon Glyph="expand_more" Size="14" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight" VerticalOffset="6" FlyoutPresenterClasses="bare">
                <Border Classes="menu" Width="264" MaxHeight="340">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Filters}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NotesFilter">
                          <Panel>
                            <TextBlock Classes="menu-label" Text="{Binding Name}" IsVisible="{Binding IsLabel}" />
                            <Border Classes="menu-sep" IsVisible="{Binding IsRule}" />
                            <Button Classes="menu-item" Classes.active="{Binding Checked}" IsVisible="{Binding IsRow}" Click="OnPicked"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Command="{Binding $parent[v:Overview].((vm:OverviewModel)DataContext).PickFilterCommand}" CommandParameter="{Binding}">
                              <Grid ColumnDefinitions="Auto,*,10,Auto">
                                <c:Icon Glyph="inbox" Size="16" Foreground="{DynamicResource InkSubtle}" IsVisible="{Binding IsUnsorted}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <c:Swatch Fill="{Binding Dot}" IsVisible="{Binding IsFolder}" Margin="3,0,13,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <c:Icon Grid.Column="3" Glyph="check" Size="16" Foreground="{DynamicResource InkSubtle}" IsVisible="{Binding Checked}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Count}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource InkSubtle}"
                                           IsVisible="{Binding ShowCount}" VerticalAlignment="Center" />
                                <c:Icon Grid.Column="3" Glyph="chevron_right" Size="16" Foreground="{DynamicResource InkSubtle}" IsVisible="{Binding IsFolder}" VerticalAlignment="Center" />
                              </Grid>
                            </Button>
                          </Panel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>
              </Flyout>
            </Button.Flyout>
          </Button>
        </Grid>
        <TextBlock Name="NoNotes" Classes="empty" Text="{Binding NotesEmpty}" IsVisible="{Binding NoNotes}" MaxWidth="560" />
        <ItemsControl Name="NoteRows" ItemsSource="{Binding Notes}" ClipToBounds="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NoteItem">
              <v:NoteRowView />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- More of them: scrolling to the end brings the next page; so does this -->
        <Button Name="More" Classes="text-link" Content="Show more" Command="{Binding LoadMoreCommand}" IsVisible="{Binding CanLoadMore}" Margin="128,8,0,0" />
      </StackPanel>

      <!-- A folder: its lectures (or meetings) by week, and beside them the rail -->
      <Grid Name="Folder" Classes.narrow="{Binding Narrow}" IsVisible="{Binding IsFolder}" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,36,0,0">
        <StackPanel>
          <TextBlock Name="FolderNotes" Classes="h2" Text="{Binding NotesHeading}" Margin="0,0,0,14" />
          <TextBlock Classes="empty" Text="{Binding NotesEmpty}" IsVisible="{Binding NoNotes}" />
          <ItemsControl ItemsSource="{Binding Groups}" ClipToBounds="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NoteGroup">
                <StackPanel>
                  <TextBlock Classes="group-label" Classes.first="{Binding First}" Text="{Binding Label}" />
                  <ItemsControl ItemsSource="{Binding Notes}" ClipToBounds="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:NoteItem">
                        <v:NoteRowView />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Name="Rail" Classes="ov-rail" Grid.Column="{Binding RailColumn}" Grid.Row="{Binding RailRow}" Spacing="28" IsVisible="{Binding HasRail}" VerticalAlignment="Top">
          <!-- What's due next in this class -->
          <StackPanel Name="RailDue" IsVisible="{Binding HasDue}">
            <TextBlock Classes="rail-title" Text="Due" />
            <ItemsControl ItemsSource="{Binding Due}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RailDue">
                  <StackPanel>
                    <Border Classes="rule" IsVisible="{Binding !First}" />
                    <Button Classes="rail-due" Classes.first="{Binding First}" AutomationProperties.Name="{Binding Said}"
                            Command="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).OpenRailDueCommand}" CommandParameter="{Binding}">
                      <StackPanel Spacing="2">
                        <TextBlock Classes="rail-due-title" Text="{Binding Title}" />
                        <TextBlock Classes="rail-due-when" Classes.soon="{Binding Soon}" Classes.late="{Binding Late}" Text="{Binding When}" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Name="SeeCalendar" Classes="text-link" Content="See these on the calendar" Command="{Binding SeeCalendarCommand}" Margin="0,6,0,0" />
          </StackPanel>
          <!-- Its lists on Canvas: each opens that list -->
          <StackPanel Name="OnCanvas" IsVisible="{Binding HasLinks}">
            <TextBlock Classes="rail-title" Text="On Canvas" />
            <ItemsControl ItemsSource="{Binding Links}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OverviewLink">
                  <Button Classes="text-link" Content="{Binding Label}" ToolTip.Tip="{Binding Detail}"
                          Command="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).OpenLinkCommand}" CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <!-- When it next meets, from the calendar -->
          <StackPanel Name="NextMeets" IsVisible="{Binding HasNext}">
            <TextBlock Classes="rail-title" Text="{Binding NextHeading}" />
            <TextBlock Classes="rail-text" Text="{Binding NextText}" />
          </StackPanel>
          <!-- What's attached to the folder (drop files anywhere on the page) -->
          <StackPanel Name="FolderFiles" IsVisible="{Binding HasFiles}">
            <c:BySkin Mac="{x:Type v:MacAttachments}" Win="{x:Type v:WinAttachments}" DataContext="{Binding Files}" />
          </StackPanel>
          <!-- Folders on the computer that go with it (a project's repo), linked, not copied in -->
          <StackPanel Name="LinkedFolders" IsVisible="{Binding ShowFolders}">
            <TextBlock Classes="rail-title" Text="Linked folders" />
            <TextBlock Classes="rail-text" IsVisible="{Binding !HasFolders}" Margin="0,0,0,8"
                       Text="A project's repo, a shared drive: anything that goes with this folder but isn't notes. It stays where it is." />
            <ItemsControl ItemsSource="{Binding Folders}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LinkedFolder">
                  <Button Classes="rail-due" Command="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).OpenFolderCommand}" CommandParameter="{Binding}"
                          ToolTip.Tip="Open the folder">
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Unlink from this folder" Command="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).UnlinkFolderCommand}" CommandParameter="{Binding}" />
                      </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Spacing="2">
                      <TextBlock Classes="rail-due-title" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="rail-due-when" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Name="LinkFolder" Classes="text-link" Content="Link a folder" Command="{Binding LinkFolderCommand}" IsVisible="{Binding CanLinkFolders}" Margin="0,6,0,0"
                    ToolTip.Tip="Link a folder on this computer: it stays where it is, and search and the AI can read it" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- Due: what Canvas needs (when it needs something), and the calendar -->
      <StackPanel Name="Due" IsVisible="{Binding IsDuePage}" Margin="0,28,0,0" Spacing="20">
        <Panel IsVisible="{Binding HasCanvasStatus}" MaxWidth="560" HorizontalAlignment="Left">
          <c:BySkin Mac="{x:Type v:MacCanvasStatus}" Win="{x:Type v:WinCanvasStatus}" DataContext="{Binding CanvasStatus}" />
        </Panel>
        <v:DueCalendar Name="Calendar" DataContext="{Binding Calendar}" />
      </StackPanel>

      <!-- Home: Study Stash is free, and a tip for the two students who build it goes to their Ko-fi page -->
      <Button Name="Support" Classes="text-link" Content="{x:Static s:SupportAsk.Button}" Command="{Binding SupportCommand}" IsVisible="{Binding CanSupport}"
              ToolTip.Tip="{x:Static s:SupportAsk.HomeTip}" Margin="0,36,0,0" />
    </StackPanel>
  </ScrollViewer>
  <!-- The page fades out under Ask, so what scrolls beneath never collides with it -->
  <Border Name="Fade" Height="120" VerticalAlignment="Bottom" IsHitTestVisible="False" IsVisible="{Binding HasAsk}" />
  <!-- Ask about every note (Home) or this folder's, docked at the foot of the page; its latest answer just above -->
  <StackPanel Classes="ov-ask" Classes.narrow="{Binding Narrow}" VerticalAlignment="Bottom" Spacing="8" IsVisible="{Binding HasAsk}">
    <c:BySkin Mac="{x:Type v:MacAiAnswer}" Win="{x:Type v:WinAiAnswer}" DataContext="{Binding Ask}"
              IsVisible="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).HasAnswer}" MaxHeight="420" HorizontalAlignment="Center" />
    <c:BySkin Name="AskBar" Mac="{x:Type v:MacAiAskBar}" Win="{x:Type v:WinAiAskBar}" DataContext="{Binding Ask}" />
  </StackPanel>
  </Panel>
</UserControl>
