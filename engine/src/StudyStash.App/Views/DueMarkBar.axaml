<!-- "Mark done" and "Hide" on an assignment's page (both looks), or, once the student did one, a tick (for done) and what
     was done with "Undo". These only change Syft Notes' own Due list: nothing changes in Canvas. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:k="using:StudyStash.App.ViewModels.Kit"
             xmlns:c="using:StudyStash.App.Controls"
             x:Class="StudyStash.App.Views.DueMarkBar"
             x:DataType="k:DueMarkModel">
  <StackPanel Spacing="8">
    <WrapPanel ItemSpacing="10" LineSpacing="8">
      <Button Name="MarkDone" Classes="btn sm" Content="{x:Static k:DueMarkModel.DoneLabel}" Command="{Binding MarkDoneCommand}"
              IsVisible="{Binding CanMark}" ToolTip.Tip="{x:Static k:DueMarkModel.DoneTip}" VerticalAlignment="Center" />
      <Button Name="HideIt" Classes="btn sm" Content="{x:Static k:DueMarkModel.HideLabel}" Command="{Binding HideItCommand}"
              IsVisible="{Binding CanMark}" ToolTip.Tip="{x:Static k:DueMarkModel.HideTip}" VerticalAlignment="Center" />
      <c:Icon Name="Tick" Glyph="check" Size="16" IsVisible="{Binding Ticked}" VerticalAlignment="Center" />
      <TextBlock Name="State" Classes="cv-sub-detail" Text="{Binding State}" IsVisible="{Binding CanUndo}" VerticalAlignment="Center" />
      <Button Name="UndoIt" Classes="btn sm" Content="{x:Static k:DueMarkModel.UndoLabel}" Command="{Binding UndoItCommand}"
              IsVisible="{Binding CanUndo}" VerticalAlignment="Center" />
    </WrapPanel>
    <TextBlock Name="Say" Classes="cv-sub-detail" Text="{Binding Action.Say}" TextWrapping="Wrap"
               IsVisible="{Binding Action.Say, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </StackPanel>
</UserControl>
