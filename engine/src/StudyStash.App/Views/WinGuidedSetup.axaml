<!-- Guided setup (Windows): the Mac's (MacGuidedSetup), as the library window is the same in both looks: Pick your AI,
     Install, Sign in, then the chat with the checklist beside it; the steps (or the checklist) straight on the window's
     canvas under Windows' own title bar, the page one white sheet beside them (SetupStyles). Its links open with
     Windows' "open in new" mark. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:s="using:StudyStash.App.Services"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:v="using:StudyStash.App.Views"
             x:Class="StudyStash.App.Views.WinGuidedSetup"
             x:DataType="vm:GuidedSetupModel"
             Classes="in-setup"
             Width="760" Height="640">
  <UserControl.Styles>
    <StyleInclude Source="avares://StudyStash/Views/WinAiStyles.axaml" />
    <StyleInclude Source="avares://StudyStash/Views/WinCanvasStyles.axaml" />
    <StyleInclude Source="avares://StudyStash/Views/SetupStyles.axaml" />
    <StyleInclude Source="avares://StudyStash/Views/SetupCanvasStyles.axaml" />
    <!-- The window's frame, for a screenshot only: a real window has Windows' own corners, edge and shadow. -->
    <Style Selector="Border#Frame.framed">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BoxShadow" Value="{DynamicResource ShadowLg}" />
    </Style>
    <Style Selector="StackPanel.picks > Button.choice">
      <Setter Property="MinHeight" Value="62" />
      <Setter Property="Padding" Value="16,10" />
    </Style>
  </UserControl.Styles>

  <Border Name="Frame" Background="{DynamicResource Canvas}" ClipToBounds="True">
    <DockPanel>
      <c:WindowHeader Name="Header" DockPanel.Dock="Top" CanResize="False" Title="Set up Syft Notes" />
      <Grid ColumnDefinitions="228,*" Margin="8,0,8,8">
        <!-- The steps before the chat, or the chat's checklist: straight on the canvas, as the library's sidebar is. -->
        <Panel>
          <StackPanel Classes="setup-side" Spacing="2" IsVisible="{Binding !OnChat}">
            <StackPanel Classes="flow" Orientation="Horizontal" Spacing="8">
              <c:Icon Glyph="auto_awesome" Size="16" VerticalAlignment="Center" />
              <TextBlock Classes="side-group" Text="Guided setup" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Steps}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StepItem">
                  <Border Classes="step" Classes.current="{Binding Current}">
                    <Grid ColumnDefinitions="18,10,*">
                      <c:Icon Classes="done" IsVisible="{Binding Done}" />
                      <Border Classes="num" IsVisible="{Binding ShowNumber}"><TextBlock Text="{Binding Number}" /></Border>
                      <TextBlock Grid.Column="2" Classes="title" Text="{Binding Title}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <!-- The chat's checklist: only the app ticks it; a line not done yet asks the AI to go there. -->
          <DockPanel Margin="6,6,6,0" IsVisible="{Binding OnChat}">
            <StackPanel DockPanel.Dock="Top" Classes="flow" Orientation="Horizontal" Spacing="8">
              <c:Icon Glyph="{Binding BrandGlyph}" Size="16" VerticalAlignment="Center" />
              <TextBlock Classes="side-group" Text="{Binding SidebarTitle}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Spacing="16" Margin="4,12,4,10">
              <Button Name="FinishSide" Classes="btn ink" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding ReadyToFinish}" Command="{Binding FinishCommand}" Content="Open Syft Notes" />
              <Button Name="ByHandChat" Classes="text-link" Margin="6,0" Command="{Binding ByHandCommand}" Content="Set up by hand" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl Name="Checklist" ItemsSource="{Binding Checklist}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChecklistRow">
                    <Button AutomationProperties.Name="{Binding Title}" Classes="item" Classes.now="{Binding IsNow}" IsHitTestVisible="{Binding Clickable}"
                            Command="{Binding $parent[UserControl].((vm:GuidedSetupModel)DataContext).ClickItemCommand}" CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="18,10,*,Auto" RowDefinitions="Auto,Auto">
                        <Panel Width="18" Height="18" VerticalAlignment="Center">
                          <c:Icon Classes="done" IsVisible="{Binding IsDone}" />
                          <Border Classes="now-dot" IsVisible="{Binding IsNow}"><Ellipse /></Border>
                          <Border Classes="todo-dot" IsVisible="{Binding IsTodo}" />
                          <c:Icon IsVisible="{Binding IsSkipped}" Glyph="remove" Size="16" Foreground="{DynamicResource InkSubtle}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          <c:Icon Classes="warn" IsVisible="{Binding IsProblem}" Size="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Panel>
                        <TextBlock Grid.Column="2" Classes="title" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="3" Classes="tag" Margin="6,0,0,0" IsVisible="{Binding HasTag}"><TextBlock Text="{Binding Tag}" /></Border>
                        <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Classes="detail" Classes.warn="{Binding IsProblem}" Text="{Binding DetailLine}" IsVisible="{Binding HasDetailLine}"
                                   TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Panel>

        <!-- The page: one white sheet, a hairline round it -->
        <Panel Grid.Column="1">
          <Border Classes="setup-pane" />
          <Border Classes="setup-clip">
            <Panel>
              <!-- Pick your AI, Install, Sign in -->
              <DockPanel IsVisible="{Binding !OnChat}">
                <Grid DockPanel.Dock="Bottom" Classes="setup-foot" ColumnDefinitions="Auto,*,Auto">
                  <Button Name="ByHand" Classes="text-link" VerticalAlignment="Center" Command="{Binding ByHandCommand}" Content="{Binding ByHandLabel}" />
                  <Button Name="Continue" Grid.Column="2" Classes="btn ink" Command="{Binding ContinueCommand}" IsEnabled="{Binding CanContinue}" Content="Continue" />
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Classes="setup-page">
                    <TextBlock Classes="step-label" Text="{Binding StepLabel}" IsVisible="{Binding HasStepLabel}" />

                    <!-- Screen 1 · Pick your AI -->
                    <StackPanel IsVisible="{Binding OnPick}">
                      <TextBlock Classes="page-title step-title" Text="{Binding PickTitle}" />
                      <TextBlock Classes="page-lede step-lede" Text="{x:Static vm:GuidedSetupModel.PickLede}" />
                      <!-- The answers in the student's own terms: the AI they use, or no paid plan. The tools underneath
                           (Claude Code, Codex, Antigravity, Ollama) aren't named here. Four of them: a little closer
                           together than a card's choices elsewhere, so they and the plan links fit the page. -->
                      <StackPanel Classes="picks" Spacing="8" Margin="0,18,0,0" MaxWidth="480" HorizontalAlignment="Stretch">
                        <Button AutomationProperties.Name="Claude" Name="PickClaude" Classes="choice" Classes.on="{Binding PickedClaude}" Command="{Binding PickCommand}" CommandParameter="claude">
                          <Grid ColumnDefinitions="*,14,Auto">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:Icon Glyph="brand:claude" Size="18" VerticalAlignment="Center" />
                                <TextBlock Classes="choice-title" Text="Claude" />
                                <Border Classes="tag" IsVisible="{Binding ClaudeHere}">
                                  <StackPanel Orientation="Horizontal" Spacing="4">
                                    <c:Icon Glyph="check" Size="12" />
                                    <TextBlock Text="{Binding AlreadyHere}" />
                                  </StackPanel>
                                </Border>
                              </StackPanel>
                              <TextBlock Classes="choice-about" Text="{x:Static vm:GuidedSetupModel.ClaudeLine}" />
                            </StackPanel>
                            <Border Grid.Column="2" Classes="radio" Classes.on="{Binding PickedClaude}"><Ellipse /></Border>
                          </Grid>
                        </Button>
                        <Button AutomationProperties.Name="ChatGPT" Name="PickCodex" Classes="choice" Classes.on="{Binding PickedCodex}" Command="{Binding PickCommand}" CommandParameter="codex">
                          <Grid ColumnDefinitions="*,14,Auto">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:Icon Glyph="brand:chatgpt" Size="18" VerticalAlignment="Center" />
                                <TextBlock Classes="choice-title" Text="ChatGPT" />
                                <Border Classes="tag" IsVisible="{Binding CodexHere}">
                                  <StackPanel Orientation="Horizontal" Spacing="4">
                                    <c:Icon Glyph="check" Size="12" />
                                    <TextBlock Text="{Binding AlreadyHere}" />
                                  </StackPanel>
                                </Border>
                              </StackPanel>
                              <TextBlock Classes="choice-about" Text="{x:Static vm:GuidedSetupModel.CodexLine}" />
                            </StackPanel>
                            <Border Grid.Column="2" Classes="radio" Classes.on="{Binding PickedCodex}"><Ellipse /></Border>
                          </Grid>
                        </Button>
                        <!-- Gemini: the same path as Claude and ChatGPT (get it ready, sign in with Google, the chat), through Google's Antigravity CLI. -->
                        <Button AutomationProperties.Name="Gemini" Name="PickGemini" Classes="choice" Classes.on="{Binding PickedGemini}" Command="{Binding PickCommand}" CommandParameter="gemini">
                          <Grid ColumnDefinitions="*,14,Auto">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:Icon Glyph="brand:gemini" Size="18" VerticalAlignment="Center" />
                                <TextBlock Classes="choice-title" Text="Gemini" />
                                <Border Classes="tag" IsVisible="{Binding GeminiHere}">
                                  <StackPanel Orientation="Horizontal" Spacing="4">
                                    <c:Icon Glyph="check" Size="12" />
                                    <TextBlock Text="{Binding AlreadyHere}" />
                                  </StackPanel>
                                </Border>
                              </StackPanel>
                              <TextBlock Classes="choice-about" Text="{x:Static vm:GuidedSetupModel.GeminiLine}" />
                            </StackPanel>
                            <Border Grid.Column="2" Classes="radio" Classes.on="{Binding PickedGemini}"><Ellipse /></Border>
                          </Grid>
                        </Button>
                        <Button AutomationProperties.Name="I don't have a paid plan" Name="PickFree" Classes="choice" Classes.on="{Binding PickedFree}" Command="{Binding PickCommand}" CommandParameter="free">
                          <Grid ColumnDefinitions="*,14,Auto">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                              <TextBlock Classes="choice-title" Text="{x:Static vm:GuidedSetupModel.FreeTitle}" />
                              <TextBlock Classes="choice-about" Text="{Binding FreeLine}" />
                            </StackPanel>
                            <Border Grid.Column="2" Classes="radio" Classes.on="{Binding PickedFree}"><Ellipse /></Border>
                          </Grid>
                        </Button>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,16,0,0">
                        <Button AutomationProperties.Name="What's Claude Pro?" Classes="text-link small" Command="{Binding OpenPlansCommand}" CommandParameter="claude">
                          <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="What's Claude Pro?" /><c:Icon Glyph="open_in_new" Size="13" /></StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="What's ChatGPT Plus?" Classes="text-link small" Command="{Binding OpenPlansCommand}" CommandParameter="codex">
                          <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="What's ChatGPT Plus?" /><c:Icon Glyph="open_in_new" Size="13" /></StackPanel>
                        </Button>
                      </StackPanel>
                    </StackPanel>

                    <!-- Screen 2 · Install -->
                    <StackPanel IsVisible="{Binding OnInstall}">
                      <Grid ColumnDefinitions="Auto,12,*">
                        <c:Icon Name="InstallMark" Glyph="{Binding BrandGlyph}" Size="28" VerticalAlignment="Top" Margin="0,10,0,0" />
                        <TextBlock Grid.Column="2" Classes="page-title step-title" Text="{Binding InstallTitle}" />
                      </Grid>
                      <TextBlock Classes="page-lede step-lede" Text="{Binding InstallLede}" />
                      <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,24,0,0" IsVisible="{Binding ShowInstallButton}">
                        <Button Name="Install" Classes="btn sm ink" Command="{Binding InstallCommand}" Content="{Binding InstallButton}" />
                        <TextBlock Classes="hint" Text="{Binding InstallSource}" VerticalAlignment="Center" MaxWidth="250" />
                      </StackPanel>
                      <StackPanel Spacing="10" Margin="0,26,0,0" MaxWidth="480" HorizontalAlignment="Stretch" IsVisible="{Binding Installing}">
                        <c:SyftLoader Kind="PixelProgress" Size="9" HorizontalAlignment="Left" />
                        <TextBlock Classes="hint" Text="{Binding Phase}" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,26,0,0" IsVisible="{Binding ShowInstalled}">
                        <c:Icon Classes="ok" Size="18" />
                        <TextBlock Classes="say" Text="{Binding InstalledWords}" />
                      </StackPanel>
                      <Border Classes="problem" Margin="0,22,0,0" IsVisible="{Binding HasInstallProblem}">
                        <StackPanel Spacing="12">
                          <Grid ColumnDefinitions="Auto,10,*">
                            <c:Icon Classes="warn" Size="18" VerticalAlignment="Top" Margin="0,1,0,0" />
                            <TextBlock Grid.Column="2" Classes="say" Text="{Binding InstallProblem}" />
                          </Grid>
                          <WrapPanel Margin="28,0,0,0" ItemSpacing="8" LineSpacing="8">
                            <Button Classes="btn sm" Command="{Binding TryAgainCommand}" Content="Try again" />
                            <Button Classes="btn sm" Command="{Binding UseOtherCommand}" IsVisible="{Binding InstallRegion}" Content="{Binding UseOtherLabel}" />
                            <Button Classes="btn sm" Command="{Binding UseOllamaCommand}" IsVisible="{Binding InstallRegion}" Content="Carry on without it" />
                            <Button Classes="text-link small" VerticalAlignment="Center" Margin="6,0,0,0" Command="{Binding OpenDocsCommand}" IsVisible="{Binding InstallOther}">
                              <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="Get help" /><c:Icon Glyph="open_in_new" Size="13" /></StackPanel>
                            </Button>
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                      <Button Classes="text-link small" Margin="0,18,0,0" Command="{Binding ToggleDetailsCommand}" Content="Details" />
                      <Border Classes="mono" Margin="0,10,0,0" IsVisible="{Binding ShowDetails}">
                        <StackPanel Spacing="6">
                          <SelectableTextBlock Text="{Binding InstallLine}" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
                          <SelectableTextBlock Text="{Binding InstallOutput}" MaxHeight="120" />
                        </StackPanel>
                      </Border>
                    </StackPanel>

                    <!-- Screen 3 · Sign in -->
                    <StackPanel IsVisible="{Binding OnSignIn}">
                      <Grid ColumnDefinitions="Auto,12,*">
                        <c:Icon Name="SignInMark" Glyph="{Binding BrandGlyph}" Size="28" VerticalAlignment="Top" Margin="0,10,0,0" />
                        <TextBlock Grid.Column="2" Classes="page-title step-title" Text="{Binding SignInTitle}" />
                      </Grid>
                      <TextBlock Classes="page-lede step-lede" Text="{Binding SignInLede}" />
                      <Button Name="OpenSignIn" Classes="btn sm ink" HorizontalAlignment="Left" Margin="0,24,0,0" Command="{Binding OpenSignInCommand}" IsVisible="{Binding ShowOpenSignIn}" Content="Open sign-in page" />
                      <StackPanel Spacing="8" Margin="0,24,0,0" IsVisible="{Binding WaitingSignIn}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <c:Icon Glyph="hourglass_top" Size="16" Foreground="{DynamicResource InkMuted}" VerticalAlignment="Center" />
                          <TextBlock Classes="say" Text="Waiting for you to sign in…" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="24,0,0,0">
                          <TextBlock Classes="hint" Text="Didn't open?" VerticalAlignment="Center" />
                          <Button Classes="text-link small" VerticalAlignment="Center" Command="{Binding OpenAgainCommand}" Content="Open it again" />
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,24,0,0" IsVisible="{Binding ShowCheckingPlan}">
                        <c:Icon Classes="ok" Size="18" />
                        <TextBlock Classes="say" Text="{Binding CheckingWords}" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,24,0,0" IsVisible="{Binding ShowReady}">
                        <c:Icon Classes="ok" Size="18" />
                        <TextBlock Classes="say" Text="{Binding ReadyWords}" FontWeight="Bold" />
                      </StackPanel>
                      <!-- How much of the account's allowance is left, when the AI says (Gemini's). -->
                      <TextBlock Name="Allowance" Classes="hint" Margin="26,6,0,0" Text="{Binding AllowanceWords}" IsVisible="{Binding HasAllowance}" />
                      <!-- A sign-in that stopped: Try again; one Syft Notes couldn't start, Get help too (never a terminal). -->
                      <Border Name="SignInProblem" Classes="problem" Margin="0,18,0,0" IsVisible="{Binding HasSignInProblem}">
                        <Grid ColumnDefinitions="Auto,10,*,10,Auto,8,Auto">
                          <c:Icon Classes="warn" Size="18" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Classes="say" Text="{Binding SignInProblem}" />
                          <Button Grid.Column="4" Classes="btn sm" VerticalAlignment="Center" Command="{Binding OpenSignInCommand}" Content="Try again" />
                          <Button Name="SignInHelp" Grid.Column="6" Classes="text-link small" VerticalAlignment="Center" Command="{Binding GetHelpCommand}" IsVisible="{Binding SignInStuck}">
                            <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="Get help" /><c:Icon Glyph="arrow_outward" Size="13" /></StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                      <Border Classes="problem" Margin="0,18,0,0" IsVisible="{Binding HasPlanProblem}">
                        <StackPanel Spacing="12">
                          <Grid ColumnDefinitions="Auto,10,*">
                            <c:Icon Classes="warn" Size="18" VerticalAlignment="Top" Margin="0,1,0,0" />
                            <StackPanel Grid.Column="2" Spacing="4">
                              <TextBlock Classes="say" Text="{Binding PlanProblemTitle}" FontWeight="Bold" />
                              <TextBlock Classes="hint" Text="{Binding PlanProblemText}" IsVisible="{Binding PlanProblemText, Converter={x:Static c:Converters.NotEmpty}}" />
                            </StackPanel>
                          </Grid>
                          <StackPanel Orientation="Horizontal" Spacing="8" Margin="28,0,0,0">
                            <Button Classes="btn sm ink" Command="{Binding OpenPlansCommand}" CommandParameter="" IsVisible="{Binding PlanIsPlan}">
                              <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="See plans" VerticalAlignment="Center" /><c:Icon Glyph="open_in_new" Size="13" /></StackPanel>
                            </Button>
                            <Button Classes="btn sm" Command="{Binding CheckAgainCommand}" Content="Check again" />
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="8" Margin="28,0,0,0">
                            <Button Classes="text-link small" VerticalAlignment="Center" Command="{Binding UseOtherCommand}" Content="{Binding UseOtherLabel}" />
                            <TextBlock Text="·" FontSize="13" Foreground="{DynamicResource InkSubtle}" VerticalAlignment="Center" />
                            <Button Classes="text-link small" VerticalAlignment="Center" Command="{Binding UseOllamaCommand}" Content="Carry on without it" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                      <StackPanel Spacing="6" Margin="0,26,0,0" MaxWidth="480" HorizontalAlignment="Left">
                        <TextBlock Classes="hint" Text="{Binding Privacy}" />
                        <TextBlock Classes="hint" Text="{Binding PlanNote}" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </DockPanel>

              <!-- Screen 4 · The chat: the AI's words and the student's, Syft Notes' notes, and the cards the AI opens. -->
              <DockPanel IsVisible="{Binding OnChat}">
                <StackPanel DockPanel.Dock="Top" Margin="32,26,32,0">
                  <TextBlock Classes="step-label" Text="{Binding StepLabel}" />
                  <TextBlock Classes="page-title step-title chat-title" Text="{Binding HeaderTitle}" />
                  <Border Classes="rule" Margin="0,16,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="32,10,32,20" Spacing="10">
                  <!-- (Each reply keeps room round itself for its hairline and focus ring, which a list would cut off.) -->
                  <ItemsControl Name="QuickReplies" ItemsSource="{Binding QuickReplies}" IsVisible="{Binding HasQuickReplies}" Margin="-4">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Button Classes="btn sm" Margin="4" Command="{Binding $parent[UserControl].((vm:GuidedSetupModel)DataContext).ReplyCommand}" CommandParameter="{Binding}" Content="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Classes="problem" MaxWidth="10000" IsVisible="{Binding HasChatProblem}">
                    <Grid ColumnDefinitions="Auto,10,*,10,Auto,8,Auto">
                      <c:Icon Classes="warn" Size="18" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Classes="say" Text="{Binding ChatProblemText}" />
                      <Button Grid.Column="4" Classes="btn sm" VerticalAlignment="Center" Command="{Binding TryAgainCommand}" Content="Try again" />
                      <Button Grid.Column="6" Classes="btn sm" VerticalAlignment="Center" Command="{Binding ByHandCommand}" Content="Set up by hand" />
                    </Grid>
                  </Border>
                  <!-- The reply field: the library's Ask bar -->
                  <Border Classes="ask">
                    <Grid ColumnDefinitions="*,8,Auto" VerticalAlignment="Center">
                      <TextBox Name="Field" Classes="bare" Text="{Binding Draft}" PlaceholderText="{Binding FieldHint}" VerticalAlignment="Center" IsEnabled="{Binding CanType}">
                        <TextBox.KeyBindings>
                          <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
                        </TextBox.KeyBindings>
                      </TextBox>
                      <Button Name="Send" Grid.Column="2" Classes="ask-send" AutomationProperties.Name="Send" ToolTip.Tip="Send" Command="{Binding SendCommand}" IsEnabled="{Binding CanType}">
                        <c:Icon Glyph="arrow_upward" Size="18" />
                      </Button>
                    </Grid>
                  </Border>
                </StackPanel>
                <ScrollViewer Name="ThreadScroll" Margin="32,16,16,0" Padding="0,0,16,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" c:FollowEnd.IsOn="True">
                  <StackPanel Spacing="14" Margin="0,0,0,8">
                    <ItemsControl Name="Thread" ItemsSource="{Binding Thread}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="14" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.DataTemplates>
                        <DataTemplate DataType="vm:AiEntry">
                          <!-- Syft says it: the pixel s beside each of the AI's messages -->
                          <Grid ColumnDefinitions="Auto,12,*" HorizontalAlignment="Left">
                          <c:SyftMark Size="34" Bits="False" VerticalAlignment="Top" Margin="0,2,0,0" />
                          <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Left" MaxWidth="540">
                            <TextBlock Classes="ai-byline" Text="{Binding Byline}" />
                            <TextBlock Classes="ai-answer" Text="{Binding Text}" />
                            <ItemsControl ItemsSource="{Binding Chips}" IsVisible="{Binding HasChips}" Margin="0,4,0,0">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="4" /></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                  <Border Classes="tag">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                      <c:Icon Glyph="check" Size="12" />
                                      <TextBlock Text="{Binding}" />
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                          </Grid>
                        </DataTemplate>
                        <DataTemplate DataType="vm:StudentEntry">
                          <Border Classes="ai-bubble-q" MaxWidth="420" Classes.queued="{Binding Queued}">
                            <TextBlock Text="{Binding Text}" />
                          </Border>
                        </DataTemplate>
                        <DataTemplate DataType="vm:NoteEntry">
                          <Grid ColumnDefinitions="Auto,8,*" MaxWidth="540" HorizontalAlignment="Left">
                            <Panel VerticalAlignment="Center">
                              <c:Icon Classes="ok" Size="15" IsVisible="{Binding Good}" />
                              <c:Icon Classes="warn" Size="15" IsVisible="{Binding Warn}" />
                            </Panel>
                            <TextBlock Grid.Column="2" Classes="note-line" Text="{Binding Text}" />
                          </Grid>
                        </DataTemplate>
                        <DataTemplate DataType="vm:CardEntry">
                          <Panel>
                            <!-- Folded: its outcome in one line -->
                            <Grid ColumnDefinitions="Auto,8,*" IsVisible="{Binding Folded}" HorizontalAlignment="Left">
                              <Panel VerticalAlignment="Center">
                                <c:Icon Classes="ok" Size="15" IsVisible="{Binding HasOutcome}" />
                                <c:Icon Glyph="radio_button_unchecked" Size="15" Foreground="{DynamicResource InkSubtle}" IsVisible="{Binding !HasOutcome}" VerticalAlignment="Center" />
                              </Panel>
                              <TextBlock Grid.Column="2" Classes="note-line" Text="{Binding FoldedLine}" />
                            </Grid>
                            <Border Classes="card" IsVisible="{Binding Open}">
                              <StackPanel Spacing="12">
                                <TextBlock Classes="card-title" Text="{Binding Title}" />

                                <!-- Where lectures are kept: just this computer, and under Advanced a laptop or a computer at home -->
                                <StackPanel Spacing="6" IsVisible="{Binding IsComputer}">
                                  <Button AutomationProperties.Name="{Binding JustThis}" Classes="choice row" Classes.on="{Binding ChoseOne}" Command="{Binding ChooseCommand}" CommandParameter="one">
                                    <Grid ColumnDefinitions="Auto,12,*">
                                      <Border Classes="radio" Classes.on="{Binding ChoseOne}"><Ellipse /></Border>
                                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Classes="choice-title" Text="{Binding JustThis}" />
                                        <Border Classes="tag"><TextBlock Text="Recommended" /></Border>
                                      </StackPanel>
                                    </Grid>
                                  </Button>
                                  <!-- Advanced: a laptop for class and a computer at home, folded away (most students have one computer) -->
                                  <Button Classes="text-link small" Margin="0,4,0,0" Command="{Binding ToggleOtherCommand}"
                                          AutomationProperties.Name="{x:Static vm:SetupModel.OtherComputersLabel}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                      <c:Icon Glyph="chevron_right" Size="16" IsVisible="{Binding !OtherOpen}" />
                                      <c:Icon Glyph="expand_more" Size="16" IsVisible="{Binding OtherOpen}" />
                                      <TextBlock Text="{x:Static vm:SetupModel.OtherComputersLabel}" VerticalAlignment="Center" />
                                    </StackPanel>
                                  </Button>
                                  <StackPanel Spacing="6" IsVisible="{Binding OtherOpen}">
                                    <TextBlock Classes="hint" Text="{x:Static vm:SetupModel.OtherComputersAbout}" />
                                    <Button AutomationProperties.Name="{x:Static vm:SetupModel.LaptopTitle}" AutomationProperties.HelpText="{x:Static vm:SetupModel.LaptopAbout}" Classes="choice row" Classes.on="{Binding ChoseLaptop}" Command="{Binding ChooseCommand}" CommandParameter="laptop">
                                      <Grid ColumnDefinitions="Auto,12,*">
                                        <Border Classes="radio" Classes.on="{Binding ChoseLaptop}"><Ellipse /></Border>
                                        <TextBlock Grid.Column="2" Classes="choice-title"><Run Text="{x:Static vm:SetupModel.LaptopTitle}" /><Run Text="  (lectures kept on your computer at home)" FontWeight="Normal" Foreground="{DynamicResource InkMuted}" /></TextBlock>
                                      </Grid>
                                    </Button>
                                    <Button AutomationProperties.Name="{x:Static vm:SetupModel.LibraryTitle}" AutomationProperties.HelpText="{Binding Setup.LibraryAbout}" Classes="choice row" Classes.on="{Binding ChoseLibrary}" Command="{Binding ChooseCommand}" CommandParameter="library">
                                      <Grid ColumnDefinitions="Auto,12,*">
                                        <Border Classes="radio" Classes.on="{Binding ChoseLibrary}"><Ellipse /></Border>
                                        <TextBlock Grid.Column="2" Classes="choice-title"><Run Text="{x:Static vm:SetupModel.LibraryTitle}" /><Run Text="  (stays on and keeps them)" FontWeight="Normal" Foreground="{DynamicResource InkMuted}" /></TextBlock>
                                      </Grid>
                                    </Button>
                                  </StackPanel>
                                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                                    <c:SyftLoader Kind="HoppingBits" Size="20" IsVisible="{Binding Busy}" VerticalAlignment="Center" />
                                    <Button Classes="btn sm ink" Command="{Binding PressCommand}" CommandParameter="setup" IsEnabled="{Binding !Busy}" Content="Set up" />
                                  </StackPanel>
                                </StackPanel>

                                <!-- The library's name and password -->
                                <StackPanel Spacing="8" IsVisible="{Binding IsPassword}">
                                  <Border Classes="field"><TextBox Classes="bare" Text="{Binding Setup.LibraryName}" PlaceholderText="Library name" /></Border>
                                  <Border Classes="field"><TextBox Classes="bare" Text="{Binding Setup.Password}" PasswordChar="•" PlaceholderText="A password for your library (4 or more letters)" /></Border>
                                  <TextBlock Classes="hint" Text="{Binding PasswordNote}" />
                                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
                                    <c:SyftLoader Kind="HoppingBits" Size="20" IsVisible="{Binding Busy}" VerticalAlignment="Center" />
                                    <Button Classes="btn sm ink" Command="{Binding PressCommand}" CommandParameter="create" IsEnabled="{Binding !Busy}" Content="Create library" />
                                  </StackPanel>
                                </StackPanel>

                                <!-- A laptop connecting to its library -->
                                <StackPanel Spacing="8" IsVisible="{Binding IsConnection}">
                                  <Border Classes="field"><TextBox Classes="bare" Text="{Binding Setup.Address}" PlaceholderText="Your library's address, like mac-mini:8787" /></Border>
                                  <Border Classes="field"><TextBox Classes="bare" Text="{Binding Setup.ConnectPassword}" PasswordChar="•" PlaceholderText="Its password" /></Border>
                                  <TextBlock Classes="hint" Text="{Binding Setup.LibraryResult}" IsVisible="{Binding Setup.HasLibraryResult}" />
                                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
                                    <c:SyftLoader Kind="HoppingBits" Size="20" IsVisible="{Binding Busy}" VerticalAlignment="Center" />
                                    <Button Classes="btn sm" Command="{Binding PressCommand}" CommandParameter="find" IsEnabled="{Binding !Busy}" Content="Find it" />
                                    <Button Classes="btn sm ink" Command="{Binding PressCommand}" CommandParameter="connect" IsEnabled="{Binding !Busy}" Content="Connect" />
                                  </StackPanel>
                                </StackPanel>

                                <!-- The microphone -->
                                <StackPanel Spacing="10" IsVisible="{Binding IsMicrophone}">
                                  <TextBlock Classes="hint" Text="It records with this computer's microphone. The recording stays here; only the transcript goes to your library." />
                                  <Button Classes="btn sm ink" HorizontalAlignment="Left" Command="{Binding PressCommand}" CommandParameter="allow" IsVisible="{Binding Setup.ShowAllowMic}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                      <c:Icon Glyph="mic" Size="16" />
                                      <TextBlock Text="Allow microphone" VerticalAlignment="Center" />
                                    </StackPanel>
                                  </Button>
                                  <StackPanel Spacing="8" IsVisible="{Binding Setup.ShowMicCheck}">
                                    <c:Waveform Height="28" Bars="24" Levels="{Binding Setup.MicLevels}" Foreground="{DynamicResource Record}" HorizontalAlignment="Left" />
                                    <TextBlock Classes="hint" Text="{Binding Setup.MicLine}" />
                                  </StackPanel>
                                  <StackPanel Spacing="8" IsVisible="{Binding Setup.ShowMicProblem}">
                                    <TextBlock Classes="say" FontWeight="Bold" Text="{Binding Setup.MicProblemTitle}" IsVisible="{Binding Setup.HasMicProblemTitle}" />
                                    <TextBlock Classes="hint" Text="{Binding Setup.MicProblemText}" />
                                    <Button Classes="btn sm" HorizontalAlignment="Left" Command="{Binding PressCommand}" CommandParameter="settings" IsVisible="{Binding Setup.HasMicProblemButton}" Content="{Binding Setup.MicProblemButton}" />
                                  </StackPanel>
                                </StackPanel>

                                <!-- The transcription model -->
                                <StackPanel Spacing="10" IsVisible="{Binding IsModel}">
                                  <TextBlock Classes="hint" Text="{Binding ModelBody}" />
                                  <!-- (Each row keeps room round itself for its focus ring, which a list would cut off.) -->
                                  <ItemsControl ItemsSource="{Binding Setup.Models}" IsVisible="{Binding Changing}" Margin="-4,-3">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="s:ModelChoice">
                                        <Button AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Size}" Classes="choice row" Margin="4,3" Command="{Binding $parent[ItemsControl].((vm:CardEntry)DataContext).PickModelCommand}" CommandParameter="{Binding}">
                                          <Grid ColumnDefinitions="*,12,Auto">
                                            <TextBlock Classes="choice-title" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Classes="num hint" Text="{Binding Size}" VerticalAlignment="Center" />
                                          </Grid>
                                        </Button>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                  <Grid ColumnDefinitions="Auto,*,Auto,8,Auto" Margin="0,4,0,0">
                                    <Button Classes="text-link small" VerticalAlignment="Center" Command="{Binding PressCommand}" CommandParameter="change" Content="Change" />
                                    <Button Grid.Column="2" Classes="btn sm" Command="{Binding PressCommand}" CommandParameter="notnow" Content="Not now" />
                                    <Button Grid.Column="4" Classes="btn sm ink" Command="{Binding PressCommand}" CommandParameter="download" Content="Download" />
                                  </Grid>
                                </StackPanel>

                                <!-- Canvas: the browser helper, with Canvas connect's own steps and code (a store: the Chrome Web
                                     Store, or Mozilla's for Firefox) or its three pictures (the folder) -->
                                <StackPanel Spacing="12" IsVisible="{Binding IsChrome}">
                                  <ContentControl Content="{Binding Canvas}">
                                    <ContentControl.ContentTemplate>
                                      <DataTemplate x:DataType="vm:CanvasConnectModel">
                                        <StackPanel Spacing="12">
                                          <StackPanel Spacing="6" IsVisible="{Binding ShowAdvice}">
                                            <TextBlock Classes="say" Text="{Binding AdviceText}" />
                                            <Button Classes="text-link small" Command="{Binding GetBrowserCommand}" IsVisible="{Binding ShowGetBrowser}" Content="Get Chrome" />
                                            <Button Classes="text-link small" Command="{Binding HaveItCommand}" IsVisible="{Binding ShowHaveIt}" Content="{Binding HaveItLabel}" />
                                          </StackPanel>
                                          <TextBlock Classes="hint" Text="{Binding BrowserHelp}" />
                                          <StackPanel Spacing="10" IsVisible="{Binding FromFolder}">
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                              <Border Classes="cv-illus" Height="76">
                                                <StackPanel Spacing="10">
                                                  <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right">
                                                    <TextBlock Classes="cv-illus-row" Text="Developer mode" VerticalAlignment="Center" />
                                                    <Border Classes="cv-illus-toggle"><Ellipse Classes="cv-illus-knob" /></Border>
                                                  </StackPanel>
                                                  <Border Height="6" CornerRadius="3" Background="{DynamicResource Line}" Margin="0,4,20,0" />
                                                  <Border Height="6" CornerRadius="3" Background="{DynamicResource Line}" Margin="0,0,40,0" />
                                                </StackPanel>
                                              </Border>
                                              <Border Grid.Column="1" Classes="cv-illus" Height="76">
                                                <StackPanel Spacing="10">
                                                  <TextBlock Classes="cv-illus-title" Text="Extensions" />
                                                  <Border Classes="cv-illus-load" HorizontalAlignment="Left"><TextBlock Text="Load unpacked" /></Border>
                                                </StackPanel>
                                              </Border>
                                              <Border Grid.Column="2" Classes="cv-illus" Height="76">
                                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                                  <TextBlock Classes="cv-illus-row" Text="Downloads" />
                                                  <Border Grid.Row="1" Classes="cv-illus-row cv-highlight" Padding="4,2"><TextBlock Classes="cv-illus-row cv-highlight" Text="{Binding FolderName}" TextTrimming="CharacterEllipsis" /></Border>
                                                  <Border Grid.Row="2" Classes="cv-illus-pick" HorizontalAlignment="Right"><TextBlock Text="Select" /></Border>
                                                </Grid>
                                              </Border>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                              <Grid ColumnDefinitions="16,*"><TextBlock Classes="cv-caption-num" Text="1" /><TextBlock Grid.Column="1" Classes="cv-caption" Text="Turn on Developer mode, top right" TextWrapping="Wrap" /></Grid>
                                              <Grid Grid.Column="1" ColumnDefinitions="16,*"><TextBlock Classes="cv-caption-num" Text="2" /><TextBlock Grid.Column="1" Classes="cv-caption" Text="Click Load unpacked" TextWrapping="Wrap" /></Grid>
                                              <Grid Grid.Column="2" ColumnDefinitions="16,*"><TextBlock Classes="cv-caption-num" Text="3" /><TextBlock Grid.Column="1" Classes="cv-caption" Text="{Binding PickCaption}" TextWrapping="Wrap" /></Grid>
                                            </Grid>
                                          </StackPanel>
                                          <StackPanel Spacing="8" IsVisible="{Binding FromStore}">
                                            <Grid ColumnDefinitions="16,*"><TextBlock Classes="cv-caption-num" Text="1" /><TextBlock Grid.Column="1" Classes="cv-caption" Text="{Binding StoreStep1}" TextWrapping="Wrap" /></Grid>
                                            <Grid ColumnDefinitions="16,*"><TextBlock Classes="cv-caption-num" Text="2" /><TextBlock Grid.Column="1" Classes="cv-caption" Text="{Binding StoreStep2}" TextWrapping="Wrap" /></Grid>
                                            <Border Classes="cv-code" Margin="16,0,0,0" IsVisible="{Binding ShowCode}">
                                              <Grid ColumnDefinitions="*,10,Auto">
                                                <SelectableTextBlock AutomationProperties.Name="Connection code" Text="{Binding ConnectionCode}" />
                                                <Button Grid.Column="2" Classes="btn sm" VerticalAlignment="Top" Command="{Binding CopyCodeCommand}" Content="{Binding CopyLabel}" />
                                              </Grid>
                                            </Border>
                                            <Grid ColumnDefinitions="16,*"><TextBlock Classes="cv-caption-num" Text="3" /><TextBlock Grid.Column="1" Classes="cv-caption" Text="{Binding StoreStep3}" TextWrapping="Wrap" /></Grid>
                                          </StackPanel>
                                          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding WaitingForBrowser}">
                                            <c:SyftLoader Kind="HoppingBits" Size="20" VerticalAlignment="Center" />
                                            <TextBlock Classes="hint" Text="{Binding WaitingLabel}" VerticalAlignment="Center" />
                                          </StackPanel>
                                          <Button Name="OtherWay" Classes="text-link small" Command="{Binding OtherWayCommand}" IsVisible="{Binding ShowOtherWay}" Content="{Binding OtherWayLabel}" />
                                          <Grid ColumnDefinitions="Auto,8,*" IsVisible="{Binding BrowserError, Converter={x:Static c:Converters.NotEmpty}}">
                                            <c:Icon Classes="warn" Size="15" VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <TextBlock Grid.Column="2" Classes="hint" Foreground="{DynamicResource Ink}" Text="{Binding BrowserError}" />
                                          </Grid>
                                        </StackPanel>
                                      </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                  </ContentControl>
                                  <!-- Another browser (when there is one), a link on the left; the card's one button on the right -->
                                  <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding Canvas.ShowAddRow, FallbackValue=True}">
                                    <Button Classes="text-link small" VerticalAlignment="Center" IsVisible="{Binding Canvas.CanSwitchBrowser, FallbackValue=False}" Content="Use another browser">
                                      <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedLeft" ItemsSource="{Binding Canvas.BrowserChoices}" ItemContainerTheme="{StaticResource CvBrowserItem}" />
                                      </Button.Flyout>
                                    </Button>
                                    <Button Grid.Column="2" Classes="btn sm ink" Command="{Binding PressCommand}" CommandParameter="add" IsVisible="{Binding Canvas.ShowAddToBrowser, FallbackValue=True}" IsEnabled="{Binding !Busy}"
                                            Content="{Binding Canvas.AddLabel, FallbackValue='Add to your browser'}" />
                                  </Grid>
                                </StackPanel>

                                <!-- The courses Canvas found -->
                                <StackPanel Spacing="10" IsVisible="{Binding IsCourses}">
                                  <ItemsControl ItemsSource="{Binding Setup.Courses}">
                                    <ItemsControl.ItemsPanel>
                                      <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="vm:SetupCourse">
                                        <CheckBox AutomationProperties.Name="{Binding Name}" IsChecked="{Binding Ticked}">
                                          <TextBlock FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"><Run Text="{Binding Name}" /><Run Text="  " /><Run Text="{Binding Code}" FontWeight="Medium" Foreground="{DynamicResource InkSubtle}" FontSize="12.5" /></TextBlock>
                                        </CheckBox>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <c:SyftLoader Kind="HoppingBits" Size="20" IsVisible="{Binding Busy}" VerticalAlignment="Center" />
                                    <Button Classes="btn sm ink" Command="{Binding PressCommand}" CommandParameter="add" IsEnabled="{Binding !Busy}" Content="Add these classes" />
                                  </StackPanel>
                                </StackPanel>

                                <!-- Let the ChatGPT or Claude app read the library -->
                                <StackPanel Spacing="12" IsVisible="{Binding IsAiApp}">
                                  <TextBlock Classes="hint" Text="{Binding AiAppBody}" />
                                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <Button Classes="btn sm" Command="{Binding PressCommand}" CommandParameter="notnow" Content="Not now" />
                                    <Button Classes="btn sm ink" Command="{Binding PressCommand}" CommandParameter="connect" Content="Connect" />
                                  </StackPanel>
                                </StackPanel>

                                <!-- Start at login -->
                                <StackPanel Spacing="12" IsVisible="{Binding IsStartAtLogin}">
                                  <TextBlock Classes="hint" Text="{Binding StartAtLoginBody}" />
                                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <Button Classes="btn sm" Command="{Binding PressCommand}" CommandParameter="notnow" Content="Not now" />
                                    <Button Classes="btn sm ink" Command="{Binding PressCommand}" CommandParameter="on" Content="Turn on" />
                                  </StackPanel>
                                </StackPanel>

                                <!-- Windows' taskbar -->
                                <StackPanel Spacing="12" IsVisible="{Binding IsTaskbar}">
                                  <TextBlock Classes="hint" Text="{Binding TaskbarBody}" />
                                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <Button Classes="btn sm" Command="{Binding PressCommand}" CommandParameter="open" Content="Open taskbar settings" />
                                    <Button Classes="btn sm ink" Command="{Binding PressCommand}" CommandParameter="done" Content="Done" />
                                  </StackPanel>
                                </StackPanel>

                                <!-- Finished -->
                                <StackPanel Spacing="12" IsVisible="{Binding IsFinish}">
                                  <ItemsControl ItemsSource="{Binding Recap}">
                                    <ItemsControl.ItemsPanel>
                                      <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="x:String">
                                        <Grid ColumnDefinitions="Auto,8,*">
                                          <c:Icon Glyph="check" Size="15" Foreground="{DynamicResource InkMuted}" VerticalAlignment="Center" />
                                          <TextBlock Grid.Column="2" Classes="hint" Foreground="{DynamicResource Ink}" Text="{Binding}" VerticalAlignment="Center" />
                                        </Grid>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                  <StackPanel Spacing="10" IsVisible="{Binding Setup.HasKeys}">
                                    <Button Classes="text-link small" AutomationProperties.Name="Change shortcuts" Command="{Binding Setup.ToggleKeysCommand}">
                                      <StackPanel Orientation="Horizontal" Spacing="6">
                                        <c:Icon Glyph="keyboard" Size="15" />
                                        <TextBlock Text="Change shortcuts" VerticalAlignment="Center" />
                                      </StackPanel>
                                    </Button>
                                    <Panel IsVisible="{Binding Setup.KeysOpen}">
                                      <v:ShortcutsEditor DataContext="{Binding Setup.Keys}" />
                                    </Panel>
                                  </StackPanel>
                                  <Button Classes="btn sm ink" HorizontalAlignment="Right" Command="{Binding PressCommand}" CommandParameter="finish" Content="Open Syft Notes" />
                                </StackPanel>

                                <Grid ColumnDefinitions="Auto,8,*" IsVisible="{Binding HasProblem}">
                                  <c:Icon Classes="warn" Size="15" VerticalAlignment="Top" Margin="0,2,0,0" />
                                  <TextBlock Grid.Column="2" Classes="hint" Foreground="{DynamicResource Ink}" Text="{Binding Problem}" />
                                </Grid>
                              </StackPanel>
                            </Border>
                          </Panel>
                        </DataTemplate>
                      </ItemsControl.DataTemplates>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding Busy}">
                      <c:SyftLoader Kind="HoppingBits" Size="24" IsActive="{Binding Busy}" VerticalAlignment="Center" />
                      <TextBlock Classes="ai-thinking" Text="{Binding Thinking}" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </DockPanel>
            </Panel>
          </Border>
        </Panel>
      </Grid>
    </DockPanel>
  </Border>
</UserControl>
