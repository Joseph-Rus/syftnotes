<!-- The Canvas screens' shared Mac look (design 06, 08): a "cv-" prefix on every class so it never crosses the
     settings page's own "group"/"row"/"pill" classes once our controls sit inside it. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:StudyStash.App.Controls">

  <!-- design 08: one state's card -->
  <Style Selector="Border.cv-card">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="{DynamicResource Group}" />
    <Setter Property="Padding" Value="16,14,14,14" />
  </Style>

  <Style Selector="c|Icon.cv-glyph">
    <Setter Property="Size" Value="20" />
    <Setter Property="Filled" Value="True" />
  </Style>
  <Style Selector="c|Icon.cv-glyph.cv-info">
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="c|Icon.cv-glyph.cv-ok">
    <Setter Property="Foreground" Value="{DynamicResource Ok}" />
  </Style>
  <Style Selector="c|Icon.cv-glyph.cv-warn">
    <Setter Property="Foreground" Value="{DynamicResource Warn}" />
  </Style>
  <!-- The design has no separate Mac "error" colour: the error card's icon is the accent, same as its title link. -->
  <Style Selector="c|Icon.cv-glyph.cv-error">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <Style Selector="TextBlock.cv-title">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.cv-text">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    <Setter Property="LineHeight" Value="17.4" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>

  <!-- Syncing's progress bar: a flexible track, the done fraction filled in the accent. -->
  <Style Selector="Border.cv-track">
    <Setter Property="Height" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource Fill2}" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>
  <Style Selector="Border.cv-bar">
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource Accent}" />
  </Style>

  <!-- A state's button: a tinted pill (Connect, Show me how), a plain raised pill (everything else with one), or
       plain text (Dismiss — no fill at all in the design). -->
  <Style Selector="Button.cv-pill">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="{DynamicResource Raised}" />
  </Style>
  <Style Selector="Button.cv-pill /template/ Border#PART_Bg">
    <Setter Property="BoxShadow" Value="{DynamicResource RaisedShadow}" />
  </Style>
  <Style Selector="Button.cv-pill.cv-primary">
    <Setter Property="Background" Value="{DynamicResource Tint}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="Button.cv-pill.cv-primary TextBlock">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.cv-pill.cv-primary /template/ Border#PART_Bg">
    <Setter Property="BoxShadow" Value="{DynamicResource EdgeTint}" />
  </Style>
  <Style Selector="Button.cv-pill.cv-plain">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.cv-pill.cv-plain /template/ Border#PART_Bg">
    <Setter Property="BoxShadow" Value="none" />
  </Style>

  <!-- design 06: Settings -> Canvas -->
  <!-- letter-spacing (design -0.015em) goes on the element itself, as c:Typography.Extra="-0.39" -->
  <Style Selector="TextBlock.cv-h1">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.cv-intro">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="19.5" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxWidth" Value="520" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="TextBlock.cv-h2">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="4,0" />
  </Style>
  <Style Selector="TextBlock.cv-link">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
  </Style>
  <Style Selector="Border.cv-group">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="{DynamicResource Group}" />
  </Style>
  <Style Selector="Border.cv-sep">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Sep}" />
    <Setter Property="Margin" Value="16,0,0,0" />
  </Style>
  <Style Selector="Grid.cv-row">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Margin" Value="16,8" />
  </Style>
  <Style Selector="TextBlock.cv-value">
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.cv-dot-label">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Ellipse.cv-dot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
  </Style>
  <Style Selector="c|Icon.cv-scout">
    <Setter Property="Size" Value="14" />
    <Setter Property="Filled" Value="True" />
  </Style>
  <Style Selector="c|Icon.cv-scout.cv-ok">
    <Setter Property="Foreground" Value="{DynamicResource Ok}" />
  </Style>
  <Style Selector="c|Icon.cv-scout.cv-warn">
    <Setter Property="Foreground" Value="{DynamicResource Warn}" />
  </Style>
  <Style Selector="TextBlock.cv-scout">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="TextBlock.cv-change">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="c|Icon.cv-change">
    <Setter Property="Size" Value="17" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>

  <!-- The design's select: a rounded pill with a chevron, its flyout listing the choices. -->
  <Style Selector="Button.cv-select">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="12,0,8,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="{DynamicResource Raised}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.cv-select /template/ Border#PART_Bg">
    <Setter Property="BoxShadow" Value="{DynamicResource RaisedShadow}" />
  </Style>
  <Style Selector="Button.cv-select-item">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="TextBlock.cv-placeholder">
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>

  <!-- design 09: the Due list -->
  <Style Selector="TextBlock.cv-due-title">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.cv-due-sub">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="TextBlock.cv-group-label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    <Setter Property="Padding" Value="22,14,22,4" />
  </Style>
  <Style Selector="TextBlock.cv-group-label.cv-accent">
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
  </Style>
  <Style Selector="Button.cv-due-row">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="10,2" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.cv-due-row.cv-selected">
    <Setter Property="Background" Value="{DynamicResource Tint}" />
  </Style>
  <Style Selector="Button.cv-due-row.cv-selected /template/ Border#PART_Bg">
    <Setter Property="BoxShadow" Value="{DynamicResource EdgeTint}" />
  </Style>
  <Style Selector="Button.cv-due-row.cv-selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="TextBlock.cv-row-title">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.cv-row-right">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="TextBlock.cv-row-right.cv-strong">
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.cv-row-sub">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="Ellipse.cv-row-dot">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
  </Style>
  <Style Selector="Ellipse.cv-row-dot.cv-selected">
    <Setter Property="Stroke" Value="{DynamicResource OnAccent}" />
    <Setter Property="StrokeThickness" Value="1.5" />
  </Style>

  <!-- design 09: an assignment's detail -->
  <Style Selector="TextBlock.cv-meta">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="TextBlock.cv-detail-title">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Border.cv-tiles">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="{DynamicResource Group}" />
  </Style>
  <Style Selector="Border.cv-tile-sep">
    <Setter Property="Width" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Sep}" />
  </Style>
  <Style Selector="TextBlock.cv-tile-label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="TextBlock.cv-tile-value">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.cv-h3">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.cv-rule">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Sep}" />
  </Style>
  <Style Selector="TextBlock.cv-rubric-crit">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.cv-rubric-pts">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="TextBlock.cv-rubric-comment">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.cv-submission">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="{DynamicResource Group}" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="TextBlock.cv-sub-status">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.cv-sub-detail">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="TextBlock.cv-comment">
    <Setter Property="FontFamily" Value="{DynamicResource SerifFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="25.6" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.cv-comment-author">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="Button.cv-hand-in">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="TextBlock.cv-hand-in">
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Border.cv-chip">
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Background" Value="{DynamicResource Raised}" />
    <Setter Property="Padding" Value="10,0,14,0" />
    <Setter Property="BoxShadow" Value="{DynamicResource RaisedShadow}" />
  </Style>
  <Style Selector="TextBlock.cv-chip-name">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.cv-chip-size">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="Button.cv-toolbtn">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Background" Value="{DynamicResource Glass}" />
    <Setter Property="Padding" Value="12,0,14,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.cv-toolbtn /template/ Border#PART_Bg">
    <Setter Property="BoxShadow" Value="{DynamicResource Edge}, {DynamicResource CtlShadow}" />
  </Style>
  <Style Selector="Button.cv-toolicon">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Background" Value="{DynamicResource Glass}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.cv-toolicon /template/ Border#PART_Bg">
    <Setter Property="BoxShadow" Value="{DynamicResource Edge}, {DynamicResource CtlShadow}" />
  </Style>

  <!-- design 10/11: a Canvas-linked class's own page -->
  <Style Selector="c|Icon.cv-scoutline">
    <Setter Property="Size" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>

  <!-- the tabs layout's segmented control -->
  <Style Selector="Border.cv-seg">
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Background" Value="{DynamicResource Group}" />
    <Setter Property="Padding" Value="3" />
  </Style>
  <Style Selector="Button.cv-seg-item">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="Padding" Value="6,5" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.cv-seg-item.cv-on">
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
    <Setter Property="Background" Value="{DynamicResource Raised}" />
  </Style>
  <Style Selector="Button.cv-seg-item.cv-on /template/ Border#PART_Bg">
    <Setter Property="BoxShadow" Value="{DynamicResource RaisedShadow}" />
  </Style>

  <!-- a tree section's own header row (Modules, Files, Announcements) -->
  <Style Selector="Button.cv-section-header">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sep}" />
  </Style>
  <Style Selector="TextBlock.cv-section-title">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="c|Icon.cv-tree-icon">
    <Setter Property="Size" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="c|Icon.cv-tree-icon.cv-section">
    <Setter Property="Size" Value="18" />
  </Style>
  <Style Selector="Ellipse.cv-new-dot">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="Fill" Value="{DynamicResource Accent}" />
  </Style>

  <!-- a module: its own small label, an open module's items, a collapsed module's summary row -->
  <Style Selector="TextBlock.cv-mod-label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="Button.cv-mod-item">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="TextBlock.cv-mod-title">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.cv-mod-right">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="Button.cv-mod-collapsed">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="TextBlock.cv-mod-collapsed-text">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>

  <!-- a lecture row -->
  <Style Selector="Button.cv-lecture-row">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="TextBlock.cv-lecture-title">
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- a reader (a page or an announcement) -->
  <Style Selector="TextBlock.cv-reader-body">
    <Setter Property="FontFamily" Value="{DynamicResource SerifFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="25.6" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- design 07: connecting Canvas -->
  <Style Selector="TextBlock.cv-step-label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="Border.cv-num">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="1.3" />
    <Setter Property="BorderBrush" Value="{DynamicResource Fg3}" />
  </Style>
  <Style Selector="Border.cv-num TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Fg3}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.cv-num.cv-current">
    <Setter Property="BorderBrush" Value="{DynamicResource Fg}" />
  </Style>
  <Style Selector="Border.cv-num.cv-current TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
  </Style>
  <Style Selector="c|Icon.cv-num-done">
    <Setter Property="Size" Value="20" />
    <Setter Property="Filled" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
  </Style>
  <Style Selector="TextBlock.cv-step-title">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.cv-step-title.cv-current">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.cv-step-title.cv-todo">
    <Setter Property="Foreground" Value="{DynamicResource Fg3}" />
  </Style>
  <Style Selector="Grid.cv-step-row">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Margin" Value="16,8" />
  </Style>
  <Style Selector="TextBlock.cv-step-body">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    <Setter Property="LineHeight" Value="17.4" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.cv-illus">
    <Setter Property="Background" Value="{DynamicResource Raised}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sep}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10" />
  </Style>
  <Style Selector="TextBlock.cv-illus-title">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.cv-illus-toggle">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="15" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Ellipse.cv-illus-knob">
    <Setter Property="Width" Value="11" />
    <Setter Property="Height" Value="11" />
    <Setter Property="Fill" Value="White" />
    <Setter Property="Margin" Value="0,0,2,0" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.cv-illus-load">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="Border.cv-illus-load TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Border.cv-illus-pick">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,3" />
  </Style>
  <Style Selector="Border.cv-illus-pick TextBlock">
    <Setter Property="FontSize" Value="9" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="TextBlock.cv-illus-row">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="TextBlock.cv-illus-row.cv-highlight">
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.cv-illus-row.cv-highlight">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="TextBlock.cv-caption">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="TextBlock.cv-caption-num">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
  </Style>
  <Style Selector="TextBlock.cv-waiting">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="StackPanel.cv-footer">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Margin" Value="0,18,0,0" />
  </Style>
  <Style Selector="Button.cv-skip">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- design 12: a Canvas notification toast -->
  <Style Selector="Border.cv-toast-tile">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="TextBlock.cv-toast-title">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.cv-toast-when">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>
  <Style Selector="TextBlock.cv-toast-text">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="17.55" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Button.cv-toast-btn">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="{DynamicResource Fill2}" />
  </Style>
  <Style Selector="Button.cv-toast-btn /template/ Border#PART_Bg">
    <Setter Property="BoxShadow" Value="{DynamicResource EdgeSoft}" />
  </Style>

</Styles>
