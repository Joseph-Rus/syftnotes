<!-- Getting Gemini, Claude or ChatGPT ready from a lecture's page (Windows): guided setup's two screens for it,
     on their own in a small window (no list of steps, no chat). Get it ready (its maker's own installer, one button),
     then sign in on its maker's own page; it moves on by itself, and once it's ready the window closes and it writes
     the lecture's notes. Back closes it with nothing changed. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             x:Class="StudyStash.App.Views.WinGetReady"
             x:DataType="vm:GuidedSetupModel"
             Classes="in-setup"
             Width="620" Height="580">
  <UserControl.Styles>
    <StyleInclude Source="avares://StudyStash/Views/SetupStyles.axaml" />
    <!-- The window's frame, for a screenshot only: a real window has Windows' own corners, edge and shadow. -->
    <Style Selector="Border#Chrome.chrome">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BoxShadow" Value="{DynamicResource ShadowLg}" />
    </Style>
  </UserControl.Styles>

  <Border Name="Chrome" Classes="chrome" Background="{DynamicResource Canvas}" ClipToBounds="True">
    <DockPanel>
      <!-- The title bar: drag the window by it; the system's caption buttons sit on its right. -->
      <c:WindowHeader Name="Header" DockPanel.Dock="Top" CanResize="False" Title="{Binding ReadyTitle}" />
      <Panel Margin="8,0,8,8">
        <Border Classes="setup-pane" />
        <Border Classes="setup-clip">
          <DockPanel>
            <!-- Back, and nothing else: it moves on by itself once installed, and closes once signed in and checked. -->
            <Grid DockPanel.Dock="Bottom" Classes="setup-foot" ColumnDefinitions="Auto,*">
              <Button Name="ByHand" Classes="text-link" VerticalAlignment="Center" Command="{Binding ByHandCommand}" Content="{Binding ByHandLabel}" />
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Classes="setup-page">
                <TextBlock Classes="step-label" Text="{Binding StepLabel}" IsVisible="{Binding HasStepLabel}" />
                    <!-- Screen 2 · Install -->
                    <StackPanel IsVisible="{Binding OnInstall}">
                      <Grid ColumnDefinitions="Auto,12,*">
                        <c:Icon Name="InstallMark" Glyph="{Binding BrandGlyph}" Size="28" VerticalAlignment="Top" Margin="0,10,0,0" />
                        <TextBlock Grid.Column="2" Classes="page-title step-title" Text="{Binding InstallTitle}" />
                      </Grid>
                      <TextBlock Classes="page-lede step-lede" Text="{Binding InstallLede}" />
                      <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,24,0,0" IsVisible="{Binding ShowInstallButton}">
                        <Button Name="Install" Classes="btn sm ink" Command="{Binding InstallCommand}" Content="{Binding InstallButton}" />
                        <TextBlock Classes="hint" Text="{Binding InstallSource}" VerticalAlignment="Center" MaxWidth="250" />
                      </StackPanel>
                      <StackPanel Spacing="10" Margin="0,26,0,0" MaxWidth="480" HorizontalAlignment="Stretch" IsVisible="{Binding Installing}">
                        <c:SyftLoader Kind="PixelProgress" Size="9" HorizontalAlignment="Left" />
                        <TextBlock Classes="hint" Text="{Binding Phase}" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,26,0,0" IsVisible="{Binding ShowInstalled}">
                        <c:Icon Classes="ok" Size="18" />
                        <TextBlock Classes="say" Text="{Binding InstalledWords}" />
                      </StackPanel>
                      <Border Classes="problem" Margin="0,22,0,0" IsVisible="{Binding HasInstallProblem}">
                        <StackPanel Spacing="12">
                          <Grid ColumnDefinitions="Auto,10,*">
                            <c:Icon Classes="warn" Size="18" VerticalAlignment="Top" Margin="0,1,0,0" />
                            <TextBlock Grid.Column="2" Classes="say" Text="{Binding InstallProblem}" />
                          </Grid>
                          <WrapPanel Margin="28,0,0,0" ItemSpacing="8" LineSpacing="8">
                            <Button Classes="btn sm" Command="{Binding TryAgainCommand}" Content="Try again" />
                            <Button Classes="btn sm" Command="{Binding UseOtherCommand}" IsVisible="{Binding InstallRegion}" Content="{Binding UseOtherLabel}" />
                            <Button Classes="btn sm" Command="{Binding UseOllamaCommand}" IsVisible="{Binding InstallRegion}" Content="Carry on without it" />
                            <Button Classes="text-link small" VerticalAlignment="Center" Margin="6,0,0,0" Command="{Binding OpenDocsCommand}" IsVisible="{Binding InstallOther}">
                              <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="Get help" /><c:Icon Glyph="arrow_outward" Size="13" /></StackPanel>
                            </Button>
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                      <Button Classes="text-link small" Margin="0,18,0,0" Command="{Binding ToggleDetailsCommand}" Content="Details" />
                      <Border Classes="mono" Margin="0,10,0,0" IsVisible="{Binding ShowDetails}">
                        <StackPanel Spacing="6">
                          <SelectableTextBlock Text="{Binding InstallLine}" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
                          <SelectableTextBlock Text="{Binding InstallOutput}" MaxHeight="120" />
                        </StackPanel>
                      </Border>
                    </StackPanel>

                    <!-- Screen 3 · Sign in -->
                    <StackPanel IsVisible="{Binding OnSignIn}">
                      <Grid ColumnDefinitions="Auto,12,*">
                        <c:Icon Name="SignInMark" Glyph="{Binding BrandGlyph}" Size="28" VerticalAlignment="Top" Margin="0,10,0,0" />
                        <TextBlock Grid.Column="2" Classes="page-title step-title" Text="{Binding SignInTitle}" />
                      </Grid>
                      <TextBlock Classes="page-lede step-lede" Text="{Binding SignInLede}" />
                      <Button Name="OpenSignIn" Classes="btn sm ink" HorizontalAlignment="Left" Margin="0,24,0,0" Command="{Binding OpenSignInCommand}" IsVisible="{Binding ShowOpenSignIn}" Content="Open sign-in page" />
                      <StackPanel Spacing="8" Margin="0,24,0,0" IsVisible="{Binding WaitingSignIn}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <c:Icon Glyph="hourglass_top" Size="16" Foreground="{DynamicResource InkMuted}" VerticalAlignment="Center" />
                          <TextBlock Classes="say" Text="Waiting for you to sign in…" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="24,0,0,0">
                          <TextBlock Classes="hint" Text="Didn't open?" VerticalAlignment="Center" />
                          <Button Classes="text-link small" VerticalAlignment="Center" Command="{Binding OpenAgainCommand}" Content="Open it again" />
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,24,0,0" IsVisible="{Binding ShowCheckingPlan}">
                        <c:Icon Classes="ok" Size="18" />
                        <TextBlock Classes="say" Text="{Binding CheckingWords}" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,24,0,0" IsVisible="{Binding ShowReady}">
                        <c:Icon Classes="ok" Size="18" />
                        <TextBlock Classes="say" Text="{Binding ReadyWords}" FontWeight="Bold" />
                      </StackPanel>
                      <!-- How much of the account's allowance is left, when the AI says (Gemini's). -->
                      <TextBlock Name="Allowance" Classes="hint" Margin="26,6,0,0" Text="{Binding AllowanceWords}" IsVisible="{Binding HasAllowance}" />
                      <!-- A sign-in that stopped: Try again; one Syft Notes couldn't start, Get help too (never a terminal). -->
                      <Border Name="SignInProblem" Classes="problem" Margin="0,18,0,0" IsVisible="{Binding HasSignInProblem}">
                        <Grid ColumnDefinitions="Auto,10,*,10,Auto,8,Auto">
                          <c:Icon Classes="warn" Size="18" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Classes="say" Text="{Binding SignInProblem}" />
                          <Button Grid.Column="4" Classes="btn sm" VerticalAlignment="Center" Command="{Binding OpenSignInCommand}" Content="Try again" />
                          <Button Name="SignInHelp" Grid.Column="6" Classes="text-link small" VerticalAlignment="Center" Command="{Binding GetHelpCommand}" IsVisible="{Binding SignInStuck}">
                            <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="Get help" /><c:Icon Glyph="arrow_outward" Size="13" /></StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                      <Border Classes="problem" Margin="0,18,0,0" IsVisible="{Binding HasPlanProblem}">
                        <StackPanel Spacing="12">
                          <Grid ColumnDefinitions="Auto,10,*">
                            <c:Icon Classes="warn" Size="18" VerticalAlignment="Top" Margin="0,1,0,0" />
                            <StackPanel Grid.Column="2" Spacing="4">
                              <TextBlock Classes="say" Text="{Binding PlanProblemTitle}" FontWeight="Bold" />
                              <TextBlock Classes="hint" Text="{Binding PlanProblemText}" IsVisible="{Binding PlanProblemText, Converter={x:Static c:Converters.NotEmpty}}" />
                            </StackPanel>
                          </Grid>
                          <StackPanel Orientation="Horizontal" Spacing="8" Margin="28,0,0,0">
                            <Button Classes="btn sm ink" Command="{Binding OpenPlansCommand}" CommandParameter="" IsVisible="{Binding PlanIsPlan}">
                              <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="See plans" VerticalAlignment="Center" /><c:Icon Glyph="arrow_outward" Size="13" /></StackPanel>
                            </Button>
                            <Button Classes="btn sm" Command="{Binding CheckAgainCommand}" Content="Check again" />
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="8" Margin="28,0,0,0">
                            <Button Classes="text-link small" VerticalAlignment="Center" Command="{Binding UseOtherCommand}" Content="{Binding UseOtherLabel}" />
                            <TextBlock Text="·" FontSize="13" Foreground="{DynamicResource InkSubtle}" VerticalAlignment="Center" />
                            <Button Classes="text-link small" VerticalAlignment="Center" Command="{Binding UseOllamaCommand}" Content="Carry on without it" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                      <StackPanel Spacing="6" Margin="0,26,0,0" MaxWidth="480" HorizontalAlignment="Left">
                        <TextBlock Classes="hint" Text="{Binding Privacy}" />
                        <TextBlock Classes="hint" Text="{Binding PlanNote}" />
                      </StackPanel>
                    </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Panel>
    </DockPanel>
  </Border>
</UserControl>
