<!-- "Add a lecture a friend shared" (both looks), in a small window of its own: the one question, which class, with the
     lecture (its title, the class and day it had there), one line on what comes in, and Add lecture. A lecture already
     here, or a library that didn't take it, says why in plain words above the buttons. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             x:Class="StudyStash.App.Views.SharedLecturePage"
             x:DataType="vm:SharedLectureModel"
             Classes="in-setup"
             Width="480">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </UserControl.KeyBindings>
  <UserControl.Styles>
    <StyleInclude Source="avares://StudyStash/Views/SetupStyles.axaml" />
    <Style Selector="Border#Chrome.chrome">
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
      <Setter Property="BoxShadow" Value="{DynamicResource ShadowLg}" />
    </Style>
    <!-- The class, as a field, as Add a recording's is. -->
    <Style Selector="Button.picker.as-field">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="10,0,8,0" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </UserControl.Styles>
  <Border Name="Chrome" Background="{DynamicResource Canvas}" ClipToBounds="True">
    <DockPanel>
      <c:WindowHeader Name="Header" DockPanel.Dock="Top" CanResize="False" Title="{x:Static vm:SharedWords.WindowTitle}" />
      <StackPanel Margin="28,4,28,26" Spacing="{DynamicResource Space5}">

        <TextBlock Name="Question" Classes="say" FontWeight="Bold" Text="{Binding Question}" TextWrapping="Wrap" />

        <!-- The lecture -->
        <Border Name="LectureCard" Classes="group">
          <Grid ColumnDefinitions="Auto,12,*" Margin="16,12">
            <c:Icon Glyph="description" Size="22" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <TextBlock Name="LectureTitle" Classes="say" FontWeight="Bold" Text="{Binding Lecture.Title}" ToolTip.Tip="{Binding Lecture.Title}" c:Tips.WhenCut="True"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
              <TextBlock Name="LectureDetail" Classes="hint" Text="{Binding Detail}" IsVisible="{Binding Detail, Converter={x:Static c:Converters.NotEmpty}}" />
            </StackPanel>
          </Grid>
        </Border>

        <StackPanel>
          <TextBlock Classes="label" Text="{x:Static vm:SharedWords.ClassLabel}" />
          <Button Name="ClassButton" Classes="picker as-field" Click="OnPickClass" AutomationProperties.Name="{Binding ClassWords}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <c:Swatch Fill="{Binding ClassDot}" IsVisible="{Binding HasClassDot}" Margin="3,0,10,0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding ClassWords}" ToolTip.Tip="{Binding ClassWords}" c:Tips.WhenCut="True" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <c:Icon Grid.Column="2" Glyph="expand_more" Size="14" VerticalAlignment="Center" />
            </Grid>
          </Button>
        </StackPanel>

        <TextBlock Name="Next" Classes="hint" Text="{x:Static vm:SharedWords.Next}" TextWrapping="Wrap" />

        <!-- It didn't come in: the words are the library's own -->
        <Grid ColumnDefinitions="Auto,8,*" IsVisible="{Binding Add.Say, Converter={x:Static c:Converters.NotEmpty}}">
          <c:Icon Classes="warn" Size="16" VerticalAlignment="Top" Margin="0,1,0,0" />
          <TextBlock Name="Problem" Grid.Column="2" Classes="say" Text="{Binding Add.Say}" TextWrapping="Wrap" />
        </Grid>

        <Grid ColumnDefinitions="*,Auto,8,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Add.Busy}" VerticalAlignment="Center">
            <c:SyftLoader Kind="HoppingBits" Size="16" VerticalAlignment="Center" />
            <TextBlock Classes="say" Text="{x:Static vm:SharedWords.Working}" VerticalAlignment="Center" />
          </StackPanel>
          <Button Name="Cancel" Grid.Column="1" Classes="btn sm" Command="{Binding CancelCommand}" Content="{x:Static vm:SharedWords.Cancel}" />
          <Button Name="AddLecture" Grid.Column="3" Classes="btn sm ink" Command="{Binding Add.Command}" IsEnabled="{Binding CanAdd}"
                  Content="{x:Static vm:SharedWords.Add}" />
        </Grid>
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
