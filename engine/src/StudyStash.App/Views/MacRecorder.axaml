<!-- The floating recorder (Mac): small, an upright pill of the pixel s and a level meter (Stop and a card on hover); open,
     360 × 520, the transcript fading upward and a chat below whose answers link to moments in the recording. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:v="using:StudyStash.App.Views"
             x:Class="StudyStash.App.Views.MacRecorder"
             x:DataType="vm:RecorderModel"
             ClipToBounds="False">
  <!-- Esc anywhere in the recorder closes its chat (the chat's own close button does the same) -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding Ask.CloseChatCommand}" />
  </UserControl.KeyBindings>
  <UserControl.Styles>
    <Style Selector="Button.small">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <!-- The red dot that's Stop (and Resume in its place) is one of the s's cells: its corners a cell's, 27 % of its side. -->
    <Style Selector="Button.stop, Button.resume">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="CornerRadius" Value="6.5" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.stop, Button.resume">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.stop">
      <Setter Property="Background" Value="{DynamicResource Record}" />
    </Style>
    <Style Selector="Button.stop /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource Record}" />
    </Style>
    <Style Selector="TextBlock.old">
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    </Style>
    <Style Selector="TextBlock.paused">
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    </Style>
  </UserControl.Styles>
  <Panel>
    <!-- The pill, upright and quiet: the pixel s over a three-bar level meter, nothing else. With the pointer on
         it the s turns into Stop (Resume while paused), one click away, and a card beside it says the class, the time
         and the last lines heard (PillCard, a window of its own beside it). A click anywhere else on it opens the recorder; a drag moves it. Paused, the meter
         rests and the s dims. -->
    <Border Name="Pill" IsVisible="{Binding !Expanded}" Classes.recording="{Binding IsRunning}" Classes.paused="{Binding IsPaused}"
            Width="36" Height="62" CornerRadius="18" Background="{DynamicResource Surface}" BoxShadow="{DynamicResource ShadowFloat}"
            HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.Name="{Binding PillSaid}">
      <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Panel Width="24" Height="24" HorizontalAlignment="Center">
          <Viewbox Name="PillMark" Width="18" Height="18" IsVisible="{Binding ShowMark}" Opacity="{Binding IsPaused, Converter={x:Static c:Converters.Dim}}">
            <!-- The menu bar's mark: the pixel s in one colour, the window's ink. -->
            <c:SyftMark Look="Ink" Size="18" Foreground="{DynamicResource Fg}" />
          </Viewbox>
          <Button AutomationProperties.Name="Stop" Classes="stop" Command="{Binding StopCommand}" IsVisible="{Binding ShowStop}">
            <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource OnRecord}" />
          </Button>
          <Button AutomationProperties.Name="Resume" Classes="resume" Command="{Binding PauseCommand}" IsVisible="{Binding ShowResume}">
            <c:Icon Glyph="play_arrow" Filled="True" Size="14" Foreground="{DynamicResource Fg}" />
          </Button>
        </Panel>
        <!-- Its cells about the size of the s's over it (2.5 a pitch on a Retina screen, 3 at 1×) -->
        <c:Waveform Bars="3" Height="11" Lively="True" Levels="{Binding Levels}" Foreground="{DynamicResource Record}" HorizontalAlignment="Center"
                    Opacity="{Binding IsPaused, Converter={x:Static c:Converters.Dim}}" />
      </StackPanel>
    </Border>

    <!-- Expanded: the glass keeps its shadow outside; the Border inside cuts what scrolls to its corners. -->
    <c:Glass IsVisible="{Binding Expanded}" Width="360" Height="520" CornerRadius="{DynamicResource RadiusPane}">
      <Border CornerRadius="{DynamicResource RadiusPane}" ClipToBounds="True">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Height="60" Margin="20,0,12,0" ColumnDefinitions="Auto,10,Auto,10,Auto,*,Auto">
            <c:SyftCell Width="8" Height="8" Fill="{DynamicResource Rec}" VerticalAlignment="Center" IsVisible="{Binding IsRunning}" />
            <c:SyftCell Width="8" Height="8" Fill="{DynamicResource Fg3}" VerticalAlignment="Center" IsVisible="{Binding IsPaused}" />
            <TextBlock Grid.Column="2" Text="{Binding DisplayClass}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Classes="num" Text="{Binding Elapsed}" FontSize="13" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
            <!-- Make it small, pause, stop: one pill of three round buttons -->
            <Border Grid.Column="6" Classes="fill" CornerRadius="19" Padding="3" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button AutomationProperties.Name="Make it small" Classes="small" Command="{Binding ToggleCommand}" ToolTip.Tip="Make it small">
                  <c:Icon Glyph="close_fullscreen" Size="18" Foreground="{DynamicResource Fg2}" />
                </Button>
                <Button AutomationProperties.Name="{Binding PauseTip}" Classes="small" Command="{Binding PauseCommand}" ToolTip.Tip="{Binding PauseTip}">
                  <c:Icon Glyph="{Binding PauseGlyph}" Filled="True" Size="18" Foreground="{DynamicResource Fg}" />
                </Button>
                <Button AutomationProperties.Name="Stop" Classes="small" Background="{DynamicResource Record}" Command="{Binding StopCommand}" ToolTip.Tip="Stop">
                  <c:Icon Glyph="stop" Filled="True" Size="12" Foreground="{DynamicResource OnRecord}" />
                </Button>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Ask about this lecture, with any engine (design 16); none for one written down after class -->
          <v:MacAiAskChat Name="AskChat" DockPanel.Dock="Bottom" Margin="12,4,12,12" DataContext="{Binding Ask}"
                          IsVisible="{Binding $parent[UserControl].((vm:RecorderModel)DataContext).Live}" />

          <!-- What's been said, newest at the bottom, fading out toward the top -->
          <ScrollViewer Name="Heard" Padding="20,0,20,16" VerticalScrollBarVisibility="Hidden">
            <ScrollViewer.OpacityMask>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="Transparent" Offset="0" />
                <GradientStop Color="Black" Offset="0.55" />
              </LinearGradientBrush>
            </ScrollViewer.OpacityMask>
            <Panel VerticalAlignment="Bottom">
              <TextBlock IsVisible="{Binding NoLines}" Text="{Binding Waiting}" FontSize="13" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" />
              <!-- One drag selects from line to line (a line copied from its start keeps its time); the room between
                   them is left to the recorder's background, which moves it. -->
              <ItemsControl ItemsSource="{Binding Lines}" Background="{x:Null}" c:TextSelection.Area="True">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HeardLine">
                    <Grid ColumnDefinitions="34,10,*">
                      <TextBlock Classes="num" Text="{Binding Time}" FontSize="11" Foreground="{DynamicResource Fg2}" Margin="0,2,0,0" />
                      <c:PageText Grid.Column="2" Text="{Binding Text}" CopyLead="{Binding CopyLead}" FontSize="13" LineHeight="18.85" TextWrapping="Wrap"
                                 Classes.old="{Binding !Latest}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </c:Glass>
  </Panel>
</UserControl>
