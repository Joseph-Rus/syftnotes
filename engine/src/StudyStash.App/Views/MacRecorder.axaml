<!-- The floating recorder (Surfaces, macOS 02), in Liquid Glass: a small pill, 28 tall, recording or paused; open,
     360 × 520, the transcript fading upward and a chat below whose answers link to moments in the recording. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:v="using:StudyStash.App.Views"
             x:Class="StudyStash.App.Views.MacRecorder"
             x:DataType="vm:RecorderModel"
             ClipToBounds="False">
  <UserControl.Styles>
    <Style Selector="Button.small">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.stop">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <!-- The recording dot breathes, slowly: it's alive, and never glows. -->
    <Style Selector="Ellipse.pulse">
      <Style.Animations>
        <Animation Duration="0:0:1.6" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="TextBlock.old">
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    </Style>
    <Style Selector="TextBlock.paused">
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    </Style>
  </UserControl.Styles>
  <Panel>
    <!-- The pill: small, and only says it's recording. The red dot pulses slowly (no glow), then the time and a tiny
         level meter; with the pointer over it Stop takes the meter's place, and a click opens the recorder. -->
    <c:Glass Name="Pill" IsVisible="{Binding !Expanded}" Height="28" CornerRadius="14" Padding="10,0,5,0" HorizontalAlignment="Left"
             ToolTip.Tip="Click to see the transcript">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Panel Width="8" Height="8" VerticalAlignment="Center">
          <Ellipse Classes="pulse" Fill="{DynamicResource Rec}" IsVisible="{Binding IsRunning}" />
          <Ellipse Fill="{DynamicResource Fg3}" IsVisible="{Binding IsPaused}" />
        </Panel>
        <TextBlock Classes="num" Text="{Binding Elapsed}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                   Classes.paused="{Binding IsPaused}" />
        <Panel Width="18" Height="18" VerticalAlignment="Center">
          <c:Waveform Bars="3" Height="10" MinBar="2" Levels="{Binding Levels}" Foreground="{DynamicResource Fg2}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowMeter}" />
          <c:Icon Glyph="pause" Filled="True" Size="12" Foreground="{DynamicResource Fg2}" HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsVisible="{Binding ShowPausedMark}" />
          <Button Classes="stop fill2" Command="{Binding StopCommand}" ToolTip.Tip="Stop" IsVisible="{Binding Hovered}">
            <c:Icon Glyph="stop" Filled="True" Size="12" Foreground="{DynamicResource Fg}" />
          </Button>
        </Panel>
      </StackPanel>
    </c:Glass>

    <!-- Expanded: the glass keeps its shadow outside; the Border inside cuts what scrolls to its corners. -->
    <c:Glass IsVisible="{Binding Expanded}" Width="360" Height="520" CornerRadius="28">
      <Border CornerRadius="28" ClipToBounds="True">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Height="60" Margin="20,0,12,0" ColumnDefinitions="Auto,10,Auto,10,Auto,*,Auto">
            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Rec}" VerticalAlignment="Center"
                    IsVisible="{Binding IsRunning}" />
            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Fg3}" VerticalAlignment="Center" IsVisible="{Binding IsPaused}" />
            <TextBlock Grid.Column="2" Text="{Binding DisplayClass}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Classes="num" Text="{Binding Elapsed}" FontSize="13" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
            <!-- Make it small, pause, stop: one pill of three round buttons -->
            <Border Grid.Column="6" Classes="fill" CornerRadius="20" Padding="3" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="small" Command="{Binding ToggleCommand}" ToolTip.Tip="Make it small">
                  <c:Icon Glyph="close_fullscreen" Size="18" Foreground="{DynamicResource Fg2}" />
                </Button>
                <Button Classes="small" Command="{Binding PauseCommand}" ToolTip.Tip="{Binding PauseTip}">
                  <c:Icon Glyph="{Binding PauseGlyph}" Filled="True" Size="18" Foreground="{DynamicResource Fg}" />
                </Button>
                <Button Classes="small tint" Command="{Binding StopCommand}" ToolTip.Tip="Stop">
                  <c:Icon Glyph="stop" Filled="True" Size="18" Foreground="{DynamicResource OnAccent}" />
                </Button>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Ask about this lecture, with any engine (design 16) -->
          <v:MacAiAskChat Name="AskChat" DockPanel.Dock="Bottom" Margin="12,4,12,12" DataContext="{Binding Ask}" />

          <!-- What's been said, newest at the bottom, fading out toward the top -->
          <ScrollViewer Name="Heard" Padding="20,0,20,16" VerticalScrollBarVisibility="Hidden">
            <ScrollViewer.OpacityMask>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="Transparent" Offset="0" />
                <GradientStop Color="Black" Offset="0.55" />
              </LinearGradientBrush>
            </ScrollViewer.OpacityMask>
            <Panel VerticalAlignment="Bottom">
              <TextBlock IsVisible="{Binding NoLines}" Text="{Binding Waiting}" FontSize="13" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HeardLine">
                    <Grid ColumnDefinitions="34,10,*">
                      <TextBlock Classes="num" Text="{Binding Time}" FontSize="11" Foreground="{DynamicResource Fg2}" Margin="0,2,0,0" />
                      <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="13" LineHeight="18.85" TextWrapping="Wrap"
                                 Classes.old="{Binding !Latest}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </c:Glass>
  </Panel>
</UserControl>
