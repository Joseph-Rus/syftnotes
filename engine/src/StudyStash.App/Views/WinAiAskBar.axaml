<!-- Ask, docked at the foot of a page (Home, a class's home, a lecture's notes): the question, what it's asked about
     ("All classes"), which AI answers (its own mark; a click opens "Answer with"), and the shortcut that puts the caret
     here, which gives way to Send once there's a question. It fills the width it's given. The latest answer has its own
     card above it (WinAiAnswer), in its own room on the page. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:v="using:StudyStash.App.Views"
             x:Class="StudyStash.App.Views.WinAiAskBar"
             x:DataType="vm:AiAskModel"
             ClipToBounds="False">
  <UserControl.Styles>
    <StyleInclude Source="avares://StudyStash/Views/WinAiStyles.axaml" />
  </UserControl.Styles>

  <Border Classes="ask" ClipToBounds="False">
    <Grid ColumnDefinitions="*,12,Auto,2,Auto,8,Auto" VerticalAlignment="Center">
      <TextBox Name="AskInput" Classes="bare" Text="{Binding Question}" PlaceholderText="{Binding Placeholder}" PlaceholderForeground="{DynamicResource InkSubtle}"
               FontSize="15.5" VerticalAlignment="Center" AutomationProperties.Name="Ask about your lectures">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding AskCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <!-- What it's asked about -->
      <Button Grid.Column="2" Classes="ask-scope" AutomationProperties.Name="{Binding ScopeName}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="{Binding ScopeName}" VerticalAlignment="Center" />
          <c:Icon Glyph="expand_more" Size="14" VerticalAlignment="Center" />
        </StackPanel>
        <Button.Flyout>
          <MenuFlyout Placement="Top" VerticalOffset="-12" FlyoutPresenterTheme="{StaticResource AiMenuFlyout}" ItemsSource="{Binding ScopeChoices}" ItemContainerTheme="{StaticResource AiChoiceItem}" />
        </Button.Flyout>
      </Button>
      <!-- Which AI answers: its own mark, no sparkle and no pill -->
      <Button Name="EngineChip" Grid.Column="4" Classes="icon-btn" VerticalAlignment="Center" ToolTip.Tip="{Binding EngineTip}" AutomationProperties.Name="{Binding EngineTip}">
        <c:Icon Glyph="{Binding EngineIcon}" Size="18" />
        <Button.Flyout>
          <Flyout Placement="Top" VerticalOffset="-12" ShowMode="Standard" FlyoutPresenterClasses="bare">
            <ContentControl Content="{Binding Menu}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:EngineMenuModel">
                  <v:WinAiEngineMenu />
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </Flyout>
        </Button.Flyout>
      </Button>
      <!-- Nothing typed: the keys that bring the caret here. A question: Send takes their place. -->
      <Border Grid.Column="6" Classes="kbd" IsVisible="{Binding ShowKeys}">
        <TextBlock Text="{x:Static v:AskKeys.Shown}" />
      </Border>
      <Button AutomationProperties.Name="Send question" Grid.Column="6" Classes="ask-send" Command="{Binding AskCommand}" IsVisible="{Binding CanSend}" ToolTip.Tip="Send">
        <c:Icon Glyph="arrow_upward" Size="18" />
      </Button>
      <!-- While an answer is being written, the same place stops it -->
      <Button Grid.Column="6" Classes="ask-send" Command="{Binding StopCommand}" IsVisible="{Binding Busy}" ToolTip.Tip="Stop" AutomationProperties.Name="Stop the answer">
        <c:Icon Glyph="stop" Filled="True" Size="12" />
      </Button>
    </Grid>
  </Border>
</UserControl>
