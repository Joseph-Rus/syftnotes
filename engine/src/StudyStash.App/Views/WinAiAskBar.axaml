<!-- The ask bar under a lecture's notes (design 16): a field, an engine chip opening "Answer with", a scope chip,
     and a send icon. The latest answer has its own card above it (WinAiAnswer), in its own room on the page. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:v="using:StudyStash.App.Views"
             x:Class="StudyStash.App.Views.WinAiAskBar"
             x:DataType="vm:AiAskModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://StudyStash/Views/WinAiStyles.axaml" />
  </UserControl.Styles>

  <Panel>
    <Border CornerRadius="8" Background="{DynamicResource Acrylic}" BorderBrush="{DynamicResource FlyStroke}" BorderThickness="1"
            BoxShadow="{DynamicResource ShadowLg}" Height="52" Width="600" Padding="16,0,8,0">
      <Grid ColumnDefinitions="*,8,Auto,8,Auto,8,Auto" VerticalAlignment="Center">
        <TextBox Classes="bare" Text="{Binding Question}" PlaceholderText="{Binding Placeholder}" FontSize="14" VerticalAlignment="Center">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding AskCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Name="EngineChip" Grid.Column="2" Classes="ai-chipbtn" VerticalAlignment="Center">
          <Border Classes="ai-chip-engine">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Glyph="auto_awesome" Size="15" Foreground="{DynamicResource AccentText}" />
              <TextBlock Text="{Binding EngineName}" TextTrimming="CharacterEllipsis" />
              <c:Icon Glyph="expand_more" Size="16" Foreground="{DynamicResource Fg2}" />
            </StackPanel>
          </Border>
          <Button.Flyout>
            <Flyout Placement="Top" VerticalOffset="-20" ShowMode="Standard" FlyoutPresenterClasses="bare">
              <ContentControl Content="{Binding Menu}">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:EngineMenuModel">
                    <v:WinAiEngineMenu />
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button Grid.Column="4" Classes="ai-chipbtn" VerticalAlignment="Center">
          <Border Classes="ai-chip-scope">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="{Binding ScopeName}" />
              <c:Icon Glyph="expand_more" Size="16" Foreground="{DynamicResource Fg2}" />
            </StackPanel>
          </Border>
          <Button.Flyout>
            <MenuFlyout Placement="Top" VerticalOffset="-20" FlyoutPresenterTheme="{StaticResource AiMenuFlyout}" ItemsSource="{Binding ScopeChoices}" ItemContainerTheme="{StaticResource AiChoiceItem}" />
          </Button.Flyout>
        </Button>
        <Button Grid.Column="6" Classes="ai-send" Command="{Binding AskCommand}" VerticalAlignment="Center">
          <c:Icon Glyph="send" Size="18" Foreground="{DynamicResource Fg3}" />
        </Button>
      </Grid>
    </Border>
  </Panel>
</UserControl>
