<!-- Coming up, in the dropdown and the library window (Mac): the next few events today and tomorrow from the
     student's calendars, each with when, what, and the class it's for (its dot); a click records it. Hidden with no calendars; with
     calendars and nothing left, one quiet line says so. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:vm="using:StudyStash.App.ViewModels"
             x:Class="StudyStash.App.Views.MacComingUp"
             x:DataType="vm:ComingUpModel">
  <UserControl.Styles>
    <!-- "File every … in Machine Learning": a line of ink words under the event, not a second row. -->
    <Style Selector="Button.suggest">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.suggest:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextBlock.TextDecorations" Value="Underline" />
    </Style>
  </UserControl.Styles>

  <StackPanel IsVisible="{Binding HasCalendars}">
    <TextBlock Classes="drop-label" Text="{Binding Heading}" />
    <TextBlock IsVisible="{Binding IsEmpty}" Classes="row-sub" Text="{Binding EmptyText}" Margin="8,0,8,2" />
    <ItemsControl ItemsSource="{Binding Rows}" Margin="0,3,0,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ComingUpRow">
          <StackPanel>
          <Button Classes="row" AutomationProperties.Name="{Binding Said}"
                  Command="{Binding $parent[UserControl].((vm:ComingUpModel)DataContext).RecordCommand}" CommandParameter="{Binding}">
            <Grid ColumnDefinitions="7,8,*,8,Auto">
              <c:Swatch Small="True" Fill="{Binding Dot}" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="2">
                <TextBlock Classes="row-title" Text="{Binding Title}" ToolTip.Tip="{Binding Title}" c:Tips.WhenCut="True" />
                <TextBlock IsVisible="{Binding HasDetail}" Classes="row-sub" Text="{Binding Detail}" ToolTip.Tip="{Binding Detail}" c:Tips.WhenCut="True" Margin="0,2,0,0" />
              </StackPanel>
              <TextBlock Grid.Column="4" Classes="num row-when" Text="{Binding When}" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button Classes="suggest" IsVisible="{Binding HasSuggestion}" Margin="23,0,8,4" HorizontalAlignment="Left" FontSize="{DynamicResource FontCaption}"
                  Command="{Binding $parent[UserControl].((vm:ComingUpModel)DataContext).FileCommand}" CommandParameter="{Binding}"
                  Content="{Binding SuggestText}" ToolTip.Tip="From now on, every event called this goes in that class, and what's recorded in it." />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
