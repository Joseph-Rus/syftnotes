<!-- Home and a class's home (Mac): across the library window beside the sidebar. A greeting (or the class's name), a
     row of numbers, the newest lectures beside what's due and what's coming up, and on Home a card for every class;
     a class's home ends with the ways further in (all its lectures, its Canvas lists) and what's attached to it. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:v="using:StudyStash.App.Views"
             x:Class="StudyStash.App.Views.MacOverview"
             x:DataType="vm:OverviewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.ov-h2">
      <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.ov-group">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{DynamicResource Group}" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector="Button.ov-row">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,9" />
    </Style>
    <Style Selector="Border.ov-stat">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{DynamicResource Group}" />
      <Setter Property="Padding" Value="14,10,14,11" />
      <Setter Property="MinWidth" Value="132" />
    </Style>
    <Style Selector="TextBlock.ov-value">
      <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.ov-value.strong">
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    </Style>
    <Style Selector="TextBlock.ov-sub">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    </Style>
    <Style Selector="TextBlock.ov-empty">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="12,10" />
    </Style>
    <Style Selector="TextBlock.ov-right">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    </Style>
    <Style Selector="TextBlock.ov-right.strong">
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.ov-link">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.ov-card">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Background" Value="{DynamicResource Group}" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="Button.ov-pill">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="12,0,14,0" />
      <Setter Property="Background" Value="{DynamicResource Fill}" />
    </Style>
    <Style Selector="Button.ov-pill /template/ Border#PART_Bg">
      <Setter Property="BoxShadow" Value="{DynamicResource EdgeSoft}" />
    </Style>
    <Style Selector="Grid.ov-body.narrow StackPanel.ov-side">
      <Setter Property="Margin" Value="0,24,0,0" />
    </Style>
  </UserControl.Styles>

  <Panel>
  <ScrollViewer Name="Page" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="1040" HorizontalAlignment="Stretch" Margin="36,18,36,130" Spacing="24">

      <!-- The greeting and the day, or the class, what it is on Canvas, and what it covers -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="3">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Ellipse Width="10" Height="10" Fill="{Binding Dot}" IsVisible="{Binding IsClass}" VerticalAlignment="Center" />
            <TextBlock Name="Title" Text="{Binding Title}" FontFamily="{DynamicResource DisplayFont}" FontSize="28" FontWeight="Bold"
                       c:Typography.Extra="-0.5" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" FontSize="13" LineHeight="19" Foreground="{DynamicResource Fg2}"
                     TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" Margin="0,4,0,0" MaxLines="3" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="12,4,0,0">
          <!-- Due's home: the two-column list, each assignment beside its detail -->
          <Button Name="FullList" Classes="ov-pill" Command="{Binding AllDueCommand}" IsVisible="{Binding IsDuePage}" Height="44" Padding="16,0,18,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:Icon Glyph="assignment" Size="18" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
              <TextBlock Text="Full list" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <!-- Record from here: into this class on its home, sorted by the library on Home -->
          <Button Name="Record" Theme="{StaticResource Surface}" Height="44" CornerRadius="22" Padding="18,0,22,0" Background="{DynamicResource Rec}"
                  Command="{Binding RecordCommand}" IsVisible="{Binding CanRecord}" AutomationProperties.Name="{Binding RecordWords}" ToolTip.Tip="Start recording a lecture">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:Icon Glyph="mic" Size="20" Foreground="#FFFFFFFF" VerticalAlignment="Center" />
              <TextBlock Text="{Binding RecordWords}" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFFFF" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="ov-pill" Command="{Binding Files.AttachCommand, FallbackValue={x:Null}}" IsVisible="{Binding HasFiles}"
                  ToolTip.Tip="Attach notes, slides or a handout to this class (or drop files on the page)" AutomationProperties.Name="Attach to class">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Glyph="attach_file" Size="15" Foreground="{DynamicResource Fg}" />
              <TextBlock Text="Attach" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- The numbers: a number with somewhere to go (To hand in, Unsorted) opens it -->
      <ItemsControl Name="Stats" ItemsSource="{Binding Stats}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel ItemSpacing="10" LineSpacing="10" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:OverviewStat">
            <Button Theme="{StaticResource Surface}" CornerRadius="14" IsHitTestVisible="{Binding CanOpen}"
                    Command="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).OpenStatCommand}" CommandParameter="{Binding}">
              <Border Classes="ov-stat">
                <StackPanel>
                  <TextBlock Classes="ov-value" Classes.strong="{Binding Strong}" Text="{Binding Value}" />
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <TextBlock Classes="ov-sub" Text="{Binding Label}" />
                    <c:Icon Glyph="chevron_right" Size="14" Foreground="{DynamicResource Fg3}" IsVisible="{Binding CanOpen}" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- The newest lectures, beside what's due and what's coming up (under them in a narrow window) -->
      <Grid Classes="ov-body" Classes.narrow="{Binding Narrow}" ColumnDefinitions="*,24,*" RowDefinitions="Auto,Auto" IsVisible="{Binding ShowMain}">
        <StackPanel Name="Recent" Grid.ColumnSpan="{Binding LecturesSpan}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="ov-h2" Text="Recent lectures" />
            <Button Grid.Column="1" Classes="ov-link" Command="{Binding AllLecturesCommand}" IsVisible="{Binding CanSeeAllLectures}">
              <TextBlock Text="See all" FontSize="12" Foreground="{DynamicResource AccentText}" />
            </Button>
          </Grid>
          <Border Classes="ov-group">
            <StackPanel>
              <TextBlock Classes="ov-empty" Text="{Binding LecturesEmpty}" IsVisible="{Binding NoLectures}" />
              <ItemsControl ItemsSource="{Binding Lectures}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:OverviewLecture">
                    <Button Classes="ov-row" Command="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).OpenLectureCommand}" CommandParameter="{Binding}">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Ellipse Width="7" Height="7" Fill="{Binding Dot}" VerticalAlignment="Center"
                                   IsVisible="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).IsHome}" />
                          <TextBlock Classes="ov-sub" Text="{Binding ClassName}" TextTrimming="CharacterEllipsis" MaxWidth="220"
                                     IsVisible="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).IsHome}" />
                          <TextBlock Classes="ov-sub" Text="·" IsVisible="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).IsHome}" />
                          <TextBlock Classes="ov-sub" Text="{Binding Meta}" />
                        </StackPanel>
                        <TextBlock Classes="ov-sub" Text="{Binding Summary}" IsVisible="{Binding HasSummary}" LineHeight="16.8" Margin="0,2,0,0"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Classes="ov-side" Grid.Column="{Binding SideColumn}" Grid.Row="{Binding SideRow}" Grid.ColumnSpan="{Binding SideSpan}" Spacing="24" IsVisible="{Binding HasSide}">
          <StackPanel Name="DueSoon" IsVisible="{Binding ShowDue}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="ov-h2" Text="{Binding DueHeading}" />
              <Button Grid.Column="1" Classes="ov-link" Command="{Binding AllDueCommand}" IsVisible="{Binding CanSeeAllDue}">
                <TextBlock Text="See all" FontSize="12" Foreground="{DynamicResource AccentText}" />
              </Button>
            </Grid>
            <Border Classes="ov-group">
              <StackPanel>
                <TextBlock Classes="ov-empty" Text="{Binding DueEmpty}" IsVisible="{Binding NoDue}" />
                <ItemsControl ItemsSource="{Binding Due}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:OverviewDue">
                      <Button Classes="ov-row" Command="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).OpenDueCommand}" CommandParameter="{Binding}">
                        <StackPanel Spacing="3">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Classes="ov-right" Classes.strong="{Binding Strong}" Text="{Binding Right}" Margin="8,0,0,0" VerticalAlignment="Bottom" />
                          </Grid>
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="7" Height="7" Fill="{Binding Dot}" VerticalAlignment="Center" />
                            <TextBlock Classes="ov-sub" Text="{Binding Sub}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Name="Events" IsVisible="{Binding ShowEvents}">
            <TextBlock Classes="ov-h2" Text="Coming up" />
            <Border Classes="ov-group">
              <StackPanel>
                <TextBlock Classes="ov-empty" Text="{Binding EventsEmpty}" IsVisible="{Binding NoEvents}" />
                <ItemsControl ItemsSource="{Binding Events}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:OverviewEvent">
                      <Grid ColumnDefinitions="7,10,*,10,Auto" Margin="12,8">
                        <Ellipse Width="7" Height="7" Fill="{Binding Dot}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="ov-sub" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="4" Classes="num ov-right" Classes.strong="{Binding Now}" Text="{Binding When}" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- Due's home: what's to hand in, by when -->
      <ItemsControl Name="DueGroups" ItemsSource="{Binding DueGroups}" IsVisible="{Binding IsDuePage}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Spacing="24" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:OverviewDueGroup">
            <StackPanel>
              <TextBlock Classes="ov-h2" Text="{Binding Heading}" Margin="0,0,0,8" />
              <Border Classes="ov-group">
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:OverviewDue">
                      <Button Classes="ov-row" Command="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).OpenDueCommand}" CommandParameter="{Binding}">
                        <StackPanel Spacing="3">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Classes="ov-right" Classes.strong="{Binding Strong}" Text="{Binding Right}" Margin="8,0,0,0" VerticalAlignment="Bottom" />
                          </Grid>
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="7" Height="7" Fill="{Binding Dot}" VerticalAlignment="Center" />
                            <TextBlock Classes="ov-sub" Text="{Binding Sub}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Home: a card for every class -->
      <StackPanel Name="ClassCards" IsVisible="{Binding HasClasses}">
        <TextBlock Classes="ov-h2" Text="{Binding ClassesHeading}" Margin="0,0,0,8" />
        <ItemsControl ItemsSource="{Binding Classes}" Margin="0,0,-10,-10">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).CardColumns}" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:OverviewClass">
              <Button Classes="ov-card" Command="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).OpenClassCommand}" CommandParameter="{Binding}"
                      ToolTip.Tip="{Binding Name}">
                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="Auto,8,*">
                    <Ellipse Width="9" Height="9" Fill="{Binding Dot}" VerticalAlignment="Top" Margin="0,5,0,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                  </Grid>
                  <TextBlock Classes="ov-sub" Text="{Binding Lectures}" TextTrimming="CharacterEllipsis" Margin="17,0,0,0" />
                  <TextBlock Classes="ov-right" Classes.strong="{Binding NextStrong}" Text="{Binding Next}" IsVisible="{Binding HasNext}"
                             TextTrimming="CharacterEllipsis" Margin="17,0,0,0" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- A class's home: the ways further in -->
      <StackPanel Name="Links" IsVisible="{Binding HasLinks}">
        <TextBlock Classes="ov-h2" Text="On Canvas" Margin="0,0,0,8" />
        <ItemsControl ItemsSource="{Binding Links}" Margin="0,0,-10,-10">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).LinkColumns}" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:OverviewLink">
              <Button Classes="ov-card" Command="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).OpenLinkCommand}" CommandParameter="{Binding}">
                <Grid ColumnDefinitions="Auto,10,*,Auto">
                  <c:Icon Glyph="{Binding Glyph}" Size="18" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Classes="ov-sub" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <c:Icon Grid.Column="3" Glyph="chevron_right" Size="16" Foreground="{DynamicResource Fg3}" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- A class's home: folders on the computer that go with it (a project's repo), linked, not copied in -->
      <StackPanel Name="LinkedFolders" IsVisible="{Binding ShowFolders}">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
          <TextBlock Classes="ov-h2" Text="Linked folders" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="ov-pill" Command="{Binding LinkFolderCommand}" IsVisible="{Binding CanLinkFolders}"
                  ToolTip.Tip="Link a folder on this computer to the class: it stays where it is, and search and the AI can read it">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Glyph="add" Size="15" Foreground="{DynamicResource Fg}" />
              <TextBlock Text="Link a folder" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
        <TextBlock Classes="ov-sub" IsVisible="{Binding !HasFolders}" TextWrapping="Wrap"
                   Text="A project's repo, a shared drive, anything that goes with this class but isn't notes. It stays where it is." />
        <ItemsControl ItemsSource="{Binding Folders}" Margin="0,0,-10,-10">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LinkedFolder">
              <Button Classes="ov-card" Command="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).OpenFolderCommand}" CommandParameter="{Binding}"
                      ToolTip.Tip="Open the folder">
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Unlink from this class" Command="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).UnlinkFolderCommand}" CommandParameter="{Binding}" />
                  </ContextMenu>
                </Button.ContextMenu>
                <Grid ColumnDefinitions="Auto,10,*,Auto">
                  <c:Icon Glyph="folder" Size="18" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="ov-sub" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <c:Icon Grid.Column="3" Glyph="open_in_new" Size="15" Foreground="{DynamicResource Fg3}" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- A class's home: what's attached to it (drop files anywhere on the page) -->
      <StackPanel Name="ClassFiles" IsVisible="{Binding HasFiles}">
        <TextBlock Classes="ov-h2" Text="Files" Margin="0,0,0,8" IsVisible="{Binding Files.HasItems, FallbackValue=False}" />
        <v:MacAttachments DataContext="{Binding Files}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
  <!-- Ask about everything (Home) or this class, at the foot of the page; its latest answer just above -->
  <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24" Spacing="8" IsVisible="{Binding HasAsk}">
    <v:MacAiAnswer DataContext="{Binding Ask}" IsVisible="{Binding $parent[UserControl].((vm:OverviewModel)DataContext).HasAnswer}" MaxHeight="420" />
    <v:MacAiAskBar DataContext="{Binding Ask}" />
  </StackPanel>
  </Panel>
</UserControl>
