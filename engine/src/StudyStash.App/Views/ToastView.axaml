<!-- A notification of the app's own, for where the system's can't be had: one plain panel, a title, a few lines, and
     at most two quiet buttons, with no picture on it. On a Mac, a banner (the × shows on its top-left corner when the pointer is over it); on Windows, a Windows 11
     toast (the app's name and × along the top). Every toast the app shows, Canvas's included, is one of these. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:v="using:StudyStash.App.Views"
             x:Class="StudyStash.App.Views.ToastView"
             x:DataType="v:ToastView"
             x:Name="Root"
             Width="356" ClipToBounds="False">
  <UserControl.Styles>
    <!-- One type scale on both systems: the title in Body, its lines in Caption. -->
    <Style Selector="TextBlock#TitleText">
      <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
    </Style>
    <Style Selector="TextBlock#BodyText">
      <Setter Property="FontSize" Value="{DynamicResource FontCaption}" />
      <Setter Property="LineHeight" Value="17" />
    </Style>
    <!-- Its buttons: small cells of the mesh, ink words. -->
    <Style Selector="Button.toast-btn">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Height" Value="24" />
      <Setter Property="MinWidth" Value="64" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="c:Cell.Round" Value="True" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="Button.toast-btn TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource FontCaption}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Windows 11's: the same cells, taller and sharing the width. -->
    <Style Selector="v|ToastView.win Button.toast-btn">
      <Setter Property="Height" Value="32" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <!-- Windows' × is in its header. A Mac banner shows its × under the pointer, on its top-left corner, as the system's do. -->
    <Style Selector="v|ToastView.win Button#MacClose">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="v|ToastView.mac Button#MacClose">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="v|ToastView.mac:pointerover Button#MacClose">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </UserControl.Styles>
  <Panel>
  <Border Name="Card" ClipToBounds="False">
    <StackPanel>
      <!-- Windows: the app's name along the top, with the × -->
      <Grid Name="WinHeader" ColumnDefinitions="*,Auto" Margin="0,0,0,10" IsVisible="False">
        <TextBlock Text="Syft Notes" FontSize="{DynamicResource FontCaption}" Foreground="{DynamicResource InkMuted}" VerticalAlignment="Center" />
        <Button Name="WinClose" Grid.Column="1" Theme="{StaticResource Surface}" Width="24" Height="24" c:Cell.Round="True" Margin="0,-4,-6,-4"
                HorizontalContentAlignment="Center" ToolTip.Tip="Dismiss" AutomationProperties.Name="Dismiss">
          <c:Icon Glyph="close" Size="14" Foreground="{DynamicResource Fg2}" />
        </Button>
      </Grid>
      <Grid>
        <StackPanel Name="Words" Spacing="1">
          <Grid ColumnDefinitions="*,Auto" MinHeight="18">
            <TextBlock Name="TitleText" Text="{Binding #Root.Title}" ToolTip.Tip="{Binding #Root.Title}" c:Tips.WhenCut="True" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <TextBlock Name="WhenText" Grid.Column="1" Margin="8,0,0,0" Text="{Binding #Root.When}" IsVisible="{Binding #Root.When, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       FontSize="{DynamicResource FontCaption}" Foreground="{DynamicResource InkSubtle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Name="BodyText" Text="{Binding #Root.Text}" ToolTip.Tip="{Binding #Root.Text}" c:Tips.WhenCut="True" IsVisible="{Binding #Root.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Foreground="{DynamicResource InkMuted}" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" />
          <Grid Name="Actions" Margin="0,8,0,0">
            <Button Name="ActionButton" Classes="toast-btn">
              <TextBlock Text="{Binding #Root.ActionLabel}" />
            </Button>
            <Button Name="SecondButton" Classes="toast-btn">
              <TextBlock Text="{Binding #Root.SecondLabel}" />
            </Button>
          </Grid>
        </StackPanel>
      </Grid>
    </StackPanel>
  </Border>
  <!-- A Mac banner's ×: over the top-left corner, as macOS's own notifications have it -->
  <Button Name="MacClose" Theme="{StaticResource Surface}" Width="20" Height="20" c:Cell.Round="True" Margin="-7,-7,0,0" Padding="0"
          HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
          Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource PopupStroke}" BorderThickness="1"
          ToolTip.Tip="Dismiss" AutomationProperties.Name="Dismiss">
    <c:Icon Glyph="close" Size="12" Foreground="{DynamicResource Fg2}" />
  </Button>
  </Panel>
</UserControl>
