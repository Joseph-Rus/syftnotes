<!-- A notification that looks like the system's own: one plain panel, the app's icon, a title, a few lines, and at
     most two quiet buttons. On a Mac, a banner (the × shows on its top-left corner when the pointer is over it); on Windows, a Windows 11
     toast (the app's name and × along the top). Every toast the app shows, Canvas's included, is one of these. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:v="using:StudyStash.App.Views"
             x:Class="StudyStash.App.Views.ToastView"
             x:DataType="v:ToastView"
             x:Name="Root"
             Width="356" ClipToBounds="False">
  <UserControl.Styles>
    <Style Selector="TextBlock#TitleText">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock#BodyText">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="LineHeight" Value="16" />
    </Style>
    <!-- A Mac banner's buttons: small grey capsules, as the Liquid Glass look's own. -->
    <Style Selector="Button.toast-btn">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Height" Value="24" />
      <Setter Property="MinWidth" Value="64" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource Fill2}" />
    </Style>
    <Style Selector="Button.toast-btn TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Windows 11's: standard buttons (the control fill and its edge), sharing the width. -->
    <Style Selector="v|ToastView.win Button.toast-btn">
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{DynamicResource Ctrl}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CtrlBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="v|ToastView.win Button.toast-btn TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <!-- Windows 11 sets a toast's words larger than a Mac banner's. -->
    <Style Selector="v|ToastView.win TextBlock#TitleText">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="v|ToastView.win TextBlock#BodyText">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="18" />
    </Style>
    <!-- Windows' × is in its header. A Mac banner shows its × under the pointer, on its top-left corner, as the system's do. -->
    <Style Selector="v|ToastView.win Button#MacClose">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="v|ToastView.mac Button#MacClose">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="v|ToastView.mac:pointerover Button#MacClose">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </UserControl.Styles>
  <Panel>
  <Border Name="Card" ClipToBounds="False">
    <StackPanel>
      <!-- Windows: the app's name along the top, with the × -->
      <Grid Name="WinHeader" ColumnDefinitions="Auto,8,*,Auto" Margin="0,0,0,10" IsVisible="False">
        <Image Source="avares://StudyStash/Assets/icon.png" Width="16" Height="16" RenderOptions.BitmapInterpolationMode="HighQuality"
               VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="Study Stash" FontSize="12" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
        <Button Name="WinClose" Grid.Column="3" Theme="{StaticResource Surface}" Width="24" Height="24" CornerRadius="4" Margin="0,-4,-6,-4"
                HorizontalContentAlignment="Center" ToolTip.Tip="Dismiss">
          <c:Icon Glyph="close" Size="14" Foreground="{DynamicResource Fg2}" />
        </Button>
      </Grid>
      <Grid ColumnDefinitions="Auto,*">
        <Border Name="MacIcon" Width="32" Height="32" CornerRadius="7" ClipToBounds="True" Margin="0,1,10,0" VerticalAlignment="Top">
          <Image Source="avares://StudyStash/Assets/icon.png" RenderOptions.BitmapInterpolationMode="HighQuality" />
        </Border>
        <StackPanel Name="Words" Grid.Column="1" Spacing="1">
          <Grid ColumnDefinitions="*,Auto" MinHeight="18">
            <TextBlock Name="TitleText" Text="{Binding #Root.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <TextBlock Name="WhenText" Grid.Column="1" Margin="8,0,0,0" Text="{Binding #Root.When}" IsVisible="{Binding #Root.When, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       FontSize="12" Foreground="{DynamicResource Fg3}" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Name="BodyText" Text="{Binding #Root.Text}" IsVisible="{Binding #Root.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" />
          <Grid Name="Actions" Margin="0,8,0,0">
            <Button Name="ActionButton" Classes="toast-btn">
              <TextBlock Text="{Binding #Root.ActionLabel}" />
            </Button>
            <Button Name="SecondButton" Classes="toast-btn">
              <TextBlock Text="{Binding #Root.SecondLabel}" />
            </Button>
          </Grid>
        </StackPanel>
      </Grid>
    </StackPanel>
  </Border>
  <!-- A Mac banner's ×: over the top-left corner, as macOS's own notifications have it -->
  <Button Name="MacClose" Theme="{StaticResource Surface}" Width="20" Height="20" CornerRadius="10" Margin="-7,-7,0,0" Padding="0"
          HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
          Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource PopupStroke}" BorderThickness="1"
          ToolTip.Tip="Dismiss" AutomationProperties.Name="Dismiss">
    <c:Icon Glyph="close" Size="12" Foreground="{DynamicResource Fg2}" />
  </Button>
  </Panel>
</UserControl>
