<!-- Connecting Canvas (design 07): the school, Add to Chrome (or whichever browser), finding your courses, and
     (Settings' window only) matching classes and the first sync. Every step is one row of the same height: its marker,
     its title, and on the right its summary or its one action; the open step's help, pictures and lists sit under its title.
     Draws no outer padding or window — the setup wizard or a small dialog gives the margins. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:v="using:StudyStash.App.Views"
             x:Class="StudyStash.App.Views.WinCanvasConnect"
             x:DataType="vm:CanvasConnectModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://StudyStash/Views/WinCanvasStyles.axaml" />
  </UserControl.Styles>
  <DockPanel>
    <!-- The small window's own footer, under the steps (which scroll when they run long): Skip for now on the left; Back and Finish on the right, one height, one line -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,18,0,0" IsVisible="{Binding ShowFooter}">
      <Button Classes="cv-skip" VerticalAlignment="Center" Command="{Binding SkipCommand}"><TextBlock Classes="cv-link" Text="Skip for now" /></Button>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
        <Button Classes="cv-btn" Command="{Binding BackCommand}"><TextBlock Text="Back" /></Button>
        <Button Classes="cv-btn cv-primary" IsEnabled="{Binding CanFinish}" Command="{Binding FinishCommand}"><TextBlock Text="{Binding FinishLabel}" /></Button>
      </StackPanel>
    </Grid>
    <ScrollViewer Name="Page" VerticalScrollBarVisibility="{Binding ShowFooter, Converter={x:Static c:Converters.ScrollsIfOwn}}">
  <StackPanel Spacing="6">
    <TextBlock Classes="cv-step-label" Text="{Binding StepLabel}" IsVisible="{Binding StepLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <TextBlock Classes="cv-h1" Text="{x:Static vm:CanvasConnectModel.Title}" />
    <TextBlock Classes="cv-intro" Text="{x:Static vm:CanvasConnectModel.Intro}" Margin="0,0,0,10" />

    <Border Classes="cv-group">
      <StackPanel>

        <!-- 1 School address -->
        <Grid Classes="cv-srow" ColumnDefinitions="20,12,*,Auto">
          <Panel Classes="cv-marker">
            <Border Classes="cv-num" Classes.cv-current="{Binding Step1.IsCurrent}" IsVisible="{Binding !Step1.IsDone}"><TextBlock Text="1" /></Border>
            <c:Icon Classes="cv-num-done" Glyph="check_circle" IsVisible="{Binding Step1.IsDone}" />
          </Panel>
          <TextBlock Grid.Column="2" Classes="cv-step-title" Classes.cv-current="{Binding Step1.IsCurrent}" Classes.cv-todo="{Binding Step1.IsToDo}" Text="{Binding Step1.Title}" />
          <StackPanel Grid.Column="3" Classes="cv-action" IsVisible="{Binding Step1.IsDone}">
            <TextBlock Classes="cv-value" Text="{Binding Step1.Summary}" />
            <Button Classes="cv-btn cv-mini" Command="{Binding ChangeSchoolCommand}"><TextBlock Text="Change" /></Button>
          </StackPanel>
          <StackPanel Grid.Column="3" Classes="cv-action" IsVisible="{Binding Step1.IsCurrent}">
            <Border Classes="cv-field" Width="220">
              <TextBox Classes="bare" Text="{Binding SchoolField}" PlaceholderText="school.instructure.com" FontSize="14" />
            </Border>
            <Button Classes="cv-btn cv-mini cv-primary" IsEnabled="{Binding !SavingSchool}" Command="{Binding ContinueCommand}"><TextBlock Text="Continue" /></Button>
          </StackPanel>
        </Grid>
        <TextBlock Classes="cv-help cv-body" Text="{Binding SchoolError}" IsVisible="{Binding SchoolError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Border Classes="cv-sep" />

        <!-- 2 The browser extension: Add to Chrome, Edge, Firefox… -->
        <Grid Classes="cv-srow" ColumnDefinitions="20,12,*,Auto">
          <Panel Classes="cv-marker">
            <Border Classes="cv-num" Classes.cv-current="{Binding Step2.IsCurrent}" IsVisible="{Binding !Step2.IsDone}"><TextBlock Text="2" /></Border>
            <c:Icon Classes="cv-num-done" Glyph="check_circle" IsVisible="{Binding Step2.IsDone}" />
          </Panel>
          <TextBlock Grid.Column="2" Classes="cv-step-title" Classes.cv-current="{Binding Step2.IsCurrent}" Classes.cv-todo="{Binding Step2.IsToDo}" Text="{Binding Step2.Title}" />
          <TextBlock Grid.Column="3" Classes="cv-value cv-good" Text="{Binding Step2.Summary}" VerticalAlignment="Center" IsVisible="{Binding Step2.IsDone}" />
          <Panel Grid.Column="3" IsVisible="{Binding Step2.IsCurrent}" VerticalAlignment="Center">
            <Button Classes="cv-btn cv-mini cv-primary" IsVisible="{Binding ShowAddToBrowser}" IsEnabled="{Binding !AddingToBrowser}" Command="{Binding AddToBrowserCommand}">
              <TextBlock Text="{Binding AddLabel}" />
            </Button>
            <StackPanel Classes="cv-action" IsVisible="{Binding WaitingForBrowser}">
              <c:Spinner Width="14" Height="14" Thickness="2" Foreground="{DynamicResource Fg2}" />
              <TextBlock Classes="cv-value" Text="{Binding WaitingLabel}" />
            </StackPanel>
            <StackPanel Classes="cv-action" IsVisible="{Binding BrowserConnected}">
              <c:Icon Glyph="check" Size="16" Foreground="{DynamicResource Ok}" />
              <TextBlock Classes="cv-value cv-good" Text="Connected" />
            </StackPanel>
          </Panel>
        </Grid>
        <StackPanel Classes="cv-body" Spacing="12" IsVisible="{Binding Step2.IsCurrent}">
          <!-- The student's usual browser can't take the extension: said first, with the one that will be used -->
          <StackPanel Spacing="4" IsVisible="{Binding ShowAdvice}">
            <TextBlock Classes="cv-step-body cv-advice" Text="{Binding AdviceText}" />
            <Button Classes="cv-quiet" HorizontalAlignment="Left" Command="{Binding GetBrowserCommand}" IsVisible="{Binding ShowGetBrowser}"><TextBlock Classes="cv-link" Text="Get Chrome" /></Button>
          </StackPanel>
          <TextBlock Classes="cv-step-body" Text="{Binding BrowserHelp}" />
          <!-- Chrome's family: three pictures of its extensions page -->
          <StackPanel Spacing="12" IsVisible="{Binding IsChromium}">
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
            <Border Classes="cv-illus" Height="84">
              <StackPanel Spacing="10">
                <!-- The extensions page, its Developer mode switch at the top right -->
                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right">
                  <TextBlock Classes="cv-illus-row" Text="Developer mode" VerticalAlignment="Center" />
                  <Border Classes="cv-illus-toggle"><Ellipse Classes="cv-illus-knob" /></Border>
                </StackPanel>
                <Border Height="6" CornerRadius="3" Background="{DynamicResource Subtle}" Margin="0,4,20,0" />
                <Border Height="6" CornerRadius="3" Background="{DynamicResource Subtle}" Margin="0,0,40,0" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="cv-illus" Height="84">
              <StackPanel Spacing="10">
                <TextBlock Classes="cv-illus-title" Text="Extensions" />
                <Border Classes="cv-illus-load" HorizontalAlignment="Left"><TextBlock Text="Load unpacked" /></Border>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="cv-illus" Height="84">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                <TextBlock Classes="cv-illus-row" Text="Downloads" />
                <Border Grid.Row="1" Classes="cv-illus-row cv-highlight" Padding="4,2"><TextBlock Classes="cv-illus-row cv-highlight" Text="{Binding FolderName}" TextTrimming="CharacterEllipsis" /></Border>
                <TextBlock Grid.Row="2" Classes="cv-illus-row" Text="Documents" />
                <Border Grid.Row="3" Classes="cv-illus-pick" HorizontalAlignment="Right"><TextBlock Text="Select" /></Border>
              </Grid>
            </Border>
          </Grid>
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
            <Grid ColumnDefinitions="14,*"><TextBlock Classes="cv-caption-num" Text="1" /><TextBlock Grid.Column="1" Classes="cv-caption" Text="Turn on Developer mode, top right" TextWrapping="Wrap" /></Grid>
            <Grid Grid.Column="1" ColumnDefinitions="14,*"><TextBlock Classes="cv-caption-num" Text="2" /><TextBlock Grid.Column="1" Classes="cv-caption" Text="Click Load unpacked" TextWrapping="Wrap" /></Grid>
            <Grid Grid.Column="2" ColumnDefinitions="14,*"><TextBlock Classes="cv-caption-num" Text="3" /><TextBlock Grid.Column="1" Classes="cv-caption" Text="{Binding PickCaption}" TextWrapping="Wrap" /></Grid>
          </Grid>
          </StackPanel>
          <!-- Firefox's family: three steps, and the code its second step pastes -->
          <StackPanel Spacing="8" IsVisible="{Binding IsFirefox}">
            <Grid ColumnDefinitions="14,*"><TextBlock Classes="cv-caption-num" Text="1" /><TextBlock Grid.Column="1" Classes="cv-caption" Text="{Binding FirefoxStep1}" TextWrapping="Wrap" /></Grid>
            <Grid ColumnDefinitions="14,*"><TextBlock Classes="cv-caption-num" Text="2" /><TextBlock Grid.Column="1" Classes="cv-caption" Text="{Binding FirefoxStep2}" TextWrapping="Wrap" /></Grid>
            <Border Classes="cv-code" Margin="14,0,0,0" IsVisible="{Binding ShowCode}">
              <Grid ColumnDefinitions="*,10,Auto">
                <SelectableTextBlock AutomationProperties.Name="Connection code" Text="{Binding ConnectionCode}" />
                <Button Grid.Column="2" Classes="cv-btn cv-mini" VerticalAlignment="Top" Command="{Binding CopyCodeCommand}"><TextBlock Text="{Binding CopyLabel}" /></Button>
              </Grid>
            </Border>
            <Grid ColumnDefinitions="14,*"><TextBlock Classes="cv-caption-num" Text="3" /><TextBlock Grid.Column="1" Classes="cv-caption" Text="{Binding FirefoxStep3}" TextWrapping="Wrap" /></Grid>
          </StackPanel>
          <!-- Quiet links: the folder and the extensions page again (or the add-on again), and another browser when there is one -->
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowLinks}">
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowFolderLinks}">
              <Button Classes="cv-quiet" Command="{Binding ShowFolderCommand}"><TextBlock Classes="cv-link" Text="Show the folder again" /></Button>
              <TextBlock Classes="cv-link-sep" Text="·" />
              <Button Classes="cv-quiet" Command="{Binding OpenExtensionsCommand}"><TextBlock Classes="cv-link" Text="{Binding OpenExtensionsLabel}" /></Button>
            </StackPanel>
            <Button Classes="cv-quiet" IsVisible="{Binding ShowAddOnLink}" Command="{Binding OpenAddOnCommand}"><TextBlock Classes="cv-link" Text="Open the add-on again" /></Button>
            <TextBlock Classes="cv-link-sep" Text="·" IsVisible="{Binding ShowSwitchAfterLinks}" />
            <Button Name="OtherBrowser" Classes="cv-quiet" IsVisible="{Binding CanSwitchBrowser}">
              <TextBlock Classes="cv-link" Text="Use another browser" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft" ItemsSource="{Binding BrowserChoices}" ItemContainerTheme="{StaticResource CvBrowserItem}" />
              </Button.Flyout>
            </Button>
          </StackPanel>
          <TextBlock Classes="cv-help" Text="{Binding BrowserError}" IsVisible="{Binding BrowserError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <Border Classes="cv-sep" />

        <!-- 3 Find my courses -->
        <Grid Classes="cv-srow" ColumnDefinitions="20,12,*,Auto">
          <Panel Classes="cv-marker">
            <Border Classes="cv-num" Classes.cv-current="{Binding Step3.IsCurrent}" IsVisible="{Binding !Step3.IsDone}"><TextBlock Text="3" /></Border>
            <c:Icon Classes="cv-num-done" Glyph="check_circle" IsVisible="{Binding Step3.IsDone}" />
          </Panel>
          <TextBlock Grid.Column="2" Classes="cv-step-title" Classes.cv-current="{Binding Step3.IsCurrent}" Classes.cv-todo="{Binding Step3.IsToDo}" Text="{Binding Step3.Title}" />
          <TextBlock Grid.Column="3" Classes="cv-value" Text="{Binding Step3.Summary}" VerticalAlignment="Center" IsVisible="{Binding Step3.IsDone}" />
          <Panel Grid.Column="3" IsVisible="{Binding Step3.IsCurrent}" VerticalAlignment="Center">
            <Button Classes="cv-btn cv-mini cv-primary" IsVisible="{Binding SignedOut}" Command="{Binding OpenCanvasCommand}"><TextBlock Text="Open Canvas" /></Button>
            <StackPanel Classes="cv-action" IsVisible="{Binding ShowFind}">
              <c:Spinner IsVisible="{Binding FindingCourses}" Width="14" Height="14" Thickness="2" Foreground="{DynamicResource Fg2}" />
              <TextBlock Classes="cv-value" Text="Looking…" IsVisible="{Binding FindingCourses}" />
              <Button Classes="cv-btn cv-mini cv-primary" IsVisible="{Binding !FindingCourses}" Command="{Binding FindCoursesCommand}"><TextBlock Text="Find my courses" /></Button>
            </StackPanel>
          </Panel>
          <!-- Settings' window, once the courses are found: the ticked ones become classes, then matching -->
          <Button Grid.Column="3" Classes="cv-btn cv-mini cv-primary" IsVisible="{Binding ShowBringIn}" IsEnabled="{Binding !Linking}"
                  Command="{Binding BringInCommand}"><TextBlock Text="{Binding BringInLabel}" /></Button>
        </Grid>
        <StackPanel Classes="cv-body" IsVisible="{Binding Step3.IsCurrent}">
          <TextBlock Classes="cv-step-body" Text="{Binding SignInHelp}" IsVisible="{Binding SignedOut}" />
          <TextBlock Classes="cv-step-body" Text="{Binding CoursesSay}" IsVisible="{Binding ShowCoursesSay}" />
        </StackPanel>
        <!-- Which courses to bring in: this term's ticked, the rest (past terms, sandboxes, chapel) not -->
        <StackPanel Classes="cv-body" Spacing="6" IsVisible="{Binding ShowPicker}">
          <TextBlock Classes="cv-step-body" Text="{Binding PickerHint}" />
          <ScrollViewer Name="PickerScroll" MaxHeight="{Binding PickerHeight}" VerticalScrollBarVisibility="Auto">
            <v:WinCoursePicker Classes="inset" DataContext="{Binding Picker}" />
          </ScrollViewer>
        </StackPanel>

        <!-- 4 Match each class to a course (Settings' window only) -->
        <StackPanel IsVisible="{Binding ShowMatchAndSync}">
          <Border Classes="cv-sep" />
          <Grid Classes="cv-srow" ColumnDefinitions="20,12,*,Auto">
            <Panel Classes="cv-marker">
              <Border Classes="cv-num" Classes.cv-current="{Binding Step4.IsCurrent}" IsVisible="{Binding !Step4.IsDone}"><TextBlock Text="4" /></Border>
              <c:Icon Classes="cv-num-done" Glyph="check_circle" IsVisible="{Binding Step4.IsDone}" />
            </Panel>
            <TextBlock Grid.Column="2" Classes="cv-step-title" Classes.cv-current="{Binding Step4.IsCurrent}" Classes.cv-todo="{Binding Step4.IsToDo}" Text="{Binding Step4.Title}" />
            <Button Grid.Column="3" Classes="cv-btn cv-mini cv-primary" VerticalAlignment="Center" IsVisible="{Binding Step4.IsCurrent}" IsEnabled="{Binding !Linking}"
                    Command="{Binding LinkTheseCommand}"><TextBlock Text="Link these" /></Button>
          </Grid>
          <StackPanel Classes="cv-body" IsVisible="{Binding Step4.IsCurrent}">
            <ItemsControl ItemsSource="{Binding Courses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CanvasCourseRow">
                  <Grid ColumnDefinitions="*,Auto" Height="34">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Ellipse Classes="cv-dot" Fill="{Binding Dot}" />
                      <TextBlock Classes="cv-dot-label" Text="{Binding Class}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="cv-select" Width="240" VerticalAlignment="Center">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Selected.Label}" TextTrimming="CharacterEllipsis"
                                   Classes.cv-placeholder="{Binding Selected.Id, Converter={x:Static ObjectConverters.IsNull}}" />
                        <c:Icon Grid.Column="1" Glyph="expand_more" Size="16" Foreground="{DynamicResource Fg2}" Margin="6,0,0,0" />
                      </Grid>
                      <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight" OverlayDismissEventPassThrough="True">
                          <ItemsControl ItemsSource="{Binding Choices}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:CourseChoice">
                                <Button Classes="cv-select-item"
                                        Command="{Binding $parent[ItemsControl].((vm:CanvasCourseRow)DataContext).PickCommand}"
                                        CommandParameter="{Binding}">
                                  <TextBlock Text="{Binding Label}" />
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="cv-help" Text="{Binding LinkError}" IsVisible="{Binding LinkError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>

          <!-- 5 Sync now -->
          <Border Classes="cv-sep" />
          <Grid Classes="cv-srow" ColumnDefinitions="20,12,*,Auto">
            <Panel Classes="cv-marker">
              <Border Classes="cv-num" Classes.cv-current="{Binding Step5.IsCurrent}" IsVisible="{Binding !Step5.IsDone}"><TextBlock Text="5" /></Border>
              <c:Icon Classes="cv-num-done" Glyph="check_circle" IsVisible="{Binding Step5.IsDone}" />
            </Panel>
            <TextBlock Grid.Column="2" Classes="cv-step-title" Classes.cv-current="{Binding Step5.IsCurrent}" Classes.cv-todo="{Binding Step5.IsToDo}" Text="{Binding Step5.Title}" />
            <TextBlock Grid.Column="3" Classes="cv-value" Text="The first sync takes a few minutes" VerticalAlignment="Center" IsVisible="{Binding Step5.IsToDo}" />
            <Panel Grid.Column="3" VerticalAlignment="Center" IsVisible="{Binding Step5.IsCurrent}">
              <Button Classes="cv-btn cv-mini cv-primary" IsVisible="{Binding !Syncing}" Command="{Binding SyncNowCommand}"><TextBlock Text="Sync now" /></Button>
              <StackPanel Classes="cv-action" IsVisible="{Binding Syncing}">
                <c:Spinner Width="14" Height="14" Thickness="2" Foreground="{DynamicResource Fg2}" />
                <TextBlock Classes="cv-value" Text="Syncing…" />
              </StackPanel>
            </Panel>
          </Grid>
          <StackPanel Classes="cv-body" IsVisible="{Binding Step5.IsCurrent}">
            <StackPanel Spacing="4" IsVisible="{Binding Syncing}">
              <TextBlock Classes="cv-step-body" Text="The first sync takes a few minutes" />
              <Border Classes="cv-track">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding SyncProgress, Converter={x:Static vm:CanvasConverters.FillStar}}" />
                    <ColumnDefinition Width="{Binding SyncProgress, Converter={x:Static vm:CanvasConverters.RestStar}}" />
                  </Grid.ColumnDefinitions>
                  <Border Classes="cv-bar-fill" />
                  <Border Grid.Column="1" Classes="cv-bar-rest" />
                </Grid>
              </Border>
            </StackPanel>
            <TextBlock Classes="cv-step-body" Text="{Binding SyncedLine}" IsVisible="{Binding SyncedLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </StackPanel>

      </StackPanel>
    </Border>

  </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
