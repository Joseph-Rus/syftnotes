<!-- The menu bar dropdown (Surfaces, macOS 01): 320 pt of Liquid Glass, as compact as the system's own menu bar extras
     (Control Centre, Wi-Fi). Idle: Record for the class on now, a 32 pt pill tinted with the accent, and the small
     chevron beside it switches class. Recording: the timer, the waveform, the last line heard, Pause and Stop. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:v="using:StudyStash.App.Views"
             x:Class="StudyStash.App.Views.MacPanel"
             x:DataType="vm:PanelModel"
             Width="320" ClipToBounds="False">
  <UserControl.Styles>
    <Style Selector="Button.row">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,5" />
    </Style>
  </UserControl.Styles>

  <c:Glass CornerRadius="16" Padding="8">
    <StackPanel Spacing="8">

      <!-- Idle: Record, and the class switcher -->
      <StackPanel Spacing="6" IsVisible="{Binding IsIdle}">
        <Grid ColumnDefinitions="*,6,32">
          <Button Name="Record" Classes="tint" Theme="{StaticResource Surface}" Height="32" CornerRadius="16" Padding="12,0"
                  Command="{Binding RecordCommand}" IsEnabled="{Binding CanRecord}" ToolTip.Tip="Start recording">
            <Grid ColumnDefinitions="Auto,8,*,Auto">
              <Ellipse Width="10" Height="10" Fill="{DynamicResource OnAccent}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding RecordLabel}" FontSize="13" FontWeight="SemiBold"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="3" Text="{Binding RecordShortcut}" FontSize="11" Opacity="0.7" Margin="8,0,0,0" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button Name="SwitchClass" AutomationProperties.Name="Switch class" Grid.Column="2" Classes="fill" Theme="{StaticResource Surface}" Width="32" Height="32" CornerRadius="16"
                  HorizontalContentAlignment="Center" Command="{Binding SwitchClassCommand}" ToolTip.Tip="Switch class">
            <c:Icon Glyph="unfold_more" Size="16" Foreground="{DynamicResource Fg}" />
          </Button>
        </Grid>
        <StackPanel Spacing="2" Margin="8,0">
          <TextBlock Text="{Binding Hint}" IsVisible="{Binding HasHint}" FontSize="11" Foreground="{DynamicResource Fg2}"
                     TextTrimming="CharacterEllipsis" />
          <v:MacNextDue DataContext="{Binding NextDue}" IsVisible="{Binding $parent[UserControl].((vm:PanelModel)DataContext).HasNextDue}" />
        </StackPanel>
      </StackPanel>

      <!-- Recording -->
      <Border Classes="fill" IsVisible="{Binding IsRecording}" CornerRadius="10" Padding="10,8">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="Auto,6,*,Auto">
            <Border Width="7" Height="7" CornerRadius="3.5" Background="{DynamicResource Accent}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding RecordingLabel}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="3" Theme="{StaticResource Surface}" CornerRadius="5" Padding="4,1" Margin="0,-1,-4,-1" Command="{Binding ShowRecorderCommand}">
              <TextBlock Text="Show recorder" FontSize="11" Foreground="{DynamicResource Fg2}" />
            </Button>
          </Grid>
          <Grid ColumnDefinitions="Auto,12,*">
            <TextBlock Classes="num" Text="{Binding Elapsed}" FontFamily="{DynamicResource DisplayFont}" FontSize="24" FontWeight="Light"
                       c:Typography.Extra="-0.24" VerticalAlignment="Center" />
            <c:Waveform Grid.Column="2" Height="20" Bars="20" Levels="{Binding Levels}" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Text="{Binding LastLine}" IsVisible="{Binding HasLastLine}" FontSize="11" LineHeight="15" TextWrapping="Wrap" MaxLines="2"
                     TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fg2}" />
          <Grid ColumnDefinitions="*,6,*">
            <Button Classes="fill2" Theme="{StaticResource Surface}" Height="28" CornerRadius="14" HorizontalContentAlignment="Center"
                    Command="{Binding PauseCommand}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <c:Icon Glyph="{Binding PauseGlyph}" Filled="True" Size="14" Foreground="{DynamicResource Fg}" />
                <TextBlock Text="{Binding PauseLabel}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="tint" Theme="{StaticResource Surface}" Height="28" CornerRadius="14" HorizontalContentAlignment="Center"
                    Command="{Binding StopCommand}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <c:Icon Glyph="stop" Filled="True" Size="14" Foreground="{DynamicResource OnAccent}" />
                <TextBlock Text="Stop" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Recent lectures -->
      <StackPanel IsVisible="{Binding HasRecent}">
        <TextBlock Text="Recent" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Fg2}" Margin="8,2,8,0" />
        <ItemsControl ItemsSource="{Binding Recent}" Margin="0,3,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LectureItem">
              <Button Classes="row" Classes.fill="{Binding Selected}"
                      Command="{Binding $parent[UserControl].((vm:PanelModel)DataContext).OpenLectureCommand}" CommandParameter="{Binding}">
                <Grid ColumnDefinitions="7,8,*,8,Auto">
                  <Ellipse Width="7" Height="7" Fill="{Binding Dot}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Fg2}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                    <Border IsVisible="{Binding HasProgress}" Width="120" Height="3" CornerRadius="1.5" Background="{DynamicResource Fill2}"
                            HorizontalAlignment="Left" Margin="0,4,0,0">
                      <Border Width="{Binding ProgressWidth}" CornerRadius="1.5" Background="{DynamicResource Accent}" HorizontalAlignment="Left" />
                    </Border>
                  </StackPanel>
                  <TextBlock Grid.Column="4" Classes="num" Text="{Binding Time}" FontSize="11" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Search -->
      <Button Name="Search" Classes="fill" Theme="{StaticResource Surface}" Height="28" CornerRadius="14" Padding="10,0" Command="{Binding SearchCommand}">
        <Grid ColumnDefinitions="Auto,6,*,Auto">
          <c:Icon Glyph="search" Size="14" Foreground="{DynamicResource Fg2}" />
          <TextBlock Grid.Column="2" Text="Search notes and lectures" FontSize="12" Foreground="{DynamicResource Fg2}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <TextBlock Grid.Column="3" Text="{Binding SearchShortcut}" FontSize="10" Foreground="{DynamicResource Fg3}" Margin="6,0,0,0" VerticalAlignment="Center" />
        </Grid>
      </Button>

      <!-- Status, then the app and its Settings as the last row (like a menu bar extra's "… Settings" row) -->
      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="Auto,6,*" Margin="8,0">
          <Ellipse Width="6" Height="6" Classes="status" Classes.warn="{Binding !StatusGood}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource Fg2}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </Grid>
        <Border Height="1" Background="{DynamicResource Sep}" Margin="8,2" />
        <!-- The app and its Settings, like a menu bar extra's last row: the gear's right edge is the search field's. -->
        <Grid ColumnDefinitions="*,4,Auto">
          <Button Name="OpenApp" Classes="row" Padding="8,3" Height="26" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                  Command="{Binding OpenAppCommand}">
            <TextBlock Text="Open Study Stash" FontSize="13" />
          </Button>
          <Button Name="Settings" AutomationProperties.Name="Settings" Grid.Column="2" Classes="row" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center" Command="{Binding SettingsCommand}" ToolTip.Tip="{Binding SettingsTip}">
            <c:Icon Glyph="settings" Size="15" Foreground="{DynamicResource Fg2}" />
          </Button>
        </Grid>
      </StackPanel>
    </StackPanel>
  </c:Glass>
</UserControl>
