<!-- The full app (Mac): the sidebar straight on the window's canvas (its toolbar, Home, Due, Unsorted, the classes, and
     two plain lines about the library at its foot), and beside it one white page with a hairline round it. The page
     is Home or a class's home, or a list (a class's lectures by week, Canvas's Due list, a linked class's own lists)
     with what's opened beside it: a lecture's notes with Ask floating at their foot, an assignment, a Canvas page.
     Search, Settings and the open lecture's tools sit at the page's top right. The window's title bar lies behind it
     all: any empty stretch along the top moves the window, and the system's traffic lights sit in its corner. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:v="using:StudyStash.App.Views"
             x:Class="StudyStash.App.Views.MacLibrary"
             x:DataType="vm:LibraryModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://StudyStash/Views/MacCanvasStyles.axaml" />
    <!-- A transcript line a diagram pointed to: marked, a little room round it, the words where they were. -->
    <Style Selector="Border.heard">
      <Setter Property="Margin" Value="-8,-4" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.heard.here">
      <Setter Property="Background" Value="{DynamicResource Hl}" />
    </Style>
    <!-- The real window has its own rounded corners and shadow; a screenshot draws both itself. -->
    <Style Selector="Border#Chrome.chrome">
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="BoxShadow" Value="{DynamicResource WindowShadow}" />
    </Style>
    <!-- The library's two lines at the sidebar's foot; when something's wrong they say so in the late red. -->
    <Style Selector="TextBlock.side-foot">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="LineHeight" Value="20" />
      <Setter Property="Foreground" Value="{DynamicResource InkSubtle}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="ItemsControl.bad TextBlock.side-foot">
      <Setter Property="Foreground" Value="{DynamicResource Late}" />
    </Style>
    <!-- A lecture in a class's list: plain words, and the open one on a grey wash. -->
    <Style Selector="Button.card">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="Margin" Value="10,1" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.card.selected">
      <Setter Property="Background" Value="{DynamicResource Hover}" />
    </Style>
    <Style Selector="Button.card TextBlock.sub">
      <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
    </Style>
    <Style Selector="TextBlock.group">
      <Setter Property="Margin" Value="22,16,20,6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource InkSubtle}" />
    </Style>
    <Style Selector="TextBlock.group.first">
      <Setter Property="Margin" Value="22,8,20,6" />
    </Style>
    <Style Selector="Button.pill">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="Padding" Value="10,0,12,0" />
    </Style>
    <Style Selector="Border.seg">
      <Setter Property="Padding" Value="16,5" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.seg.on">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BoxShadow" Value="{DynamicResource LineRing}" />
    </Style>
    <Style Selector="Border.seg TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
    </Style>
    <Style Selector="Border.seg.on TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <!-- The notes fade out under the floating ask bar; with an answer open they end above it, so a short fade will do. -->
    <Style Selector="Border.fade">
      <Setter Property="Height" Value="120" />
    </Style>
    <Style Selector="Border.fade.answer">
      <Setter Property="Height" Value="40" />
    </Style>
    <Style Selector="Border.undo">
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
      <Setter Property="Padding" Value="16,0,6,0" />
      <Setter Property="Background" Value="{DynamicResource PopupBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PopupStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="{DynamicResource PopupShadow}" />
    </Style>
    <Style Selector="Button.undo">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
  </UserControl.Styles>

  <Border Name="Chrome" Background="{DynamicResource Canvas}" ClipToBounds="True" Classes.chrome="{Binding DrawChrome}">
    <Panel>
    <!-- The title bar, behind everything: drag the window by any empty stretch along its top (the sidebar's toolbar
         row, the strip over the page), and the system's traffic lights sit in its left corner. -->
    <c:WindowHeader Name="Header" VerticalAlignment="Top" DrawChrome="{Binding DrawChrome}" />
    <Grid ColumnDefinitions="Auto,*" Margin="8">
      <!-- The sidebar: straight on the canvas, no panel behind it -->
      <DockPanel Name="Sidebar" Width="244" Margin="0,0,8,0" IsVisible="{Binding ShowSidebar}" Background="Transparent" c:WindowHeader.MovesWindow="True">
        <!-- Its toolbar: fold the sidebar away on the left (after the traffic lights; in full screen, which has none
             at rest, in the corner itself), back and forward through the places picked on the right. -->
        <Grid Name="SideTools" DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,2,Auto" Height="32" Margin="80,2,6,22">
          <Button Name="ToggleSidebar" Classes="icon-btn" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="Hide sidebar (⌃⌘S)" AutomationProperties.Name="Hide sidebar">
            <c:Icon Glyph="sidebar" Size="18" />
          </Button>
          <Button Grid.Column="2" Classes="icon-btn" Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip.Tip="Back (⌘[)" AutomationProperties.Name="Back">
            <c:Icon Glyph="arrow_back" Size="18" />
          </Button>
          <Button Grid.Column="4" Classes="icon-btn" Command="{Binding GoForwardCommand}" IsEnabled="{Binding CanGoForward}" ToolTip.Tip="Forward (⌘])" AutomationProperties.Name="Forward">
            <c:Icon Glyph="arrow_forward" Size="18" />
          </Button>
        </Grid>
        <!-- Whether the library answers, and when Canvas last synced: two plain lines at the foot, never under the
             classes (they scroll). -->
        <ItemsControl Name="StatusRow" DockPanel.Dock="Bottom" Classes.bad="{Binding !StatusGood}" ItemsSource="{Binding StatusLines}" Margin="16,8,16,2">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Classes="side-foot" Text="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ScrollViewer Name="ClassList" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,0,6,0" c:WindowHeader.MovesWindow="True">
          <StackPanel Classes="side">
            <!-- Home: every class at once -->
            <Button Name="HomeRow" Classes="nav-item" Classes.selected="{Binding Home.Selected}"
                    Command="{Binding PickClassCommand}" CommandParameter="{Binding Home}">
              <Grid ColumnDefinitions="Auto,10,*">
                <c:Icon Glyph="home" Size="18" />
                <TextBlock Grid.Column="2" Text="Home" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Name="DueRow" Classes="nav-item" Classes.selected="{Binding Due.Selected, FallbackValue=False}" IsVisible="{Binding HasDue}"
                    Command="{Binding PickClassCommand}" CommandParameter="{Binding Due}">
              <Grid ColumnDefinitions="Auto,10,*,10,Auto">
                <c:Icon Glyph="event_upcoming" Size="18" />
                <TextBlock Grid.Column="2" Text="Due" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Classes="count" Text="{Binding Due.Count, FallbackValue=0}" IsVisible="{Binding Due.ShowCount, FallbackValue=False}" />
              </Grid>
            </Button>
            <Button Name="UnsortedRow" Classes="nav-item unsorted" Classes.selected="{Binding Unsorted.Selected}"
                    Command="{Binding PickClassCommand}" CommandParameter="{Binding Unsorted}">
              <Grid ColumnDefinitions="Auto,10,*,10,Auto">
                <c:Icon Glyph="inbox" Size="18" />
                <TextBlock Grid.Column="2" Text="Unsorted" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Classes="count" Text="{Binding Unsorted.Count}" IsVisible="{Binding Unsorted.ShowCount}" />
              </Grid>
            </Button>
            <Grid ColumnDefinitions="*,Auto" Margin="10,22,4,6">
              <TextBlock Classes="side-group" Text="Classes" />
              <Button Name="AddClass" Grid.Column="1" Classes="icon-btn sm" Command="{Binding AddClassCommand}" IsVisible="{Binding CanAddClass}"
                      ToolTip.Tip="Add class" AutomationProperties.Name="Add class">
                <c:Icon Glyph="add" Size="16" />
              </Button>
            </Grid>
            <ItemsControl ItemsSource="{Binding Classes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ClassItem">
                  <StackPanel>
                    <TextBlock Classes="side-group" Text="{Binding Section}" Margin="10,22,4,6" IsVisible="{Binding HasSection}" />
                    <Button Classes="nav-item class" Classes.selected="{Binding Selected}" IsVisible="{Binding !IsDue}"
                            Command="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).PickClassCommand}" CommandParameter="{Binding}">
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Move to folder" ItemsSource="{Binding MoveChoices}">
                            <MenuItem.ItemContainerTheme>
                              <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:FolderChoice">
                                <Setter Property="Header" Value="{Binding Label}" />
                                <Setter Property="Command" Value="{Binding Pick}" />
                              </ControlTheme>
                            </MenuItem.ItemContainerTheme>
                          </MenuItem>
                        </ContextMenu>
                      </Button.ContextMenu>
                      <!-- its swatch | the name, cut short with "…" (the whole name, and its code, on hover) | how many
                           lectures, when there are some -->
                      <Grid ColumnDefinitions="Auto,10,*,Auto">
                        <c:Swatch Fill="{Binding Dot}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="name" Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Tip}" c:Tips.WhenCut="True" />
                        <TextBlock Grid.Column="3" Classes="count" Text="{Binding Count}" Margin="10,0,0,0" IsVisible="{Binding ShowCount}" />
                      </Grid>
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>

      <!-- The page: one white sheet, a hairline round it, no shadow. The sheet itself takes no clicks, so the strip
           along its top (where nothing else is) still moves the window. -->
      <Panel Grid.Column="1">
      <Border Name="Pane" Background="{DynamicResource Surface}" CornerRadius="{DynamicResource RadiusPane}" BoxShadow="{DynamicResource LineRing}" IsHitTestVisible="False" />
      <Border CornerRadius="{DynamicResource RadiusPane}" ClipToBounds="True">
      <DockPanel>
        <!-- The page's toolbar: the open lecture's tools, Open in Canvas for an assignment, search, and Settings on the
             right; with the sidebar folded away, its button and back and forward on the left. -->
        <Grid Name="PaneTools" DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Height="32" Margin="12,10,12,0">
          <StackPanel Name="PaneNav" Orientation="Horizontal" Spacing="2" IsVisible="{Binding !ShowSidebar}">
            <Button Name="ShowSidebar" Classes="icon-btn" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="Show sidebar (⌃⌘S)" AutomationProperties.Name="Show sidebar">
              <c:Icon Glyph="sidebar" Size="18" />
            </Button>
            <Button Classes="icon-btn" Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip.Tip="Back (⌘[)" AutomationProperties.Name="Back">
              <c:Icon Glyph="arrow_back" Size="18" />
            </Button>
            <Button Classes="icon-btn" Command="{Binding GoForwardCommand}" IsEnabled="{Binding CanGoForward}" ToolTip.Tip="Forward (⌘])" AutomationProperties.Name="Forward">
              <c:Icon Glyph="arrow_forward" Size="18" />
            </Button>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding ShowLectureTools}">
              <Button Classes="icon-btn" Command="{Binding MoveCommand}" ToolTip.Tip="Move to another class" AutomationProperties.Name="Move to another class" IsEnabled="{Binding HasNote}">
                <c:Icon Glyph="drive_file_move" Size="18" />
              </Button>
              <Button Classes="icon-btn" Command="{Binding ExportCommand}" ToolTip.Tip="Export" AutomationProperties.Name="Export" IsEnabled="{Binding HasNote}">
                <c:Icon Glyph="ios_share" Size="18" />
              </Button>
              <Button Name="DeleteLecture" Classes="icon-btn" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete lecture" AutomationProperties.Name="Delete lecture"
                      IsEnabled="{Binding HasNote}">
                <c:Icon Glyph="delete" Size="18" />
              </Button>
              <Border Width="1" Height="16" Background="{DynamicResource Line}" Margin="6,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button Classes="plain" Height="32" Margin="0,0,6,0" Command="{Binding Assignment.OpenInCanvasCommand, FallbackValue={x:Null}}" IsVisible="{Binding ShowAssignmentTools}"
                    Content="Open in Canvas" />
            <Button Classes="icon-btn" Command="{Binding SearchCommand}" ToolTip.Tip="Search (⌘K)" AutomationProperties.Name="Search">
              <c:Icon Glyph="search" Size="18" />
            </Button>
            <Button Name="Settings" AutomationProperties.Name="Settings" Classes="icon-btn" Command="{Binding SettingsCommand}" ToolTip.Tip="Settings (⌘,)">
              <c:Icon Glyph="settings" Size="18" />
            </Button>
          </StackPanel>
        </Grid>
      <Grid ColumnDefinitions="Auto,Auto,*">
        <!-- The list: lectures by week, Canvas's Due list, or a linked class's own page -->
        <Panel Grid.Column="1" Grid.ColumnSpan="{Binding ColumnSpan}" Width="{Binding ListWidth}" IsVisible="{Binding ShowListColumn}">
        <DockPanel Name="LectureList" IsVisible="{Binding ShowLectures}">
          <Border DockPanel.Dock="Top" MinHeight="44" Margin="22,4,12,6">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
              <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock Name="ListTitle" Classes="h2" Text="{Binding ClassTitleShown}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ClassTitle}" c:Tips.WhenCut="True" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding ClassCount}" FontSize="13" Foreground="{DynamicResource InkMuted}" IsVisible="{Binding !HasClassTabs}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding CanvasClass.HeaderLine, FallbackValue=''}" FontSize="13" Foreground="{DynamicResource InkMuted}" IsVisible="{Binding HasClassTabs}" VerticalAlignment="Center" />
                  <!-- A class's lectures: back to the class's home -->
                  <Button Classes="text-link" FontSize="13" Content="Class home" IsVisible="{Binding CanShowClassPage}" Command="{Binding ShowClassPageCommand}" />
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                <!-- Attach to the class (drop files on the list, too): its files show under the name once there are some -->
                <Button Classes="icon-btn" VerticalAlignment="Center" Command="{Binding ClassFiles.AttachCommand, FallbackValue={x:Null}}"
                        IsVisible="{Binding HasClassFiles}" ToolTip.Tip="Attach notes, slides or a handout to this class (or drop files on the list)"
                        AutomationProperties.Name="Attach to class">
                  <c:Icon Glyph="attach_file" Size="17" />
                </Button>
                <!-- Fold the list away, giving the page its room -->
                <Button Name="HideList" Classes="icon-btn" VerticalAlignment="Center" Command="{Binding ToggleListCommand}" IsVisible="{Binding CanToggleList}"
                        ToolTip.Tip="Hide the list (⌃⌘L)" AutomationProperties.Name="Hide the list">
                  <c:Icon Glyph="chevron_left" Size="18" />
                </Button>
              </StackPanel>
            </Grid>
          </Border>
          <!-- A Canvas class: switch between its lectures (the list below) and Canvas's own lists -->
          <Border DockPanel.Dock="Top" Classes="cv-seg" Margin="14,2,14,8" HorizontalAlignment="Left" IsVisible="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).HasClassTabs}"
                  DataContext="{Binding CanvasClass}" x:DataType="vm:CanvasClassModel">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto">
              <Button Grid.Column="0" Classes="cv-seg-item" Classes.cv-on="{Binding IsLecturesTab}" Content="Lectures" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:ClassTab.Lectures}" />
              <Button Grid.Column="1" Classes="cv-seg-item" Classes.cv-on="{Binding IsAssignmentsTab}" Content="Assignments" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:ClassTab.Assignments}" />
              <Button Grid.Column="2" Classes="cv-seg-item" Classes.cv-on="{Binding IsModulesTab}" Content="Modules" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:ClassTab.Modules}" />
              <Button Grid.Column="3" Classes="cv-seg-item" Classes.cv-on="{Binding IsAnnouncementsTab}" Content="Announcements" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:ClassTab.Announcements}" />
            </Grid>
          </Border>
          <!-- The one gentle ask for a tip, when it's due: in the list's flow, lined up with the lectures, covering nothing -->
          <Panel DockPanel.Dock="Top" IsVisible="{Binding HasSupport}" Margin="10,2,10,6">
            <v:MacSupportAsk Name="SupportAsk" DataContext="{Binding Support}" />
          </Panel>
          <!-- What's attached in this class (drop files on the list) -->
          <ScrollViewer DockPanel.Dock="Top" MaxHeight="200" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasClassFiles}" Margin="20,0,20,8">
            <v:MacAttachments Name="ClassAttachments" DataContext="{Binding ClassFiles}" />
          </ScrollViewer>
          <!-- A Canvas class on one of Canvas's tabs: that list, in the lectures' place -->
          <Panel IsVisible="{Binding ShowClassTabBody}">
            <v:MacCanvasClass DataContext="{Binding CanvasClass}" />
          </Panel>
          <DockPanel IsVisible="{Binding ShowLectureGroups}">
            <TextBlock DockPanel.Dock="Top" IsVisible="{Binding HasEmpty}" Text="{Binding Empty}" FontSize="15" LineHeight="22" Foreground="{DynamicResource InkMuted}" TextWrapping="Wrap" Margin="22,10" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LectureGroup">
                    <StackPanel>
                      <TextBlock Classes="group" Classes.first="{Binding First}" Text="{Binding Label}" />
                      <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:LectureCard">
                            <Button Classes="card" Classes.selected="{Binding Selected}"
                                    Command="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).PickLectureCommand}" CommandParameter="{Binding}">
                              <Button.ContextMenu>
                                <ContextMenu>
                                  <MenuItem Header="Delete lecture…" Click="OnDeleteRow" />
                                </ContextMenu>
                              </Button.ContextMenu>
                              <StackPanel Margin="12,10">
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" LineHeight="20" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="sub" Text="{Binding Meta}" FontSize="13" FontWeight="Medium" Margin="0,2,0,0" />
                                <TextBlock Classes="sub" Text="{Binding Summary}" IsVisible="{Binding HasSummary}" FontSize="13.5" LineHeight="19" Margin="0,4,0,0"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </DockPanel>
        <DockPanel IsVisible="{Binding ShowDueList}">
          <!-- Canvas needs something (design 08's cards), above what's due -->
          <Panel DockPanel.Dock="Top" IsVisible="{Binding HasDueStatus}" Margin="12,14,12,0">
            <v:MacCanvasStatus DataContext="{Binding DueStatus}" />
          </Panel>
          <v:MacCanvasDue DataContext="{Binding DueList}" />
        </DockPanel>
          <!-- "Deleted · Undo", for a few seconds after a lecture goes -->
          <Border Name="UndoToast" Classes="undo" IsVisible="{Binding HasDeleted}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,28">
            <Grid ColumnDefinitions="*,10,Auto" VerticalAlignment="Center">
              <TextBlock Text="{Binding Deleted.Said, FallbackValue=''}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="2" Name="Undo" Classes="undo" Command="{Binding UndoCommand}" VerticalAlignment="Center">
                <TextBlock Text="Undo" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Ink}" />
              </Button>
            </Grid>
          </Border>
        </Panel>

        <!-- Home, or a class's home: across the list and the page beside it -->
        <Panel Grid.Column="1" Grid.ColumnSpan="2" IsVisible="{Binding ShowOverview}">
          <v:MacOverview Name="Overview" DataContext="{Binding Overview}" />
        </Panel>

        <!-- The right: the lecture, an assignment, or a Canvas page -->
        <Panel Grid.Column="{Binding DetailColumn}" Grid.ColumnSpan="{Binding ColumnSpan}" IsVisible="{Binding ShowDetailColumn}">
          <!-- The list folded away: one arrow at the page's left edge brings it back -->
          <Button Name="ShowList" Classes="plain" Height="32" Padding="6,0,12,0" ZIndex="5" IsVisible="{Binding ShowListOpener}" Command="{Binding ToggleListCommand}"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,4,0,0" ToolTip.Tip="Show the list (⌃⌘L)" AutomationProperties.Name="Show the list">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <c:Icon Glyph="chevron_right" Size="18" VerticalAlignment="Center" />
              <TextBlock Text="List" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Border Width="1" Background="{DynamicResource Sep}" HorizontalAlignment="Left" IsVisible="{Binding !Narrow}" />
          <Panel IsVisible="{Binding ShowAssignment}" Margin="1,0,0,0">
            <v:MacAssignment DataContext="{Binding Assignment}" Classes="inwindow" />
          </Panel>
          <Panel IsVisible="{Binding ShowReader}" Margin="1,0,0,0">
            <v:MacCanvasReader DataContext="{Binding Reader}" />
          </Panel>
        <!-- The notes, and under them the latest answer in its own room: the notes end above it, never under it. The
             ask bar floats over the bottom of the page (the notes fade out under it, as designed) -->
        <Grid IsVisible="{Binding ShowLecturePage}" RowDefinitions="*,Auto" ClipToBounds="False">
          <Panel>
          <ScrollViewer Name="NoteScroll" Margin="1,0,0,0" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasNote}">
            <StackPanel MaxWidth="680" HorizontalAlignment="Center" Margin="56,14,56,140" Spacing="14" DataContext="{Binding Note}" x:DataType="vm:NoteModel">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <c:Highlight Text="{Binding ClassShown}" Fill="{Binding Dot}" FontSize="13.5" FontWeight="SemiBold" LineHeight="18" IsVisible="{Binding HasClass}" />
                <TextBlock Text="{Binding When}" FontSize="13.5" FontWeight="Medium" LineHeight="18" Foreground="{DynamicResource InkMuted}" />
              </StackPanel>
              <TextBlock Text="{Binding Title}" FontSize="32" FontWeight="ExtraBold" LineHeight="38" LetterSpacing="-0.8" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                <Border HorizontalAlignment="Left" Padding="3" CornerRadius="{DynamicResource RadiusControl}" Background="{DynamicResource SurfaceSunken}" BoxShadow="{DynamicResource LineRing}">
                  <StackPanel Orientation="Horizontal">
                    <Button Theme="{StaticResource Surface}" Padding="0" CornerRadius="6" Command="{Binding NotesCommand}" AutomationProperties.Name="Notes">
                      <Border Classes="seg" Classes.on="{Binding ShowNotes}">
                        <TextBlock Text="Notes" FontSize="13" FontWeight="Bold" />
                      </Border>
                    </Button>
                    <Button Theme="{StaticResource Surface}" Padding="0" CornerRadius="6" Command="{Binding TranscriptsCommand}" AutomationProperties.Name="Transcript">
                      <Border Classes="seg" Classes.on="{Binding ShowTranscript}">
                        <TextBlock Text="Transcript" FontSize="13" FontWeight="Bold" />
                      </Border>
                    </Button>
                  </StackPanel>
                </Border>
                <!-- Nothing attached yet: Attach sits beside the tabs rather than heading an empty list of its own -->
                <Button Grid.Column="2" Classes="plain" VerticalAlignment="Center" Height="32" Content="Attach"
                        Command="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).LectureFiles.AttachCommand, FallbackValue={x:Null}}"
                        IsVisible="{Binding !$parent[UserControl].((vm:LibraryModel)DataContext).LectureFiles.ShowHeader, FallbackValue=False}"
                        ToolTip.Tip="Attach your notes, slides or a handout (or drop files on the page)" AutomationProperties.Name="Attach" />
              </Grid>
              <!-- What's attached to this lecture (drop files anywhere on the page) -->
              <Panel IsVisible="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).HasLectureFiles}" Margin="0,2,0,0">
                <v:MacAttachments Name="LectureAttachments" DataContext="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).LectureFiles}" />
              </Panel>
              <TextBlock IsVisible="{Binding HasPending}" Text="{Binding Pending}" FontSize="13" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" Margin="0,12,0,0" />
              <Panel IsVisible="{Binding ShowNotes}">
                <Panel IsVisible="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).HasNotes}">
                  <v:MacAiNotes DataContext="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).Notes}" />
                </Panel>
                <c:NoteView IsVisible="{Binding !$parent[UserControl].((vm:LibraryModel)DataContext).HasNotes}" Markdown="{Binding Markdown}" />
              </Panel>
              <StackPanel IsVisible="{Binding ShowTranscript}" Margin="0,18,0,0">
                <TextBlock IsVisible="{Binding NoTranscript}" Text="This lecture has no transcript." FontSize="13" Foreground="{DynamicResource Fg2}" />
                <ItemsControl Name="TranscriptLines" ItemsSource="{Binding Transcript}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HeardLine">
                      <!-- The line a diagram pointed to ("where was this said"), marked -->
                      <Border Classes="heard" Classes.here="{Binding Here}">
                        <Grid ColumnDefinitions="Auto,*">
                          <TextBlock Classes="num" Width="48" Text="{Binding Time}" IsVisible="{Binding Time, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" FontSize="12" Foreground="{DynamicResource Fg2}" Margin="0,3,12,0" />
                          <SelectableTextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="{DynamicResource SerifFont}" FontSize="16" LineHeight="25.6" TextWrapping="Wrap"
                                               SelectionBrush="{DynamicResource Hl}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <TextBlock IsVisible="{Binding NoNote}" Text="{Binding NoNoteText}" FontSize="13" Foreground="{DynamicResource Fg3}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />

          <!-- The page fades under the title bar, and out under the ask bar (or above the answer) -->
          <Border Name="TopFade" Height="20" VerticalAlignment="Top" IsHitTestVisible="False" />
          <Border Name="Fade" Classes="fade" Classes.answer="{Binding HasAnswer}" VerticalAlignment="Bottom" IsHitTestVisible="False" />
          <!-- A diagram showed where it was said: one click back to the notes, where the diagram is -->
          <Button Name="BackToNotes" Theme="{StaticResource Surface}" IsVisible="{Binding Note.CanGoBack, FallbackValue=False}"
                  Command="{Binding Note.BackToNotesCommand, FallbackValue={x:Null}}" HorizontalAlignment="Center" VerticalAlignment="Top"
                  Margin="0,16,0,0" Height="32" Padding="12,0,14,0" CornerRadius="{DynamicResource RadiusControl}" Background="{DynamicResource PopupBg}"
                  BorderBrush="{DynamicResource PopupStroke}" BorderThickness="1" AutomationProperties.Name="Back to the notes">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Glyph="arrow_back" Size="15" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
              <TextBlock Text="Back to the notes" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          </Panel>

          <!-- The latest answer, just above the ask bar -->
          <Panel Name="AnswerRoom" Grid.Row="1" IsVisible="{Binding HasAnswer}" HorizontalAlignment="Center" Margin="0,8,0,84" ClipToBounds="False">
            <v:MacAiAnswer DataContext="{Binding Ask}" />
          </Panel>

          <!-- Ask about this lecture, with any engine -->
          <Panel Name="AskRoom" Grid.RowSpan="2" IsVisible="{Binding HasAsk}" VerticalAlignment="Bottom" MaxWidth="792" Margin="56,0,56,20">
            <v:MacAiAskBar DataContext="{Binding Ask}" />
          </Panel>
        </Grid>

          <!-- Narrow: back to the list -->
          <Button Classes="icon-btn" IsVisible="{Binding NarrowDetail}" Command="{Binding BackCommand}" ToolTip.Tip="Back" AutomationProperties.Name="Back to the list"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,4,0,0">
            <c:Icon Glyph="arrow_back" Size="18" />
          </Button>
        </Panel>
      </Grid>
      </DockPanel>
      </Border>
      </Panel>
    </Grid>

    <!-- "Delete this lecture?", over the window: a click outside it is Cancel -->
    <!-- "Put CS 101 in a new folder": its name, over the window -->
    <Panel Name="FolderAsk" IsVisible="{Binding AskingFolder}" Background="Transparent">
      <v:MacNewFolder HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Panel>
    <Panel Name="DeleteAsk" IsVisible="{Binding AskingDelete}" Background="Transparent" PointerPressed="OnDeleteAskPressed">
      <v:MacDeleteLecture HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Panel>
    </Panel>
  </Border>
</UserControl>
