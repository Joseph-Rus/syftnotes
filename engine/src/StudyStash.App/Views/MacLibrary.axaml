<!-- The full app (Surfaces, macOS 04): a glass sidebar (Due, Classes, Unsorted), lectures by week, then the note.
     Headings in SF Pro Display, reading text in New York. A title bar across the top holds the window buttons and the toolbar; the ask bar floats over the page.
     With Canvas (09-11) the middle column is the Due list or a class's own page, and the right an assignment or a
     Canvas page; the lecture's notes can be rewritten by another engine (17), and the ask bar picks its engine (16). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:v="using:StudyStash.App.Views"
             x:Class="StudyStash.App.Views.MacLibrary"
             x:DataType="vm:LibraryModel">
  <UserControl.Styles>
    <!-- A transcript line a diagram pointed to: marked, a little room round it, the words where they were. -->
    <Style Selector="Border.heard">
      <Setter Property="Margin" Value="-8,-4" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.heard.here">
      <Setter Property="Background" Value="{DynamicResource Hl}" />
    </Style>
    <!-- The real window has its own rounded corners and shadow; a screenshot draws both itself. -->
    <Style Selector="Border#Chrome.chrome">
      <Setter Property="CornerRadius" Value="26" />
      <Setter Property="BoxShadow" Value="{DynamicResource WindowShadow}" />
    </Style>
    <Style Selector="Button.cls">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="Button.cls.selected">
      <Setter Property="Background" Value="{DynamicResource Fill2}" />
    </Style>
    <Style Selector="Button.cls.selected /template/ Border#PART_Bg">
      <Setter Property="BoxShadow" Value="{DynamicResource EdgeSoft}" />
    </Style>
    <Style Selector="Button.cls TextBlock.title">
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Button.cls.selected TextBlock.title">
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.cls TextBlock.count">
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    </Style>
    <Style Selector="TextBlock.classes">
      <Setter Property="Margin" Value="10,8,10,6" />
    </Style>
    <!-- Unsorted's icon sits a little further out than the dots, and its count ends where every class's count ends. -->
    <Style Selector="Button.cls.unsorted">
      <Setter Property="Padding" Value="7,0,10,0" />
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector="c|Icon.unsorted">
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    </Style>
    <Style Selector="StackPanel.side.canvas">
      <Setter Property="Spacing" Value="2" />
    </Style>
    <Style Selector="StackPanel.side.canvas StackPanel.rows">
      <Setter Property="Spacing" Value="2" />
    </Style>
    <Style Selector="StackPanel.side.canvas Panel.slot">
      <Setter Property="Width" Value="16" />
    </Style>
    <Style Selector="StackPanel.side.canvas TextBlock.classes">
      <Setter Property="Margin" Value="10,10,10,4" />
    </Style>
    <Style Selector="StackPanel.side.canvas Button.cls.unsorted">
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector="StackPanel.side.canvas c|Icon.unsorted">
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    </Style>
    <Style Selector="StackPanel.side.canvas Button.cls.selected TextBlock.title">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.card">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Margin" Value="10,2" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.card.selected">
      <Setter Property="Background" Value="{DynamicResource Tint}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector="Button.card.selected /template/ Border#PART_Bg">
      <Setter Property="BoxShadow" Value="{DynamicResource EdgeTint}" />
    </Style>
    <Style Selector="Button.card TextBlock.sub">
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    </Style>
    <Style Selector="Button.card.selected TextBlock.sub">
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
      <Setter Property="Opacity" Value="0.88" />
    </Style>
    <Style Selector="TextBlock.group">
      <Setter Property="Margin" Value="20,14,20,6" />
    </Style>
    <Style Selector="TextBlock.group.first">
      <Setter Property="Margin" Value="20,10,20,6" />
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.pill">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="12,0,14,0" />
    </Style>
    <Style Selector="Button.round">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.seg">
      <Setter Property="Padding" Value="18,5" />
      <Setter Property="CornerRadius" Value="15" />
    </Style>
    <Style Selector="Border.seg.on">
      <Setter Property="Background" Value="{DynamicResource Raised}" />
      <Setter Property="BoxShadow" Value="{DynamicResource SegShadow}" />
    </Style>
    <Style Selector="Border.seg TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    </Style>
    <Style Selector="Border.seg.on TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
    </Style>
    <!-- The notes fade out under the floating ask bar; with an answer open they end above it, so a short fade will do. -->
    <Style Selector="Border.fade">
      <Setter Property="Height" Value="120" />
    </Style>
    <Style Selector="Border.fade.answer">
      <Setter Property="Height" Value="40" />
    </Style>
    <Style Selector="Border.undo">
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="16,0,6,0" />
      <Setter Property="Background" Value="{DynamicResource PopupBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PopupStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="{DynamicResource PopupShadow}" />
    </Style>
    <Style Selector="Button.undo">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
  </UserControl.Styles>

  <Border Name="Chrome" Background="{DynamicResource Win}" ClipToBounds="True" Classes.chrome="{Binding DrawChrome}">
    <Panel>
    <DockPanel>
      <!-- The title bar: drag the window by it; the system's traffic lights sit in it, and the toolbar on its right. -->
      <c:WindowHeader Name="Header" DockPanel.Dock="Top" DrawChrome="{Binding DrawChrome}">
        <!-- Beside the window buttons: fold the sidebar away, and back and forward through the places picked -->
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{x:Static c:WindowHeader.AfterLights}">
          <c:Glass Width="36" Height="36" CornerRadius="18" BoxShadow="{DynamicResource CtlGlassShadow}">
            <Button Name="ToggleSidebar" Classes="round" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="Show or hide the sidebar (⌃⌘S)" AutomationProperties.Name="Toggle sidebar">
              <c:Icon Glyph="dock_to_right" Size="19" Foreground="{DynamicResource Fg}" RenderTransform="scale(-1,1)" />
            </Button>
          </c:Glass>
          <c:Glass Height="36" CornerRadius="18" Padding="1,0" BoxShadow="{DynamicResource CtlGlassShadow}">
            <StackPanel Orientation="Horizontal">
              <Button Classes="tool" Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip.Tip="Back (⌘[)" AutomationProperties.Name="Back">
                <c:Icon Glyph="arrow_back" Size="18" Foreground="{DynamicResource Fg}" />
              </Button>
              <Button Classes="tool" Command="{Binding GoForwardCommand}" IsEnabled="{Binding CanGoForward}" ToolTip.Tip="Forward (⌘])" AutomationProperties.Name="Forward">
                <c:Icon Glyph="arrow_back" Size="18" Foreground="{DynamicResource Fg}" RenderTransform="scale(-1,1)" />
              </Button>
            </StackPanel>
          </c:Glass>
        </StackPanel>
        <!-- The toolbar: move and export for a lecture, Open in Canvas for an assignment, search, and Settings -->
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
          <c:Glass Height="36" CornerRadius="18" Padding="4,0" BoxShadow="{DynamicResource CtlGlassShadow}" IsVisible="{Binding ShowLectureTools}">
            <StackPanel Orientation="Horizontal">
              <Button Classes="tool" Command="{Binding MoveCommand}" ToolTip.Tip="Move to another class" IsEnabled="{Binding HasNote}">
                <c:Icon Glyph="drive_file_move" Size="19" Foreground="{DynamicResource Fg}" />
              </Button>
              <Button Classes="tool" Command="{Binding ExportCommand}" ToolTip.Tip="Export" IsEnabled="{Binding HasNote}">
                <c:Icon Glyph="ios_share" Size="19" Foreground="{DynamicResource Fg}" />
              </Button>
              <Button Name="DeleteLecture" Classes="tool" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete lecture" AutomationProperties.Name="Delete lecture"
                      IsEnabled="{Binding HasNote}">
                <c:Icon Glyph="delete" Size="19" Foreground="{DynamicResource Fg}" />
              </Button>
            </StackPanel>
          </c:Glass>
          <c:Glass Height="36" CornerRadius="18" BoxShadow="{DynamicResource CtlGlassShadow}" IsVisible="{Binding ShowAssignmentTools}">
            <Button Classes="pill" Command="{Binding Assignment.OpenInCanvasCommand, FallbackValue={x:Null}}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Glyph="open_in_new" Size="16" Foreground="{DynamicResource Fg}" />
                <TextBlock Text="Open in Canvas" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </c:Glass>
          <c:Glass Width="36" Height="36" CornerRadius="18" BoxShadow="{DynamicResource CtlGlassShadow}">
            <Button Classes="round" Command="{Binding SearchCommand}" ToolTip.Tip="Search">
              <c:Icon Glyph="search" Size="19" Foreground="{DynamicResource Fg}" />
            </Button>
          </c:Glass>
          <c:Glass Width="36" Height="36" CornerRadius="18" BoxShadow="{DynamicResource CtlGlassShadow}">
            <Button Name="Settings" AutomationProperties.Name="Settings" Classes="round" Command="{Binding SettingsCommand}" ToolTip.Tip="Settings (⌘,)">
              <c:Icon Glyph="settings" Size="19" Foreground="{DynamicResource Fg}" />
            </Button>
          </c:Glass>
        </StackPanel>
      </c:WindowHeader>
      <Grid ColumnDefinitions="Auto,Auto,*">
        <!-- Classes: a floating glass panel, below the title bar (folded away, the list starts at the window's edge) -->
        <c:Glass Name="Sidebar" Width="240" IsVisible="{Binding ShowSidebar}" CornerRadius="18" BoxShadow="{DynamicResource SideGlassShadow}" Padding="10,6,10,14" Margin="8,0,0,8" c:WindowHeader.MovesWindow="True">
          <DockPanel>
            <!-- Whether the library answers: a row of its own at the bottom, never under the classes (they scroll). -->
            <Grid Name="StatusRow" DockPanel.Dock="Bottom" ColumnDefinitions="Auto,8,*" Margin="10,8,10,4">
              <Ellipse Width="6" Height="6" Classes="status" Classes.warn="{Binding !StatusGood}" VerticalAlignment="Top" Margin="0,5,0,0" />
              <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" />
            </Grid>
            <!-- Coming up on the student's calendars, above the library's status -->
            <v:MacComingUp DockPanel.Dock="Bottom" DataContext="{Binding ComingUp}" Margin="2,8,2,0" />
            <ScrollViewer Name="ClassList" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" c:WindowHeader.MovesWindow="True">
            <!-- With Canvas (design 09) the rows sit 2 px apart, each led by a 16 px slot, and the chosen one is bolder. -->
            <StackPanel Classes="side" Classes.canvas="{Binding HasDue}">
              <!-- Home: every class at once -->
              <Button Name="HomeRow" Classes="cls" Classes.selected="{Binding Home.Selected}"
                      Command="{Binding PickClassCommand}" CommandParameter="{Binding Home}">
                <Grid ColumnDefinitions="Auto,8,*">
                  <c:Icon Glyph="home" Size="17" Width="16" Foreground="{DynamicResource AccentText}" />
                  <TextBlock Grid.Column="2" Classes="title" Text="Home" FontSize="13" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <Button Classes="cls" Classes.selected="{Binding Due.Selected, FallbackValue=False}" IsVisible="{Binding HasDue}"
                      Command="{Binding PickClassCommand}" CommandParameter="{Binding Due}">
                <Grid ColumnDefinitions="Auto,8,*,10,Auto">
                  <c:Icon Glyph="event_upcoming" Size="17" Width="16" Foreground="{DynamicResource AccentText}" />
                  <TextBlock Grid.Column="2" Classes="title" Text="Due" FontSize="13" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Classes="count" Text="{Binding Due.Count, FallbackValue=0}" FontSize="13" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <TextBlock Classes="classes" Text="Classes" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Fg2}" />
              <ItemsControl ItemsSource="{Binding Classes}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Classes="rows" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ClassItem">
                    <Button Classes="cls" Classes.selected="{Binding Selected}" IsVisible="{Binding !IsDue}"
                            Command="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).PickClassCommand}" CommandParameter="{Binding}">
                      <!-- dot | name, cut short with "…" (the whole name on hover) | the count, in its own column -->
                      <Grid ColumnDefinitions="Auto,8,*,10,Auto">
                        <Panel Classes="slot">
                          <Ellipse Width="8" Height="8" Fill="{Binding Dot}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Panel>
                        <TextBlock Grid.Column="2" Classes="title name" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" c:Tips.WhenCut="True" />
                        <TextBlock Grid.Column="4" Classes="count" Text="{Binding Count}" FontSize="13" VerticalAlignment="Center" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="cls unsorted" Classes.selected="{Binding Unsorted.Selected}"
                      Command="{Binding PickClassCommand}" CommandParameter="{Binding Unsorted}">
                <Grid ColumnDefinitions="Auto,8,*,10,Auto">
                  <c:Icon Classes="unsorted" Glyph="inbox" Size="16" Width="16" />
                  <TextBlock Grid.Column="2" Classes="title" Text="Unsorted" FontSize="13" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Classes="count" Text="{Binding Unsorted.Count}" FontSize="13" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </c:Glass>

        <!-- The list: lectures by week, Canvas's Due list, or a linked class's own page -->
        <Panel Grid.Column="1" Grid.ColumnSpan="{Binding ColumnSpan}" Width="{Binding ListWidth}" IsVisible="{Binding ShowListColumn}">
        <DockPanel Name="LectureList" IsVisible="{Binding ShowLectures}">
          <Border DockPanel.Dock="Top" Height="44" Margin="20,12,14,4">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Name="ListTitle" Text="{Binding ClassTitle}" FontFamily="{DynamicResource DisplayFont}" FontSize="17" FontWeight="Bold"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ClassTitle}" c:Tips.WhenCut="True" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding ClassCount}" FontSize="11" Foreground="{DynamicResource Fg2}" />
                  <!-- A class's lectures: back to the class's home -->
                  <Button Theme="{StaticResource Surface}" Padding="0" IsVisible="{Binding CanShowClassPage}" Command="{Binding ShowClassPageCommand}">
                    <TextBlock Text="· Class home" FontSize="11" Foreground="{DynamicResource AccentText}" />
                  </Button>
                </StackPanel>
              </StackPanel>
              <!-- Attach to the class (drop files on the list, too): its files show under the name once there are some -->
              <Button Grid.Column="1" Classes="tool" VerticalAlignment="Center" Command="{Binding ClassFiles.AttachCommand, FallbackValue={x:Null}}"
                      IsVisible="{Binding HasClassFiles}" ToolTip.Tip="Attach notes, slides or a handout to this class (or drop files on the list)"
                      AutomationProperties.Name="Attach to class">
                <c:Icon Glyph="attach_file" Size="17" Foreground="{DynamicResource Fg2}" />
              </Button>
            </Grid>
          </Border>
          <!-- The one gentle ask for a tip, when it's due: in the list's flow, lined up with the lectures, covering nothing -->
          <Panel DockPanel.Dock="Top" IsVisible="{Binding HasSupport}" Margin="10,2,10,6">
            <v:MacSupportAsk Name="SupportAsk" DataContext="{Binding Support}" />
          </Panel>
          <!-- What's attached in this class (drop files on the list) -->
          <ScrollViewer DockPanel.Dock="Top" MaxHeight="200" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasClassFiles}" Margin="20,0,20,8">
            <v:MacAttachments Name="ClassAttachments" DataContext="{Binding ClassFiles}" />
          </ScrollViewer>
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" IsVisible="{Binding HasEmpty}" Text="{Binding Empty}" FontSize="13" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" Margin="20,10" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LectureGroup">
                    <StackPanel>
                      <TextBlock Classes="group" Classes.first="{Binding First}" Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Fg2}" />
                      <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:LectureCard">
                            <Button Classes="card" Classes.selected="{Binding Selected}"
                                    Command="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).PickLectureCommand}" CommandParameter="{Binding}">
                              <Button.ContextMenu>
                                <ContextMenu>
                                  <MenuItem Header="Delete lecture…" Click="OnDeleteRow" />
                                </ContextMenu>
                              </Button.ContextMenu>
                              <StackPanel Margin="12,10">
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="sub" Text="{Binding Meta}" FontSize="12" Margin="0,2,0,0" />
                                <TextBlock Classes="sub" Text="{Binding Summary}" IsVisible="{Binding HasSummary}" FontSize="12" LineHeight="16.8" Margin="0,4,0,0"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </DockPanel>
        <DockPanel IsVisible="{Binding ShowDueList}">
          <!-- Canvas needs something (design 08's cards), above what's due -->
          <Panel DockPanel.Dock="Top" IsVisible="{Binding HasDueStatus}" Margin="12,14,12,0">
            <v:MacCanvasStatus DataContext="{Binding DueStatus}" />
          </Panel>
          <v:MacCanvasDue DataContext="{Binding DueList}" />
        </DockPanel>
        <Panel IsVisible="{Binding ShowCanvasClass}">
          <v:MacCanvasClass DataContext="{Binding CanvasClass}" />
        </Panel>
          <!-- "Deleted · Undo", for a few seconds after a lecture goes -->
          <Border Name="UndoToast" Classes="undo" IsVisible="{Binding HasDeleted}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,28">
            <Grid ColumnDefinitions="*,10,Auto" VerticalAlignment="Center">
              <TextBlock Text="{Binding Deleted.Said, FallbackValue=''}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="2" Name="Undo" Classes="undo" Command="{Binding UndoCommand}" VerticalAlignment="Center">
                <TextBlock Text="Undo" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" />
              </Button>
            </Grid>
          </Border>
        </Panel>

        <!-- Home, or a class's home: across the list and the page beside it -->
        <Panel Grid.Column="1" Grid.ColumnSpan="2" IsVisible="{Binding ShowOverview}">
          <v:MacOverview Name="Overview" DataContext="{Binding Overview}" />
        </Panel>

        <!-- The right: the lecture, an assignment, or a Canvas page -->
        <Panel Grid.Column="{Binding DetailColumn}" Grid.ColumnSpan="{Binding ColumnSpan}" IsVisible="{Binding ShowDetailColumn}">
          <Border Width="1" Background="{DynamicResource Sep}" HorizontalAlignment="Left" IsVisible="{Binding !Narrow}" />
          <Panel IsVisible="{Binding ShowAssignment}" Margin="1,0,0,0">
            <v:MacAssignment DataContext="{Binding Assignment}" Classes="inwindow" />
          </Panel>
          <Panel IsVisible="{Binding ShowReader}" Margin="1,0,0,0">
            <v:MacCanvasReader DataContext="{Binding Reader}" />
          </Panel>
        <!-- The notes, and under them the latest answer in its own room: the notes end above it, never under it. The
             ask bar floats over the bottom of the page (the notes fade out under it, as designed) -->
        <Grid IsVisible="{Binding ShowLecturePage}" RowDefinitions="*,Auto" ClipToBounds="False">
          <Panel>
          <ScrollViewer Name="NoteScroll" Margin="1,0,0,0" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasNote}">
            <StackPanel MaxWidth="620" HorizontalAlignment="Left" Margin="56,28,56,140" Spacing="14" DataContext="{Binding Note}" x:DataType="vm:NoteModel">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="8" Height="8" Fill="{Binding Dot}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{DynamicResource Fg2}" />
              </StackPanel>
              <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource DisplayFont}" FontSize="30" FontWeight="Bold" LineHeight="34.5"
                         c:Typography.Extra="-0.6" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                <Border HorizontalAlignment="Left" Padding="3" CornerRadius="18" Background="{DynamicResource Fill}" BoxShadow="{DynamicResource EdgeSoft}">
                  <StackPanel Orientation="Horizontal">
                    <Button Theme="{StaticResource Surface}" Padding="0" CornerRadius="15" Command="{Binding NotesCommand}" AutomationProperties.Name="Notes">
                      <Border Classes="seg" Classes.on="{Binding ShowNotes}">
                        <TextBlock Text="Notes" FontSize="12" FontWeight="Medium" />
                      </Border>
                    </Button>
                    <Button Theme="{StaticResource Surface}" Padding="0" CornerRadius="15" Command="{Binding TranscriptsCommand}" AutomationProperties.Name="Transcript">
                      <Border Classes="seg" Classes.on="{Binding ShowTranscript}">
                        <TextBlock Text="Transcript" FontSize="12" FontWeight="Medium" />
                      </Border>
                    </Button>
                  </StackPanel>
                </Border>
                <!-- Nothing attached yet: Attach sits beside the tabs rather than heading an empty list of its own -->
                <Button Grid.Column="2" Classes="pill" VerticalAlignment="Center" Height="32"
                        Command="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).LectureFiles.AttachCommand, FallbackValue={x:Null}}"
                        IsVisible="{Binding !$parent[UserControl].((vm:LibraryModel)DataContext).LectureFiles.ShowHeader, FallbackValue=False}"
                        ToolTip.Tip="Attach your notes, slides or a handout (or drop files on the page)" AutomationProperties.Name="Attach">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Glyph="attach_file" Size="15" Foreground="{DynamicResource Fg}" />
                    <TextBlock Text="Attach" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>
              <!-- What's attached to this lecture (drop files anywhere on the page) -->
              <Panel IsVisible="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).HasLectureFiles}" Margin="0,2,0,0">
                <v:MacAttachments Name="LectureAttachments" DataContext="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).LectureFiles}" />
              </Panel>
              <TextBlock IsVisible="{Binding HasPending}" Text="{Binding Pending}" FontSize="13" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" Margin="0,12,0,0" />
              <Panel IsVisible="{Binding ShowNotes}">
                <Panel IsVisible="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).HasNotes}">
                  <v:MacAiNotes DataContext="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).Notes}" />
                </Panel>
                <c:NoteView IsVisible="{Binding !$parent[UserControl].((vm:LibraryModel)DataContext).HasNotes}" Markdown="{Binding Markdown}" />
              </Panel>
              <StackPanel IsVisible="{Binding ShowTranscript}" Margin="0,18,0,0">
                <TextBlock IsVisible="{Binding NoTranscript}" Text="This lecture has no transcript." FontSize="13" Foreground="{DynamicResource Fg2}" />
                <ItemsControl Name="TranscriptLines" ItemsSource="{Binding Transcript}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HeardLine">
                      <!-- The line a diagram pointed to ("where was this said"), marked -->
                      <Border Classes="heard" Classes.here="{Binding Here}">
                        <Grid ColumnDefinitions="Auto,*">
                          <TextBlock Classes="num" Width="48" Text="{Binding Time}" IsVisible="{Binding Time, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" FontSize="12" Foreground="{DynamicResource Fg2}" Margin="0,3,12,0" />
                          <SelectableTextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="{DynamicResource SerifFont}" FontSize="16" LineHeight="25.6" TextWrapping="Wrap"
                                               SelectionBrush="{DynamicResource Hl}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <TextBlock IsVisible="{Binding NoNote}" Text="{Binding NoNoteText}" FontSize="13" Foreground="{DynamicResource Fg3}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />

          <!-- The page fades under the title bar, and out under the ask bar (or above the answer) -->
          <Border Name="TopFade" Height="20" VerticalAlignment="Top" IsHitTestVisible="False" />
          <Border Name="Fade" Classes="fade" Classes.answer="{Binding HasAnswer}" VerticalAlignment="Bottom" IsHitTestVisible="False" />
          </Panel>

          <!-- The latest answer, just above the ask bar -->
          <Panel Name="AnswerRoom" Grid.Row="1" IsVisible="{Binding HasAnswer}" HorizontalAlignment="Center" Margin="0,8,0,84" ClipToBounds="False">
            <v:MacAiAnswer DataContext="{Binding Ask}" />
          </Panel>

          <!-- Ask about this lecture, with any engine -->
          <Panel Name="AskRoom" Grid.RowSpan="2" IsVisible="{Binding HasAsk}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24">
            <v:MacAiAskBar DataContext="{Binding Ask}" />
          </Panel>
        </Grid>

          <!-- Narrow: back to the list -->
          <c:Glass IsVisible="{Binding NarrowDetail}" Width="36" Height="36" CornerRadius="18" BoxShadow="{DynamicResource CtlGlassShadow}"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,14,0,0">
            <Button Classes="round" Command="{Binding BackCommand}" ToolTip.Tip="Back">
              <c:Icon Glyph="arrow_back" Size="19" Foreground="{DynamicResource Fg}" />
            </Button>
          </c:Glass>
        </Panel>
      </Grid>
    </DockPanel>

    <!-- "Delete this lecture?", over the window: a click outside it is Cancel -->
    <Panel Name="DeleteAsk" IsVisible="{Binding AskingDelete}" Background="Transparent" PointerPressed="OnDeleteAskPressed">
      <v:MacDeleteLecture HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Panel>
    </Panel>
  </Border>
</UserControl>
