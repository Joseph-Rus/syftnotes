<!-- A Canvas notification, as its own floating window (design 12): a 364-wide acrylic card, the freshest one showing
     its "Open"/"Dismiss" pair. The window that hosts this belongs to the shell; this control draws no chrome of its
     own but the card itself. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             x:Class="StudyStash.App.Views.WinCanvasToast"
             x:DataType="vm:CanvasToastModel"
             Width="364">
  <UserControl.Styles>
    <StyleInclude Source="avares://StudyStash/Views/WinCanvasStyles.axaml" />
  </UserControl.Styles>
  <Border CornerRadius="8" Background="{DynamicResource Acrylic}" BorderBrush="{DynamicResource FlyStroke}" BorderThickness="1"
          BoxShadow="{DynamicResource ShadowLg}" Padding="16,12,16,16">
    <StackPanel Spacing="10">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <Border Grid.Column="0" Classes="cv-toast-mark">
          <c:Icon Glyph="graphic_eq" Size="12" Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Grid.Column="1" Classes="cv-toast-brand" Text="Study Stash" Margin="8,0,0,0" VerticalAlignment="Center" />
        <c:Icon Grid.Column="2" Glyph="more_horiz" Size="16" Foreground="{DynamicResource Fg2}" Margin="0,0,8,0" VerticalAlignment="Center" />
        <Button Grid.Column="3" Classes="cv-close" Width="16" Height="16" Command="{Binding DismissCommand}">
          <c:Icon Glyph="close" Size="16" Foreground="{DynamicResource Fg2}" />
        </Button>
      </Grid>
      <StackPanel Spacing="2">
        <TextBlock Classes="cv-toast-title" Text="{Binding Title}" />
        <TextBlock Classes="cv-toast-text" Text="{Binding Text}" />
      </StackPanel>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding Expanded}">
        <Button Grid.Column="0" Classes="cv-btn cv-primary" HorizontalContentAlignment="Center" Command="{Binding OpenCommand}">
          <TextBlock Text="Open" />
        </Button>
        <Button Grid.Column="1" Classes="cv-btn" HorizontalContentAlignment="Center" Command="{Binding DismissCommand}">
          <TextBlock Text="{Binding DismissLabel}" />
        </Button>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
