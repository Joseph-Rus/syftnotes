<!-- A lecture's notes with "Rewrite notes" (design 17): the current notes never change on screen until "Use new" is
     pressed, however a rewrite ends. "Edit" turns them into a text editor until Save or Cancel. Only the notes
     block — the lecture's own title/meta row above it is the host page's (MacLibrary). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:v="using:StudyStash.App.Views"
             x:Class="StudyStash.App.Views.MacAiNotes"
             x:DataType="vm:AiNotesModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://StudyStash/Views/MacAiStyles.axaml" />
  </UserControl.Styles>

  <StackPanel Spacing="12">

    <!-- Rewriting -->
    <Border Classes="ai-bar" Padding="14,12" IsVisible="{Binding IsRewriting}">
      <Grid ColumnDefinitions="Auto,10,*,10,Auto" VerticalAlignment="Center">
        <c:Spinner Width="12" Height="12" Foreground="{DynamicResource Fg2}" />
        <TextBlock Grid.Column="2" TextWrapping="Wrap" FontSize="13">
          <Run FontWeight="SemiBold" Text="{Binding RewritingLead}" />
          <Run Foreground="{DynamicResource Fg2}" Text=" Your current notes stay until the new ones are ready." />
        </TextBlock>
        <Button Grid.Column="4" Classes="ai-textbtn" Command="{Binding CancelCommand}" VerticalAlignment="Center">
          <TextBlock Classes="ai-bar-text" Text="Cancel" />
        </Button>
      </Grid>
    </Border>

    <!-- Ready -->
    <Border Classes="ai-bar" Padding="14,10,10,10" IsVisible="{Binding IsReady}">
      <Grid ColumnDefinitions="Auto,10,*,8,Auto,8,Auto,8,Auto" VerticalAlignment="Center">
        <c:Icon Glyph="check_circle" Filled="True" Size="18" Foreground="{DynamicResource Ok}" />
        <TextBlock Grid.Column="2" FontSize="13" Text="{Binding ReadyLead}" TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="4" Classes="ai-textbtn" Command="{Binding KeepOldCommand}">
          <Border Classes="ai-pill-plain"><TextBlock Text="Keep old" /></Border>
        </Button>
        <Button Grid.Column="6" Classes="ai-pillbtn" Command="{Binding CompareCommand}">
          <Border Classes="ai-pill"><TextBlock Text="Compare" /></Border>
        </Button>
        <Button Grid.Column="8" Classes="ai-pillbtn" Command="{Binding UseNewCommand}">
          <Border Classes="ai-pill" Classes.primary="True"><TextBlock Text="Use new" /></Border>
        </Button>
      </Grid>
    </Border>

    <!-- Failed -->
    <Border Classes="ai-problem" IsVisible="{Binding IsFailed}">
      <Grid ColumnDefinitions="Auto,12,*">
        <c:Icon Glyph="error" Filled="True" Size="20" Foreground="{DynamicResource Warn}" />
        <StackPanel Grid.Column="2" Spacing="0">
          <TextBlock Classes="ai-problem-title" Text="{Binding FailedTitle}" />
          <TextBlock Classes="ai-problem-message" Text="{Binding FailedMessage}" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
            <Button Classes="ai-pillbtn" Command="{Binding TryAgainCommand}">
              <Border Classes="ai-pill"><TextBlock Text="Try again" /></Border>
            </Button>
            <Button Classes="ai-textbtn" Command="{Binding DismissCommand}">
              <Border Classes="ai-pill-plain"><TextBlock Text="Dismiss" /></Border>
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Whose words are whose: the student's in ink, what was added from the recording in grey (who wrote that, and
         when, on hover); with nothing added, just "What you wrote". On the right, Edit (while editing: Cancel and
         Save) and, under the dots, writing the notes again with another AI. -->
    <Grid ColumnDefinitions="*,12,Auto,Auto" MinHeight="28">
      <StackPanel Name="Legend" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center" ToolTip.Tip="{Binding BylineTip}" Background="Transparent">
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasMine}">
          <Border Width="14" Height="3" CornerRadius="2" Background="{DynamicResource Ink}" VerticalAlignment="Center" />
          <TextBlock Classes="legend mine" Text="What you wrote" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !AllMine}">
          <Border Width="14" Height="3" CornerRadius="2" Background="{DynamicResource InkMuted}" VerticalAlignment="Center" />
          <TextBlock Name="LegendAi" Classes="legend" Text="{Binding LegendAi}" />
        </StackPanel>
        <TextBlock Name="Byline" Classes="legend" Foreground="{DynamicResource InkSubtle}" Text="{Binding DiagramsLine}"
                   IsVisible="{Binding DiagramsLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
      <Button Name="EditButton" Grid.Column="2" Classes="link-btn" Margin="0,0,6,0" VerticalAlignment="Center" IsVisible="{Binding ShowEditButton}" Command="{Binding EditCommand}"
              ToolTip.Tip="Fix or add to these notes yourself" AutomationProperties.Name="Edit notes">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <c:Icon Glyph="edit" Size="15" VerticalAlignment="Center" />
          <TextBlock Text="Edit" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <StackPanel Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding Editing}">
        <Button Classes="btn sm" Content="Cancel" Command="{Binding CancelEditCommand}" />
        <Button Classes="btn sm ink" Content="Save" Command="{Binding SaveEditCommand}" IsEnabled="{Binding CanSaveEdit}" />
      </StackPanel>
      <Button Name="RewriteButton" Grid.Column="3" Classes="icon-btn sm" VerticalAlignment="Center" IsVisible="{Binding ShowRewriteButton}"
              ToolTip.Tip="Write these notes again" AutomationProperties.Name="Rewrite notes">
        <c:Icon Glyph="more_horiz" Size="16" />
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedRight" ShowMode="Standard" FlyoutPresenterClasses="bare"
                  Opened="OnMenuOpened" Closed="OnMenuClosed">
            <ContentControl Content="{Binding Menu}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:EngineMenuModel">
                  <v:MacAiEngineMenu />
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </Flyout>
        </Button.Flyout>
      </Button>
    </Grid>

    <!-- The notes, dimmed while the menu is open -->
    <Border Classes="ai-dim" Classes.dimmed="{Binding Dimmed}" IsVisible="{Binding ShowNotes}">
      <c:NoteView Markdown="{Binding ShownMarkdown}" Provenance="True" />
    </Border>

    <!-- Editing: the notes as text, each diagram one line; Save and Cancel again under long notes -->
    <StackPanel Spacing="10" IsVisible="{Binding Editing}">
      <TextBlock Classes="ai-editor-hint" IsVisible="{Binding EditHasDiagrams}"
                 Text="A line like [Diagram 1] is a diagram. Move the line to move it, or delete the line to take it out." />
      <Border Classes="ai-editor">
        <c:MarkdownBox Name="Editor" Classes="bare ai-editor" Text="{Binding EditText}" AcceptsReturn="True" TextWrapping="Wrap" WholeNotes="True"
                 AutomationProperties.Name="Notes" />
      </Border>
      <TextBlock Classes="ai-editor-problem" IsVisible="{Binding HasEditProblem}" Text="{Binding EditProblem}" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="ai-textbtn" Command="{Binding CancelEditCommand}">
          <Border Classes="ai-pill-plain"><TextBlock Text="Cancel" /></Border>
        </Button>
        <Button Classes="ai-pillbtn" Command="{Binding SaveEditCommand}" IsEnabled="{Binding CanSaveEdit}">
          <Border Classes="ai-pill" Classes.primary="True"><TextBlock Text="Save" /></Border>
        </Button>
      </StackPanel>
    </StackPanel>

    <!-- Compare: the current notes beside the new ones -->
    <Grid ColumnDefinitions="*,28,*" IsVisible="{Binding IsComparing}">
      <StackPanel Spacing="10">
        <TextBlock Classes="ai-compare-head" Text="Current notes" />
        <c:NoteView Markdown="{Binding CurrentBody}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="10">
        <TextBlock Classes="ai-compare-head" Text="{Binding DraftHeading}" />
        <c:NoteView Markdown="{Binding DraftBody}" />
      </StackPanel>
    </Grid>

  </StackPanel>
</UserControl>
