<!-- Setup's AI step: "Choose who writes your notes" (Claude, ChatGPT, Gemini and the free AI, each a card: its radio,
     name and one line, and the one button that gets it ready, Set it up or Sign in, with nothing to type; and "No AI for
     now"), then "Who answers your questions" (starts as Same as notes).
     The step's body only: the host draws the step label, the steps and the Back/Continue foot, and calls SaveAsync on
     Continue. In setup's look (SetupStyles): white cards with a hairline, the chosen one ringed in ink. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             x:Class="StudyStash.App.Views.MacAiSetup"
             x:DataType="vm:AiSetupModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://StudyStash/Views/MacAiStyles.axaml" />
    <StyleInclude Source="avares://StudyStash/Views/SetupStyles.axaml" />
    <StyleInclude Source="avares://StudyStash/Views/SetupAiStyles.axaml" />
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="40,0,40,20" MaxWidth="660" HorizontalAlignment="Left">
      <TextBlock Classes="page-title step-title" Text="Choose who writes your notes" />
      <TextBlock Classes="page-lede step-lede" Text="{Binding Lede}" />
      <TextBlock Classes="hint" Margin="0,10,0,0" Text="{Binding OlderLibraryWords}" IsVisible="{Binding OlderLibrary}" />
      <TextBlock Classes="hint" Margin="0,10,0,0" Text="Your library isn't answering. Check it's on and connected." IsVisible="{Binding Offline}" />

      <ItemsControl ItemsSource="{Binding Engines}" Margin="0,22,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AiSetupRow">
            <Border Classes="engine" Classes.on="{Binding Selected}">
              <StackPanel>
                <!-- radio | name and one line (the choice itself) | what it needs, at the right -->
                <Grid ColumnDefinitions="*,12,Auto" MinHeight="44">
                  <Button AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding About}" Classes="ai-textbtn ai-choice quiet" Command="{Binding SelectCommand}" HorizontalContentAlignment="Stretch" Padding="0">
                    <Grid ColumnDefinitions="Auto,14,*">
                      <Border Classes="radio" Classes.on="{Binding Selected}" Classes.dim="{Binding !CanWrite}"><Ellipse /></Border>
                      <Border Classes="focusring ai-radioring" />
                      <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Classes="choice-title" Text="{Binding Name}" />
                          <!-- The free AI that runs on the computer itself: not the easy way, and said so -->
                          <Border Classes="tag" IsVisible="{Binding Advanced}"><TextBlock Text="Advanced" /></Border>
                        </StackPanel>
                        <TextBlock Classes="choice-about" Text="{Binding About}" />
                      </StackPanel>
                    </Grid>
                  </Button>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Not ready yet: one button gets it ready (Claude, ChatGPT, Gemini or the free AI), and nothing is left to do by hand -->
                    <!-- Or an API key instead (Claude, ChatGPT, Gemini): the box for it opens under the list -->
                    <Button AutomationProperties.Name="Use an API key" Classes="text-link small" VerticalAlignment="Center" Command="{Binding KeyCommand}" IsVisible="{Binding ShowKeyLink}" Content="Use an API key" />
                    <Button AutomationProperties.Name="{Binding OpenLabel}" Name="SetUpFree" Classes="btn sm" Command="{Binding OpenCommand}" IsVisible="{Binding ShowOneButton}" Content="{Binding OpenLabel}" />
                    <Button AutomationProperties.Name="Sign in" Classes="btn sm" Command="{Binding SignInCommand}" IsVisible="{Binding ShowSignIn}" Content="Sign in" />
                  </StackPanel>
                </Grid>
                <!-- The free AI being got ready: how far along -->
                <StackPanel IsVisible="{Binding Working}" Margin="34,10,0,4" Spacing="6">
                  <c:SyftLoader Kind="PixelProgress" Size="9" Progress="{Binding Fraction}" IsIndeterminate="{Binding Steady}" HorizontalAlignment="Left" />
                  <TextBlock Classes="hint" Text="{Binding Progress}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- An AI's API key (Claude, ChatGPT, Gemini): where to make one, the box, Save. Under the list, not in a row, so
           what's typed stays put while the rows are drawn again. Gemini, not on this computer at all, also says its
           other way: Google's own app, signed in. -->
      <Border Classes="engine" Margin="0,10,0,0" IsVisible="{Binding KeyOpen}">
        <StackPanel Spacing="10" Margin="2,4,2,4">
          <Grid ColumnDefinitions="*,12,Auto">
            <TextBlock Classes="choice-title" Text="{Binding KeyTitle}" VerticalAlignment="Center" />
            <Button AutomationProperties.Name="Cancel" Grid.Column="2" Classes="text-link small" VerticalAlignment="Center" Command="{Binding CloseKeyCommand}" Content="Cancel" />
          </Grid>
          <TextBlock Classes="choice-about" Text="{Binding KeyLede}" />
          <Button AutomationProperties.Name="{Binding KeyWhere, StringFormat='Open {0}'}" Classes="text-link small" HorizontalAlignment="Left" Command="{Binding GetKeyCommand}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="{Binding KeyWhere, StringFormat='Open {0}'}" />
              <c:Icon Glyph="arrow_outward" Size="13" />
            </StackPanel>
          </Button>
          <Grid ColumnDefinitions="*,8,Auto">
            <Border Classes="field">
              <TextBox Name="KeyBox" Classes="bare" Text="{Binding KeyDraft}" PasswordChar="•" PlaceholderText="Paste your key"
                       AutomationProperties.Name="{Binding KeyTitle}">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding SaveKeyCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
            </Border>
            <Button Grid.Column="2" Classes="btn sm ink" VerticalAlignment="Center" Command="{Binding SaveKeyCommand}" IsEnabled="{Binding !Busy}" Content="Save" />
          </Grid>
          <!-- Gemini: what Google's free tier does with what's sent, and who can have a free key -->
          <TextBlock Classes="hint" Text="{Binding KeyPrivacy}" IsVisible="{Binding HasKeyPrivacy}" TextWrapping="Wrap" FontSize="12.5" LineHeight="18" />
          <Grid ColumnDefinitions="*,12,Auto" IsVisible="{Binding HasKeyAlternative}">
            <TextBlock Classes="hint" Text="{Binding KeyAlternative}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button AutomationProperties.Name="Check again" Grid.Column="2" Classes="btn sm" VerticalAlignment="Center" Command="{Binding CheckKeyAlternativeCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Glyph="refresh" Size="14" />
                <TextBlock Text="Check again" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Border>

      <!-- No AI for now: transcripts only, notes turned on later in Settings -->
      <Border Classes="engine" Classes.on="{Binding NoAi}" Margin="0,10,0,0" IsVisible="{Binding OffersNoAi}">
        <Grid MinHeight="44">
          <Button AutomationProperties.Name="No AI for now" AutomationProperties.HelpText="Just transcripts. Turn notes on later in Settings." Classes="ai-textbtn ai-choice quiet" Command="{Binding PickNoAiCommand}" HorizontalContentAlignment="Stretch" Padding="0">
            <Grid ColumnDefinitions="Auto,14,*">
              <Border Classes="radio" Classes.on="{Binding NoAi}"><Ellipse /></Border>
              <Border Classes="focusring ai-radioring" />
              <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                <TextBlock Classes="choice-title" Text="No AI for now" />
                <TextBlock Classes="choice-about" Text="Just transcripts. Turn notes on later in Settings." />
              </StackPanel>
            </Grid>
          </Button>
        </Grid>
      </Border>
      <Grid ColumnDefinitions="Auto,8,*" Margin="2,12,0,0" IsVisible="{Binding HasSay}">
        <c:SyftLoader Kind="HoppingBits" Size="20" IsVisible="{Binding Busy}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Classes="hint" Text="{Binding Say}" VerticalAlignment="Center" />
      </Grid>

      <!-- Who answers questions asked in the library: a heading, and the choice in a panel of its own. -->
      <TextBlock Classes="h2 part" Text="Who answers your questions" Margin="0,28,0,8" />
      <Border Classes="group" MaxWidth="10000">
        <Grid Classes="row" ColumnDefinitions="*,12,Auto" MinHeight="56">
          <TextBlock Classes="hint" Text="You can pick per question too" VerticalAlignment="Center" />
          <Button AutomationProperties.Name="Who answers your questions" Grid.Column="2" Classes="picker" VerticalAlignment="Center" MinWidth="180" HorizontalContentAlignment="Stretch">
            <Grid ColumnDefinitions="*,8,Auto">
              <TextBlock Text="{Binding SelectedAskName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <c:Icon Grid.Column="2" Glyph="unfold_more" Size="15" Foreground="{DynamicResource InkSubtle}" VerticalAlignment="Center" />
            </Grid>
            <Button.Flyout>
              <!-- Left open, the click that closes it still reaches what it lands on: Continue moves on in one click. It
                   opens upward: the picker is at the page's foot, and opened downward it would lie over Continue. -->
              <MenuFlyout Placement="TopEdgeAlignedRight" OverlayDismissEventPassThrough="True" FlyoutPresenterTheme="{StaticResource AiMenuFlyout}" ItemsSource="{Binding AskChoices}" ItemContainerTheme="{StaticResource AiChoiceItem}" />
            </Button.Flyout>
          </Button>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
