<!-- A note's page (both looks): a lecture, a meeting or a recording, filling the pane. Over the title, where it is (its
     folder, a link to that folder's page, and a chevron that moves it) and what it is ("Lecture, Monday 12 October at
     9:30 AM, 52 min"). The title is typed over to rename it. Under it Notes and Transcript, with "Only my notes" and
     Attach on the right. The notes are one document: what the student typed in ink, what was added from the recording
     in grey. While it records the page has the recording's bar at its top, the notes are the student's own typing,
     and the other tab is what's been heard so far. Ask floats at the foot. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:v="using:StudyStash.App.Views"
             x:Class="StudyStash.App.Views.NotePage"
             x:DataType="vm:LibraryModel">
  <UserControl.Styles>
    <!-- The page is one column the notes' width, centred in the pane however wide it is (the sidebar shut, a big
         screen); the ask bar keeps to the same column. -->
    <Style Selector="StackPanel.np-page">
      <Setter Property="Margin" Value="56,6,56,140" />
      <Setter Property="MaxWidth" Value="704" />
    </Style>
    <Style Selector="StackPanel.np-page.narrow">
      <Setter Property="Margin" Value="24,6,24,140" />
    </Style>
    <Style Selector="Panel.np-ask">
      <Setter Property="Margin" Value="56,0,56,20" />
      <Setter Property="MaxWidth" Value="704" />
    </Style>
    <Style Selector="Panel.np-ask.narrow">
      <Setter Property="Margin" Value="24,0,24,20" />
    </Style>
    <!-- A transcript line a diagram pointed to: marked, a little room round it, the words where they were. -->
    <Style Selector="Border.heard">
      <Setter Property="Margin" Value="-8,-4" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.heard.here">
      <Setter Property="Background" Value="{DynamicResource Hover}" />
    </Style>
    <!-- A line's time: plain figures, and a button that plays the recording from there when it's on this computer. -->
    <Style Selector="Button.heard-time">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Width" Value="48" />
      <Setter Property="Margin" Value="0,3,12,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource InkSubtle}" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Button.heard-time /template/ Border#PART_Wash">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.heard-time:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <!-- The folder's name over the title: a link to its page. -->
    <Style Selector="Button.crumb-link">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="Button.crumb-link /template/ Border#PART_Wash">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.crumb-link:pointerover TextBlock">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
    <!-- The recording's dot breathes while it records (not while paused, and not for someone who asked for less motion). -->
    <Style Selector="Ellipse.pulse">
      <Style.Animations>
        <Animation Duration="0:0:1.6" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- The notes fade out under the floating ask bar; with an answer open they end above it, so a short fade will do. -->
    <Style Selector="Border.fade">
      <Setter Property="Height" Value="120" />
    </Style>
    <Style Selector="Border.fade.answer">
      <Setter Property="Height" Value="40" />
    </Style>
  </UserControl.Styles>

  <!-- The notes, and under them the latest answer in its own room: the notes end above it, never under it. The ask bar
       floats over the bottom of the page (the notes fade out under it). -->
  <Grid RowDefinitions="*,Auto" ClipToBounds="False">
    <Panel>
      <ScrollViewer Name="NoteScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasNote}">
        <StackPanel Classes="np-page" Classes.narrow="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).Narrow}" DataContext="{Binding Note}" x:DataType="vm:NoteModel">

          <!-- While it records: the bar. Pause keeps the file open; Stop ends the recording and starts the write-up. -->
          <Border Name="RecBar" Classes="recbar" IsVisible="{Binding Live}" Margin="0,2,0,26" AutomationProperties.Name="{Binding RecordingSaid}"
                  AutomationProperties.LiveSetting="Polite">
            <Grid ColumnDefinitions="Auto,14,Auto,14,Auto,14,Auto,*,Auto,8,Auto">
              <Ellipse Width="12" Height="12" Fill="{DynamicResource Record}" Classes.pulse="{Binding Pulses}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding RecordingWord}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
              <c:Waveform Grid.Column="4" Bars="3" Height="16" MinBar="5" Levels="{Binding Recorder.Levels, FallbackValue={x:Null}}" Foreground="{DynamicResource Record}"
                          VerticalAlignment="Center" IsVisible="{Binding Recorder.IsRunning, FallbackValue=False}" />
              <TextBlock Grid.Column="6" Text="{Binding Recorder.Elapsed, FallbackValue=''}" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource InkMuted}"
                         VerticalAlignment="Center" />
              <Button Name="Pause" Grid.Column="8" Classes="btn sm" Command="{Binding Recorder.PauseCommand, FallbackValue={x:Null}}" AutomationProperties.Name="{Binding PauseWord}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Glyph="{Binding Recorder.PauseGlyph, FallbackValue=pause}" Size="14" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding PauseWord}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Name="Stop" Grid.Column="10" Classes="btn sm ink" Command="{Binding Recorder.StopCommand, FallbackValue={x:Null}}" AutomationProperties.Name="Stop recording"
                      ToolTip.Tip="{Binding StopTip}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Surface}" VerticalAlignment="Center" />
                  <TextBlock Text="Stop" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>

          <!-- Planned for a calendar event: when it starts, and Start now -->
          <Border Name="PlanBar" Classes="recbar" IsVisible="{Binding Planned}" Margin="0,2,0,26">
            <Grid ColumnDefinitions="Auto,14,*,14,Auto">
              <Ellipse Width="12" Height="12" Stroke="{DynamicResource Record}" StrokeThickness="2" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding PlanWords}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
              <Button Name="StartNow" Grid.Column="4" Classes="btn sm ink" Command="{Binding StartNowCommand}" AutomationProperties.Name="Start recording now">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Width="10" Height="10" Fill="{DynamicResource Record}" VerticalAlignment="Center" />
                  <TextBlock Text="Start now" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>

          <!-- Where it is, and what it is -->
          <WrapPanel Name="Crumb">
            <Button Name="FolderLink" Classes="crumb-link" IsVisible="{Binding HasClass}" Margin="0,0,10,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding FolderSaid}"
                    Command="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).OpenFolderCommand}" CommandParameter="{Binding ClassName}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:Swatch Fill="{Binding Dot}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ClassShown}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsUnsorted}" Margin="0,0,10,0" VerticalAlignment="Center">
              <c:Icon Glyph="inbox" Size="15" Foreground="{DynamicResource InkSubtle}" VerticalAlignment="Center" />
              <TextBlock Classes="unsorted" FontSize="14" Text="Unsorted" VerticalAlignment="Center" />
            </StackPanel>
            <Button Name="ChangeFolder" Classes="icon-btn sm" IsVisible="{Binding CanMove}" Margin="-4,0,6,0" VerticalAlignment="Center" Click="OnPickFolder"
                    ToolTip.Tip="Change folder" AutomationProperties.Name="Change folder">
              <c:Icon Glyph="expand_more" Size="14" />
            </Button>
            <TextBlock Name="CrumbWords" Classes="crumb" Text="{Binding Crumb}" />
          </WrapPanel>

          <!-- The title: typed over to rename it -->
          <TextBox Name="Title" Classes="bare doc-title" Text="{Binding TitleText}" IsReadOnly="{Binding !CanRename}" Margin="0,10,0,0" MaxWidth="720" HorizontalAlignment="Left"
                   AutomationProperties.Name="Title" LostFocus="OnTitleLeft" KeyDown="OnTitleKey" />

          <!-- Notes | Transcript, and on the right the page's own tools -->
          <Grid Name="Tabs" ColumnDefinitions="Auto,*,Auto" Margin="0,22,0,0">
            <StackPanel Orientation="Horizontal">
              <Button Name="NotesTab" Classes="tab" Classes.on="{Binding ShowNotes}" Content="Notes" Command="{Binding NotesCommand}" />
              <Button Name="TranscriptTab" Classes="tab" Classes.on="{Binding ShowTranscript}" Content="{Binding TranscriptTab}" Command="{Binding TranscriptsCommand}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center" Margin="0,0,0,6">
              <!-- Only what the student wrote, without what was added from the recording (when something was) -->
              <Button Name="OnlyMine" Classes="switch" Classes.on="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).Notes.OnlyMine, FallbackValue=False}"
                      IsVisible="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).Notes.SomeMine, FallbackValue=False}"
                      Command="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).Notes.ToggleOnlyMineCommand, FallbackValue={x:Null}}"
                      ToolTip.Tip="Show only what you wrote, without what was added from the recording">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Classes="switch-track"><Border /></Border>
                  <TextBlock Text="Only my notes" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <!-- Recorded here: keep recording it, the new words going on the end of its transcript -->
              <Button Name="KeepRecording" Classes="link-btn" Command="{Binding ContinueCommand}" IsVisible="{Binding CanContinue}"
                      ToolTip.Tip="{Binding ContinueTip}"
                      AutomationProperties.Name="Keep recording">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Glyph="mic" Size="15" VerticalAlignment="Center" />
                  <TextBlock Text="Keep recording" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Name="Attach" Classes="link-btn"
                      Command="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).LectureFiles.AttachCommand, FallbackValue={x:Null}}"
                      IsVisible="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).HasLectureFiles}"
                      ToolTip.Tip="Attach your notes, slides or a handout (or drop files on the page)" AutomationProperties.Name="Attach">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Glyph="attach_file" Size="15" VerticalAlignment="Center" />
                  <TextBlock Text="Attach" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
          <Border Classes="rule" />

          <!-- What's attached to it (drop files anywhere on the page) -->
          <Panel IsVisible="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).LectureFiles.ShowHeader, FallbackValue=False}" Margin="0,14,0,0" MaxWidth="680" HorizontalAlignment="Left">
            <c:BySkin Name="LectureAttachments" Mac="{x:Type v:MacAttachments}" Win="{x:Type v:WinAttachments}"
                      DataContext="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).LectureFiles}" />
          </Panel>

          <!-- The notes: 68 characters wide (704), 16 on 26 -->
          <StackPanel Name="NotesBody" IsVisible="{Binding ShowNotes}" MaxWidth="704" HorizontalAlignment="Left" Margin="0,18,0,0">
            <!-- While it records: the student's own, kept as they type. A line that starts "# " becomes a heading,
                 "- " a bullet, as the space is typed. -->
            <StackPanel IsVisible="{Binding Typing}" Spacing="18">
              <c:TypedEditor Name="Typed" Text="{Binding Typed}" Placeholder="Your notes" MinHeight="120" />
              <TextBlock Name="TypedHint" Classes="notes-hint" Text="{Binding TypedHint}" />
            </StackPanel>
            <StackPanel IsVisible="{Binding Saved}" Spacing="14">
              <TextBlock Name="Pending" IsVisible="{Binding HasPending}" Text="{Binding Pending}" FontSize="14.5" LineHeight="22" Foreground="{DynamicResource InkMuted}" TextWrapping="Wrap" />
              <!-- A rewrite the library couldn't do: why, over the notes it left as they were -->
              <TextBlock Name="NotRewritten" IsVisible="{Binding WasNotRewritten}" Text="{Binding NotRewritten}" FontSize="14.5" LineHeight="22" Foreground="{DynamicResource InkMuted}" TextWrapping="Wrap" />
              <Panel IsVisible="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).HasNotes}">
                <c:BySkin Name="AiNotes" Mac="{x:Type v:MacAiNotes}" Win="{x:Type v:WinAiNotes}" DataContext="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).Notes}" />
              </Panel>
              <!-- No notes written (yet): what there is, which is what the student typed -->
              <StackPanel IsVisible="{Binding !$parent[UserControl].((vm:LibraryModel)DataContext).HasNotes}" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Mine}">
                  <Border Width="14" Height="3" CornerRadius="2" Background="{DynamicResource Ink}" VerticalAlignment="Center" />
                  <TextBlock Classes="legend mine" Text="What you wrote" />
                </StackPanel>
                <c:NoteView Markdown="{Binding Markdown}" Provenance="{Binding Mine}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <!-- The transcript: each line's time, then what was said; while it records, what's been heard so far. One drag
               selects from line to line, as the notes do; copied, a line taken from its start keeps its time. -->
          <StackPanel Name="TranscriptBody" IsVisible="{Binding ShowTranscript}" MaxWidth="704" HorizontalAlignment="Left" Margin="0,18,0,0"
                      c:TextSelection.Area="True">
            <TextBlock Name="NoTranscript" IsVisible="{Binding NoTranscript}" Text="{Binding NoTranscriptText}" FontSize="14.5" LineHeight="22" Foreground="{DynamicResource InkMuted}" TextWrapping="Wrap" />
            <ItemsControl Name="TranscriptLines" ItemsSource="{Binding Lines}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HeardLine">
                  <!-- The line a diagram pointed to ("where was this said"), marked -->
                  <Border Classes="heard" Classes.here="{Binding Here}">
                    <Grid ColumnDefinitions="Auto,*">
                      <Button Classes="heard-time num" Content="{Binding Time}" IsVisible="{Binding Time, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Click="OnTime"
                              AutomationProperties.Name="{Binding Time}" />
                      <c:PageText Grid.Column="1" Text="{Binding Text}" CopyLead="{Binding CopyLead}" FontSize="16" LineHeight="26.4" TextWrapping="Wrap" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- The page fades in under the toolbar, and out under the ask bar (or above the answer) -->
      <Border Name="TopFade" Height="20" VerticalAlignment="Top" IsHitTestVisible="False" />
      <!-- Notes | Transcript stay at the top once the page has scrolled past them (while it records, the time and a
           quiet dot too): switching never means scrolling back up. -->
      <Border Name="PinnedTabs" VerticalAlignment="Top" Background="{DynamicResource Surface}" IsVisible="False">
        <StackPanel Classes="np-page" Classes.narrow="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).Narrow}" Margin="0" DataContext="{Binding Note}" x:DataType="vm:NoteModel">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
              <Button Classes="tab" Classes.on="{Binding ShowNotes}" Content="Notes" Command="{Binding NotesCommand}" Click="OnPinnedTab" />
              <Button Classes="tab" Classes.on="{Binding ShowTranscript}" Content="{Binding TranscriptTab}" Command="{Binding TranscriptsCommand}" Click="OnPinnedTab" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,0,6" IsVisible="{Binding Live}">
              <Ellipse Width="8" Height="8" Fill="{DynamicResource Record}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Recorder.Elapsed, FallbackValue=''}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource InkMuted}" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
          <Border Classes="rule" />
        </StackPanel>
      </Border>
      <Border Name="Fade" Classes="fade" Classes.answer="{Binding HasAnswer}" VerticalAlignment="Bottom" IsHitTestVisible="False" IsVisible="{Binding HasAsk}" />
      <!-- A diagram showed where it was said: one click back to the notes, where the diagram is -->
      <Button Name="BackToNotes" Theme="{StaticResource Surface}" IsVisible="{Binding Note.CanGoBack, FallbackValue=False}"
              Command="{Binding Note.BackToNotesCommand, FallbackValue={x:Null}}" HorizontalAlignment="Center" VerticalAlignment="Top"
              Margin="0,16,0,0" Height="32" Padding="12,0,14,0" CornerRadius="{DynamicResource RadiusControl}" Background="{DynamicResource PopupBg}"
              BorderBrush="{DynamicResource PopupStroke}" BorderThickness="1" AutomationProperties.Name="Back to the notes">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <c:Icon Glyph="arrow_back" Size="15" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
          <TextBlock Text="Back to the notes" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Panel>

    <!-- The latest answer, just above the ask bar -->
    <Panel Name="AnswerRoom" Grid.Row="1" IsVisible="{Binding HasAnswer}" HorizontalAlignment="Center" Margin="0,8,0,84" ClipToBounds="False">
      <c:BySkin Mac="{x:Type v:MacAiAnswer}" Win="{x:Type v:WinAiAnswer}" DataContext="{Binding Ask}" />
    </Panel>

    <!-- Ask about this note (or, while it records, about what's been said so far), with any AI -->
    <Panel Name="AskRoom" Classes="np-ask" Classes.narrow="{Binding Narrow}" Grid.RowSpan="2" IsVisible="{Binding HasAsk}" VerticalAlignment="Bottom">
      <c:BySkin Name="AskBar" Mac="{x:Type v:MacAiAskBar}" Win="{x:Type v:WinAiAskBar}" DataContext="{Binding Ask}" />
    </Panel>
  </Grid>
</UserControl>
