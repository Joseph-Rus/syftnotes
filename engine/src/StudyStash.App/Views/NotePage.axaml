<!-- A note's page (both looks): a lecture, a meeting or a recording, filling the pane. Over the title, where it is (its
     folder, a link to that folder's page, and a chevron that moves it) and what it is ("Lecture, Monday 12 October at
     9:30 AM, 52 min"). The title is typed over to rename it. Under it Notes and Transcript, with "Only my notes" and
     Attach on the right. The notes are one document: what the student typed in ink, what was added from the recording
     in grey. While it records the page has the recording's bar at its top, the notes are the student's own typing,
     and the other tab is what's been heard so far. Ask floats at the foot; asked, the conversation opens beside the
     notes (AskSplit). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             xmlns:v="using:StudyStash.App.Views"
             x:Class="StudyStash.App.Views.NotePage"
             x:DataType="vm:LibraryModel">
  <UserControl.Styles>
    <!-- A lecture's Attach is the one beside its tabs: the attachments' own (a class page's) isn't shown twice. -->
    <Style Selector="c|BySkin#LectureAttachments Button#Attach">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- The page is one column the notes' width, centred in the pane however wide it is (the sidebar shut, a big
         screen); the ask bar keeps to the same column. -->
    <Style Selector="StackPanel.np-page">
      <Setter Property="Margin" Value="56,6,56,140" />
      <Setter Property="MaxWidth" Value="704" />
    </Style>
    <Style Selector="StackPanel.np-page.narrow">
      <Setter Property="Margin" Value="24,6,24,140" />
    </Style>
    <!-- Notes | Transcript pinned at the top keep to the column's sides. -->
    <Style Selector="StackPanel.np-pin">
      <Setter Property="Margin" Value="56,0" />
    </Style>
    <Style Selector="StackPanel.np-pin.narrow">
      <Setter Property="Margin" Value="24,0" />
    </Style>
    <!-- Beside the conversation the notes are a column of their own on the left, with no bar under them to make room
         for. -->
    <Style Selector="v|AskSplit:beside StackPanel.np-page">
      <Setter Property="Margin" Value="40,6,40,56" />
    </Style>
    <Style Selector="v|AskSplit:beside StackPanel.np-pin">
      <Setter Property="Margin" Value="40,0" />
    </Style>
    <!-- A transcript line a diagram pointed to: marked, a little room round it, the words where they were. -->
    <Style Selector="Border.heard">
      <Setter Property="Margin" Value="-8,-4" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.heard.here">
      <Setter Property="Background" Value="{DynamicResource Hover}" />
    </Style>
    <!-- A line's time: plain figures, and a button that plays the recording from there when it's on this computer. -->
    <Style Selector="Button.heard-time">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Width" Value="48" />
      <Setter Property="Margin" Value="0,3,12,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource InkSubtle}" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Button.heard-time /template/ Border#PART_Wash">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.heard-time:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <!-- The folder's name over the title: a link to its page. -->
    <Style Selector="Button.crumb-link">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="Button.crumb-link /template/ Border#PART_Wash">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.crumb-link:pointerover TextBlock">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
    <!-- The recording's dot, one of the s's cells, breathes while it records (not while paused, and not for someone who
         asked for less motion). -->
    <Style Selector="c|SyftCell.pulse">
      <Style.Animations>
        <Animation Duration="0:0:1.6" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- The notes fade out under the floating ask bar; beside the conversation there's no bar under them. -->
    <Style Selector="Border.fade">
      <Setter Property="Height" Value="120" />
    </Style>
    <Style Selector="v|AskSplit:open Border.fade">
      <Setter Property="Height" Value="0" />
    </Style>
  </UserControl.Styles>

  <!-- The notes, and Ask: at rest the bar floats at the foot of the notes (they fade out under it); once something's
       asked the notes keep the left and the conversation is a panel down the right, the bar docked at its foot. -->
  <v:AskSplit Name="Split" IsOpen="{Binding HasAnswer}" Narrow="{Binding Narrow}" BackWords="Notes"
              CloseCommand="{Binding Ask.CloseAnswerCommand, FallbackValue={x:Null}}">
    <v:AskSplit.Page>
    <Panel>
      <ScrollViewer Name="NoteScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasNote}">
        <StackPanel Name="Column" Classes="np-page" Classes.narrow="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).Narrow}" DataContext="{Binding Note}" x:DataType="vm:NoteModel">

          <!-- While it records: the bar. Pause keeps the file open; Stop ends the recording and starts the write-up. -->
          <Border Name="RecBar" Classes="recbar" IsVisible="{Binding Live}" Margin="0,2,0,26" AutomationProperties.Name="{Binding RecordingSaid}"
                  AutomationProperties.LiveSetting="Polite">
            <Grid ColumnDefinitions="Auto,10,Auto,10,Auto,12,Auto,*,Auto,8,Auto">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <!-- Listening: the Path Trace loader on its own dark tile, its trail running while it records and the
                     whole s lit while it's paused. -->
                <c:SyftLoader Kind="PathTrace" Size="38" IsActive="{Binding Recorder.IsRunning, FallbackValue=False}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                <c:SyftCell Width="10" Height="10" Fill="{DynamicResource Record}" Classes.pulse="{Binding Pulses}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding RecordingWord}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock Grid.Column="4" Classes="num" Text="{Binding Recorder.Elapsed, FallbackValue=''}" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource InkMuted}"
                         VerticalAlignment="Center" />
              <c:Waveform Grid.Column="6" Bars="5" Height="16" Lively="True" Levels="{Binding Recorder.Levels, FallbackValue={x:Null}}" Foreground="{DynamicResource Record}"
                          VerticalAlignment="Center" IsVisible="{Binding Recorder.IsRunning, FallbackValue=False}" />
              <Button Name="Pause" Grid.Column="8" Classes="btn sm" Command="{Binding Recorder.PauseCommand, FallbackValue={x:Null}}" AutomationProperties.Name="{Binding PauseWord}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Glyph="{Binding Recorder.PauseGlyph, FallbackValue=pause}" Size="14" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding PauseWord}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Name="Stop" Grid.Column="10" Classes="btn sm ink" Command="{Binding Recorder.StopCommand, FallbackValue={x:Null}}" AutomationProperties.Name="Stop recording"
                      ToolTip.Tip="{Binding StopTip}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Surface}" VerticalAlignment="Center" />
                  <TextBlock Text="Stop" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>

          <!-- Planned for a calendar event: when it starts, and Start now -->
          <Border Name="PlanBar" Classes="recbar" IsVisible="{Binding Planned}" Margin="0,2,0,26">
            <Grid ColumnDefinitions="Auto,14,*,14,Auto">
              <c:SyftCell Width="12" Height="12" Stroke="{DynamicResource Record}" StrokeThickness="2" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding PlanWords}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
              <Button Name="StartNow" Grid.Column="4" Classes="btn sm ink" Command="{Binding StartNowCommand}" AutomationProperties.Name="Start recording now">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <c:SyftCell Width="10" Height="10" Fill="{DynamicResource Record}" VerticalAlignment="Center" />
                  <TextBlock Text="Start now" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>

          <!-- Where it is, and what it is -->
          <WrapPanel Name="Crumb">
            <Button Name="FolderLink" Classes="crumb-link" IsVisible="{Binding HasClass}" Margin="0,0,10,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding FolderSaid}"
                    Command="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).OpenFolderCommand}" CommandParameter="{Binding ClassName}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:Swatch Fill="{Binding Dot}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ClassShown}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsUnsorted}" Margin="0,0,10,0" VerticalAlignment="Center">
              <c:Icon Glyph="inbox" Size="15" Foreground="{DynamicResource InkSubtle}" VerticalAlignment="Center" />
              <TextBlock Classes="unsorted" FontSize="14" Text="Unsorted" VerticalAlignment="Center" />
            </StackPanel>
            <Button Name="ChangeFolder" Classes="icon-btn sm" IsVisible="{Binding CanMove}" Margin="-4,0,6,0" VerticalAlignment="Center" Click="OnPickFolder"
                    ToolTip.Tip="Change folder" AutomationProperties.Name="Change folder">
              <c:Icon Glyph="expand_more" Size="14" />
            </Button>
            <c:PageText Name="CrumbWords" Classes="crumb" Text="{Binding Crumb}" />
          </WrapPanel>

          <!-- The title: typed over to rename it -->
          <TextBox Name="Title" Classes="bare doc-title" Text="{Binding TitleText}" IsReadOnly="{Binding !CanRename}" Margin="0,10,0,0" MaxWidth="720" HorizontalAlignment="Left"
                   AutomationProperties.Name="Title" LostFocus="OnTitleLeft" KeyDown="OnTitleKey" />

          <!-- Notes | Transcript, and on the right the page's own tools -->
          <Grid Name="Tabs" ColumnDefinitions="Auto,*,Auto" Margin="0,22,0,0">
            <StackPanel Orientation="Horizontal">
              <Button Name="NotesTab" Classes="tab" Classes.on="{Binding ShowNotes}" Content="Notes" Command="{Binding NotesCommand}" />
              <Button Name="TranscriptTab" Classes="tab" Classes.on="{Binding ShowTranscript}" Content="{Binding TranscriptTab}" Command="{Binding TranscriptsCommand}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center" Margin="0,0,0,6">
              <!-- Only what the student wrote, without what was added from the recording (when something was) -->
              <Button Name="OnlyMine" Classes="switch" Classes.on="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).Notes.OnlyMine, FallbackValue=False}"
                      IsVisible="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).Notes.SomeMine, FallbackValue=False}"
                      Command="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).Notes.ToggleOnlyMineCommand, FallbackValue={x:Null}}"
                      ToolTip.Tip="Show only what you wrote, without what was added from the recording">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Classes="switch-track"><Border /></Border>
                  <TextBlock Text="Only my notes" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <!-- Recorded here: keep recording it, the new words going on the end of its transcript -->
              <Button Name="KeepRecording" Classes="link-btn" Command="{Binding ContinueCommand}" IsVisible="{Binding CanContinue}"
                      ToolTip.Tip="{Binding ContinueTip}"
                      AutomationProperties.Name="Keep recording">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Glyph="mic" Size="15" VerticalAlignment="Center" />
                  <TextBlock Text="Keep recording" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Name="Attach" Classes="link-btn"
                      Command="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).LectureFiles.AttachCommand, FallbackValue={x:Null}}"
                      IsVisible="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).HasLectureFiles}"
                      ToolTip.Tip="Attach your notes, slides or a handout (or drop files on the page)" AutomationProperties.Name="Attach">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Glyph="attach_file" Size="15" VerticalAlignment="Center" />
                  <TextBlock Text="Attach" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
          <Border Classes="rule" />

          <!-- What's attached to it (drop files anywhere on the page) -->
          <Panel IsVisible="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).LectureFiles.ShowHeader, FallbackValue=False}" Margin="0,14,0,0" HorizontalAlignment="Stretch">
            <c:BySkin Name="LectureAttachments" Mac="{x:Type v:MacAttachments}" Win="{x:Type v:WinAttachments}"
                      DataContext="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).LectureFiles}" />
          </Panel>

          <!-- The notes: 68 characters wide (704), 16 on 26 -->
          <StackPanel Name="NotesBody" IsVisible="{Binding ShowNotes}" MaxWidth="704" HorizontalAlignment="Left" Margin="0,18,0,0">
            <!-- What the lecturer said is on the exam (and isn't), found in the transcript: each moment opens it there. -->
            <Panel IsVisible="{Binding !Typing}">
              <Border Name="ExamFlags" Classes="study-card" IsVisible="{Binding HasExamFlags}" Margin="0,0,0,22">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="Auto,8,*,Auto">
                    <c:Icon Glyph="school" Size="18" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="free-ai-lead" Text="{Binding ExamFlagsTitle}" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Classes="icon-btn sm" Command="{Binding ToggleExamFlagsCommand}" AutomationProperties.Name="{Binding ExamFlagsToggleSaid}"
                            ToolTip.Tip="{Binding ExamFlagsToggleSaid}">
                      <Panel>
                        <c:Icon Glyph="expand_less" Size="16" IsVisible="{Binding ExamFlagsOpen}" />
                        <c:Icon Glyph="expand_more" Size="16" IsVisible="{Binding !ExamFlagsOpen}" />
                      </Panel>
                    </Button>
                  </Grid>
                  <StackPanel Spacing="8" IsVisible="{Binding ExamFlagsOpen}">
                    <ItemsControl Name="ExamFlagLines" ItemsSource="{Binding ExamFlags}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExamFlagRow">
                          <Grid ColumnDefinitions="Auto,*">
                            <Button Classes="heard-time num" Content="{Binding Moment}" IsVisible="{Binding HasMoment}" Command="{Binding Open}"
                                    AutomationProperties.Name="{Binding MomentSaid}" ToolTip.Tip="{Binding MomentSaid}" />
                            <c:PageText Grid.Column="1" Text="{Binding Said}" FontSize="14.5" LineHeight="22" TextWrapping="Wrap" Foreground="{DynamicResource Ink}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Spacing="6" IsVisible="{Binding HasNotOnExam}">
                      <TextBlock Text="Said not to be on it" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource InkSubtle}" Margin="0,4,0,0" />
                      <ItemsControl Name="NotOnExamLines" ItemsSource="{Binding NotOnExam}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ExamFlagRow">
                            <Grid ColumnDefinitions="Auto,*">
                              <Button Classes="heard-time num" Content="{Binding Moment}" IsVisible="{Binding HasMoment}" Command="{Binding Open}"
                                      AutomationProperties.Name="{Binding MomentSaid}" ToolTip.Tip="{Binding MomentSaid}" />
                              <c:PageText Grid.Column="1" Text="{Binding Said}" FontSize="14.5" LineHeight="22" TextWrapping="Wrap" Foreground="{DynamicResource InkMuted}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Panel>
            <!-- The lecture's study tools: its cards in Review -->
            <Panel IsVisible="{Binding !Typing}">
              <StackPanel Name="LectureStudy" DataContext="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).LectureStudy}" x:DataType="vm:LectureStudyModel"
                          IsVisible="{Binding Available, FallbackValue=False}" Margin="0,0,0,22" Spacing="6">
                <WrapPanel>
                  <Button Name="MakeCards" Classes="btn sm" Margin="0,0,8,6" Command="{Binding MakeCardsCommand}" IsVisible="{Binding !HasCards}"
                          ToolTip.Tip="{Binding MakeTip}" AutomationProperties.Name="{Binding MakeSaid}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <c:SyftLoader Kind="HoppingBits" Size="14" IsActive="{Binding Making}" IsVisible="{Binding Making}" VerticalAlignment="Center" />
                      <c:Icon Glyph="history" Size="15" IsVisible="{Binding !Making}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding MakeSaid}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Name="ReviewLecture" Classes="btn sm" Margin="0,0,8,6" Command="{Binding ReviewCommand}" IsVisible="{Binding HasCards}"
                          ToolTip.Tip="Review this lecture's cards that are due" AutomationProperties.Name="{Binding CardsSaid}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <c:Icon Glyph="history" Size="15" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding CardsSaid}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </WrapPanel>
                <c:PageText Classes="free-ai-problem" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" />
              </StackPanel>
            </Panel>
            <!-- Listen: the lecture as a short conversation, made on a press and played here -->
            <Panel IsVisible="{Binding !Typing}">
              <StackPanel Name="Listen" DataContext="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).LectureStudy.Listen, FallbackValue={x:Null}}"
                          x:DataType="vm:ListenModel" IsVisible="{Binding Available, FallbackValue=False}" Margin="0,-14,0,22" Spacing="8">
                <Button Name="MakeListen" Classes="btn sm" HorizontalAlignment="Left" Command="{Binding MakeCommand}" IsVisible="{Binding CanMake}"
                        ToolTip.Tip="{Binding MakeTip}" AutomationProperties.Name="{Binding MakeSaid}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:Icon Glyph="headphones" Size="15" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding MakeSaid}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Making}">
                  <c:SyftLoader Kind="HoppingBits" Size="16" IsActive="{Binding Making}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding MakingSaid}" FontSize="13" Foreground="{DynamicResource InkMuted}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="600" />
                </StackPanel>
                <Border Name="Player" Classes="study-card" IsVisible="{Binding Ready}" Padding="14,10">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,6,Auto,12,*,12,Auto,8,Auto">
                      <Button Name="PlayListen" Classes="btn sm ink" Command="{Binding PlayPauseCommand}" AutomationProperties.Name="{Binding PlaySaid}" ToolTip.Tip="{Binding PlaySaid}">
                        <Panel>
                          <c:Icon Glyph="play_arrow" Size="16" IsVisible="{Binding !Playing}" />
                          <c:Icon Glyph="pause" Size="16" IsVisible="{Binding Playing}" />
                        </Panel>
                      </Button>
                      <Button Grid.Column="2" Classes="icon-btn sm" Command="{Binding BackCommand}" ToolTip.Tip="Back 15 seconds" AutomationProperties.Name="Back 15 seconds">
                        <c:Icon Glyph="undo" Size="15" />
                      </Button>
                      <ProgressBar Grid.Column="4" Minimum="0" Maximum="1" Value="{Binding Progress}" VerticalAlignment="Center" Height="4" MinHeight="4"
                                   Foreground="{DynamicResource Ink}" Background="{DynamicResource Line}" CornerRadius="2" />
                      <TextBlock Grid.Column="6" Text="{Binding Time}" FontSize="12" Classes="num" Foreground="{DynamicResource InkSubtle}" VerticalAlignment="Center" />
                      <Button Grid.Column="8" Classes="link-btn" Command="{Binding ToggleScriptCommand}" Content="{Binding ScriptToggleSaid}" VerticalAlignment="Center" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Script}" IsVisible="{Binding ScriptOpen}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScriptRow">
                          <Grid ColumnDefinitions="78,*">
                            <TextBlock Text="{Binding Who}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource InkSubtle}" Margin="0,2,0,0" />
                            <c:PageText Grid.Column="1" Text="{Binding Text}" FontSize="14" LineHeight="21" TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
                <c:PageText Classes="free-ai-problem" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" />
                <c:PageText Classes="free-ai-more" Text="{Binding CantSpeak}" IsVisible="{Binding ShowCantSpeak}" />
              </StackPanel>
            </Panel>
            <!-- While it records: the student's own, kept as they type, in Markdown that shows formatted. A line that
                 starts "# " becomes a heading, "- " a bullet, "[ ] " a checkbox, as the space is typed. -->
            <StackPanel IsVisible="{Binding Typing}" Spacing="18">
              <c:TypedEditor Name="Typed" Text="{Binding Typed}" Placeholder="Your notes" MinHeight="120" />
              <StackPanel Spacing="4">
                <TextBlock Name="TypedHint" Classes="notes-hint" Text="{Binding TypedHint}" />
                <TextBlock Name="FormatHint" Classes="notes-hint" FontSize="13" Text="{x:Static vm:NoteModel.FormatHint}" />
              </StackPanel>
            </StackPanel>
            <StackPanel IsVisible="{Binding Saved}" Spacing="14">
              <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasPending}">
                <c:SyftLoader Kind="PathTrace" Size="56" IsActive="{Binding Writing}" IsVisible="{Binding Writing}" Margin="0,0,18,0" VerticalAlignment="Center" />
                <c:PageText Grid.Column="1" Name="Pending" IsVisible="{Binding HasPending}" Text="{Binding Pending}" FontSize="14.5" LineHeight="22" Foreground="{DynamicResource InkMuted}" TextWrapping="Wrap"
                            VerticalAlignment="Center" />
              </Grid>
              <!-- A rewrite the library couldn't do: why, over the notes it left as they were -->
              <c:PageText Name="NotRewritten" IsVisible="{Binding WasNotRewritten}" Text="{Binding NotRewritten}" FontSize="14.5" LineHeight="22" Foreground="{DynamicResource InkMuted}" TextWrapping="Wrap" />
              <!-- Notes from an AI Syft Notes doesn't run: over a lecture with none, that the Claude app (or any free
                   chat) can write them, with Copy for your AI and Paste notes; a long lecture's copy a part at a time;
                   and the box a chat's notes are pasted into (from here, or the notes' ⋯ menu). -->
              <StackPanel Name="FreeAi" Spacing="12" DataContext="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).FreeAi}" x:DataType="vm:FreeAiModel"
                          IsVisible="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).FreeAi, Converter={x:Static ObjectConverters.IsNotNull}}">
                <!-- No AI writes notes yet: which, asked once, here. Continue with Google (Gemini, free with a personal
                     Google account) first; then all four AIs by name, Claude and ChatGPT for a paid plan, Gemini, and
                     Ollama (advanced, set up in Settings); and copy and paste as the quiet other free way. -->
                <Border Name="GetNotes" Classes="free-ai" IsVisible="{Binding ShowChoose}">
                  <StackPanel Spacing="8">
                    <TextBlock Name="GetNotesTitle" Classes="free-ai-lead" Text="{Binding ChooseTitle}" />
                    <TextBlock Classes="free-ai-more" Text="{x:Static vm:FreeAiModel.ChooseText}" />
                    <WrapPanel Margin="0,8,0,0" ItemSpacing="12" LineSpacing="6">
                      <Button Name="ContinueWithGoogle" Classes="btn ink" VerticalAlignment="Center" Command="{Binding ContinueWithGoogleCommand}"
                              Content="{x:Static vm:FreeAiModel.GoogleButton}" AutomationProperties.Name="{x:Static vm:FreeAiModel.GoogleButton}"
                              AutomationProperties.HelpText="{x:Static vm:FreeAiModel.GoogleBeside}" />
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <c:Icon Glyph="brand:gemini" Size="15" VerticalAlignment="Center" />
                        <TextBlock Name="GoogleBeside" Classes="free-ai-more" VerticalAlignment="Center" Text="{x:Static vm:FreeAiModel.GoogleBeside}" />
                      </StackPanel>
                    </WrapPanel>
                    <TextBlock Classes="free-ai-more" FontSize="12.5" Text="{x:Static vm:FreeAiModel.GoogleLine}" />
                    <WrapPanel Margin="0,8,0,0" ItemSpacing="8" LineSpacing="8">
                      <Button Name="UseClaude" Classes="btn sm" Command="{Binding UseClaudeCommand}" AutomationProperties.Name="Claude">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <c:Icon Glyph="brand:claude" Size="15" VerticalAlignment="Center" />
                          <TextBlock Text="Claude" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button Name="UseChatGpt" Classes="btn sm" Command="{Binding UseChatGptCommand}" AutomationProperties.Name="ChatGPT">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <c:Icon Glyph="brand:chatgpt" Size="15" VerticalAlignment="Center" />
                          <TextBlock Text="ChatGPT" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button Name="UseGemini" Classes="btn sm" Command="{Binding UseGeminiCommand}" AutomationProperties.Name="Gemini">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <c:Icon Glyph="brand:gemini" Size="15" VerticalAlignment="Center" />
                          <TextBlock Text="Gemini" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button Name="UseOllama" Classes="btn sm" Command="{Binding UseOllamaCommand}" AutomationProperties.Name="Ollama (advanced)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <c:Icon Glyph="brand:ollama" Size="15" VerticalAlignment="Center" />
                          <TextBlock Text="Ollama" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </WrapPanel>
                    <TextBlock Classes="free-ai-more" FontSize="12.5" Text="{x:Static vm:FreeAiModel.PaidLine}" />
                    <Button Name="OtherFreeWay" Classes="text-link small" HorizontalAlignment="Left" Margin="0,4,0,0" Command="{Binding ToggleCopyWayCommand}"
                            Content="{Binding OtherWayLabel}" />
                  </StackPanel>
                </Border>
                <!-- What stops the AIs being offered as they are: Google turned the account down (a school or work one),
                     or the AI is over its usage limit (its notes come by themselves once it's back). Copy and paste opens. -->
                <Border Name="NotesFallback" Classes="free-ai" IsVisible="{Binding ShowFallback}">
                  <StackPanel Spacing="8">
                    <TextBlock Name="FallbackTitle" Classes="free-ai-lead" Text="{Binding FallbackTitle}" />
                    <TextBlock Name="FallbackText" Classes="free-ai-more" Text="{Binding FallbackText}" />
                    <Button Name="GoogleAgain" Classes="btn sm ink" HorizontalAlignment="Left" Margin="0,6,0,0" Command="{Binding ContinueWithGoogleCommand}"
                            Content="{x:Static vm:FreeAiModel.GoogleButton}" IsVisible="{Binding ShowGoogleAgain}" />
                  </StackPanel>
                </Border>
                <!-- The other free way: copy this lecture for any free chat, and paste back what it writes. -->
                <Border Name="CopyWay" Classes="free-ai" IsVisible="{Binding ShowCopyWay}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="free-ai-more" Text="{x:Static vm:FreeAiModel.CopyWayText}" />
                    <WrapPanel Margin="0,4,0,0">
                      <Button Name="CopyWayCopy" Classes="btn sm" Margin="0,0,8,8" Command="{Binding CopyForAiCommand}" AutomationProperties.Name="Copy for your AI">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <c:Icon Glyph="content_copy" Size="15" VerticalAlignment="Center" />
                          <TextBlock Text="Copy for your AI" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button Name="CopyWayPaste" Classes="btn sm" Margin="0,0,8,8" Command="{Binding PasteCommand}" AutomationProperties.Name="Paste notes">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <c:Icon Glyph="content_paste" Size="15" VerticalAlignment="Center" />
                          <TextBlock Text="Paste notes" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Border Name="FreeAiOffer" Classes="free-ai" IsVisible="{Binding ShowOffer}">
                  <StackPanel Spacing="8">
                    <c:PageText Name="OfferLine" Classes="free-ai-lead" Text="{Binding OfferLine}" />
                    <c:PageText Classes="free-ai-more" Text="{x:Static vm:FreeAiModel.OfferMore}" />
                    <WrapPanel Margin="0,6,0,0">
                      <Button Name="CopyForAi" Classes="btn sm" Margin="0,0,8,8" Command="{Binding CopyForAiCommand}" AutomationProperties.Name="Copy for your AI"
                              ToolTip.Tip="Copies what to ask, and the transcript, for ChatGPT, Claude or Gemini on the web">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <c:Icon Glyph="content_copy" Size="15" VerticalAlignment="Center" />
                          <TextBlock Text="Copy for your AI" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button Name="PasteNotes" Classes="btn sm" Margin="0,0,8,8" Command="{Binding PasteCommand}" AutomationProperties.Name="Paste notes"
                              ToolTip.Tip="Paste the notes a chat wrote, and they become this lecture's notes">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <c:Icon Glyph="content_paste" Size="15" VerticalAlignment="Center" />
                          <TextBlock Text="Paste notes" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Border Name="CopyParts" Classes="free-ai" IsVisible="{Binding HasParts}">
                  <StackPanel Spacing="10">
                    <c:PageText Classes="free-ai-more" Text="{Binding PartsLine}" />
                    <ItemsControl ItemsSource="{Binding Parts}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CopyPart">
                          <Button Classes="btn sm" Margin="0,0,8,8" AutomationProperties.Name="{Binding Words, StringFormat='Copy {0}'}"
                                  Command="{Binding $parent[ItemsControl].((vm:FreeAiModel)DataContext).CopyPartOfCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <c:Icon Glyph="{Binding Glyph}" Size="15" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding Words}" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
                <c:PageText Name="FreeAiSaid" Classes="free-ai-more" Text="{Binding Say}" IsVisible="{Binding HasSay}" />
                <Border Name="PastePanel" Classes="free-ai" IsVisible="{Binding Pasting}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="free-ai-lead" Text="Paste the notes your AI wrote" />
                    <c:PageText Classes="free-ai-more" Text="{x:Static vm:FreeAiModel.PasteHint}" />
                    <c:PageText Classes="free-ai-more" Text="{Binding ReplacesWords}" IsVisible="{Binding HasReplacesWords}" />
                    <Border Classes="paste-box">
                      <TextBox Name="PasteBox" Classes="bare paste-box" Text="{Binding PasteText}" AcceptsReturn="True" TextWrapping="Wrap"
                               PlaceholderText="Paste here" AutomationProperties.Name="Notes to paste" />
                    </Border>
                    <c:PageText Classes="free-ai-problem" Text="{Binding PasteProblem}" IsVisible="{Binding HasPasteProblem}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                      <Button Name="CancelPaste" Classes="btn sm" Content="Cancel" Command="{Binding CancelPasteCommand}" />
                      <Button Name="SavePaste" Classes="btn sm ink" Content="Save notes" Command="{Binding SavePasteCommand}" IsEnabled="{Binding CanSavePaste}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
              <Panel IsVisible="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).HasNotes}">
                <c:BySkin Name="AiNotes" Mac="{x:Type v:MacAiNotes}" Win="{x:Type v:WinAiNotes}" DataContext="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).Notes}" />
              </Panel>
              <!-- No notes written (yet): what there is, which is what the student typed -->
              <StackPanel IsVisible="{Binding !$parent[UserControl].((vm:LibraryModel)DataContext).HasNotes}" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Mine}">
                  <Border Width="14" Height="3" CornerRadius="2" Background="{DynamicResource Ink}" VerticalAlignment="Center" />
                  <TextBlock Classes="legend mine" Text="What you wrote" />
                </StackPanel>
                <c:NoteView Markdown="{Binding Markdown}" Provenance="{Binding Mine}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <!-- The transcript: each line's time, then what was said; while it records, what's been heard so far. One drag
               selects from line to line, as the notes do; copied, a line taken from its start keeps its time. -->
          <StackPanel Name="TranscriptBody" IsVisible="{Binding ShowTranscript}" MaxWidth="704" HorizontalAlignment="Left" Margin="0,18,0,0"
                      c:TextSelection.Area="True">
            <TextBlock Name="NoTranscript" IsVisible="{Binding NoTranscript}" Text="{Binding NoTranscriptText}" FontSize="14.5" LineHeight="22" Foreground="{DynamicResource InkMuted}" TextWrapping="Wrap" />
            <ItemsControl Name="TranscriptLines" ItemsSource="{Binding Lines}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HeardLine">
                  <!-- The line a diagram pointed to ("where was this said"), marked -->
                  <Border Classes="heard" Classes.here="{Binding Here}">
                    <Grid ColumnDefinitions="Auto,*">
                      <Button Classes="heard-time num" Content="{Binding Time}" IsVisible="{Binding Time, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Click="OnTime"
                              AutomationProperties.Name="{Binding Time}" />
                      <c:PageText Grid.Column="1" Text="{Binding Text}" CopyLead="{Binding CopyLead}" FontSize="16" LineHeight="26.4" TextWrapping="Wrap" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- The page fades in under the toolbar, and out under the ask bar (or above the answer) -->
      <Border Name="TopFade" Height="20" VerticalAlignment="Top" IsHitTestVisible="False" />
      <!-- Notes | Transcript stay at the top once the page has scrolled past them (while it records, the time and a
           quiet dot too): switching never means scrolling back up. -->
      <Border Name="PinnedTabs" VerticalAlignment="Top" Background="{DynamicResource Surface}" IsVisible="False">
        <StackPanel Classes="np-page np-pin" Classes.narrow="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).Narrow}" DataContext="{Binding Note}" x:DataType="vm:NoteModel">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
              <Button Classes="tab" Classes.on="{Binding ShowNotes}" Content="Notes" Command="{Binding NotesCommand}" Click="OnPinnedTab" />
              <Button Classes="tab" Classes.on="{Binding ShowTranscript}" Content="{Binding TranscriptTab}" Command="{Binding TranscriptsCommand}" Click="OnPinnedTab" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,0,6" IsVisible="{Binding Live}">
              <c:SyftCell Width="8" Height="8" Fill="{DynamicResource Record}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Recorder.Elapsed, FallbackValue=''}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource InkMuted}" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
          <Border Classes="rule" />
        </StackPanel>
      </Border>
      <Border Name="Fade" Classes="fade" VerticalAlignment="Bottom" IsHitTestVisible="False" IsVisible="{Binding HasAsk}" />
      <!-- A diagram showed where it was said: one click back to the notes, where the diagram is -->
      <Button Name="BackToNotes" Theme="{StaticResource Surface}" IsVisible="{Binding Note.CanGoBack, FallbackValue=False}"
              Command="{Binding Note.BackToNotesCommand, FallbackValue={x:Null}}" HorizontalAlignment="Center" VerticalAlignment="Top"
              Margin="0,16,0,0" Height="32" Padding="12,0,14,0" CornerRadius="{DynamicResource RadiusControl}" Background="{DynamicResource PopupBg}"
              BorderBrush="{DynamicResource PopupStroke}" BorderThickness="1" AutomationProperties.Name="Back to the notes">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <c:Icon Glyph="arrow_back" Size="15" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
          <TextBlock Text="Back to the notes" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Panel>
    </v:AskSplit.Page>

    <!-- The conversation: its panel's header and thread -->
    <v:AskSplit.Chat>
      <c:BySkin Name="Answer" Mac="{x:Type v:MacAiAnswer}" Win="{x:Type v:WinAiAnswer}" DataContext="{Binding Ask}" />
    </v:AskSplit.Chat>

    <!-- Ask about this note (or, while it records, about what's been said so far), with any AI -->
    <v:AskSplit.Bar>
      <c:BySkin Name="AskBar" Mac="{x:Type v:MacAiAskBar}" Win="{x:Type v:WinAiAskBar}" DataContext="{Binding Ask}" IsVisible="{Binding $parent[UserControl].((vm:LibraryModel)DataContext).HasAsk, FallbackValue=False}" />
    </v:AskSplit.Bar>
  </v:AskSplit>
</UserControl>
