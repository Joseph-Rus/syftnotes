<!-- The Chats list of an Ask bar (both looks): this place's kept conversations, newest first, each named for its first
     question (until it's renamed) with when it was last added to and, on a folder's page or Home, which lecture or
     folder it's about. Pressing one opens it in the card to carry on; each can be renamed or deleted here. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             x:Class="StudyStash.App.Views.AiChatsMenu"
             x:DataType="vm:AiAskModel">
  <UserControl.Styles>
    <Style Selector="Border.chat-row">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Border.chat-row.current">
      <Setter Property="Background" Value="{DynamicResource Hover}" />
    </Style>
    <Style Selector="Button.chat-tool">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource PopupStroke}" BorderThickness="1" CornerRadius="14"
          BoxShadow="{DynamicResource PopupShadow}" Padding="6" Width="320">
    <StackPanel Spacing="2">
      <TextBlock Text="Chats" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Fg2}" Margin="10,4,10,4" />
      <TextBlock Text="No chats here yet. Ask a question to start one." FontSize="13" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap"
                 Margin="10,2,10,8" IsVisible="{Binding !HasChats}" />
      <ScrollViewer MaxHeight="340" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl Name="Rows" ItemsSource="{Binding Chats}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChatRow">
              <Border Classes="chat-row" Classes.current="{Binding Current}">
                <Grid ColumnDefinitions="*,4,Auto,Auto">
                  <Button Theme="{StaticResource Surface}" HorizontalContentAlignment="Stretch" Padding="0" Command="{Binding Open}"
                          AutomationProperties.Name="{Binding Title}" IsVisible="{Binding !Renaming}">
                    <StackPanel Spacing="1">
                      <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{DynamicResource Fg2}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Button>
                  <TextBox Name="NewName" Text="{Binding NewTitle}" IsVisible="{Binding Renaming}" FontSize="13" VerticalAlignment="Center"
                           AutomationProperties.Name="The chat's name">
                    <TextBox.KeyBindings>
                      <KeyBinding Gesture="Enter" Command="{Binding CommitRename}" />
                      <KeyBinding Gesture="Escape" Command="{Binding CancelRename}" />
                    </TextBox.KeyBindings>
                  </TextBox>
                  <Button Grid.Column="2" Classes="chat-tool" Command="{Binding Rename}" Click="RenameClicked" IsVisible="{Binding !Renaming}" AutomationProperties.Name="{Binding RenameSaid}">
                    <c:Icon Glyph="edit" Size="14" Foreground="{DynamicResource Fg2}" />
                  </Button>
                  <Button Grid.Column="2" Classes="chat-tool" Command="{Binding CommitRename}" IsVisible="{Binding Renaming}" AutomationProperties.Name="Save the name">
                    <c:Icon Glyph="check" Size="14" Foreground="{DynamicResource Fg2}" />
                  </Button>
                  <Button Grid.Column="3" Classes="chat-tool" Command="{Binding Delete}" AutomationProperties.Name="{Binding DeleteSaid}">
                    <c:Icon Glyph="delete" Size="14" Foreground="{DynamicResource Fg2}" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </StackPanel>
  </Border>
</UserControl>
