<!-- Guided setup (Liquid Glass): Pick your AI, Install, Sign in (720×480), then the chat with the checklist beside it
     (900×560). The same frame as setup by hand (MacSetup): an opaque window, the steps (or the checklist) on a floating
     glass panel, pill buttons, and "Set up by hand" as a quiet link at the foot of every screen. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             x:Class="StudyStash.App.Views.MacGuidedSetup"
             x:DataType="vm:GuidedSetupModel"
             Width="720" Height="480">
  <UserControl.Styles>
    <StyleInclude Source="avares://StudyStash/Views/MacAiStyles.axaml" />
    <Style Selector="Border#Chrome.chrome">
      <Setter Property="CornerRadius" Value="26" />
      <Setter Property="BoxShadow" Value="{DynamicResource WindowShadow}" />
    </Style>
    <Style Selector="Border.step">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.step.current">
      <Setter Property="Background" Value="{DynamicResource Fill2}" />
      <Setter Property="BoxShadow" Value="{DynamicResource EdgeSoft}" />
    </Style>
    <Style Selector="Border.step TextBlock.title">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    </Style>
    <Style Selector="Border.step.current TextBlock.title">
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.num">
      <Setter Property="BorderBrush" Value="{DynamicResource Fg3}" />
    </Style>
    <Style Selector="Border.step.current Border.num">
      <Setter Property="BorderBrush" Value="{DynamicResource Fg}" />
    </Style>
    <Style Selector="Border.num TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Fg3}" />
    </Style>
    <Style Selector="Border.step.current Border.num TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
    </Style>
    <Style Selector="Button.push">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.quiet">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.quiet TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.link TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.link c|Icon">
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    </Style>
    <!-- The two AIs: radio cards side by side, as the welcome's choices are drawn. -->
    <Style Selector="Button.card">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Height" Value="176" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="16,14,16,14" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="Background" Value="{DynamicResource Group}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="Button.card /template/ Border#PART_Bg">
      <Setter Property="BoxShadow" Value="{DynamicResource EdgeSoft}" />
    </Style>
    <Style Selector="Button.card.on">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Button.card TextBlock.about">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="LineHeight" Value="17" />
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.card TextBlock.plan">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="LineHeight" Value="17" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.radio">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="BorderBrush" Value="{DynamicResource Fg3}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.radio Ellipse">
      <Setter Property="Width" Value="6" />
      <Setter Property="Height" Value="6" />
      <Setter Property="Fill" Value="{DynamicResource OnAccent}" />
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.radio.on">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Border.radio.on Ellipse">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Background" Value="{DynamicResource AccentTint}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="c:Typography.Extra" Value="-0.39" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <Style Selector="TextBlock.lede">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="19.5" />
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxWidth" Value="420" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,10,0,0" />
    </Style>
    <Style Selector="TextBlock.note">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="LineHeight" Value="17" />
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxWidth" Value="420" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="TextBlock.status">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- A problem, the Mac's way: a warm line on the page's Group card, its icon in Warn. -->
    <Style Selector="Border.warm">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{DynamicResource Group}" />
      <Setter Property="BoxShadow" Value="{DynamicResource EdgeSoft}" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="MaxWidth" Value="440" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <!-- Details: the exact command and what it printed. -->
    <Style Selector="Border.mono">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource Fill}" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="MaxWidth" Value="440" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.mono SelectableTextBlock">
      <Setter Property="FontFamily" Value="SF Mono, Menlo, Consolas, monospace" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="LineHeight" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="ProgressBar.work">
      <Setter Property="Height" Value="6" />
      <Setter Property="MinHeight" Value="6" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="{DynamicResource Fill2}" />
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
      <Setter Property="MaxWidth" Value="440" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
  </UserControl.Styles>

  <Border Name="Chrome" Classes="chrome" Background="{DynamicResource Win}" ClipToBounds="True">
    <DockPanel>
      <c:WindowHeader Name="Header" DockPanel.Dock="Top" CanResize="False" Title="Set up Study Stash" />
      <Grid ColumnDefinitions="224,*">
        <!-- The steps before the chat, on the floating glass panel. -->
        <c:Glass CornerRadius="18" BoxShadow="{DynamicResource SideGlassShadow}" Padding="10,8,10,8" Margin="8,0,0,8">
          <Panel>
            <StackPanel Spacing="2" IsVisible="{Binding !OnChat}">
              <StackPanel Orientation="Horizontal" Spacing="6" Height="26" Margin="8,0,8,4">
                <c:Icon Glyph="auto_awesome" Size="16" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
                <TextBlock Text="Guided setup" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StepItem">
                    <Border Classes="step" Classes.current="{Binding Current}">
                      <Grid ColumnDefinitions="Auto,10,*">
                        <c:Icon IsVisible="{Binding Done}" Glyph="check_circle" Filled="True" Size="18" Foreground="{DynamicResource AccentText}" />
                        <Border IsVisible="{Binding ShowNumber}" Classes="num" Width="16" Height="16" Margin="1,0" CornerRadius="8" BorderThickness="1.5">
                          <TextBlock Text="{Binding Number}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="2" Classes="title" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <!-- CHAT-SIDEBAR -->
          </Panel>
        </c:Glass>

        <Panel Grid.Column="1">
          <!-- Pick your AI, Install, Sign in -->
          <DockPanel Margin="0,12,0,20" IsVisible="{Binding !OnChat}">
            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="40,0">
              <Button Name="ByHand" Classes="quiet" Command="{Binding ByHandCommand}"><TextBlock Text="Set up by hand" /></Button>
              <Button Name="Continue" Grid.Column="2" Classes="push tint" Command="{Binding ContinueCommand}" IsEnabled="{Binding CanContinue}">
                <TextBlock Text="Continue" FontSize="13" FontWeight="Medium" />
              </Button>
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="40,0,40,12">
                <TextBlock Text="{Binding StepLabel}" IsVisible="{Binding HasStepLabel}" FontSize="12" Foreground="{DynamicResource Fg2}" />

                <!-- Screen 1 · Pick your AI -->
                <StackPanel IsVisible="{Binding OnPick}">
                  <TextBlock Classes="h1" Text="{Binding PickTitle}" Margin="0,18,0,0" />
                  <TextBlock Classes="lede" Text="{x:Static vm:GuidedSetupModel.PickLede}" />
                  <Grid ColumnDefinitions="*,12,*" Margin="0,18,0,0" MaxWidth="440" HorizontalAlignment="Stretch">
                    <Panel>
                      <Button Name="PickClaude" Classes="card" Classes.on="{Binding PickedClaude}" Command="{Binding PickCommand}" CommandParameter="claude">
                        <StackPanel Spacing="6">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Claude" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Classes="radio" Classes.on="{Binding PickedClaude}"><Ellipse /></Border>
                          </Grid>
                          <TextBlock Classes="about" Text="Uses Claude Code, from Anthropic." />
                          <TextBlock Classes="plan" Text="Needs a paid Claude plan: Pro or Max." />
                          <Border Classes="badge" IsVisible="{Binding ClaudeHere}" HorizontalAlignment="Left" Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                              <c:Icon Glyph="check" Size="11" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding AlreadyHere}" />
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </Button>
                      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom" Margin="16,0,16,14">
                        <Button Classes="link" Command="{Binding OpenPlansCommand}" CommandParameter="claude">
                          <StackPanel Orientation="Horizontal" Spacing="3">
                            <TextBlock Text="What's Claude Pro?" />
                            <c:Icon Glyph="arrow_outward" Size="12" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Panel>
                    <Panel Grid.Column="2">
                      <Button Name="PickCodex" Classes="card" Classes.on="{Binding PickedCodex}" Command="{Binding PickCommand}" CommandParameter="codex">
                        <StackPanel Spacing="6">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="ChatGPT" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Classes="radio" Classes.on="{Binding PickedCodex}"><Ellipse /></Border>
                          </Grid>
                          <TextBlock Classes="about" Text="Uses Codex, from OpenAI." />
                          <TextBlock Classes="plan" Text="Needs a paid ChatGPT plan: Plus or higher." />
                          <Border Classes="badge" IsVisible="{Binding CodexHere}" HorizontalAlignment="Left" Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                              <c:Icon Glyph="check" Size="11" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding AlreadyHere}" />
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </Button>
                      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom" Margin="16,0,16,14">
                        <Button Classes="link" Command="{Binding OpenPlansCommand}" CommandParameter="codex">
                          <StackPanel Orientation="Horizontal" Spacing="3">
                            <TextBlock Text="What's ChatGPT Plus?" />
                            <c:Icon Glyph="arrow_outward" Size="12" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Panel>
                  </Grid>
                  <Button Name="Ollama" Classes="quiet" Margin="0,16,0,0" HorizontalAlignment="Left" Command="{Binding UseOllamaCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <TextBlock Text="{Binding OllamaLine}" FontSize="12" />
                      <c:Icon Glyph="chevron_right" Size="14" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </StackPanel>

                <!-- Screen 2 · Install -->
                <StackPanel IsVisible="{Binding OnInstall}">
                  <TextBlock Classes="h1" Text="{Binding InstallTitle}" />
                  <TextBlock Classes="lede" Text="{Binding InstallLede}" />
                  <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,22,0,0" IsVisible="{Binding ShowInstallButton}">
                    <Button Name="Install" Classes="push tint" Command="{Binding InstallCommand}">
                      <TextBlock Text="{Binding InstallButton}" FontSize="13" FontWeight="Medium" />
                    </Button>
                    <TextBlock Text="{Binding InstallSource}" FontSize="12" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="230" />
                  </StackPanel>
                  <StackPanel Spacing="10" Margin="0,24,0,0" IsVisible="{Binding Installing}">
                    <ProgressBar Classes="work" IsIndeterminate="True" />
                    <TextBlock Text="{Binding Phase}" FontSize="12" Foreground="{DynamicResource Fg2}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,24,0,0" IsVisible="{Binding ShowInstalled}">
                    <c:Icon Glyph="check_circle" Filled="True" Size="18" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" />
                    <TextBlock Classes="status" Text="{Binding InstalledWords}" />
                  </StackPanel>
                  <Border Classes="warm" Margin="0,20,0,0" IsVisible="{Binding HasInstallProblem}">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="Auto,10,*">
                        <c:Icon Glyph="warning" Filled="True" Size="18" Foreground="{DynamicResource Warn}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="2" Classes="status" Text="{Binding InstallProblem}" />
                      </Grid>
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="28,0,0,0">
                        <Button Classes="push fill" Command="{Binding TryAgainCommand}" Height="28"><TextBlock Text="Try again" FontSize="12" /></Button>
                        <Button Classes="push fill" Command="{Binding UseOtherCommand}" IsVisible="{Binding InstallRegion}" Height="28"><TextBlock Text="{Binding UseOtherLabel}" FontSize="12" /></Button>
                        <Button Classes="push fill" Command="{Binding UseOllamaCommand}" IsVisible="{Binding InstallRegion}" Height="28"><TextBlock Text="Use a free model instead" FontSize="12" /></Button>
                        <Button Classes="link" Command="{Binding OpenDocsCommand}" IsVisible="{Binding InstallOther}">
                          <StackPanel Orientation="Horizontal" Spacing="3"><TextBlock Text="Install it yourself" /><c:Icon Glyph="arrow_outward" Size="12" /></StackPanel>
                        </Button>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Button Classes="link" Margin="0,14,0,0" Command="{Binding ToggleDetailsCommand}">
                    <TextBlock Text="Details" />
                  </Button>
                  <Border Classes="mono" Margin="0,8,0,0" IsVisible="{Binding ShowDetails}">
                    <StackPanel Spacing="6">
                      <SelectableTextBlock Text="{Binding InstallLine}" FontWeight="SemiBold" />
                      <SelectableTextBlock Text="{Binding InstallOutput}" MaxHeight="120" />
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- Screen 3 · Sign in -->
                <StackPanel IsVisible="{Binding OnSignIn}">
                  <TextBlock Classes="h1" Text="{Binding SignInTitle}" />
                  <TextBlock Classes="lede" Text="{Binding SignInLede}" />
                  <Button Name="OpenSignIn" Classes="push tint" HorizontalAlignment="Left" Margin="0,22,0,0" Command="{Binding OpenSignInCommand}" IsVisible="{Binding ShowOpenSignIn}">
                    <TextBlock Text="Open sign-in page" FontSize="13" FontWeight="Medium" />
                  </Button>
                  <StackPanel Spacing="6" Margin="0,22,0,0" IsVisible="{Binding WaitingSignIn}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <c:Icon Glyph="hourglass_top" Size="16" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
                      <TextBlock Classes="status" Text="Waiting for you to sign in…" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="24,0,0,0">
                      <TextBlock Text="Didn't open?" FontSize="12" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
                      <Button Classes="link" Command="{Binding OpenAgainCommand}"><TextBlock Text="Open it again" /></Button>
                      <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource Fg3}" VerticalAlignment="Center" />
                      <Button Classes="link" Command="{Binding SignInInTerminalCommand}"><TextBlock Text="Sign in in Terminal instead" /></Button>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,22,0,0" IsVisible="{Binding ShowCheckingPlan}">
                    <c:Icon Glyph="check_circle" Filled="True" Size="18" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" />
                    <TextBlock Classes="status" Text="{Binding CheckingWords}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,22,0,0" IsVisible="{Binding ShowReady}">
                    <c:Icon Glyph="check_circle" Filled="True" Size="18" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" />
                    <TextBlock Classes="status" Text="{Binding ReadyWords}" FontWeight="SemiBold" />
                  </StackPanel>
                  <Border Classes="warm" Margin="0,16,0,0" IsVisible="{Binding HasSignInProblem}">
                    <Grid ColumnDefinitions="Auto,10,*,10,Auto">
                      <c:Icon Glyph="warning" Filled="True" Size="18" Foreground="{DynamicResource Warn}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Classes="status" Text="{Binding SignInProblem}" />
                      <Button Grid.Column="4" Classes="push fill" Height="28" Command="{Binding OpenSignInCommand}"><TextBlock Text="Try again" FontSize="12" /></Button>
                    </Grid>
                  </Border>
                  <Border Classes="warm" Margin="0,16,0,0" IsVisible="{Binding HasPlanProblem}">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="Auto,10,*">
                        <c:Icon Glyph="warning" Filled="True" Size="18" Foreground="{DynamicResource Warn}" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="2" Spacing="2">
                          <TextBlock Classes="status" Text="{Binding PlanProblemTitle}" FontWeight="SemiBold" />
                          <TextBlock Classes="note" Text="{Binding PlanProblemText}" IsVisible="{Binding PlanProblemText, Converter={x:Static c:Converters.NotEmpty}}" />
                        </StackPanel>
                      </Grid>
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="28,0,0,0">
                        <Button Classes="push tint" Height="28" Command="{Binding OpenPlansCommand}" CommandParameter="" IsVisible="{Binding PlanIsPlan}">
                          <StackPanel Orientation="Horizontal" Spacing="3"><TextBlock Text="See plans" FontSize="12" /><c:Icon Glyph="arrow_outward" Size="12" Foreground="{DynamicResource OnAccent}" /></StackPanel>
                        </Button>
                        <Button Classes="push fill" Height="28" Command="{Binding CheckAgainCommand}"><TextBlock Text="Check again" FontSize="12" /></Button>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="4" Margin="28,0,0,0">
                        <Button Classes="link" Command="{Binding UseOtherCommand}"><TextBlock Text="{Binding UseOtherLabel}" /></Button>
                        <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource Fg3}" VerticalAlignment="Center" />
                        <Button Classes="link" Command="{Binding UseOllamaCommand}"><TextBlock Text="Use a free model instead" /></Button>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <StackPanel Spacing="4" Margin="0,24,0,0">
                    <TextBlock Classes="note" Text="{Binding Privacy}" />
                    <TextBlock Classes="note" Text="{Binding PlanNote}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
          <!-- CHAT -->
        </Panel>
      </Grid>
    </DockPanel>
  </Border>
</UserControl>
