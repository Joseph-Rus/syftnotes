<!-- The panes Settings hosts (Your AI, AI apps, Canvas, the shortcuts), in Settings' look: the library window's, as
     setup's is (SetupStyles). Every selector starts at ".in-settings", the class SettingsView carries, so the same panes
     and pieces elsewhere (Canvas's state atop Due, the course picker in setup's Canvas step, the shortcuts on setup's
     last page) keep their own look. Each pane includes it after its look's own styles (MacAiStyles, WinAiStyles,
     MacCanvasStyles, WinCanvasStyles), whose classes it restyles, so it wins over them; SettingsView includes it for
     the pieces every page shares (the switch, the keyboard's focus). The same in both looks. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:StudyStash.App.Controls">

  <!-- ===== What every page shares ===== -->

  <!-- A switch: the library's (grey off, ink on), as a ToggleButton. Its focus is a ring round the track. -->
  <Style Selector=".in-settings ToggleButton.switch">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="Ring" Margin="-4" CornerRadius="15" BorderThickness="2" BorderBrush="{DynamicResource Focus}" IsVisible="False" />
          <Border Name="Track" CornerRadius="11" Background="{DynamicResource Line}" />
          <Border Name="Knob" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource Surface}"
                  HorizontalAlignment="Left" Margin="2,0,0,0" BoxShadow="0 1 2 0 #40000000" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector=".in-settings ToggleButton.switch:checked /template/ Border#Track">
    <Setter Property="Background" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector=".in-settings ToggleButton.switch:checked /template/ Border#Knob">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,0,2,0" />
  </Style>
  <Style Selector=".in-settings ToggleButton.switch:focus-visible /template/ Border#Ring">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector=".in-settings ToggleButton.switch:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- ===== Your AI and AI apps (MacAiEngines, WinAiEngines, MacAiAccess, WinAiAccess, the problems over them) ===== -->

  <!-- The page's title and the sentence under it; a part's heading; grey words under a part. -->
  <Style Selector=".in-settings TextBlock.ai-title">
    <Setter Property="FontFamily" Value="{DynamicResource TextFont}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="LineHeight" Value="36" />
    <Setter Property="LetterSpacing" Value="-0.6" />
  </Style>
  <Style Selector=".in-settings TextBlock.ai-sub">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
  </Style>
  <Style Selector=".in-settings TextBlock.ai-sub.lede">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="MaxWidth" Value="560" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector=".in-settings TextBlock.ai-section">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="LetterSpacing" Value="-0.17" />
  </Style>
  <!-- A group of rows (Mac) or a row on its own (Windows): a white panel, its hairline a border inside it. -->
  <Style Selector=".in-settings Border.ai-group">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector=".in-settings Border.ai-card">
    <Setter Property="MinHeight" Value="62" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16,10" />
  </Style>
  <Style Selector=".in-settings Border.ai-sep">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Line}" />
  </Style>
  <Style Selector=".in-settings TextBlock.ai-row-title">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="20" />
  </Style>
  <Style Selector=".in-settings TextBlock.ai-row-sub">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
  </Style>
  <Style Selector=".in-settings TextBlock.ai-state">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
  </Style>
  <Style Selector=".in-settings TextBlock.ai-state.warn">
    <Setter Property="Foreground" Value="{DynamicResource Warn}" />
  </Style>
  <!-- An AI's icon: on the sunken grey, the control's corners. -->
  <Style Selector=".in-settings Border.ai-tile">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
  </Style>
  <Style Selector=".in-settings Border.ai-num">
    <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
  </Style>

  <!-- A button: Styles.axaml's small pill (btn sm): white with a hairline, 34 tall, its words bold; the part's main
       one ink. Its hairline is a border inside it (the button round it would cut a ring off); under the pointer the
       hairline darkens, as the library's does, with no wash. -->
  <Style Selector=".in-settings Button.ai-pillbtn">
    <Setter Property="CornerRadius" Value="17" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>
  <Style Selector=".in-settings Border.ai-pill">
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="17" />
    <Setter Property="Padding" Value="13,0" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector=".in-settings Border.ai-pill > TextBlock, .in-settings Border.ai-pill > StackPanel > TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector=".in-settings Button.ai-pillbtn:pointerover Border.ai-pill">
    <Setter Property="BorderBrush" Value="{DynamicResource InkSubtle}" />
  </Style>
  <Style Selector=".in-settings Border.ai-pill.primary, .in-settings Button.ai-pillbtn:pointerover Border.ai-pill.primary">
    <Setter Property="Background" Value="{DynamicResource Ink}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="14,0" />
  </Style>
  <Style Selector=".in-settings Border.ai-pill.primary > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Surface}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector=".in-settings Button.ai-pillbtn:pointerover Border.ai-pill.primary">
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <!-- A link in words (Sign in, Add another AI, Get a key, Look again, Copy setup): the library's text-link, muted and
       bold over a grey underline, both ink under the pointer, no wash. (A plain pill inside a link is only its words.) -->
  <Style Selector=".in-settings Button.ai-textbtn:not(.ai-choice)">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Padding" Value="0,0,0,2" />
    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector=".in-settings Button.ai-textbtn:not(.ai-choice) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>
  <Style Selector=".in-settings Button.ai-textbtn:not(.ai-choice):pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector=".in-settings Button.ai-textbtn:not(.ai-choice):pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector=".in-settings Border.ai-pill-plain">
    <Setter Property="Height" Value="NaN" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector=".in-settings Border.ai-pill-plain > TextBlock, .in-settings TextBlock.ai-link">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
  </Style>
  <Style Selector=".in-settings Button:pointerover Border.ai-pill-plain > TextBlock, .in-settings Button:pointerover TextBlock.ai-link">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector=".in-settings Button.ai-textbtn:not(.ai-choice) /template/ Border#PART_Wash, .in-settings Button.ai-pillbtn /template/ Border#PART_Wash">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <!-- A menu's button: the choice in ink and a chevron, in a hairline, the control's corners (the library's picker). -->
  <Style Selector=".in-settings Button.ai-select-btn">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
  </Style>
  <Style Selector=".in-settings Border.ai-select">
    <Setter Property="Height" Value="34" />
    <Setter Property="Width" Value="210" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,0,8,0" />
  </Style>
  <Style Selector=".in-settings Border.ai-select TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector=".in-settings Button.ai-select-btn:pointerover Border.ai-select">
    <Setter Property="BorderBrush" Value="{DynamicResource InkSubtle}" />
  </Style>
  <!-- A field (the web address, a key): white with a hairline, the control's corners. -->
  <Style Selector=".in-settings Border.ai-field">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BoxShadow" Value="none" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <!-- Ticks and radios: grey rims, ink once on (the colour theme no longer reaches them). -->
  <Style Selector=".in-settings Border.ai-check, .in-settings Border.ai-radio">
    <Setter Property="BorderBrush" Value="{DynamicResource InkSubtle}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector=".in-settings Border.ai-check.on, .in-settings Border.ai-radio.on">
    <Setter Property="Background" Value="{DynamicResource Ink}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector=".in-settings Button.ai-choice:pointerover Border.ai-check:not(.on), .in-settings Button.ai-choice:pressed Border.ai-check:not(.on)">
    <Setter Property="BorderBrush" Value="{DynamicResource InkMuted}" />
  </Style>
  <!-- Something wrong with an AI: setup's problem, its words beside the icon on the sunken grey. -->
  <Style Selector=".in-settings Border.ai-problem, .in-settings Border.ai-problem.err, .in-settings Border.ai-problem.warn, .in-settings Border.ai-problem.info">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector=".in-settings TextBlock.ai-problem-caption">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource InkSubtle}" />
  </Style>
  <Style Selector=".in-settings TextBlock.ai-problem-title">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector=".in-settings TextBlock.ai-problem-message">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
  </Style>
  <Style Selector=".in-settings TextBlock.ai-problem-text">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
  </Style>
  <Style Selector=".in-settings c|Icon.ai-problem-icon.accent">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>

  <!-- ===== The shortcuts (ShortcutsEditor, in General) ===== -->

  <Style Selector=".in-settings Border.sk-group">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector=".in-settings Border.sk-row">
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="MinHeight" Value="58" />
  </Style>
  <Style Selector=".in-settings Border.sk-sep">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Line}" />
  </Style>
  <Style Selector=".in-settings TextBlock.sk-title">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="20" />
  </Style>
  <Style Selector=".in-settings TextBlock.sk-sub">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
  </Style>
  <!-- The keys: a small white pill with a hairline (inside it, as a button cuts a ring off); listening, ink. -->
  <Style Selector=".in-settings Button.sk-keys">
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="17" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector=".in-settings Button.sk-keys:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource InkSubtle}" />
  </Style>
  <Style Selector=".in-settings Button.sk-keys /template/ Border#PART_Wash">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector=".in-settings Button.sk-keys.listening">
    <Setter Property="Background" Value="{DynamicResource Ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
    <Setter Property="Foreground" Value="{DynamicResource Surface}" />
  </Style>
  <Style Selector=".in-settings Button.sk-link">
    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector=".in-settings Button.sk-link:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>

  <!-- ===== Canvas (MacCanvasSettings, WinCanvasSettings, the state and course picker in them) ===== -->

  <!-- The title and the sentence under it, a part's heading: as every other page's. -->
  <Style Selector=".in-settings TextBlock.cv-h1">
    <Setter Property="FontFamily" Value="{DynamicResource TextFont}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="LineHeight" Value="36" />
    <Setter Property="LetterSpacing" Value="-0.6" />
  </Style>
  <Style Selector=".in-settings TextBlock.cv-intro">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
    <Setter Property="MaxWidth" Value="560" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector=".in-settings TextBlock.cv-h2">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="LetterSpacing" Value="-0.17" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <!-- Its groups: white panels, hairlines round them and between their rows (Windows' rows each their own panel). -->
  <Style Selector=".in-settings Border.cv-group, .in-settings Border.cv-item">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector=".in-settings Border.cv-sep, .in-settings Border.pk-sep">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Line}" />
  </Style>
  <Style Selector=".in-settings Grid.cv-row">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Margin" Value="16,10" />
  </Style>
  <Style Selector=".in-settings TextBlock.cv-value">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
  </Style>
  <Style Selector=".in-settings TextBlock.cv-label">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector=".in-settings TextBlock.cv-dot-label, .in-settings TextBlock.pk-title">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector=".in-settings TextBlock.pk-detail, .in-settings TextBlock.cv-scout">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
  </Style>
  <Style Selector=".in-settings TextBlock.pk-why">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource InkSubtle}" />
  </Style>
  <Style Selector=".in-settings Grid.pk-row">
    <Setter Property="Height" Value="52" />
  </Style>
  <Style Selector=".in-settings TextBlock.cv-change">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <!-- A link in words (Find my courses again): muted and bold, ink under the pointer. -->
  <Style Selector=".in-settings TextBlock.cv-link">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
  </Style>
  <Style Selector=".in-settings Button:pointerover TextBlock.cv-link">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <!-- Canvas's state when something needs doing: setup's problem, on the sunken grey. -->
  <Style Selector=".in-settings Border.cv-card, .in-settings Border.cv-bar">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector=".in-settings TextBlock.cv-title">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector=".in-settings TextBlock.cv-text">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
  </Style>
  <Style Selector=".in-settings c|Icon.cv-glyph.cv-error">
    <Setter Property="Foreground" Value="{DynamicResource Warn}" />
  </Style>
  <Style Selector=".in-settings Border.cv-bar-fill">
    <Setter Property="Background" Value="{DynamicResource Ink}" />
  </Style>
  <!-- Its buttons: Styles.axaml's small pills (white with a hairline, the main one ink, a plain one only words). -->
  <Style Selector=".in-settings Button.cv-pill, .in-settings Button.cv-btn">
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="17" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>
  <Style Selector=".in-settings Button.cv-pill TextBlock, .in-settings Button.cv-btn TextBlock">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector=".in-settings Button.cv-pill /template/ Border#PART_Wash, .in-settings Button.cv-btn /template/ Border#PART_Wash">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector=".in-settings Button.cv-pill:pointerover, .in-settings Button.cv-btn:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource InkSubtle}" />
  </Style>
  <Style Selector=".in-settings Button.cv-pill.cv-primary, .in-settings Button.cv-btn.cv-primary">
    <Setter Property="Background" Value="{DynamicResource Ink}" />
    <Setter Property="Foreground" Value="{DynamicResource Surface}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector=".in-settings Button.cv-pill.cv-primary:pointerover, .in-settings Button.cv-btn.cv-primary:pointerover">
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector=".in-settings Button.cv-pill.cv-mini, .in-settings Button.cv-btn.cv-mini">
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="Padding" Value="12,0" />
  </Style>
  <!-- A plain one (Set up, Change browser, Cancel): only its words, underlined, as a text-link. -->
  <Style Selector=".in-settings Button.cv-pill.cv-plain">
    <Setter Property="Height" Value="NaN" />
    <Setter Property="Padding" Value="0,0,0,2" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>
  <Style Selector=".in-settings Button.cv-pill.cv-plain:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
  </Style>
  <!-- Its menus' buttons and fields: a hairline, the control's corners. -->
  <Style Selector=".in-settings Button.cv-select">
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    <Setter Property="Padding" Value="12,0,8,0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector=".in-settings Button.cv-select:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource InkSubtle}" />
  </Style>
  <Style Selector=".in-settings Button.cv-select-item">
    <Setter Property="Height" Value="32" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
  </Style>
  <Style Selector=".in-settings Border.cv-field">
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BoxShadow" Value="none" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector=".in-settings Border.cv-field:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
  </Style>

  <!-- ===== Keyboard focus ===== -->

  <!-- The library's pills show no outline when the keyboard reaches them; Settings' do, as setup's: 2 px in the focus
       colour, 2 px out from the edge, round the pill or the words. (Last in the file, so it wins over the styles above
       that hide the wash it's drawn on.) -->
  <Style Selector=".in-settings Button.btn:focus-visible /template/ Border#PART_Wash, .in-settings Button.text-link:focus-visible /template/ Border#PART_Wash, .in-settings Button.ai-pillbtn:focus-visible /template/ Border#PART_Wash, .in-settings Button.ai-textbtn:not(.ai-choice):focus-visible /template/ Border#PART_Wash, .in-settings Button.cv-pill:focus-visible /template/ Border#PART_Wash, .in-settings Button.cv-btn:focus-visible /template/ Border#PART_Wash, .in-settings Button.sk-keys:focus-visible /template/ Border#PART_Wash">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Focus}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Margin" Value="-4" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector=".in-settings Button.btn.sm:focus-visible /template/ Border#PART_Wash, .in-settings Button.ai-pillbtn:focus-visible /template/ Border#PART_Wash, .in-settings Button.cv-pill:focus-visible /template/ Border#PART_Wash, .in-settings Button.cv-btn:focus-visible /template/ Border#PART_Wash, .in-settings Button.sk-keys:focus-visible /template/ Border#PART_Wash">
    <Setter Property="CornerRadius" Value="21" />
  </Style>
  <Style Selector=".in-settings Button.text-link:focus-visible /template/ Border#PART_Wash, .in-settings Button.ai-textbtn:not(.ai-choice):focus-visible /template/ Border#PART_Wash, .in-settings Button.cv-pill.cv-plain:focus-visible /template/ Border#PART_Wash">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Margin" Value="-6,-3,-6,-3" />
  </Style>
</Styles>
