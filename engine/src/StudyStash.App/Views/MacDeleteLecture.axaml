<!-- "Delete this lecture?": asked in the library window before a lecture goes, over the page. Cancel and Delete sit
     right, one height, on one line; Escape cancels. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             x:Class="StudyStash.App.Views.MacDeleteLecture"
             x:DataType="vm:LibraryModel"
             ClipToBounds="False">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelDeleteCommand}" />
  </UserControl.KeyBindings>
  <UserControl.Styles>
    <Style Selector="Button.dialog">
      <Setter Property="Theme" Value="{StaticResource Surface}" />
      <Setter Property="Height" Value="30" />
      <Setter Property="MinWidth" Value="84" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{DynamicResource Rec}" />
    </Style>
  </UserControl.Styles>

  <Border Width="360" Padding="20,18,20,16" CornerRadius="20" Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource PopupStroke}"
          BorderThickness="1" BoxShadow="{DynamicResource PopupShadow}">
    <StackPanel Spacing="8">
      <TextBlock Text="Delete this lecture?" FontFamily="{DynamicResource DisplayFont}" FontSize="15" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Deleting.Warning, FallbackValue=''}" FontSize="13" LineHeight="18" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,10,0,0">
        <Button Name="Cancel" Classes="dialog fill2" Command="{Binding CancelDeleteCommand}">
          <TextBlock Text="Cancel" FontSize="13" FontWeight="Medium" />
        </Button>
        <Button Name="Confirm" Classes="dialog fill2 danger" Command="{Binding ConfirmDeleteCommand}">
          <TextBlock Text="Delete" FontSize="13" FontWeight="SemiBold" />
        </Button>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
