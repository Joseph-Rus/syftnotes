<!-- Settings → AI tool access (design 14, Windows): the off switch, what Claude and other MCP tools may read, the
     "Claude (desktop and web)" card (connectors task 5: Funnel on/off, the address, a live check, its problems),
     connecting a tool, and the connected list. The pane's own padding and scrolling; the settings window is the
     host's. An "Other…" text button follows Codex — not in the design, added so Claude Desktop stays reachable here
     too (see WIRING.md). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             x:Class="StudyStash.App.Views.WinAiAccess"
             x:DataType="vm:AiAccessModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://StudyStash/Views/WinAiStyles.axaml" />
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36,28,36,28" Spacing="4" MaxWidth="680">

      <TextBlock Classes="ai-title" Text="AI tool access" />
      <TextBlock Classes="ai-sub" MaxWidth="560" Margin="0,4,0,0" HorizontalAlignment="Left"
                 Text="Claude Code, Codex and other tools that support MCP can read your library. They can't change or delete anything." />
      <Border Height="12" />

      <Border Classes="ai-card">
        <Grid Classes="ai-row" ColumnDefinitions="Auto,16,*,Auto">
          <c:Icon Glyph="hub" Size="20" />
          <StackPanel Classes="ai-row-text" Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Classes="ai-row-title" Text="Let AI tools read your library" />
            <TextBlock Classes="ai-row-sub" Text="Off stops every connected tool at once" />
          </StackPanel>
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="{Binding On, Converter={x:Static c:Converters.OnOff}}" FontSize="14" />
            <ToggleButton Theme="{StaticResource AiToggle}" IsChecked="{Binding On}" />
          </StackPanel>
        </Grid>
      </Border>

      <TextBlock Classes="ai-section" Text="What they can read" Margin="0,18,0,8" />
      <Border Classes="ai-card">
        <StackPanel>
          <Button Classes="ai-textbtn ai-choice quiet" Command="{Binding ToggleLecturesCommand}" HorizontalContentAlignment="Stretch">
            <Grid ColumnDefinitions="Auto,12,*" Height="40">
              <Border Classes="ai-check" Classes.on="{Binding ReadLectures}">
                <c:Icon Glyph="check" Size="14" Foreground="{DynamicResource OnAccent}" IsVisible="{Binding ReadLectures}" />
              </Border>
              <Border Classes="focusring ai-checkring" />
              <TextBlock Grid.Column="2" Classes="ai-row-title" Text="Lectures and transcripts" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button Classes="ai-textbtn ai-choice quiet" Command="{Binding ToggleNotesCommand}" HorizontalContentAlignment="Stretch">
            <Grid ColumnDefinitions="Auto,12,*" Height="40">
              <Border Classes="ai-check" Classes.on="{Binding ReadNotes}">
                <c:Icon Glyph="check" Size="14" Foreground="{DynamicResource OnAccent}" IsVisible="{Binding ReadNotes}" />
              </Border>
              <Border Classes="focusring ai-checkring" />
              <TextBlock Grid.Column="2" Classes="ai-row-title" Text="Study notes" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button Classes="ai-textbtn ai-choice quiet" Command="{Binding ToggleCanvasCommand}" HorizontalContentAlignment="Stretch">
            <Grid ColumnDefinitions="Auto,12,*" Height="40">
              <Border Classes="ai-check" Classes.on="{Binding ReadCanvas}">
                <c:Icon Glyph="check" Size="14" Foreground="{DynamicResource OnAccent}" IsVisible="{Binding ReadCanvas}" />
              </Border>
              <Border Classes="focusring ai-checkring" />
              <TextBlock Grid.Column="2" Classes="ai-row-title" Text="Canvas assignments and files" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button Classes="ai-textbtn ai-choice quiet" Command="{Binding ToggleAudioCommand}" HorizontalContentAlignment="Stretch">
            <Grid ColumnDefinitions="Auto,12,*" Height="40">
              <Border Classes="ai-check" Classes.on="{Binding ReadAudio}">
                <c:Icon Glyph="check" Size="14" Foreground="{DynamicResource OnAccent}" IsVisible="{Binding ReadAudio}" />
              </Border>
              <Border Classes="focusring ai-checkring" />
              <TextBlock Grid.Column="2" Classes="ai-row-title" Text="Audio recordings" VerticalAlignment="Center" />
            </Grid>
          </Button>
        </StackPanel>
      </Border>

      <TextBlock Classes="ai-section" Text="Claude (desktop and web)" Margin="0,18,0,8" />
      <Border Classes="ai-card">
        <StackPanel>
          <Grid Classes="ai-row" ColumnDefinitions="20,16,*,Auto" MinHeight="52">
            <c:Icon Glyph="public" Size="20" />
            <StackPanel Classes="ai-row-text" Grid.Column="2" VerticalAlignment="Center">
              <TextBlock Classes="ai-row-title" Text="Let Claude reach your library from the internet" TextWrapping="Wrap" />
              <TextBlock Classes="ai-row-sub" TextWrapping="Wrap"
                         Text="Claude on the web, the desktop app and your phone connect over HTTPS. Only someone with your library password can let them in." />
            </StackPanel>
            <Panel Grid.Column="3" VerticalAlignment="Center">
              <c:Spinner IsVisible="{Binding WebBusy}" Width="16" Height="16" Foreground="{DynamicResource Fg2}" />
              <ToggleButton IsVisible="{Binding !WebBusy}" Theme="{StaticResource AiToggle}"
                            IsChecked="{Binding WebOn}" IsEnabled="{Binding WebToggleEnabled}" />
            </Panel>
          </Grid>

          <StackPanel IsVisible="{Binding ShowWebReady}" Margin="0,10,0,0" Spacing="10">
            <Grid ColumnDefinitions="20,16,*,Auto" MinHeight="36">
              <Grid Grid.Column="2" Classes="ai-field" ColumnDefinitions="64,*" VerticalAlignment="Center">
                <TextBlock Classes="ai-row-sub" Text="Name" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="ai-row-title" Text="{Binding WebName}" VerticalAlignment="Center" />
              </Grid>
              <Button Grid.Column="3" Classes="ai-pillbtn" Command="{Binding CopyWebNameCommand}">
                <Border Classes="ai-pill"><TextBlock Text="Copy" /></Border>
              </Button>
            </Grid>
            <Grid ColumnDefinitions="20,16,*,Auto" MinHeight="36">
              <Grid Grid.Column="2" Classes="ai-field" ColumnDefinitions="64,*" VerticalAlignment="Center">
                <TextBlock Classes="ai-row-sub" Text="URL" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="ai-row-title" Text="{Binding WebUrl}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </Grid>
              <Button Grid.Column="3" Classes="ai-pillbtn" Command="{Binding CopyWebUrlCommand}">
                <Border Classes="ai-pill"><TextBlock Text="Copy" /></Border>
              </Button>
            </Grid>
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="20,16,*">
                <Border Classes="ai-num"><TextBlock Text="1" /></Border>
                <TextBlock Grid.Column="2" Classes="ai-row-sub" TextWrapping="Wrap"
                           Text="In Claude, open Settings → Connectors and choose Add custom connector." />
              </Grid>
              <Grid ColumnDefinitions="20,16,*">
                <Border Classes="ai-num"><TextBlock Text="2" /></Border>
                <TextBlock Grid.Column="2" Classes="ai-row-sub" TextWrapping="Wrap"
                           Text="Paste the name and URL, then choose Continue." />
              </Grid>
              <Grid ColumnDefinitions="20,16,*">
                <Border Classes="ai-num"><TextBlock Text="3" /></Border>
                <TextBlock Grid.Column="2" Classes="ai-row-sub" TextWrapping="Wrap"
                           Text="Sign in with your library password and choose Allow." />
              </Grid>
            </StackPanel>
            <Grid ColumnDefinitions="20,16,*,Auto" MinHeight="36">
              <Ellipse Classes="ai-dot" Classes.good="{Binding WebStatusOk}" Classes.warn="{Binding WebStatusWarn}" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="2" Classes="ai-state" Classes.warn="{Binding WebStatusWarn}" Text="{Binding WebStatusWords}" VerticalAlignment="Center" />
              <Button Grid.Column="3" Classes="ai-textbtn" Command="{Binding CheckWebAgainCommand}" VerticalAlignment="Center">
                <TextBlock Text="Check again" FontSize="14" />
              </Button>
            </Grid>
          </StackPanel>

          <Grid IsVisible="{Binding ShowWebNote}" ColumnDefinitions="20,16,*,Auto" Margin="0,10,0,0" MinHeight="40">
            <c:Icon Glyph="warning" Filled="True" Size="18" Foreground="{DynamicResource Warn}" />
            <TextBlock Grid.Column="2" Classes="ai-row-sub" TextWrapping="Wrap" Text="{Binding WebNote}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding ShowWebNoteAction}">
              <Button Classes="ai-textbtn" Command="{Binding CopyWebFixCommand}" VerticalAlignment="Center">
                <TextBlock Text="Copy link" FontSize="14" />
              </Button>
              <Button Classes="ai-pillbtn" Command="{Binding OpenWebFixCommand}">
                <Border Classes="ai-pill"><TextBlock Text="Open" /></Border>
              </Button>
            </StackPanel>
          </Grid>

          <Grid IsVisible="{Binding ShowToolsOffNote}" ColumnDefinitions="20,16,*" Margin="0,10,0,0" MinHeight="32">
            <c:Icon Glyph="info" Size="16" Foreground="{DynamicResource Fg3}" />
            <TextBlock Grid.Column="2" Classes="ai-row-sub" TextWrapping="Wrap"
                       Text="AI tool access is off, so Claude can't read anything even when connected." />
          </Grid>

          <ItemsControl ItemsSource="{Binding ClaudeConnections}" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AiConnectionRow">
                <Grid Classes="ai-row" ColumnDefinitions="20,16,*,Auto" MinHeight="40" Margin="0,4,0,0">
                  <c:Icon Glyph="{Binding Icon}" Size="18" />
                  <StackPanel Classes="ai-row-text" Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Classes="ai-row-title" Text="{Binding Name}" />
                    <TextBlock Classes="ai-row-sub" Text="{Binding WinDetail}" />
                  </StackPanel>
                  <Button Grid.Column="3" Classes="ai-pillbtn" Command="{Binding Remove}" IsVisible="{Binding CanRemove}" VerticalAlignment="Center">
                    <Border Classes="ai-pill"><TextBlock Text="Remove" /></Border>
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <TextBlock Classes="ai-section" Text="Connect a tool" Margin="0,18,0,8" />
      <Border Classes="ai-card">
        <Grid Classes="ai-row" ColumnDefinitions="Auto,16,*,Auto">
          <c:Icon Glyph="add_link" Size="20" />
          <StackPanel Classes="ai-row-text" Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Classes="ai-row-title" Text="Add Study Stash to a tool" />
            <TextBlock Classes="ai-row-sub" Text="Copies the setup, then paste it into the tool's settings" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Button Classes="ai-pillbtn" Command="{Binding CopyClaudeCodeCommand}">
              <Border Classes="ai-pill">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <c:Icon Glyph="content_copy" Size="16" />
                  <TextBlock Text="Claude Code" />
                </StackPanel>
              </Border>
            </Button>
            <Button Classes="ai-pillbtn" Command="{Binding CopyCodexCommand}">
              <Border Classes="ai-pill">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <c:Icon Glyph="content_copy" Size="16" />
                  <TextBlock Text="Codex" />
                </StackPanel>
              </Border>
            </Button>
            <Button Classes="ai-textbtn" VerticalAlignment="Center">
              <TextBlock Text="Other…" FontSize="14" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterTheme="{StaticResource AiMenuFlyout}">
                  <MenuItem Theme="{StaticResource AiMenuItem}" Header="Claude Desktop: add it for me" Command="{Binding AddClaudeDesktopCommand}" />
                  <MenuItem Theme="{StaticResource AiMenuItem}" Header="Another tool: copy the JSON" Command="{Binding CopyOtherCommand}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <TextBlock Classes="ai-section" Text="Connected tools" Margin="0,18,0,8" IsVisible="{Binding HasConnections}" />
      <ItemsControl ItemsSource="{Binding Connected}" IsVisible="{Binding HasConnections}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AiConnectionRow">
            <Border Classes="ai-card" Margin="{Binding First, Converter={x:Static c:Converters.FirstCardMargin}}">
              <Grid Classes="ai-row" ColumnDefinitions="Auto,16,*,Auto">
                <c:Icon Glyph="{Binding Icon}" Size="20" />
                <StackPanel Classes="ai-row-text" Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Classes="ai-row-title" Text="{Binding Name}" />
                  <TextBlock Classes="ai-row-sub" Text="{Binding WinDetail}" />
                </StackPanel>
                <Button Grid.Column="3" Classes="ai-pillbtn" Command="{Binding Remove}" IsVisible="{Binding CanRemove}" VerticalAlignment="Center">
                  <Border Classes="ai-pill">
                    <TextBlock Text="Remove" />
                  </Border>
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="ai-sub" Text="No tools connected yet." IsVisible="{Binding !HasConnections}" Margin="0,18,0,0" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
