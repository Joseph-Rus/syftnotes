<!-- "Which notes folder should Syft Notes use?" (both looks): a row per notes folder found on this computer (where it
     is, how many lectures and when the last one was, "In use now" on the current one, and Show in Finder or File
     Explorer), the picked one ringed in ink, and Use this folder. Setup's white sheet on the window's canvas
     (SetupStyles): ink and paper, no accent. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyStash.App.ViewModels"
             xmlns:c="using:StudyStash.App.Controls"
             x:Class="StudyStash.App.Views.NotesFolderPick"
             x:DataType="vm:NotesFolderPickModel"
             Classes="in-setup"
             Width="580">
  <UserControl.Styles>
    <StyleInclude Source="avares://StudyStash/Views/SetupStyles.axaml" />
  </UserControl.Styles>

  <Border Background="{DynamicResource Canvas}" ClipToBounds="True">
    <DockPanel>
      <!-- The title bar: drag the window by it; the system's own buttons sit in it. -->
      <c:WindowHeader DockPanel.Dock="Top" CanResize="False" Title="Syft Notes" />
      <Panel Margin="8,0,8,8">
        <Border Classes="setup-pane" />
        <Border Classes="setup-clip">
          <DockPanel>
            <Grid DockPanel.Dock="Bottom" Classes="setup-foot" ColumnDefinitions="*,Auto">
              <TextBlock Classes="say" Foreground="{DynamicResource Warn}" Text="{Binding Use.Say}" IsVisible="{Binding Use.Say, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,0,16,0" />
              <Button Name="UseFolder" Grid.Column="1" Classes="btn ink" Command="{Binding Use.Command}" IsEnabled="{Binding !Use.Busy}" IsDefault="True"
                      Content="Use this folder" />
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Classes="setup-page" Spacing="0">
                <TextBlock Name="Question" Classes="page-title step-title" Text="{x:Static vm:NotesFolderPickModel.Title}" TextWrapping="Wrap" />
                <TextBlock Classes="page-lede step-lede" Text="{x:Static vm:NotesFolderPickModel.Lede}" />
                <ItemsControl Name="Folders" ItemsSource="{Binding Rows}" Margin="0,20,0,0">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NotesFolderRow">
                      <!-- The row picks the folder; Show in Finder sits over its right end, a button of its own. -->
                      <Grid>
                        <Button Classes="choice" Classes.on="{Binding IsPicked}" Command="{Binding Pick}"
                                AutomationProperties.Name="{Binding Where}" AutomationProperties.HelpText="{Binding Detail}">
                          <Grid ColumnDefinitions="Auto,14,*,14,Auto">
                            <Border Classes="radio" Classes.on="{Binding IsPicked}"><Ellipse /></Border>
                            <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                              <TextBlock Classes="choice-title" Text="{Binding Where}" TextTrimming="CharacterEllipsis"
                                         c:Tips.WhenCut="True" ToolTip.Tip="{Binding Path}" />
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="choice-about" Text="{Binding Detail}" VerticalAlignment="Center" />
                                <Border Classes="tag" IsVisible="{Binding InUse}"><TextBlock Text="In use now" /></Border>
                              </StackPanel>
                            </StackPanel>
                            <!-- Room for the link drawn over it. -->
                            <TextBlock Grid.Column="4" FontSize="13" Opacity="0" IsHitTestVisible="False" VerticalAlignment="Center"
                                       Text="{x:Static vm:NotesFolderPickModel.RevealLabel}" />
                          </Grid>
                        </Button>
                        <Button Classes="text-link small" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                                Command="{Binding Show}" Content="{x:Static vm:NotesFolderPickModel.RevealLabel}"
                                AutomationProperties.HelpText="{Binding Path}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Panel>
    </DockPanel>
  </Border>
</UserControl>
