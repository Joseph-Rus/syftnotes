<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:StudyStash.App.Controls">
  <Styles.Resources>
    <!-- A button that is only its background: the design's buttons, rows and chips. Hover and press lay a faint
         wash over it, the way both systems do. -->
    <ControlTheme x:Key="Surface" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Border Name="PART_Bg" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
            <Border Name="PART_Wash" CornerRadius="{TemplateBinding CornerRadius}" Background="Transparent" />
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Panel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#PART_Wash">
        <Setter Property="Background" Value="{DynamicResource Hover}" />
      </Style>
      <Style Selector="^:pressed /template/ Border#PART_Wash">
        <Setter Property="Background" Value="{DynamicResource Press}" />
      </Style>
      <Style Selector="^:focus-visible /template/ Border#PART_Wash">
        <Setter Property="BorderBrush" Value="{DynamicResource Focus}" />
        <Setter Property="BorderThickness" Value="2" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.4" />
      </Style>
      <!-- A choice that shows its own hover, press and keyboard focus (a swatch's ring, a card's outline, a radio's
           rim, a Border.focusring round it): no wash, which would be a square box round something round. -->
      <Style Selector="^.quiet /template/ Border#PART_Wash">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
      </Style>
      <!-- Its content (with that focus ring just outside it) isn't cut off at the button's edge. -->
      <Style Selector="^.quiet">
        <Setter Property="ClipToBounds" Value="False" />
      </Style>
      <!-- The Mac's fills, as on the Borders below: a button round as its height reads as a pill. The tinted one
           glows past its edge, which a button would otherwise cut off. -->
      <Style Selector="^.tint">
        <Setter Property="Background" Value="{DynamicResource Tint}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        <Setter Property="ClipToBounds" Value="False" />
      </Style>
      <Style Selector="^.tint /template/ Border#PART_Bg">
        <Setter Property="BoxShadow" Value="{DynamicResource EdgeTint}" />
      </Style>
      <Style Selector="^.fill">
        <Setter Property="Background" Value="{DynamicResource Fill}" />
      </Style>
      <Style Selector="^.fill2">
        <Setter Property="Background" Value="{DynamicResource Fill2}" />
      </Style>
      <Style Selector="^.fill /template/ Border#PART_Bg, ^.fill2 /template/ Border#PART_Bg">
        <Setter Property="BoxShadow" Value="{DynamicResource EdgeSoft}" />
      </Style>
    </ControlTheme>

    <!-- Popups: every menu, flyout and context menu is one rounded panel, nothing round it. These replace Fluent's
         presenters (a square-ish box of its own, with padding, that showed round the app's rounded menus); the app's
         own menu themes (AiMenuFlyout, SettingsMenu) build on them. LayoutRoot draws the panel, Clip keeps what's
         inside to its rounded corners. No drawn shadow: a popup is a window exactly the panel's size, so one would
         only fill its corners; on a Mac the system draws the soft shadow round the panel (MacPopupShadow). -->
    <ControlTheme x:Key="{x:Type FlyoutPresenter}" TargetType="FlyoutPresenter">
      <Setter Property="Background" Value="{DynamicResource PopupBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PopupStroke}" />
      <Setter Property="BorderThickness" Value="{DynamicResource PopupStrokeWidth}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusMenu}" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="FontFamily" Value="{DynamicResource TextFont}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="MaxHeight" Value="640" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="LayoutRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
            <Border Name="Clip" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              </ScrollViewer>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter>
      <!-- A flyout whose content is already its own panel (the "Answer with" / "Rewrite notes with" glass): the
           presenter shows nothing of its own. -->
      <Style Selector="^.bare">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
      </Style>
      <Style Selector="^.bare /template/ Border#Clip">
        <Setter Property="ClipToBounds" Value="False" />
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type MenuFlyoutPresenter}" TargetType="MenuFlyoutPresenter">
      <Setter Property="Background" Value="{DynamicResource PopupBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PopupStroke}" />
      <Setter Property="BorderThickness" Value="{DynamicResource PopupStrokeWidth}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusMenu}" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="FontFamily" Value="{DynamicResource TextFont}" />
      <Setter Property="MaxHeight" Value="640" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="LayoutRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
            <Border Name="Clip" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Margin="{TemplateBinding Padding}"
                                KeyboardNavigation.TabNavigation="Continue" Grid.IsSharedSizeScope="True" />
              </ScrollViewer>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <!-- Menus (the dropdown's class picker, the library's ••• and Move): the same panel, the look's own radius. -->
    <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource PopupBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PopupStroke}" />
      <Setter Property="BorderThickness" Value="{DynamicResource PopupStrokeWidth}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusMenu}" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="MinWidth" Value="200" />
      <Setter Property="MaxHeight" Value="640" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="FontFamily" Value="{DynamicResource TextFont}" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="LayoutRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
            <Border Name="Clip" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Margin="{TemplateBinding Padding}"
                                KeyboardNavigation.TabNavigation="Continue" Grid.IsSharedSizeScope="True" />
              </ScrollViewer>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <!-- A tooltip: one small panel like the menus', the look's control radius, nothing round it (Fluent's had a dark
         square border). It fades in quickly; when it shows at all is Tips'. -->
    <ControlTheme x:Key="{x:Type ToolTip}" TargetType="ToolTip">
      <Setter Property="Background" Value="{DynamicResource PopupBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PopupStroke}" />
      <Setter Property="BorderThickness" Value="{DynamicResource PopupStrokeWidth}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="Padding" Value="8,4,8,5" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="FontFamily" Value="{DynamicResource TextFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MaxWidth" Value="320" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
        </Transitions>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_LayoutRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}">
              <ContentPresenter.Styles>
                <Style Selector="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
              </ContentPresenter.Styles>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:open">
        <Setter Property="Opacity" Value="1" />
      </Style>
    </ControlTheme>
  </Styles.Resources>

  <!-- A quiet choice's keyboard focus: a ring just outside the thing itself, which the view sizes and rounds. -->
  <Style Selector="Border.focusring">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{DynamicResource Focus}" />
  </Style>
  <Style Selector="Button.quiet:focus-visible Border.focusring">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <!-- A popup's own window shows only what its panel draws: where the system can't make it see-through, nothing
       (not white) fills the corners round the rounded panel. -->
  <Style Selector="PopupRoot">
    <Setter Property="Background" Value="{x:Null}" />
    <Setter Property="TransparencyBackgroundFallback" Value="Transparent" />
  </Style>

  <!-- A select's list (ComboBox, and a search box's suggestions) is the menus' one rounded panel (FluentPopups points
       Fluent's names at the popup tokens); its rows are rounded inside it like a menu's. -->
  <Style Selector="ComboBox /template/ Border#PopupBorder">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="ComboBoxItem, AutoCompleteBox ListBoxItem">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    <Setter Property="FontFamily" Value="{DynamicResource TextFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
    <Setter Property="Padding" Value="10,5" />
  </Style>

  <!-- A ticked box takes the colour theme's accent, not the system's blue. -->
  <Style Selector="CheckBox:checked /template/ Border#NormalRectangle, CheckBox:checked:pointerover /template/ Border#NormalRectangle, CheckBox:checked:pressed /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="CheckBox:checked /template/ Path#CheckGlyph, CheckBox:checked:pointerover /template/ Path#CheckGlyph, CheckBox:checked:pressed /template/ Path#CheckGlyph">
    <Setter Property="Fill" Value="{DynamicResource OnAccent}" />
  </Style>

  <!-- One face everywhere (a marked-up or selectable line of text is a TextBlock too), its figures all one width so
       times and counts line up. -->
  <Style Selector=":is(TextBlock)">
    <Setter Property="FontFamily" Value="{DynamicResource TextFont}" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <!-- A text field that's only its text: the design draws the field around it (the ask bars, the quick panel). -->
  <Style Selector="TextBox.bare">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource Fg3}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Ink}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Hl}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Fg}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{DynamicResource TextFont}" />
  </Style>
  <Style Selector="TextBox.bare /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!-- Its placeholder is the colour the view gives it (Fg3 unless it says otherwise), at full strength and the same
       when hovered or focused: Fluent would halve it and swap in its own. -->
  <Style Selector="TextBox.bare /template/ TextBlock#PART_Placeholder">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="TextBox.bare:pointerover /template/ TextBlock#PART_Placeholder, TextBox.bare:focus /template/ TextBlock#PART_Placeholder">
    <Setter Property="Foreground" Value="{Binding $parent[TextBox].PlaceholderForeground}" />
  </Style>
  <Style Selector="TextBox.bare:pointerover, TextBox.bare:focus">
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
  </Style>

  <Style Selector="TextBlock.num">
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>

  <!-- Status by class, so it follows the look, light and dark: a dot that's green when all is well and amber when
       something needs you, and a result line that says whether it worked. -->
  <Style Selector="Ellipse.status">
    <Setter Property="Fill" Value="{DynamicResource Good}" />
  </Style>
  <Style Selector="Ellipse.status.warn">
    <Setter Property="Fill" Value="{DynamicResource Warn}" />
  </Style>
  <Style Selector="TextBlock.result">
    <Setter Property="Foreground" Value="{DynamicResource Ok}" />
  </Style>
  <Style Selector="TextBlock.result.bad">
    <Setter Property="Foreground" Value="{DynamicResource Warn}" />
  </Style>

  <!-- The Mac's glass: views give it only its corners and padding (and the side panel's or toolbar's shadow), so the
       fill can change per window below. Its shadow falls outside it, so it never clips. -->
  <Style Selector="c|Glass">
    <Setter Property="Background" Value="{DynamicResource Glass}" />
    <Setter Property="BoxShadow" Value="{DynamicResource GlassShadow}" />
    <Setter Property="Filter" Value="{DynamicResource GlassFilter}" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>
  <!-- A floating window (the dropdown, the recorder, the quick panel) is clear, with the desktop right behind it:
       see-through glass there would be hard to read, so it's solid until the system's blur sits under it. -->
  <Style Selector=".solidglass c|Glass">
    <Setter Property="Background" Value="{DynamicResource GlassSolid}" />
  </Style>
  <!-- Glass that is a popup's own panel (the "Answer with" menu): solid, like the other menus, since nothing blurs
       what's behind a popup window; and its edges, not its drop shadow, which would only fill the window's corners. -->
  <Style Selector="FlyoutPresenter c|Glass">
    <Setter Property="Background" Value="{DynamicResource GlassSolid}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Edge}" />
  </Style>
  <!-- What lies on the Mac's glass, each with its edge highlight: "tint" is the accent seen through glass, glowing a
       little (Record, Stop, your own chat bubble), "fill" a pale pane (cards, fields, the chosen row) and "fill2" a
       greyer one (Pause, source chips). Surface buttons take the same classes. -->
  <Style Selector="Border.tint">
    <Setter Property="Background" Value="{DynamicResource Tint}" />
    <Setter Property="BoxShadow" Value="{DynamicResource EdgeTint}" />
  </Style>
  <Style Selector="Border.fill">
    <Setter Property="Background" Value="{DynamicResource Fill}" />
    <Setter Property="BoxShadow" Value="{DynamicResource EdgeSoft}" />
  </Style>
  <Style Selector="Border.fill2">
    <Setter Property="Background" Value="{DynamicResource Fill2}" />
    <Setter Property="BoxShadow" Value="{DynamicResource EdgeSoft}" />
  </Style>

  <!-- A submenu (an engine's Models) opens as the same panel as the menu it hangs off. -->
  <Style Selector="MenuItem /template/ Popup#PART_Popup > Border">
    <Setter Property="Background" Value="{DynamicResource PopupBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PopupStroke}" />
    <Setter Property="BorderThickness" Value="{DynamicResource PopupStrokeWidth}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMenu}" />
    <Setter Property="Padding" Value="5" />
  </Style>
  <Style Selector="MenuItem /template/ Popup#PART_Popup > Border > ScrollViewer > ItemsPresenter">
    <Setter Property="Margin" Value="0" />
  </Style>

  <!-- A menu's rows: one plain, neutral panel like the system's, no colour. -->
  <Style Selector="ContextMenu MenuItem">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
    <Setter Property="Padding" Value="10,5" />
  </Style>
  <Style Selector="ContextMenu Separator">
    <Setter Property="Background" Value="{DynamicResource Sep}" />
    <Setter Property="Margin" Value="8,4" />
  </Style>

  <!-- ===== The look's own pieces, the same in both systems' windows (the design's semester.css) ===== -->

  <!-- An icon alone as a button (the sidebar's toolbar, search, Settings): 32 px, muted until the pointer's on it. -->
  <Style Selector="Button.icon-btn">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
  </Style>
  <Style Selector="Button.icon-btn:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="Button.icon-btn.sm">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
  </Style>

  <!-- The sidebar's rows. The chosen one is a white chip with a hairline round it and bold words. -->
  <Style Selector="Button.nav-item">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.nav-item:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="Button.nav-item.class">
    <Setter Property="Height" Value="32" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.nav-item.selected">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.nav-item.selected /template/ Border#PART_Bg">
    <Setter Property="BoxShadow" Value="{DynamicResource LineRing}" />
  </Style>
  <!-- A count beside a row: plain grey figures, no badge behind them. -->
  <Style Selector="TextBlock.count">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource InkSubtle}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.side-group">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource InkSubtle}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A page: its title (the date, or a class's name), the sentence under it, a section's heading. -->
  <Style Selector="TextBlock.page-title">
    <Setter Property="FontSize" Value="40" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="LineHeight" Value="44" />
    <Setter Property="LetterSpacing" Value="-1" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.page-lede">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxWidth" Value="560" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="LetterSpacing" Value="-0.17" />
  </Style>
  <Style Selector="TextBlock.empty">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxWidth" Value="480" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <!-- A link in words: muted and bold over a grey underline; under the pointer both turn ink. No accent colour. -->
  <Style Selector="Button.text-link">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="0,0,0,2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>
  <Style Selector="Button.text-link /template/ Border#PART_Wash">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Button.text-link /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>
  <Style Selector="Button.text-link:pointerover, Button.text-link:focus-visible">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="Button.text-link:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.text-link:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
  </Style>

  <!-- Record: a white pill, and red only in its dot. Recording, the pill is ringed in red and the dot's centre is a
       stop square; paused, the dot is a red ring round a red centre. The words beside it are the view's. -->
  <Style Selector="Button.record">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Height" Value="48" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Padding" Value="4,4,18,4" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>
  <Style Selector="Button.record /template/ Border#PART_Bg">
    <Setter Property="BoxShadow" Value="{DynamicResource LineRing}" />
  </Style>
  <Style Selector="Button.record /template/ Border#PART_Wash">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Button.record:pointerover /template/ Border#PART_Bg, Button.record:focus-visible /template/ Border#PART_Bg">
    <Setter Property="BoxShadow" Value="{DynamicResource SubtleRing}" />
  </Style>
  <Style Selector="Button.record.recording /template/ Border#PART_Bg, Button.record.paused /template/ Border#PART_Bg">
    <Setter Property="BoxShadow" Value="{DynamicResource RecordRing}" />
  </Style>
  <Style Selector="Border.record-dot">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Background" Value="{DynamicResource Record}" />
  </Style>
  <Style Selector="Border.record-dot > Border">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="{DynamicResource OnRecord}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector=".recording Border.record-dot > Border">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector=".paused Border.record-dot">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Record}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector=".paused Border.record-dot > Border">
    <Setter Property="Background" Value="{DynamicResource Record}" />
  </Style>
  <!-- The floating recorder's dot is smaller. -->
  <Style Selector="Border.record-dot.mini">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>
  <Style Selector="Border.record-dot.mini > Border">
    <Setter Property="Width" Value="11" />
    <Setter Property="Height" Value="11" />
    <Setter Property="CornerRadius" Value="5.5" />
  </Style>
  <Style Selector=".recording Border.record-dot.mini > Border">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <!-- A shortcut's keys beside what they do. -->
  <Style Selector="Border.kbd">
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.kbd > TextBlock, TextBlock.kbd">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource InkSubtle}" />
  </Style>

  <!-- The week: a sunken grid of days, today's column lifted out of it; each day its class meetings, a hairline,
       then what's due, the name marked with its class's highlighter. -->
  <Style Selector="Border.week">
    <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>
  <Style Selector="Border.day">
    <Setter Property="Padding" Value="10,12" />
  </Style>
  <Style Selector="Border.day.today">
    <Setter Property="Margin" Value="0,-4" />
    <Setter Property="Background" Value="{DynamicResource SurfaceToday}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusDay}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowToday}" />
  </Style>
  <Style Selector="TextBlock.day-name">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource InkSubtle}" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="0,0,0,3" />
  </Style>
  <Style Selector="TextBlock.day-num">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="LineHeight" Value="26" />
    <Setter Property="LetterSpacing" Value="-0.44" />
    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
  </Style>
  <Style Selector="Border.day.today TextBlock.day-name, Border.day.today TextBlock.day-num">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="Border.day.late TextBlock.day-name">
    <Setter Property="Foreground" Value="{DynamicResource Late}" />
  </Style>
  <Style Selector="TextBlock.micro">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource InkSubtle}" />
  </Style>
  <Style Selector="TextBlock.meeting-class">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.meeting-class.recorded">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <!-- Something due: its name, marked, over when. A click opens it; under the pointer the mark is ringed in ink. -->
  <Style Selector="Button.deadline">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
  </Style>
  <Style Selector="Button.deadline /template/ Border#PART_Wash">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.deadline c|Highlight">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.deadline:pointerover c|Highlight">
    <Setter Property="Outlined" Value="True" />
  </Style>
  <Style Selector="Button.deadline.done c|Highlight">
    <Setter Property="Struck" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource InkSubtle}" />
  </Style>
  <Style Selector="TextBlock.deadline-when">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource InkSubtle}" />
  </Style>
  <Style Selector="Button.deadline.late TextBlock.deadline-when">
    <Setter Property="Foreground" Value="{DynamicResource Late}" />
  </Style>

  <!-- A lecture in a list: when, then its title over its class (marked) and a sentence or two, then how long. Rows are
       parted by hairlines: no boxes, no icons. Under the pointer the title is underlined. -->
  <Style Selector="Button.lecture">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Padding" Value="0,16" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="Button.lecture /template/ Border#PART_Wash">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TextBlock.lecture-date">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>
  <Style Selector="TextBlock.lecture-title">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="LetterSpacing" Value="-0.17" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Button.lecture:pointerover TextBlock.lecture-title">
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>
  <Style Selector="c|Highlight.lecture-class">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="TextBlock.lecture-summary">
    <Setter Property="FontSize" Value="14.5" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxLines" Value="2" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="MaxWidth" Value="590" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>
  <Style Selector="TextBlock.lecture-summary.pending">
    <Setter Property="Foreground" Value="{DynamicResource InkSubtle}" />
    <Setter Property="FontStyle" Value="Italic" />
  </Style>
  <Style Selector="TextBlock.lecture-length">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource InkSubtle}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>
  <Style Selector="Border.rule">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Line}" />
  </Style>
  <!-- The first row of a list has no hairline over it. -->
  <Style Selector="ItemsControl.rows > ContentPresenter:nth-child(1) Border.rule">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <!-- A plain row to somewhere (a class's lists on Canvas, a linked folder): its name, a line about it, an arrow. -->
  <Style Selector="Button.row-link">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Padding" Value="0,12" />
  </Style>
  <Style Selector="Button.row-link /template/ Border#PART_Wash">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.row-link:pointerover TextBlock.row-title">
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>
  <Style Selector="TextBlock.row-title">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.row-sub">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <!-- A quiet button with words (Attach, Full list, Link a folder): white, a hairline round it, the control's corners. -->
  <Style Selector="Button.plain">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>
  <Style Selector="Button.plain /template/ Border#PART_Bg">
    <Setter Property="BoxShadow" Value="{DynamicResource LineRing}" />
  </Style>

  <!-- Ask: docked at the foot of the page, floating on its shadow; with the caret in it, ringed in ink. -->
  <Style Selector="Border.ask">
    <Setter Property="Height" Value="52" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowFloat}" />
    <Setter Property="Padding" Value="18,0,10,0" />
  </Style>
  <Style Selector="Border.ask:focus-within">
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowFloatFocus}" />
  </Style>
  <Style Selector="Button.ask-scope">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.ask-scope:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="Button.ask-send">
    <Setter Property="Theme" Value="{StaticResource Surface}" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="17" />
    <Setter Property="Background" Value="{DynamicResource Ink}" />
    <Setter Property="Foreground" Value="{DynamicResource Surface}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
