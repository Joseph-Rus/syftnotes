<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Study Stash app: the menu bar (or tray) panel, the recorder, the quick panel, the library, and setup. One
       codebase draws the Mac look and the Windows look, each in light and dark. Given a command (serve, mcp, ...) it
       runs the engine instead, so the app bundle has one program. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>StudyStash</AssemblyName>
    <RootNamespace>StudyStash.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\..\assets\study-stash.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Svg.Skia" Version="5.1.1" />
    <!-- CSharpMath has no stable release; 1.0.0-pre.2 is the only build whose SkiaSharp dependency (3.119.4) matches
         Avalonia.Skia 12.1.3's, so NuGet's prerelease warning is expected here, not a sign of drift. -->
    <PackageReference Include="CSharpMath.SkiaSharp" Version="1.0.0-pre.2" NoWarn="NU5104" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StudyStash.Core\StudyStash.Core.csproj" />
    <ProjectReference Include="..\StudyStash.Audio\StudyStash.Audio.csproj" />
    <ProjectReference Include="..\StudyStash.Library\StudyStash.Library.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StudyStash.App.Tests" />
  </ItemGroup>

  <!-- StudyStash.Audio carries both live words' models (see Needle.targets): Cactus Whistle with its engine for ARM
       (needle/<rid>/), and the small Whisper for x64. A publish for one processor (the installers) keeps its own: on
       ARM (osx-arm64, win-arm64) Whistle, its own engine and its licence; on x64 (osx-x64, win-x64) the small Whisper
       and its licence. -->
  <PropertyGroup>
    <LiveWordsArm>$([System.String]::Copy('$(RuntimeIdentifier)').EndsWith('-arm64'))</LiveWordsArm>
  </PropertyGroup>
  <Target Name="KeepThisProcessorsLiveWords" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <_LiveWordsFile Include="@(ResolvedFileToPublish)" Path="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/'))" />
      <_LiveWordsDrop Include="@(_LiveWordsFile)" Condition="'$(LiveWordsArm)' == 'true' and $([System.String]::Copy('%(Path)').StartsWith('models/live-whisper'))" />
      <_LiveWordsDrop Include="@(_LiveWordsFile)" Condition="'$(LiveWordsArm)' == 'true' and $([System.String]::Copy('%(Path)').Contains('/libneedle')) and !$([System.String]::Copy('%(Path)').StartsWith('needle/$(RuntimeIdentifier)/'))" />
      <_LiveWordsDrop Include="@(_LiveWordsFile)" Condition="'$(LiveWordsArm)' != 'true' and ($([System.String]::Copy('%(Path)').StartsWith('needle/')) or '%(Path)' == 'models/whistle.cact')" />
      <ResolvedFileToPublish Remove="@(_LiveWordsDrop)" />
    </ItemGroup>
  </Target>

</Project>
