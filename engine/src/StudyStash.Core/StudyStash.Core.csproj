<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.5.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Msagl" Version="1.1.6" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <!-- The typed text in a PDF, on Windows (a Mac reads it with its own PDFKit). -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="ReverseMarkdown" Version="6.2.1" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <!-- The Chrome extension that reads Canvas: written out as a folder Chrome loads (see Canvas/Extension.cs). -->
  <ItemGroup>
    <EmbeddedResource Include="../../../extension/*" LogicalName="extension/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The ready-made parts illustrations are composed from (built by tools/PartsImport; see docs/parts-sources.md). -->
  <ItemGroup>
    <EmbeddedResource Include="Rich/PartsLibrary.xml" LogicalName="StudyStash.Core.Rich.PartsLibrary.xml" />
  </ItemGroup>

  <!-- The laptop's Google sign-in secret (the Desktop client of docs/phone-google.md), built in for GoogleClient.Secret.
       Never in the repo: CI passes the repository secret GOOGLE_DESKTOP_CLIENT_SECRET as an environment variable, and a
       build on a computer of our own can read it from engine/google-desktop-client-secret.txt (git-ignored). Without
       either the app builds as usual, and Connect with Google says this copy can't connect. -->
  <PropertyGroup>
    <GoogleSecretFile>$(MSBuildThisFileDirectory)../../google-desktop-client-secret.txt</GoogleSecretFile>
    <GoogleDesktopClientSecret Condition="'$(GOOGLE_DESKTOP_CLIENT_SECRET)' != ''">$(GOOGLE_DESKTOP_CLIENT_SECRET)</GoogleDesktopClientSecret>
    <GoogleDesktopClientSecret Condition="'$(GoogleDesktopClientSecret)' == '' and Exists('$(GoogleSecretFile)')">$([System.IO.File]::ReadAllText('$(GoogleSecretFile)').Trim())</GoogleDesktopClientSecret>
  </PropertyGroup>
  <ItemGroup Condition="'$(GoogleDesktopClientSecret)' != ''">
    <AssemblyMetadata Include="GoogleDesktopClientSecret" Value="$(GoogleDesktopClientSecret)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StudyStash.Core.Tests" />
    <!-- CI's check of the real AI sign-ins (RealCliSignInTests) reads what AgentSignIn's hidden terminal showed. -->
    <InternalsVisibleTo Include="StudyStash.App.Tests" />
  </ItemGroup>

</Project>
